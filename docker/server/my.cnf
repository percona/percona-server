[mysqld]
# SSL configuration — certs mounted via docker-compose volume
ssl_ca   = /etc/mysql/certs/ca-cert.pem
ssl_cert = /etc/mysql/certs/server-cert.pem
ssl_key  = /etc/mysql/certs/server-key.pem

# Require TLS 1.3
tls_version = TLSv1.3

# Load the authentication_appkey plugin
# The .so is mounted from the builder container output
plugin-load-add = authentication_appkey=authentication_appkey.so

# Verbose error logging for debugging
log_error_verbosity = 3

# Set appkey plugin verbosity to 2 for detailed diagnostics
loose_authentication_appkey_error_verbosity = 2
