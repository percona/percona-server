PS-10396 Test if end-range scans on a table with prefix indexes
on BLOB columns causes any memory leaks.

CREATE TABLE tb (
a BLOB,
b INT,
INDEX i1(a(1)),
INDEX i(b),
INDEX i2(a(2))
);
INSERT INTO tb VALUES ('abc', 123);
INSERT INTO tb VALUES ('abcd', 1234);
SELECT * FROM tb WHERE a BETWEEN 'abc' AND 'abc';
a	b
abc	123
DROP TABLE tb;
