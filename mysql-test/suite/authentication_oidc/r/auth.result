### INITIALIZE TESTS
INSTALL PLUGIN authentication_openid_connect SONAME 'authentication_openid_connect.so';;
CREATE USER mysql_oidc_user IDENTIFIED WITH 'authentication_openid_connect' AS '{"identity_provider" : "oidc-idp", "user" : "oidc-user"}';

### Validate system variable checks for authentication_openid_connect_configuration

## VALID CASES
SET GLOBAL authentication_openid_connect_configuration = 'JSON://{"oidc-idp": {"issuer-name": "https://idp-test.com/realms/dummy", "keys": [{"kid": "rsa-key-1", "kty": "RSA", "n": "ptR4YxjdrF2RrYiY9XYH3KcXKzlS6b2foGAeHN9dViAs5yKStKAucUf81kszq6LkzkOOPX5SbToLBRv5wwOtrBLKVkqhw4i5kS0b-7jpR9g7lER3qfDVYfe0nneaJzc-1Iz6id0oVj4ay8lGmWg5JX5Z8nBs52_7rfDIBtyAsyIQ2dF2tW4e72cypvskw_TwdbsqelY5ZezzTmKx8Ra4-o9Pu5_Vxe1Hhlkx1K_tfbGH9ZUsbFy90b0Vcw5w6EKPEkM9mZTUoj8TMeHTHaiOREK4llIJ6hokXbEG8BsKJuMuYrzx98e23JkaWaWQY27LUGK5sx-lsX_n8DO2kEASRw", "e": "AQAB", "use": "sig", "alg": "RS256"}], "audiences": ["ee2811b9-10b8","https://api.example.com"]}}';
user()	current_user()
mysql_oidc_user@localhost	mysql_oidc_user@%
SET GLOBAL authentication_openid_connect_configuration = 'FILE:///Users/michal.jankowski/dev/jankowsk-percona-server_8.4/percona-server/mysql-test/std_data/oidc/dummy_oidc_conf.json';
user()	current_user()
mysql_oidc_user@localhost	mysql_oidc_user@%

## INVALID CASES
CALL mtr.add_suppression("Plugin authentication_openid_connect reported: 'invalid sysvar prefix");
CALL mtr.add_suppression("Plugin authentication_openid_connect reported: 'invalid value for system variable'");
CALL mtr.add_suppression("Plugin authentication_openid_connect reported: 'cannot open config file:");
SET GLOBAL authentication_openid_connect_configuration = 'INVD://';
ERROR 42000: Variable 'authentication_openid_connect_configuration' can't be set to the value of 'INVD://'
SET GLOBAL authentication_openid_connect_configuration = 'JSON://{"invalid"[}';
ERROR 42000: Variable 'authentication_openid_connect_configuration' can't be set to the value of 'JSON://{"invalid"[}'
SET GLOBAL authentication_openid_connect_configuration = 'FILE://nonexistent_path/nonexistent_file.json';
ERROR 42000: Variable 'authentication_openid_connect_configuration' can't be set to the value of 'FILE://nonexistent_path/nonexistent_file.json'
SET GLOBAL authentication_openid_connect_configuration = 'JSON://{}';

### Client side validations (FR.5)
SET GLOBAL authentication_openid_connect_configuration = 'FILE:///Users/michal.jankowski/dev/jankowsk-percona-server_8.4/percona-server/mysql-test/std_data/oidc/dummy_oidc_conf.json';

### CREATE USER with incorrect AS clause
CREATE USER invalid_user IDENTIFIED WITH 'authentication_openid_connect' AS '{"identity_provider" : "oidc-idp"}';
DROP USER invalid_user;
CREATE USER invalid_user IDENTIFIED WITH 'authentication_openid_connect' AS '{"user" : "oidc-user"}';
DROP USER invalid_user;
CREATE USER invalid_user IDENTIFIED WITH 'authentication_openid_connect';
DROP USER invalid_user;

### Verifying token (FR.7, FR.8, FR.9)
CREATE USER invalid_user IDENTIFIED WITH 'authentication_openid_connect' AS '{"user" : "oidc-user", "identity_provider" : "nonexistent-idp"}';
DROP USER invalid_user;
SET GLOBAL authentication_openid_connect_configuration = 'JSON://{"oidc-idp": {"issuer-name": "https://idp-test.com/realms/dummy", "keys": [{"kid": "rsa-key-1", "kty": "RSA", "n": "ptR4YxjdrF2RrYiY9XYH3KcXKzlS6b2foGAeHN9dViAs5yKStKAucUf81kszq6LkzkOOPX5SbToLBRv5wwOtrBLKVkqhw4i5kS0b-7jpR9g7lER3qfDVYfe0nneaJzc-1Iz6id0oVj4ay8lGmWg5JX5Z8nBs52_7rfDIBtyAsyIQ2dF2tW4e72cypvskw_TwdbsqelY5ZezzTmKx8Ra4-o9Pu5_Vxe1Hhlkx1K_tfbGH9ZUsbFy90b0Vcw5w6EKPEkM9mZTUoj8TMeHTHaiOREK4llIJ6hokXbEG8BsKJuMuYrzx98e23JkaWaWQY27LUGK5sx-lsX_n8DO2kEASRw", "e": "AQAB", "use": "sig", "alg": "RS256"}], "audiences": ["ee2811b9-10b8","https://api.example.com"]}}';
user()	current_user()
mysql_oidc_user@localhost	mysql_oidc_user@%
SET GLOBAL authentication_openid_connect_configuration = 'FILE:///Users/michal.jankowski/dev/jankowsk-percona-server_8.4/percona-server/mysql-test/std_data/oidc/dummy_oidc_conf.json';

### CLEANUP
DROP USER 'mysql_oidc_user'@'%';
UNINSTALL PLUGIN authentication_openid_connect;
