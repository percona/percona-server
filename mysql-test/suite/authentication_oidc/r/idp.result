### INITIALIZE TESTS
INSTALL PLUGIN authentication_openid_connect SONAME 'authentication_openid_connect.so';
SET GLOBAL authentication_openid_connect_configuration = 'FILE:///Users/michal.jankowski/dev/jankowsk-percona-server_8.4/percona-server/mysql-test/std_data/oidc/keycloak_oidc_conf.json';
CREATE USER mysql_oidc_user IDENTIFIED WITH 'authentication_openid_connect' AS '{"identity_provider" : "my-keycloak", "user" : "4c28d537-a635-4b6d-957f-58e3c8860bcc"}';;
CREATE USER mysql_other_user IDENTIFIED WITH 'authentication_openid_connect' AS '{"identity_provider" : "my-keycloak", "user" : "other-user-id"}';

## Login tests
user()	current_user()
mysql_oidc_user@localhost	mysql_oidc_user@%

## role mapping tests
CREATE ROLE accounting;
CREATE ROLE marketing;

## Tests of update_jwks() UDF
CREATE FUNCTION update_jwks RETURNS INTEGER SONAME 'authentication_openid_connect.so';
CALL mtr.add_suppression("Plugin authentication_openid_connect reported: 'JWKS configuration is insecure");
CALL mtr.add_suppression("Plugin authentication_openid_connect reported: 'IDP not found");
CALL mtr.add_suppression("Plugin authentication_openid_connect reported: 'JWKS: HTTP GET from");
CALL mtr.add_suppression("Plugin authentication_openid_connect reported: 'configuration of unaccessible-idp");
SELECT update_jwks();
update_jwks()
1
SELECT update_jwks('my-keycloak');
update_jwks('my-keycloak')
1
SELECT update_jwks('unaccessible-idp');
update_jwks('unaccessible-idp')
0
SELECT update_jwks('dummy');
update_jwks('dummy')
NULL
SELECT update_jwks('arg1', 'arg2');
ERROR HY000: Can't initialize function 'update_jwks'; function requires 0 or 1 argument
SELECT update_jwks(123);
ERROR HY000: Can't initialize function 'update_jwks'; first argument of the function must be string

### CLEANUP
DROP USER mysql_oidc_user;
DROP USER mysql_other_user;
DROP ROLE accounting;
DROP ROLE marketing;
DROP FUNCTION update_jwks;
UNINSTALL PLUGIN authentication_openid_connect;
