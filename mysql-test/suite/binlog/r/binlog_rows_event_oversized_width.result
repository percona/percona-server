#
# Bug#39282350 - reject rows-event metadata with an oversized width
#
CREATE TABLE t1 (a INT);
# A format description event must be established first.
BINLOG 'cvN/ag8BAAAAdwAAAHsAAAABAAQANS43LjQ0LWVvbC0xMi1kZWJ1Zy1sb2cAAAAAAAAAAAAAAAAA
AAAAAAAAAAAAAAAAAABy839qEzgNAAgAEgAEBAQEEgAAXwAEGggAAAAICAgCAAAACgoKKioAEjQA
AGleF1k=';
# R2: table map + well-formed WRITE_ROWS_EVENT (width=1) in one statement equivalent to INSERT INTO t1 VALUES (1);.
BINLOG 'jPN/ahMBAAAAKQAAANoBAAAAAG0AAAAAAAEABHRlc3QAAnQxAAEDAAE=
jPN/ah4BAAAAJAAAAP4BAAAAAG0AAAAAAAEAAgAB//4BAAAA';
# R1: WRITE_ROWS_EVENT with width=4097 must be rejected while it is
#     decoded, not accepted and passed on to bitmap/row consumers.
BINLOG '';
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use
# R3: WRITE_ROWS_EVENT with width=0 must be rejected too -- the fix bounds
#     the width from both sides.
BINLOG 'jPN/ah4BAAAAHgAAAP4BAAAAAG0AAAAAAAEAAgAA';
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use
SELECT * FROM t1;
a
1
DROP TABLE t1;
