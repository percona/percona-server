# ==== Purpose ====
#
# Bug#39282350 - Validate rows event width earlier
#
# Rows_event's decoder read the column-count width with get_field_length() and
# accepted whatever it found, using it to size the column bitmaps. Unlike
# upstream 8.0, this tree did not reject width == 0 either, so the backport adds
# both bounds at once. The width is attacker controlled: it comes off the wire
# from a malicious or corrupted source, or out of a crafted binlog. An oversized
# width then drives large bitmap allocations and later decoding steps that
# assume a sane column count (bounded by MAX_FIELDS / 4096).
#
# ==== Requirements ====
#
# R1. A WRITE_ROWS_EVENT encoding width > 4096 must be rejected while the event
#     is being decoded.
#
# R2. A well-formed WRITE_ROWS_EVENT with a normal width must still decode and
#     apply, so that R1 is not satisfied by refusing rows events in general.
#
# R3. A WRITE_ROWS_EVENT encoding width == 0 must be rejected as well: the fix
#     bounds the width from both sides.
#
# ==== Implementation ====
#
# Craft the events as BINLOG statements (no debug sync). The table map and the
# well-formed write-rows event are applied in one BINLOG statement so the map
# stays open across apply. R1 carries width=4097 and a full 513-byte column
# bitmap ((4097 + 7) / 8) and no row image; R3 carries width=0 and, since
# (0 + 7) / 8 == 0, no bitmap and no row image at all.
#
# Either bound rejects the same way: Rows_event's ctor sets m_width= 0 and
# returns early, so columns_before_image and row stay empty. Rows_log_event's
# ctor then leaves m_cols.bitmap NULL and m_rows_buf 0, is_valid_param is never
# set, and Log_event::read_log_event() returns NULL -- BINLOG reports
# ER_SYNTAX_ERROR.
#
# Without the upper bound, R1's width is accepted, the 513-byte bitmap is
# copied, and apply is a no-op (no bytes remain after the bitmap, so the row
# image is empty). BINLOG returns success -- that is the bug R1 pins down.
#
# R3 is a requirement-level guard rather than a discriminating case. Even
# without the width == 0 check the event is refused, just later and for a
# different reason: the bitmap copy loop runs (0 + 7) / 8 == 0 times, so
# columns_before_image stays empty, Rows_log_event's ctor takes the
# columns_before_image.empty() branch and sets m_cols.bitmap= NULL, is_valid()
# is false, and BINLOG still reports ER_SYNTAX_ERROR. R3 therefore passes with
# or without the fix. It is kept so the rejection of width == 0 stays covered
# if that incidental bitmap-derived check is ever refactored away.
#
# ==== How the BINLOG payloads were built ====
#
# FDE and R2 (TABLE_MAP + WRITE_ROWS) are real events captured with checksums
# off and pasted verbatim from mysqlbinlog. To regenerate:
#   SET GLOBAL binlog_checksum = NONE;   -- rotates the binlog
#   RESET MASTER;                        -- fresh binlog whose FDE records NONE
#   SET SESSION binlog_format = ROW;
#   CREATE TABLE t1 (a INT);
#   INSERT INTO t1 VALUES (1);
#   \! mysqlbinlog <datadir>/master-bin.000001
# Copy the FDE BINLOG statement and the INSERT's BINLOG statement; mysqlbinlog
# emits TABLE_MAP + WRITE_ROWS in one statement (two base64 chunks, decoded via
# MY_BASE64_DECODE_ALLOW_MULTIPLE_CHUNKS). Decode any payload with:
#   echo '<base64>' | base64 -d | xxd
#
# Checksums are OFF. The FDE (5.7.44-eol-12-debug-log) carries checksum alg 0x00
# (BINLOG_CHECKSUM_ALG_OFF), so every following event is read with no trailing
# 4-byte CRC: event_size == 19-byte header + body, with no reserved tail. This
# is what keeps the byte math below exact. With checksums ON,
# Log_event::read_log_event() shortens event_len by BINLOG_CHECKSUM_LEN (and the
# CRC is not even verified -- the BINLOG path passes crc_check= 0), which would
# cut 4 bytes off R1's body and make decode fail on the truncated-body path
# instead of on the width bound -- i.e. the test would pass even with the fix
# reverted.
#
# TABLE_MAP maps table_id 0x6d (109) -> test.t1 (one INT column).
#
# Well-formed WRITE_ROWS (type 30) body after the 19-byte common header
# (buf points at the post-header inside Rows_event's ctor):
#   table_id      6 bytes  = 0x6d   (the mapped table)
#   flags         2 bytes  = STMT_END_F (1)
#   var_header_len 2 bytes = 2  (V2 post-header; no extra-row-info chunks)
#   width         1 byte   = 1
#   cols bitmap   1 byte   = 0xff
#   null bits     1 byte   = 0xfe   (bit 0 clear: column not null; the seven
#                                    unused bits are padding set to 1)
#   INT value     4 bytes  = 1
# The first three make up ROWS_HEADER_LEN_V2 (10). Applying it inserts a=1.
#
# Malformed WRITE_ROWS (R1) is generated by cloning the WRITE_ROWS event above:
# its 19-byte common header and 10-byte post-header (table_id, rows flags,
# var_header_len) are copied byte-for-byte, so R1 differs from the well-formed
# event in only four places, all unavoidable:
#   event_size    -> 545 (0x221)          (forced by the larger body)
#   width         3 bytes = net_store_length(4097) = 0xfc 0x01 0x10
#   cols bitmap 513 bytes = all zero      ((4097 + 7) / 8)
#   (no row image)
# event_len = 19 + 10 + 3 + 513 = 545, and the 513 bitmap bytes are exactly the
# body bytes left after the post-header and the width. The full bitmap is
# present so that, apart from the oversized width, R1 is a genuinely well-formed
# event: without the fix it clears the "Avoid reading out of buffer" guard
#   ptr_after_width + n_bits_len <= buf + event_len - post_header_len
#   i.e. (10 + 3) + 513 = 526 <= 545 - 10 = 535
# and deserializes, so the rejection below can only be credited to the width
# bound. R1 reuses the mapped table_id 0x6d, but decode rejects it before any
# apply.
#
# Malformed WRITE_ROWS (R3) is cloned from the same WRITE_ROWS template, with
# the smallest body the format allows:
#   event_size    -> 30 (0x1e)             (19 + 10 + 1)
#   width         1 byte  = 0x00
#   (no cols bitmap -- (0 + 7) / 8 == 0 -- and no row image)
# The single width byte is the whole body after the post-header, so R3 is also
# well-formed apart from the out-of-range width.
#

--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc

--echo #
--echo # Bug#39282350 - reject rows-event metadata with an oversized width
--echo #

CREATE TABLE t1 (a INT);

--echo # A format description event must be established first.
BINLOG 'cvN/ag8BAAAAdwAAAHsAAAABAAQANS43LjQ0LWVvbC0xMi1kZWJ1Zy1sb2cAAAAAAAAAAAAAAAAA
AAAAAAAAAAAAAAAAAABy839qEzgNAAgAEgAEBAQEEgAAXwAEGggAAAAICAgCAAAACgoKKioAEjQA
AGleF1k=';

--echo # R2: table map + well-formed WRITE_ROWS_EVENT (width=1) in one statement equivalent to INSERT INTO t1 VALUES (1);.
BINLOG 'jPN/ahMBAAAAKQAAANoBAAAAAG0AAAAAAAEABHRlc3QAAnQxAAEDAAE=
jPN/ah4BAAAAJAAAAP4BAAAAAG0AAAAAAAEAAgAB//4BAAAA';

--echo # R1: WRITE_ROWS_EVENT with width=4097 must be rejected while it is
--echo #     decoded, not accepted and passed on to bitmap/row consumers.
--error ER_SYNTAX_ERROR
BINLOG '';

--echo # R3: WRITE_ROWS_EVENT with width=0 must be rejected too -- the fix bounds
--echo #     the width from both sides.
--error ER_SYNTAX_ERROR
BINLOG 'jPN/ah4BAAAAHgAAAP4BAAAAAG0AAAAAAAEAAgAA';

SELECT * FROM t1;
DROP TABLE t1;
