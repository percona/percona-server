# ==== Purpose ====
#
# Bug#39254885 - Validate DECIMAL user var event metadata
#
# A User_var event of type DECIMAL carries its precision in val[0] and its scale
# in val[1], followed by the binary decimal payload. 5.7 performed no validation
# of that metadata at all: the deserializer only bounded val_len against the
# event, and the apply path only checked val_len < 3. bin2decimal() then reads
# decimal_bin_size(precision, scale) bytes from the payload, so an event
# declaring a large precision over a short payload reads past the end of the
# event buffer. The metadata is attacker controlled: it comes off the wire from
# a malicious or corrupted source, or out of a crafted binlog.
#
# ==== Requirements ====
#
# R1. A DECIMAL User_var event whose declared precision and scale need more
#     payload bytes than the event carries must be rejected while it is decoded.
#
# R2. A DECIMAL User_var event whose payload matches its declared precision and
#     scale must still decode, so that R1 is not satisfied by refusing DECIMAL
#     user variables in general.
#
# The event cannot be fed in with a BINLOG statement, because check_event_type()
# in sql/sql_binlog.cc admits only the format description event, the rows events
# and TABLE_MAP_EVENT. The decoder is shared with mysqlbinlog, so the crafted
# events are supplied as binlog files instead, in the style of
# std_data/binlog_no_fd_event.000001. The malformed one declares precision 65
# and scale 2 over a two-byte payload, where decimal_bin_size() needs 29, and it
# satisfies every check that predates this fix so it exercises the new
# payload-length clause alone.
#

--source include/have_log_bin.inc

--echo #
--echo # Bug#39254885 - reject DECIMAL user var metadata that overruns the payload
--echo #

--echo # R2: payload matches the declared precision and scale, so it decodes.
--exec $MYSQL_BINLOG $MYSQL_TEST_DIR/std_data/binlog_uservar_good_decimal.000001 > $MYSQLTEST_VARDIR/tmp/uservar_good.out 2>&1

--let $assert_text= a well-formed DECIMAL user var event is not rejected
--let $assert_file= $MYSQLTEST_VARDIR/tmp/uservar_good.out
--let $assert_select= Found invalid event in binary log
--let $assert_count= 0
--source include/assert_grep.inc

--echo # R1: declared precision 65 over a two-byte payload needs 29 bytes, so the
--echo #     event must be refused instead of read past its end.
--error 1
--exec $MYSQL_BINLOG $MYSQL_TEST_DIR/std_data/binlog_uservar_bad_decimal.000001 > $MYSQLTEST_VARDIR/tmp/uservar_bad.out 2>&1

--let $assert_text= the oversized DECIMAL metadata is rejected while decoding
--let $assert_file= $MYSQLTEST_VARDIR/tmp/uservar_bad.out
--let $assert_select= Found invalid event in binary log
--let $assert_count= 1
--source include/assert_grep.inc

--remove_file $MYSQLTEST_VARDIR/tmp/uservar_good.out
--remove_file $MYSQLTEST_VARDIR/tmp/uservar_bad.out
