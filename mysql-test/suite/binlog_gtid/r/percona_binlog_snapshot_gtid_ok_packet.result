RESET BINARY LOGS AND GTIDS;
CREATE TABLE t1 (a INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1);
# ALL_GTIDS: must return UUID:1-2
SET SESSION session_track_gtids='ALL_GTIDS';
START TRANSACTION WITH CONSISTENT SNAPSHOT;
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-2

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

COMMIT;
# Implicit commit of an open transaction: must return UUID:1-3,
# the snapshot, and not a mix with the committed GTID.
START TRANSACTION;
INSERT INTO t1 VALUES (2);
START TRANSACTION WITH CONSISTENT SNAPSHOT;
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-3

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

# Other session commits UUID:4
INSERT INTO t1 VALUES (3);
# FROM SESSION: must return the donor snapshot UUID:1-3, not UUID:1-4
SET SESSION session_track_gtids='ALL_GTIDS';
START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION DONOR_ID;
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-3

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

COMMIT;
# OWN_GTID: must return nothing
SET SESSION session_track_gtids='OWN_GTID';
START TRANSACTION WITH CONSISTENT SNAPSHOT;
-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

COMMIT;
# OFF: must return nothing
SET SESSION session_track_gtids='OFF';
START TRANSACTION WITH CONSISTENT SNAPSHOT;
-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

COMMIT;
# Plain START TRANSACTION: must return nothing
SET SESSION session_track_gtids='ALL_GTIDS';
START TRANSACTION;
-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_______

COMMIT;
COMMIT;
SET SESSION session_track_gtids='OFF';
DROP TABLE t1;
