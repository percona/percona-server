RESET BINARY LOGS AND GTIDS;
CREATE TABLE t1 (a INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1);
# ALL_GTIDS: must return UUID:1-2, the value of
# Binlog_snapshot_gtid_executed
SET SESSION session_track_gtids='ALL_GTIDS';
START TRANSACTION WITH CONSISTENT SNAPSHOT;
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-2

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

SHOW STATUS LIKE 'Binlog_snapshot_gtid_executed';
Variable_name	Value
Binlog_snapshot_gtid_executed	00000000-1111-0000-1111-000000000000:1-2
COMMIT;
# Implicit commit of an open transaction: must return UUID:1-3,
# the snapshot, and not a mix with the committed GTID.
START TRANSACTION;
INSERT INTO t1 VALUES (2);
START TRANSACTION WITH CONSISTENT SNAPSHOT;
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-3

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

# Other session commits UUID:4
INSERT INTO t1 VALUES (3);
# FROM SESSION: must return the donor snapshot UUID:1-3, not UUID:1-4
SET SESSION session_track_gtids='ALL_GTIDS';
START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION DONOR_ID;
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-3

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

SHOW STATUS LIKE 'Binlog_snapshot_gtid_executed';
Variable_name	Value
Binlog_snapshot_gtid_executed	00000000-1111-0000-1111-000000000000:1-3
COMMIT;
# OWN_GTID: must return nothing
SET SESSION session_track_gtids='OWN_GTID';
START TRANSACTION WITH CONSISTENT SNAPSHOT;
-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

COMMIT;
# OFF: must return nothing
SET SESSION session_track_gtids='OFF';
START TRANSACTION WITH CONSISTENT SNAPSHOT;
-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

COMMIT;
# Plain START TRANSACTION: must return nothing
SET SESSION session_track_gtids='ALL_GTIDS';
START TRANSACTION;
-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_______

COMMIT;
COMMIT;
# START TRANSACTION must return the snapshot, UUID:1-4, the following
# COMMIT must return gtid_executed, UUID:1-5
START TRANSACTION WITH CONSISTENT SNAPSHOT;
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-4

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

INSERT INTO t1 VALUES (4);
COMMIT;
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-5

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- ________

# Multi-statement query: START TRANSACTION must return the snapshot,
# UUID:1-5, COMMIT must return gtid_executed, UUID:1-6
START TRANSACTION WITH CONSISTENT SNAPSHOT; INSERT INTO t1 VALUES (5); COMMIT|
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-5

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-6

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- ________

# Stored procedures: CALL must return the snapshot only if the snapshot
# transaction is still active when the procedure ends, and otherwise
# gtid_executed, including the GTIDs committed after the snapshot.
CREATE PROCEDURE p_snapshot_commit()
BEGIN
START TRANSACTION WITH CONSISTENT SNAPSHOT;
INSERT INTO t1 VALUES (6);
COMMIT;
END|
CREATE PROCEDURE p_snapshot_rollback()
BEGIN
START TRANSACTION WITH CONSISTENT SNAPSHOT;
INSERT INTO t1 VALUES (7);
ROLLBACK;
INSERT INTO t1 VALUES (7);
END|
CREATE PROCEDURE p_snapshot()
BEGIN
START TRANSACTION WITH CONSISTENT SNAPSHOT;
END|
# Commit: must return UUID:1-10
CALL p_snapshot_commit();
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-10

# Rollback, then an autocommitted INSERT: must return UUID:1-11
CALL p_snapshot_rollback();
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-11

# Snapshot transaction still active: must return the snapshot, UUID:1-11
CALL p_snapshot();
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-11

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

SHOW STATUS LIKE 'Binlog_snapshot_gtid_executed';
Variable_name	Value
Binlog_snapshot_gtid_executed	00000000-1111-0000-1111-000000000000:1-11
COMMIT;
DROP PROCEDURE p_snapshot_commit;
DROP PROCEDURE p_snapshot_rollback;
DROP PROCEDURE p_snapshot;
# Snapshot ignored by InnoDB (READ COMMITTED): must return nothing
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

Warnings:
Warning	138	InnoDB: WITH CONSISTENT SNAPSHOT was ignored because this phrase can only be used with REPEATABLE READ isolation level.
COMMIT;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
# FROM SESSION, the donor has no snapshot: must return nothing
START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION IDLE_ID;
-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

Warnings:
Warning	138	WITH CONSISTENT SNAPSHOT FROM SESSION was ignored for binary log, because the specified session does not have a consistent snapshot of binary log coordinates.
Warning	138	InnoDB: WITH CONSISTENT SNAPSHOT FROM SESSION was ignored because the specified session does not have an open transaction inside InnoDB.
COMMIT;
# FROM SESSION, the donor has a binary log snapshot but no InnoDB read
# view (snapshot started at READ COMMITTED): must return nothing,
# although the binary log snapshot UUID:1-14 is cloned
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
Warnings:
Warning	138	InnoDB: WITH CONSISTENT SNAPSHOT was ignored because this phrase can only be used with REPEATABLE READ isolation level.
START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION RC_ID;
-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

Warnings:
Warning	138	InnoDB: WITH CONSISTENT SNAPSHOT FROM SESSION was ignored because the target transaction has not been assigned a read view.
SHOW STATUS LIKE 'Binlog_snapshot_gtid_executed';
Variable_name	Value
Binlog_snapshot_gtid_executed	00000000-1111-0000-1111-000000000000:1-14
COMMIT;
COMMIT;
# FROM SESSION, the donor does not exist: error
START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION 4294967295;
ERROR HY000: Unknown thread id: 4294967295
COMMIT;
# OWN_GTID, implicit commit of an open transaction: must return only
# the GTID of the committed transaction, UUID:15
SET SESSION session_track_gtids='OWN_GTID';
START TRANSACTION;
INSERT INTO t1 VALUES (8);
START TRANSACTION WITH CONSISTENT SNAPSHOT;
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:15

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

COMMIT;
# Stored procedures that drop the snapshot without committing anything
# and then start a plain transaction: CALL must not return the dropped
# snapshot, but what was collected before it, like without a snapshot.
SET SESSION session_track_gtids='ALL_GTIDS';
CREATE PROCEDURE p_snapshot_rollback_begin()
BEGIN
START TRANSACTION WITH CONSISTENT SNAPSHOT;
ROLLBACK;
START TRANSACTION;
END|
CREATE PROCEDURE p_snapshot_begin()
BEGIN
START TRANSACTION WITH CONSISTENT SNAPSHOT;
START TRANSACTION;
END|
CREATE PROCEDURE p_insert_snapshot_rollback_begin() BEGIN INSERT INTO t1 VALUES (9); START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION OLD_ID; ROLLBACK; START TRANSACTION; END;
# The donor snapshot is UUID:1-18
START TRANSACTION WITH CONSISTENT SNAPSHOT;
# Rollback, then plain START TRANSACTION: must return nothing
CALL p_snapshot_rollback_begin();
-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_______

COMMIT;
# Plain START TRANSACTION commits the snapshot transaction: must return
# nothing
CALL p_snapshot_begin();
-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_______

COMMIT;
# Autocommitted INSERT before an older snapshot cloned FROM SESSION:
# must return gtid_executed collected at the INSERT commit, UUID:1-19,
# neither the dropped snapshot UUID:1-18 nor nothing
CALL p_insert_snapshot_rollback_begin();
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-19

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_______

COMMIT;
COMMIT;
# Multi-statement query: INSERT must return UUID:1-20, CALL must return
# nothing, not the GTIDs already returned by INSERT
INSERT INTO t1 VALUES (10); CALL p_snapshot_rollback_begin()|
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-20

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_______

COMMIT;
DROP PROCEDURE p_snapshot_rollback_begin;
DROP PROCEDURE p_snapshot_begin;
DROP PROCEDURE p_insert_snapshot_rollback_begin;
# Multi-statement query switching session_track_gtids before the
# snapshot: the snapshot is reported according to the switched value.
# OWN_GTID to ALL_GTIDS: START TRANSACTION must return the snapshot,
# UUID:1-23
SET SESSION session_track_gtids='OWN_GTID';
SET SESSION session_track_gtids='ALL_GTIDS'; START TRANSACTION WITH CONSISTENT SNAPSHOT|
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-23

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

COMMIT;
# ALL_GTIDS to OWN_GTID: SET still returns gtid_executed, UUID:1-23, as
# it is tracked according to the previous value, START TRANSACTION must
# return nothing
SET SESSION session_track_gtids='OWN_GTID'; START TRANSACTION WITH CONSISTENT SNAPSHOT|
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-23

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

COMMIT;
# Multi-statement query with OWN_GTID, upstream behaviour kept: the
# second INSERT returns also the GTID of the first, UUID:24, UUID:24-25
INSERT INTO t1 VALUES (11); INSERT INTO t1 VALUES (12)|
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:24

-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:24-25

# Statement error handled in a stored procedure: the statement rollback
# does not end the snapshot transaction, CALL must return the snapshot,
# UUID:1-28, which Binlog_snapshot_gtid_executed keeps after another
# session commits UUID:29
SET SESSION session_track_gtids='ALL_GTIDS';
CREATE TABLE t2 (a INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t2 VALUES (1);
CREATE PROCEDURE p_snapshot_handled_error()
BEGIN
-- ER_DUP_ENTRY
DECLARE CONTINUE HANDLER FOR 1062 BEGIN END;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
INSERT INTO t2 VALUES (1);
END|
CALL p_snapshot_handled_error();
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-28

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

INSERT INTO t1 VALUES (13);
SHOW STATUS LIKE 'Binlog_snapshot_gtid_executed';
Variable_name	Value
Binlog_snapshot_gtid_executed	00000000-1111-0000-1111-000000000000:1-28
COMMIT;
DROP PROCEDURE p_snapshot_handled_error;
DROP TABLE t2;
# Stored procedure returning a result set between an older snapshot
# cloned FROM SESSION and its rollback. With CLIENT_DEPRECATE_EOF, the
# OK packet terminating the result set returns the snapshot, UUID:1-32.
# CALL must still return gtid_executed collected at the INSERT commit,
# UUID:1-33, which was not returned yet.
CREATE PROCEDURE p_insert_snapshot_select_rollback_begin() BEGIN INSERT INTO t1 VALUES (14); START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION OLD_ID; SELECT 1 AS a; ROLLBACK; START TRANSACTION; END;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
CALL p_insert_snapshot_select_rollback_begin();
a
1
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-32

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-33

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_______

COMMIT;
COMMIT;
DROP PROCEDURE p_insert_snapshot_select_rollback_begin;
SET SESSION session_track_gtids='OFF';
DROP TABLE t1;
