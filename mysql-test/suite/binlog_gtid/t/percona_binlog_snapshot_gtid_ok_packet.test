#
# START TRANSACTION WITH CONSISTENT SNAPSHOT sends the snapshot
# gtid_executed in the OK packet when session_track_gtids=ALL_GTIDS.
#
# Session tracker output is not filtered by --replace_result, so the
# server runs with a deterministic server_uuid (see -master.opt).
#
--source include/have_debug.inc
--source include/rpl/assert_gtid_mode_on.inc
--source include/have_log_bin.inc
--source include/count_sessions.inc

RESET BINARY LOGS AND GTIDS;

CREATE TABLE t1 (a INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1);

--echo # ALL_GTIDS: must return UUID:1-2, the value of
--echo # Binlog_snapshot_gtid_executed
SET SESSION session_track_gtids='ALL_GTIDS';
--enable_session_track_info
START TRANSACTION WITH CONSISTENT SNAPSHOT;
--disable_session_track_info
SHOW STATUS LIKE 'Binlog_snapshot_gtid_executed';
COMMIT;

--echo # Implicit commit of an open transaction: must return UUID:1-3,
--echo # the snapshot, and not a mix with the committed GTID.
START TRANSACTION;
INSERT INTO t1 VALUES (2);
--enable_session_track_info
START TRANSACTION WITH CONSISTENT SNAPSHOT;
--disable_session_track_info
--let $donor_id= `SELECT CONNECTION_ID()`

--echo # Other session commits UUID:4
--connect (con1,localhost,root,,)
INSERT INTO t1 VALUES (3);

--echo # FROM SESSION: must return the donor snapshot UUID:1-3, not UUID:1-4
SET SESSION session_track_gtids='ALL_GTIDS';
--enable_session_track_info
--replace_result $donor_id DONOR_ID
--eval START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION $donor_id
--disable_session_track_info
SHOW STATUS LIKE 'Binlog_snapshot_gtid_executed';
COMMIT;

--echo # OWN_GTID: must return nothing
SET SESSION session_track_gtids='OWN_GTID';
--enable_session_track_info
START TRANSACTION WITH CONSISTENT SNAPSHOT;
--disable_session_track_info
COMMIT;

--echo # OFF: must return nothing
SET SESSION session_track_gtids='OFF';
--enable_session_track_info
START TRANSACTION WITH CONSISTENT SNAPSHOT;
--disable_session_track_info
COMMIT;

--echo # Plain START TRANSACTION: must return nothing
SET SESSION session_track_gtids='ALL_GTIDS';
--enable_session_track_info
START TRANSACTION;
--disable_session_track_info
COMMIT;

--disconnect con1
--connection default
COMMIT;

--echo # START TRANSACTION must return the snapshot, UUID:1-4, the following
--echo # COMMIT must return gtid_executed, UUID:1-5
--enable_session_track_info
START TRANSACTION WITH CONSISTENT SNAPSHOT;
INSERT INTO t1 VALUES (4);
COMMIT;
--disable_session_track_info

--echo # Multi-statement query: START TRANSACTION must return the snapshot,
--echo # UUID:1-5, COMMIT must return gtid_executed, UUID:1-6
--delimiter |
--enable_session_track_info
START TRANSACTION WITH CONSISTENT SNAPSHOT; INSERT INTO t1 VALUES (5); COMMIT|
--disable_session_track_info
--delimiter ;

--echo # Stored procedures: CALL must return the snapshot only if the snapshot
--echo # transaction is still active when the procedure ends, and otherwise
--echo # gtid_executed, including the GTIDs committed after the snapshot.
--delimiter |
CREATE PROCEDURE p_snapshot_commit()
BEGIN
  START TRANSACTION WITH CONSISTENT SNAPSHOT;
  INSERT INTO t1 VALUES (6);
  COMMIT;
END|
CREATE PROCEDURE p_snapshot_rollback()
BEGIN
  START TRANSACTION WITH CONSISTENT SNAPSHOT;
  INSERT INTO t1 VALUES (7);
  ROLLBACK;
  INSERT INTO t1 VALUES (7);
END|
CREATE PROCEDURE p_snapshot()
BEGIN
  START TRANSACTION WITH CONSISTENT SNAPSHOT;
END|
--delimiter ;
--echo # Commit: must return UUID:1-10
--enable_session_track_info
CALL p_snapshot_commit();
--disable_session_track_info
--echo # Rollback, then an autocommitted INSERT: must return UUID:1-11
--enable_session_track_info
CALL p_snapshot_rollback();
--disable_session_track_info
--echo # Snapshot transaction still active: must return the snapshot, UUID:1-11
--enable_session_track_info
CALL p_snapshot();
--disable_session_track_info
SHOW STATUS LIKE 'Binlog_snapshot_gtid_executed';
COMMIT;
DROP PROCEDURE p_snapshot_commit;
DROP PROCEDURE p_snapshot_rollback;
DROP PROCEDURE p_snapshot;

--echo # Snapshot ignored by InnoDB (READ COMMITTED): must return nothing
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
--enable_session_track_info
START TRANSACTION WITH CONSISTENT SNAPSHOT;
--disable_session_track_info
COMMIT;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;

--echo # FROM SESSION, the donor has no snapshot: must return nothing
--connect (con_idle,localhost,root,,)
--let $idle_id= `SELECT CONNECTION_ID()`
--connection default
--enable_session_track_info
--replace_result $idle_id IDLE_ID
--eval START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION $idle_id
--disable_session_track_info
COMMIT;
--disconnect con_idle

--echo # FROM SESSION, the donor has a binary log snapshot but no InnoDB read
--echo # view (snapshot started at READ COMMITTED): must return nothing,
--echo # although the binary log snapshot UUID:1-14 is cloned
--connect (con_rc,localhost,root,,)
--let $rc_id= `SELECT CONNECTION_ID()`
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
--connection default
--enable_session_track_info
--replace_regex /FROM SESSION [0-9]+/FROM SESSION RC_ID/
--eval START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION $rc_id
--disable_session_track_info
SHOW STATUS LIKE 'Binlog_snapshot_gtid_executed';
COMMIT;
--connection con_rc
COMMIT;
--disconnect con_rc
--connection default

--echo # FROM SESSION, the donor does not exist: error
--error ER_NO_SUCH_THREAD
START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION 4294967295;
COMMIT;

--echo # OWN_GTID, implicit commit of an open transaction: must return only
--echo # the GTID of the committed transaction, UUID:15
SET SESSION session_track_gtids='OWN_GTID';
START TRANSACTION;
INSERT INTO t1 VALUES (8);
--enable_session_track_info
START TRANSACTION WITH CONSISTENT SNAPSHOT;
--disable_session_track_info
COMMIT;

--echo # Stored procedures that drop the snapshot without committing anything
--echo # and then start a plain transaction: CALL must not return the dropped
--echo # snapshot, but what was collected before it, like without a snapshot.
SET SESSION session_track_gtids='ALL_GTIDS';
--delimiter |
CREATE PROCEDURE p_snapshot_rollback_begin()
BEGIN
  START TRANSACTION WITH CONSISTENT SNAPSHOT;
  ROLLBACK;
  START TRANSACTION;
END|
CREATE PROCEDURE p_snapshot_begin()
BEGIN
  START TRANSACTION WITH CONSISTENT SNAPSHOT;
  START TRANSACTION;
END|
--delimiter ;
--connect (con_old,localhost,root,,)
--let $old_id= `SELECT CONNECTION_ID()`
--connection default
--replace_regex /FROM SESSION [0-9]+/FROM SESSION OLD_ID/
--eval CREATE PROCEDURE p_insert_snapshot_rollback_begin() BEGIN INSERT INTO t1 VALUES (9); START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION $old_id; ROLLBACK; START TRANSACTION; END
--echo # The donor snapshot is UUID:1-18
--connection con_old
START TRANSACTION WITH CONSISTENT SNAPSHOT;
--connection default
--echo # Rollback, then plain START TRANSACTION: must return nothing
--enable_session_track_info
CALL p_snapshot_rollback_begin();
--disable_session_track_info
COMMIT;
--echo # Plain START TRANSACTION commits the snapshot transaction: must return
--echo # nothing
--enable_session_track_info
CALL p_snapshot_begin();
--disable_session_track_info
COMMIT;
--echo # Autocommitted INSERT before an older snapshot cloned FROM SESSION:
--echo # must return gtid_executed collected at the INSERT commit, UUID:1-19,
--echo # neither the dropped snapshot UUID:1-18 nor nothing
--enable_session_track_info
CALL p_insert_snapshot_rollback_begin();
--disable_session_track_info
COMMIT;
--connection con_old
COMMIT;
--disconnect con_old
--connection default
--echo # Multi-statement query: INSERT must return UUID:1-20, CALL must return
--echo # nothing, not the GTIDs already returned by INSERT
--delimiter |
--enable_session_track_info
INSERT INTO t1 VALUES (10); CALL p_snapshot_rollback_begin()|
--disable_session_track_info
--delimiter ;
COMMIT;
DROP PROCEDURE p_snapshot_rollback_begin;
DROP PROCEDURE p_snapshot_begin;
DROP PROCEDURE p_insert_snapshot_rollback_begin;

--echo # Multi-statement query switching session_track_gtids before the
--echo # snapshot: the snapshot is reported according to the switched value.
--echo # OWN_GTID to ALL_GTIDS: START TRANSACTION must return the snapshot,
--echo # UUID:1-23
SET SESSION session_track_gtids='OWN_GTID';
--delimiter |
--enable_session_track_info
SET SESSION session_track_gtids='ALL_GTIDS'; START TRANSACTION WITH CONSISTENT SNAPSHOT|
--disable_session_track_info
--delimiter ;
COMMIT;
--echo # ALL_GTIDS to OWN_GTID: SET still returns gtid_executed, UUID:1-23, as
--echo # it is tracked according to the previous value, START TRANSACTION must
--echo # return nothing
--delimiter |
--enable_session_track_info
SET SESSION session_track_gtids='OWN_GTID'; START TRANSACTION WITH CONSISTENT SNAPSHOT|
--disable_session_track_info
--delimiter ;
COMMIT;

--echo # Multi-statement query with OWN_GTID, upstream behaviour kept: the
--echo # second INSERT returns also the GTID of the first, UUID:24, UUID:24-25
--delimiter |
--enable_session_track_info
INSERT INTO t1 VALUES (11); INSERT INTO t1 VALUES (12)|
--disable_session_track_info
--delimiter ;

--echo # Statement error handled in a stored procedure: the statement rollback
--echo # does not end the snapshot transaction, CALL must return the snapshot,
--echo # UUID:1-28, which Binlog_snapshot_gtid_executed keeps after another
--echo # session commits UUID:29
SET SESSION session_track_gtids='ALL_GTIDS';
CREATE TABLE t2 (a INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t2 VALUES (1);
--delimiter |
CREATE PROCEDURE p_snapshot_handled_error()
BEGIN
  -- ER_DUP_ENTRY
  DECLARE CONTINUE HANDLER FOR 1062 BEGIN END;
  START TRANSACTION WITH CONSISTENT SNAPSHOT;
  INSERT INTO t2 VALUES (1);
END|
--delimiter ;
--enable_session_track_info
CALL p_snapshot_handled_error();
--disable_session_track_info
--connect (con_commit,localhost,root,,)
INSERT INTO t1 VALUES (13);
--disconnect con_commit
--connection default
SHOW STATUS LIKE 'Binlog_snapshot_gtid_executed';
COMMIT;
DROP PROCEDURE p_snapshot_handled_error;
DROP TABLE t2;

--echo # Stored procedure returning a result set between an older snapshot
--echo # cloned FROM SESSION and its rollback. With CLIENT_DEPRECATE_EOF, the
--echo # OK packet terminating the result set returns the snapshot, UUID:1-32.
--echo # CALL must still return gtid_executed collected at the INSERT commit,
--echo # UUID:1-33, which was not returned yet.
--connect (con_old,localhost,root,,)
--let $old_id= `SELECT CONNECTION_ID()`
--connection default
--replace_regex /FROM SESSION [0-9]+/FROM SESSION OLD_ID/
--eval CREATE PROCEDURE p_insert_snapshot_select_rollback_begin() BEGIN INSERT INTO t1 VALUES (14); START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION $old_id; SELECT 1 AS a; ROLLBACK; START TRANSACTION; END
--connection con_old
START TRANSACTION WITH CONSISTENT SNAPSHOT;
--connection default
--enable_session_track_info
CALL p_insert_snapshot_select_rollback_begin();
--disable_session_track_info
COMMIT;
--connection con_old
COMMIT;
--disconnect con_old
--connection default
DROP PROCEDURE p_insert_snapshot_select_rollback_begin;

SET SESSION session_track_gtids='OFF';
DROP TABLE t1;

--source include/wait_until_count_sessions.inc
