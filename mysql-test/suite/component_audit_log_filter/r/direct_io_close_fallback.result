call mtr.add_suppression("Component audit_log_filter reported: 'Skipping disabled event class .* in filter");
call mtr.add_suppression("Audit Log Filter: O_DIRECT write failed, falling back to buffered I/O");
SET GLOBAL audit_log_filter.event_mode=FULL;
SELECT audit_log_filter_set_filter('log_query', '{"filter": {"class": {"name": "query"}}}');
audit_log_filter_set_filter('log_query', '{"filter": {"class": {"name": "query"}}}')
OK
SELECT audit_log_filter_set_user('%', 'log_query');
audit_log_filter_set_user('%', 'log_query')
OK
#
# Restart with direct_io=ON and ASYNCHRONOUS strategy
# restart: --audit-log-filter.direct_io=ON --audit-log-filter.strategy=ASYNCHRONOUS --audit-log-filter.event_mode=FULL
SELECT @@global.audit_log_filter.direct_io;
@@global.audit_log_filter.direct_io
1
SELECT @@global.audit_log_filter.strategy;
@@global.audit_log_filter.strategy
ASYNCHRONOUS
SET GLOBAL audit_log_filter.event_mode=FULL;
SET SESSION debug='+d,audit_log_filter_direct_flush_fail,audit_log_filter_direct_fallback_reopen_fail';
SET SESSION debug='-d,audit_log_filter_direct_flush_fail,audit_log_filter_direct_fallback_reopen_fail';
