# ----------------------------------------------------------------------
# Setup
# Creating local configuration file for keyring component: component_keyring_file
# Creating manifest file for current MySQL server instance
# Re-starting mysql server with manifest file
# ----------------------------------------------------------------------
SELECT @@global.audit_log_filter.encryption;
@@global.audit_log_filter.encryption
NONE
#
# The only password is the active one
SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
passwords
1
SET GLOBAL audit_log_filter.password_history_keep_days = 1;
SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
passwords
1
SELECT REGEXP_LIKE(JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')), '^[0-9A-Za-z]{126}$', 'c') AS generated_password_format;
generated_password_format
1
SET GLOBAL audit_log_filter.password_history_keep_days = DEFAULT;
#
# The passwords set before the active one are removed
SELECT audit_log_encryption_password_set('pwd1');
audit_log_encryption_password_set('pwd1')
OK
SELECT audit_log_encryption_password_set('pwd2');
audit_log_encryption_password_set('pwd2')
OK
SELECT audit_log_encryption_password_set('pwd3');
audit_log_encryption_password_set('pwd3')
OK
SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
passwords
4
SET GLOBAL audit_log_filter.password_history_keep_days = 1;
SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
passwords
1
SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) AS password;
password
pwd3
SET GLOBAL audit_log_filter.password_history_keep_days = DEFAULT;
#
# The active password is the same after a restart
# Re-starting mysql server with manifest file
SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
passwords
1
SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) AS password;
password
pwd3
#
# Cleanup
# ----------------------------------------------------------------------
# Teardown
# Removing manifest file for current MySQL server instance
# Removing local keyring file for keyring component: component_keyring_file
# Removing local configuration file for keyring component: component_keyring_file
# Restarting server without the manifest file
