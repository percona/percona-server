# ----------------------------------------------------------------------
# Setup
# Creating local configuration file for keyring component: component_keyring_file
# Creating manifest file for current MySQL server instance
# Re-starting mysql server with manifest file
# ----------------------------------------------------------------------
INSTALL PLUGIN keyring_udf SONAME 'keyring_udf.so';
CREATE FUNCTION keyring_key_store RETURNS INTEGER SONAME 'keyring_udf.so';
CREATE FUNCTION keyring_key_remove RETURNS INTEGER SONAME 'keyring_udf.so';
#
# A key of another owner with a long ID. performance_schema.keyring_keys
# is not read while the key exists, the table does not expect such an ID.
SELECT keyring_key_store(REPEAT('k', 2000), 'AES', '0123456789abcdef');
keyring_key_store(REPEAT('k', 2000), 'AES', '0123456789abcdef')
1
SELECT keyring_key_store('short_id', 'AES', '0123456789abcdef');
keyring_key_store('short_id', 'AES', '0123456789abcdef')
1
# The IDs are read when a password is set and when the component starts
SELECT audit_log_encryption_password_set('pwd1');
audit_log_encryption_password_set('pwd1')
OK
SELECT audit_log_encryption_password_set('pwd2');
audit_log_encryption_password_set('pwd2')
OK
# Re-starting mysql server with manifest file
SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) AS password;
password
pwd2
# The end of the keys is not logged as a failure
SELECT COUNT(*) AS failures FROM performance_schema.error_log
WHERE DATA LIKE '%Failed to get metadata from current keys metadata iterator position%';
failures
0
#
# Cleanup
SELECT keyring_key_remove(REPEAT('k', 2000));
keyring_key_remove(REPEAT('k', 2000))
1
SELECT keyring_key_remove('short_id');
keyring_key_remove('short_id')
1
SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
passwords
3
DROP FUNCTION keyring_key_store;
DROP FUNCTION keyring_key_remove;
UNINSTALL PLUGIN keyring_udf;
# ----------------------------------------------------------------------
# Teardown
# Removing manifest file for current MySQL server instance
# Removing local keyring file for keyring component: component_keyring_file
# Removing local configuration file for keyring component: component_keyring_file
# Restarting server without the manifest file
# ----------------------------------------------------------------------
