# ----------------------------------------------------------------------
# Setup
# Creating local configuration file for keyring component: component_keyring_file
# Creating manifest file for current MySQL server instance
# Re-starting mysql server with manifest file
# ----------------------------------------------------------------------
call mtr.add_suppression("generated by an earlier server version was replaced");
CREATE TABLE t1 (step VARCHAR(16) PRIMARY KEY,
key_id VARCHAR(64),
password VARCHAR(255),
recorded TIMESTAMP(6));
#
# A password generated by this version is kept
INSERT INTO t1
SELECT 'generated', MAX(KEY_ID),
JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')),
NOW(6)
FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
# Re-starting mysql server with manifest file
SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
passwords
1
SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) = password AS password_kept
FROM t1 WHERE step = 'generated';
password_kept
1
#
# A password generated by an earlier version is replaced
SELECT audit_log_encryption_password_set('TletisG7O1XFZf2yNiSFe8hkyRyzbo8wPeq8Xy7nre3O9xMYfigArDuhhsY8gg5yBn6alDLdjGtsE8GlqwnZAi7jQfrzKwxNbvxL0IqbRbJhjbIQO6rQgy9yespqhe');
audit_log_encryption_password_set('TletisG7O1XFZf2yNiSFe8hkyRyzbo8wPeq8Xy7nre3O9xMYfigArDuhhsY8gg5yBn6alDLdjGtsE8GlqwnZAi7jQfrzKwxNbvxL0IqbRbJhjbIQO6rQgy9yespqhe')
OK
INSERT INTO t1
SELECT 'legacy', MAX(KEY_ID),
JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')),
NOW(6)
FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
# Re-starting mysql server with manifest file
INSERT INTO t1
SELECT 'replaced', MAX(KEY_ID),
JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')),
NOW(6)
FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
passwords
3
SELECT r.key_id > l.key_id AS new_key_id,
r.password <> l.password AS new_password,
REGEXP_LIKE(r.password, '^[0-9A-Za-z]{126}$', 'c') AS generated_password_format
FROM t1 r, t1 l WHERE r.step = 'replaced' AND l.step = 'legacy';
new_key_id	new_password	generated_password_format
1	1	1
# The replacement is reported in the error log
SELECT COUNT(*) AS warnings
FROM performance_schema.error_log e, t1 l, t1 r
WHERE l.step = 'legacy' AND r.step = 'replaced' AND e.LOGGED > l.recorded
AND e.PRIO = 'Warning'
  AND e.DATA LIKE CONCAT('%Log encryption password with ID \'', l.key_id,
                         '\' generated by an earlier server version was replaced with newly generated password with ID \'',
                         r.key_id, '\'%');
warnings
1
# The replaced password is still available for the existing log files
SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get('LEGACY_KEY_ID'), '$.password')) = password AS legacy_password_available FROM t1 WHERE step = 'legacy';
legacy_password_available
1
# The log encrypted with the replaced password is rotated, the new one uses the new password
audit_filter.<timestamp>.log.<timestamp>.enc
#
# The new password is not replaced again
# Re-starting mysql server with manifest file
SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
passwords
3
SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) = password AS password_kept
FROM t1 WHERE step = 'replaced';
password_kept
1
#
# A password set by the user is kept
SELECT audit_log_encryption_password_set('pwd1');
audit_log_encryption_password_set('pwd1')
OK
# Re-starting mysql server with manifest file
SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
passwords
4
SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) AS password;
password
pwd1
#
# A password of one repeated character is kept, although its characters
# are related like the ones from the earlier generator
SELECT audit_log_encryption_password_set(REPEAT('0', 126));
audit_log_encryption_password_set(REPEAT('0', 126))
OK
# Re-starting mysql server with manifest file
SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
passwords
5
SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) = REPEAT('0', 126) AS password_kept;
password_kept
1
#
# The largest sequence number of an ID is followed by the first one of
# the next second
SELECT audit_log_encryption_password_set('TletisG7O1XFZf2yNiSFe8hkyRyzbo8wPeq8Xy7nre3O9xMYfigArDuhhsY8gg5yBn6alDLdjGtsE8GlqwnZAi7jQfrzKwxNbvxL0IqbRbJhjbIQO6rQgy9yespqhe');
audit_log_encryption_password_set('TletisG7O1XFZf2yNiSFe8hkyRyzbo8wPeq8Xy7nre3O9xMYfigArDuhhsY8gg5yBn6alDLdjGtsE8GlqwnZAi7jQfrzKwxNbvxL0IqbRbJhjbIQO6rQgy9yespqhe')
OK
# Re-starting mysql server with the log encryption options stored as audit_log-20990101T000000-18446744073709551615 only
SELECT KEY_ID FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%' ORDER BY KEY_ID;
KEY_ID
audit_log-20990101T000000-18446744073709551615
audit_log-20990101T000001-1
SELECT audit_log_encryption_password_get() = audit_log_encryption_password_get('audit_log-20990101T000001-1') AS new_password_active,
REGEXP_LIKE(JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')), '^[0-9A-Za-z]{126}$', 'c') AS generated_password_format;
new_password_active	generated_password_format
1	1
# The new password is not replaced again
# Re-starting mysql server with manifest file
SELECT KEY_ID FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%' ORDER BY KEY_ID;
KEY_ID
audit_log-20990101T000000-18446744073709551615
audit_log-20990101T000001-1
SELECT audit_log_encryption_password_get() = audit_log_encryption_password_get('audit_log-20990101T000001-1') AS new_password_active;
new_password_active
1
#
# A password generated by an earlier version is kept when its options
# are not valid
SELECT audit_log_encryption_password_set('TletisG7O1XFZf2yNiSFe8hkyRyzbo8wPeq8Xy7nre3O9xMYfigArDuhhsY8gg5yBn6alDLdjGtsE8GlqwnZAi7jQfrzKwxNbvxL0IqbRbJhjbIQO6rQgy9yespqhe');
audit_log_encryption_password_set('TletisG7O1XFZf2yNiSFe8hkyRyzbo8wPeq8Xy7nre3O9xMYfigArDuhhsY8gg5yBn6alDLdjGtsE8GlqwnZAi7jQfrzKwxNbvxL0IqbRbJhjbIQO6rQgy9yespqhe')
OK
# Re-starting mysql server with damaged log encryption options (iterations)
SELECT KEY_ID FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%' ORDER BY KEY_ID;
KEY_ID
audit_log-20990101T000000-18446744073709551615
audit_log-20990101T000001-1
audit_log-20990101T000001-2
SELECT audit_log_encryption_password_get();
ERROR HY000: audit_log_encryption_password_get_udf UDF failed; Could not read options
#
# The component starts when the active password cannot be read from the
# keyring
# Re-starting mysql server with damaged log encryption options (salt)
SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
passwords
3
SELECT audit_log_encryption_password_get();
ERROR HY000: audit_log_encryption_password_get_udf UDF failed; Could not read options
# Re-starting mysql server with damaged log encryption options (json)
SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
passwords
3
SELECT audit_log_encryption_password_get();
ERROR HY000: audit_log_encryption_password_get_udf UDF failed; Could not read options
# A new password can be set
SELECT audit_log_encryption_password_set('pwd2');
audit_log_encryption_password_set('pwd2')
OK
SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) AS password;
password
pwd2
#
# Cleanup
DROP TABLE t1;
