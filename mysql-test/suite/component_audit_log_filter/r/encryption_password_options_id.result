# ----------------------------------------------------------------------
# Setup
# Creating local configuration file for keyring component: component_keyring_file
# Creating manifest file for current MySQL server instance
# Re-starting mysql server with manifest file
# ----------------------------------------------------------------------
#
# Two IDs with the same time in the repeated hour are ordered by their
# sequence numbers, whatever the other IDs are
# Re-starting mysql server with the options added to the keyring file
SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) AS password;
password
audit_log-20981026T021500-2
# A new password follows them
SELECT audit_log_encryption_password_set('pwd1');
audit_log_encryption_password_set('pwd1')
OK
SELECT KEY_ID FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-2098%' ORDER BY KEY_ID;
KEY_ID
audit_log-20980101T010000-1
audit_log-20980801T010000-1
audit_log-20981026T021500-1
audit_log-20981026T021500-2
audit_log-20981026T021500-3
# Re-starting mysql server with manifest file
SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) AS password;
password
pwd1
#
# A password set after the keyring was reloaded with later options
# follows them and is the active one after a restart
ALTER INSTANCE RELOAD KEYRING;
SELECT audit_log_encryption_password_set('pwd2');
audit_log_encryption_password_set('pwd2')
OK
SELECT KEY_ID FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-2099%' ORDER BY KEY_ID;
KEY_ID
audit_log-20990601T000000-1
audit_log-20990601T000000-2
# Re-starting mysql server with manifest file
SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) AS password;
password
pwd2
