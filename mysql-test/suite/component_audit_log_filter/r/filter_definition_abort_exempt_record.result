call mtr.add_suppression("Component audit_log_filter reported: 'Audit log filter '.*': regex '.*' on field '.*' failed");
CREATE DATABASE tpcc;
CREATE TABLE tpcc.orders1 (id INT PRIMARY KEY, v INT);
CREATE USER rx_app@localhost, rx_exempt@localhost;
GRANT ALL ON tpcc.* TO rx_app@localhost, rx_exempt@localhost;
GRANT SYSTEM_USER, AUDIT_ABORT_EXEMPT ON *.* TO rx_exempt@localhost;
# Regex match errors: +0
# Case: the condition is false, the event is not logged
SELECT audit_log_filter_set_filter('rx_abort_0', '{"filter": {"class": {"name": "table_access", "event": {"name": "insert", "abort": {"field": {"name": "table_name.str", "regex": "^secret_[0-9]+$"}}, "print": {"field": {"name": "query.str", "print": false, "replace": {"function": {"name": "query_digest"}}}}}}}}') AS result;
result
OK
SELECT audit_log_filter_set_user('rx_app@localhost', 'rx_abort_0') AS result;
result
OK
SELECT audit_log_filter_set_user('rx_exempt@localhost', 'rx_abort_0') AS result;
result
OK
