# Records: 1
#   1 x query UPDATE rx_kill_data SET v = v + 1 WHERE id = 1 /* rx_kill_full */
SELECT * FROM tpcc.rx_kill_data;
id	v
1	1
# Regex match errors: +0
SELECT audit_log_filter_remove_filter('rx_kill_query_full') AS result;
result
OK
SET GLOBAL audit_log_filter.event_mode = REDUCED;
#
# Disconnect of a killed connection is still matched
#
SELECT audit_log_filter_set_filter('rx_kill_conn', '{"filter": {"class": {"name": "connection", "event": {"name": "disconnect", "log": {"field": {"name": "user.str", "regex": "^rx_kill_user$"}}}}}}') AS result;
result
OK
SELECT audit_log_filter_set_user('rx_kill_user@localhost', 'rx_kill_conn') AS result;
result
OK
# Records: 2
#   1 x connection disconnect rx_kill_user control
#   1 x connection disconnect rx_kill_user victim
# Regex match errors: +0
# Active victim killed while its statement waits for a row lock: its
# statement status and disconnect are matched, nothing is committed
SELECT audit_log_filter_set_filter('rx_kill_active', '{"filter": {"class": [{"name": "general", "event": {"name": "status", "log": {"field": {"name": "general_query.str", "regex": "rx_active_kill"}}}}, {"name": "connection", "event": {"name": "disconnect", "log": {"field": {"name": "user.str", "regex": "^rx_kill_user$"}}}}]}}') AS result;
result
OK
SELECT audit_log_filter_set_user('rx_kill_user@localhost', 'rx_kill_active') AS result;
result
OK
BEGIN;
SELECT * FROM rx_kill_data WHERE id = 1 FOR UPDATE;
id	v
1	1
UPDATE rx_kill_data SET v = v + 1 WHERE id = 1 /* rx_active_kill */;
Got one of the listed errors
ROLLBACK;
# Records: 2
#   1 x connection disconnect rx_kill_user victim
#   1 x general UPDATE rx_kill_data SET v = v + 1 WHERE id = 1 /* rx_active_kill */
SELECT * FROM tpcc.rx_kill_data;
id	v
1	1
# Regex match errors: +0
#
# A statement stopped by MAX_EXECUTION_TIME is still matched and is not
# a regex error
#
SET GLOBAL audit_log_filter.event_mode = FULL;
SELECT audit_log_filter_set_filter('rx_stmt_timeout', '{"filter": {"class": [{"name": "general", "event": {"name": "status", "log": {"field": {"name": "general_query.str", "regex": "rx_timeout_marker"}}}}, {"name": "query", "event": {"name": "status_end", "log": {"field": {"name": "query.str", "regex": "rx_timeout_marker"}}}}]}}') AS result;
result
OK
SELECT audit_log_filter_set_user('rx_app@localhost', 'rx_stmt_timeout') AS result;
result
OK
# One query/status_end and one general/status record of the statement,
# the hint and sleep arguments depend on have_statement_timeout
# Records: 2
#   1 x general SELECT /*+ MAX_EXECUTION_TIME(<masked>) */ *, SLEEP(<masked>) FROM rx_kill_data /* rx_timeout_marker */
#   1 x query SELECT /*+ MAX_EXECUTION_TIME(<masked>) */ *, SLEEP(<masked>) FROM rx_kill_data /* rx_timeout_marker */
# Regex match errors: +0
SELECT audit_log_filter_remove_filter('rx_stmt_timeout') AS result;
result
OK
SET GLOBAL audit_log_filter.event_mode = REDUCED;
#
# Cleanup
#
DROP USER rx_app@localhost, rx_exempt@localhost, rx_kill_user@localhost,
app_svc_1@localhost, app_svc_2@localhost, other_user@localhost;
DROP DATABASE tpcc;
DROP TABLE test.orders1;
