# Regex match errors: +0
#
# Raw query text is matched before conversion to UTF-8 for the log
#
SET @rx_query = "SELECT 'café' AS c /* rx_cs_marker */";
# ASCII marker matches both client character sets
SET @rx_cond = JSON_OBJECT('field', JSON_OBJECT('name', 'general_query.str', 'regex', 'rx_cs_marker'));
SET @rx_definition = JSON_OBJECT('filter', JSON_OBJECT('class', JSON_OBJECT('name', 'general', 'event', JSON_OBJECT('name', 'status', 'log', CAST(@rx_cond AS JSON)))));
SELECT audit_log_filter_set_filter('rx_charset_0', @rx_definition) AS result;
result
OK
SELECT audit_log_filter_set_user('rx_app@localhost', 'rx_charset_0') AS result;
result
OK
# Records: 2
#   2 x general SELECT 'café' AS c /* rx_cs_marker */
# UTF-8 literal matches only UTF-8 raw text
SET @rx_cond = JSON_OBJECT('field', JSON_OBJECT('name', 'general_query.str', 'regex', 'café.*rx_cs_marker'));
SET @rx_definition = JSON_OBJECT('filter', JSON_OBJECT('class', JSON_OBJECT('name', 'general', 'event', JSON_OBJECT('name', 'status', 'log', CAST(@rx_cond AS JSON)))));
SELECT audit_log_filter_set_filter('rx_charset_1', @rx_definition) AS result;
result
OK
SELECT audit_log_filter_set_user('rx_app@localhost', 'rx_charset_1') AS result;
result
OK
# Records: 1
#   1 x general SELECT 'café' AS c /* rx_cs_marker */
# Raw byte length still selects only the latin1 text
SET @rx_cond = JSON_OBJECT('and', JSON_ARRAY(JSON_OBJECT('field', JSON_OBJECT('name', 'general_query.str', 'regex', 'rx_cs_marker')), JSON_OBJECT('field', JSON_OBJECT('name', 'general_query.length', 'value', LENGTH(CONVERT(@rx_query USING latin1))))));
SET @rx_definition = JSON_OBJECT('filter', JSON_OBJECT('class', JSON_OBJECT('name', 'general', 'event', JSON_OBJECT('name', 'status', 'log', CAST(@rx_cond AS JSON)))));
SELECT audit_log_filter_set_filter('rx_charset_2', @rx_definition) AS result;
result
OK
SELECT audit_log_filter_set_user('rx_app@localhost', 'rx_charset_2') AS result;
result
OK
# Records: 1
