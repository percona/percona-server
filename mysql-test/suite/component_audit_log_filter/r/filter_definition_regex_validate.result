# Pattern containing NUL built with JSON_OBJECT() is stored decoded
SET @rx_pattern = CONCAT('nul_probe_a', CHAR(0 USING utf8mb4), 'b');
SET @rx_definition = JSON_OBJECT('filter', JSON_OBJECT('class', JSON_OBJECT('name', 'general', 'event', JSON_OBJECT('name', 'status', 'log', JSON_OBJECT('field', JSON_OBJECT('name', 'general_query.str', 'regex', @rx_pattern))))));
SELECT audit_log_filter_set_filter('rx_nul_json', @rx_definition) AS result;
result
OK
SELECT JSON_UNQUOTE(JSON_EXTRACT(filter, '$.filter.class.event.log.field.regex')) = @rx_pattern AS pattern_stored,
LENGTH(JSON_UNQUOTE(JSON_EXTRACT(filter, '$.filter.class.event.log.field.regex'))) AS pattern_length
FROM mysql.audit_log_filter WHERE name = 'rx_nul_json';
pattern_stored	pattern_length
1	13
