#
# Whole definition size gate is checked first
#
SET @rx_definition = CONCAT('{"filter":{"class":{"name":"table_access","event":{"name":"insert","log":{"field":{"name":"table_name.str","regex":"', REPEAT('a', 16400), '"}}}}}}');
SELECT audit_log_filter_set_filter('rx_too_long', @rx_definition);
ERROR HY000: Can't initialize function 'audit_log_filter_set_filter'; Wrong argument: definition is too long, max length is 16384
SELECT COUNT(*) AS stored_rows FROM mysql.audit_log_filter WHERE name = 'rx_too_long';
stored_rows
0
#
# Stored definitions are validated when loaded
#
SELECT audit_log_filter_flush() AS result;
result
OK
