#
# Keyring component not initialized
SELECT audit_log_encryption_password_get();
ERROR HY000: Can't initialize function 'audit_log_encryption_password_get'; Keyring component not initialized
# ----------------------------------------------------------------------
# Setup
# Creating local configuration file for keyring component: component_keyring_file
# Creating manifest file for current MySQL server instance
# Re-starting mysql server with manifest file
# ----------------------------------------------------------------------
#
# Check wrong argument number
SELECT audit_log_encryption_password_get('arg1', 'arg2');
ERROR HY000: Can't initialize function 'audit_log_encryption_password_get'; Wrong argument list: audit_log_encryption_password_get([keyring_id])
#
# Check wrong argument type
SELECT audit_log_encryption_password_get(1);
ERROR HY000: Can't initialize function 'audit_log_encryption_password_get'; Wrong argument type: audit_log_encryption_password_get(string)
SELECT audit_log_encryption_password_get(0.1);
ERROR HY000: Can't initialize function 'audit_log_encryption_password_get'; Wrong argument type: audit_log_encryption_password_get(string)
#
# Check empty argument
SELECT audit_log_encryption_password_get('');
ERROR HY000: Can't initialize function 'audit_log_encryption_password_get'; Wrong argument: empty keyring_id
#
# Check too long argument
SELECT audit_log_encryption_password_get('');
ERROR HY000: Can't initialize function 'audit_log_encryption_password_get'; Wrong argument: keyring_id is too long, max length is 766
#
# Get current password
SELECT audit_log_encryption_password_get();
audit_log_encryption_password_get()
{"password":"pwd","salt":"ffffffffffffffff","iterations":1000}
#
# The generated password has 126 characters from [0-9A-Za-z]
SELECT REGEXP_LIKE(JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')), '^[0-9A-Za-z]{126}$', 'c') AS generated_password_format;
generated_password_format
1
#
# The options are returned for every row of a result
SELECT audit_log_encryption_password_set('pwd1');
audit_log_encryption_password_set('pwd1')
OK
SELECT audit_log_encryption_password_set('pwd2');
audit_log_encryption_password_set('pwd2')
OK
CREATE TABLE t1 (id INT PRIMARY KEY AUTO_INCREMENT, key_id VARCHAR(64));
INSERT INTO t1 (key_id)
SELECT KEY_ID FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%' ORDER BY KEY_ID;
INSERT INTO t1 (key_id) SELECT key_id FROM t1 ORDER BY id;
SELECT id, JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(key_id), '$.password')) IN ('pwd1', 'pwd2') AS password_set
FROM t1 ORDER BY id;
id	password_set
1	0
2	1
3	1
4	0
5	1
6	1
SELECT COUNT(*) AS rows_read, COUNT(DISTINCT audit_log_encryption_password_get(key_id)) AS options_read FROM t1;
rows_read	options_read
6	3
DROP TABLE t1;
