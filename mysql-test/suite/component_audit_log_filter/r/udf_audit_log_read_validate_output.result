Validate audit log filter output
File format Ok
Export output of audit_log_read('$start_bookmark_esc') to a file
SET @start_bookmark_esc := REPLACE(@start_bookmark, '"', '\\"');
Validate output of audit_log_read('$start_bookmark_esc')
File format Ok
Ignore first event as our bookmark points to the last event in the previous log
SELECT audit_log_read(JSON_SET(@start_bookmark, '$.max_array_length', 1));
Start processing audit log from the beginning. Get 5 events from "audit_log_read"
SELECT audit_log_read('{"max_array_length": 4}');
audit_log_read('{"max_array_length": 4}')
[
{"timestamp": "<hidden>", "id": 0, "class": "command", "event": "command_start", "connection_id": <id>, "command_data": {"name": "command_start", "status": 0, "command": "Query"}},
{"timestamp": "<hidden>", "id": 1, "class": "general", "event": "log", "connection_id": <id>, "account": {"user": "user1", "host": "localhost"}, "login": {"user": "user1", "os": "", "ip": "", "proxy": ""}, "general_data": {"command": "Query", "sql_command": "insert", "query": "INSERT INTO t1 VALUES (1)", "status": 0}},
{"timestamp": "<hidden>", "id": 2, "class": "query", "event": "query_start", "connection_id": <id>, "query_data": {"query": "INSERT INTO t1 VALUES (1)", "status": 0, "sql_command": "insert"}},
{"timestamp": "<hidden>", "id": 3, "class": "table_access", "event": "insert", "connection_id": <id>, "account": {"user": "user1", "host": "localhost"}, "login": {"user": "user1", "os": "", "ip": "", "proxy": ""}, "table_access_data": {"db": "test", "table": "t1", "query": "INSERT INTO t1 VALUES (1)", "sql_command": "insert"}}
]

