#
# PS-10347: AuditJsonHandler used by audit_log_read UDF returns malformed JSON
# https://perconadev.atlassian.net/browse/PS-10347
#
CREATE TABLE t1 (c1 INT);
CREATE USER user1@localhost IDENTIFIED BY 'pass';
GRANT ALL ON *.* TO user1@localhost;
SELECT audit_log_filter_set_filter('filter_que_gen_com_tab', '{"filter": { "class": [
  { "name": "query" },
  { "name": "general" },
  { "name": "command" },
  { "name": "table_access" }
] } }');
audit_log_filter_set_filter('filter_que_gen_com_tab', '{"filter": { "class": [
  { "name": "query" },
  { "name": "general" },
  { "name": "command" },
  { "name": "table_access" }
] } }')
OK
Turn on audit log
SELECT audit_log_filter_set_user('user1@localhost', 'filter_que_gen_com_tab');
audit_log_filter_set_user('user1@localhost', 'filter_que_gen_com_tab')
OK
SET @start_bookmark := audit_log_read_bookmark();
INSERT INTO t1 VALUES (1);
Turn off audit log
SELECT audit_log_filter_remove_filter('filter_que_gen_com_tab');
audit_log_filter_remove_filter('filter_que_gen_com_tab')
OK
Rotate to close a log file and get access to it
Print audit log filter output
