#
# Outdated log encryption passwords are removed when the log is not encrypted,
# the active password is kept: no log file uses it, but it is the one
# returned by audit_log_encryption_password_get() and used when the
# encryption is enabled.
#
# The debug time moves by a day every time it is read, so every password is
# older than a day when the outdated ones are removed.
#
--source include/have_debug.inc
--source include/have_component_audit_log.inc
--source include/have_component_keyring_file.inc
--source suite/component_keyring_file/inc/setup_component.inc
--source ../inc/audit_tables_init.inc
--source ../inc/audit_comp_install.inc

SELECT @@global.audit_log_filter.encryption;

--echo #
--echo # The only password is the active one
SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
SET GLOBAL audit_log_filter.password_history_keep_days = 1;
SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
SELECT REGEXP_LIKE(JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')), '^[0-9A-Za-z]{126}$', 'c') AS generated_password_format;
SET GLOBAL audit_log_filter.password_history_keep_days = DEFAULT;

--echo #
--echo # The passwords set before the active one are removed
SELECT audit_log_encryption_password_set('pwd1');
SELECT audit_log_encryption_password_set('pwd2');
SELECT audit_log_encryption_password_set('pwd3');
SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
SET GLOBAL audit_log_filter.password_history_keep_days = 1;
SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) AS password;
SET GLOBAL audit_log_filter.password_history_keep_days = DEFAULT;

--echo #
--echo # The active password is the same after a restart
--source include/keyring_tests/helper/start_server_with_manifest.inc

SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) AS password;

--echo #
--echo # Cleanup
--source ../inc/audit_comp_uninstall.inc
--source ../inc/audit_tables_cleanup.inc
--source suite/component_keyring_file/inc/teardown_component.inc
