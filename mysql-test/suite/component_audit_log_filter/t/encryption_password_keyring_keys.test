#
# The log encryption options are read from the keyring among the keys of
# other owners:
#  - a key with an ID longer than 1023 characters
#  - reading the IDs of all keys logs no failure
#
--source include/have_component_audit_log.inc
--source include/have_component_keyring_file.inc
--source suite/component_keyring_file/inc/setup_component.inc
--source ../inc/audit_tables_init.inc
--source ../inc/audit_comp_install.inc

--replace_regex /\.dll/.so/
--eval INSTALL PLUGIN keyring_udf SONAME '$KEYRING_UDF'
--replace_regex /\.dll/.so/
--eval CREATE FUNCTION keyring_key_store RETURNS INTEGER SONAME '$KEYRING_UDF'
--replace_regex /\.dll/.so/
--eval CREATE FUNCTION keyring_key_remove RETURNS INTEGER SONAME '$KEYRING_UDF'

--echo #
--echo # A key of another owner with a long ID. performance_schema.keyring_keys
--echo # is not read while the key exists, the table does not expect such an ID.
SELECT keyring_key_store(REPEAT('k', 2000), 'AES', '0123456789abcdef');
SELECT keyring_key_store('short_id', 'AES', '0123456789abcdef');

--echo # The IDs are read when a password is set and when the component starts
SELECT audit_log_encryption_password_set('pwd1');
SELECT audit_log_encryption_password_set('pwd2');
--source include/keyring_tests/helper/start_server_with_manifest.inc

SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) AS password;

--echo # The end of the keys is not logged as a failure
SELECT COUNT(*) AS failures FROM performance_schema.error_log
WHERE DATA LIKE '%Failed to get metadata from current keys metadata iterator position%';

--echo #
--echo # Cleanup
SELECT keyring_key_remove(REPEAT('k', 2000));
SELECT keyring_key_remove('short_id');
SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
DROP FUNCTION keyring_key_store;
DROP FUNCTION keyring_key_remove;
UNINSTALL PLUGIN keyring_udf;
--source ../inc/audit_comp_uninstall.inc
--source ../inc/audit_tables_cleanup.inc
--source suite/component_keyring_file/inc/teardown_component.inc
