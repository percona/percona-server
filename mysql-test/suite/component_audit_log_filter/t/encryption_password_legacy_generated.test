#
# A log encryption password generated by an earlier server version is replaced
# with a newly generated one when the component starts. The replaced password
# stays in the keyring for the existing log files.
#
# See encryption_password_legacy_generated_debug for the cases that need
# debug keywords.
#
--source include/have_component_audit_log.inc
--source include/have_component_keyring_file.inc
--source suite/component_keyring_file/inc/setup_component.inc
--source ../inc/audit_tables_init.inc
--source ../inc/audit_comp_install.inc

call mtr.add_suppression("generated by an earlier server version was replaced");

--let $audit_filter_log_path = `SELECT @@global.datadir`

CREATE TABLE t1 (step VARCHAR(16) PRIMARY KEY,
                 key_id VARCHAR(64),
                 password VARCHAR(255),
                 recorded TIMESTAMP(6));

--echo #
--echo # A password generated by this version is kept
INSERT INTO t1
SELECT 'generated', MAX(KEY_ID),
       JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')),
       NOW(6)
FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';

--source include/keyring_tests/helper/start_server_with_manifest.inc

SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) = password AS password_kept
FROM t1 WHERE step = 'generated';

--echo #
--echo # A password generated by an earlier version is replaced
SELECT audit_log_encryption_password_set('TletisG7O1XFZf2yNiSFe8hkyRyzbo8wPeq8Xy7nre3O9xMYfigArDuhhsY8gg5yBn6alDLdjGtsE8GlqwnZAi7jQfrzKwxNbvxL0IqbRbJhjbIQO6rQgy9yespqhe');
INSERT INTO t1
SELECT 'legacy', MAX(KEY_ID),
       JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')),
       NOW(6)
FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';

--source include/keyring_tests/helper/start_server_with_manifest.inc

INSERT INTO t1
SELECT 'replaced', MAX(KEY_ID),
       JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')),
       NOW(6)
FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';

SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
SELECT r.key_id > l.key_id AS new_key_id,
       r.password <> l.password AS new_password,
       REGEXP_LIKE(r.password, '^[0-9A-Za-z]{126}$', 'c') AS generated_password_format
FROM t1 r, t1 l WHERE r.step = 'replaced' AND l.step = 'legacy';

--echo # The replacement is reported in the error log
SELECT COUNT(*) AS warnings
FROM performance_schema.error_log e, t1 l, t1 r
WHERE l.step = 'legacy' AND r.step = 'replaced' AND e.LOGGED > l.recorded
  AND e.PRIO = 'Warning'
  AND e.DATA LIKE CONCAT('%Log encryption password with ID \'', l.key_id,
                         '\' generated by an earlier server version was replaced with newly generated password with ID \'',
                         r.key_id, '\'%');

--echo # The replaced password is still available for the existing log files
--let $legacy_key_id = `SELECT key_id FROM t1 WHERE step = 'legacy'`
--let $legacy_key_timestamp = `SELECT SUBSTRING(key_id, 11) FROM t1 WHERE step = 'legacy'`
--let $replaced_key_timestamp = `SELECT SUBSTRING(key_id, 11) FROM t1 WHERE step = 'replaced'`
--replace_result $legacy_key_id LEGACY_KEY_ID
--eval SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get('$legacy_key_id'), '\$.password')) = password AS legacy_password_available FROM t1 WHERE step = 'legacy'

--echo # The log encrypted with the replaced password is rotated, the new one uses the new password
--replace_regex /\d{8}T\d{6}(-\d+)?/<timestamp>/
--list_files $audit_filter_log_path audit_filter.*.log.$legacy_key_timestamp.enc
--file_exists $audit_filter_log_path/audit_filter.log.$replaced_key_timestamp.enc

--echo #
--echo # The new password is not replaced again
--source include/keyring_tests/helper/start_server_with_manifest.inc

SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) = password AS password_kept
FROM t1 WHERE step = 'replaced';

--echo #
--echo # A password set by the user is kept
SELECT audit_log_encryption_password_set('pwd1');

--source include/keyring_tests/helper/start_server_with_manifest.inc

SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) AS password;

--echo #
--echo # A password of one repeated character is kept, although its characters
--echo # are related like the ones from the earlier generator
SELECT audit_log_encryption_password_set(REPEAT('0', 126));

--source include/keyring_tests/helper/start_server_with_manifest.inc

SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) = REPEAT('0', 126) AS password_kept;

--echo #
--echo # The largest sequence number of an ID is followed by the first one of
--echo # the next second
SELECT audit_log_encryption_password_set('TletisG7O1XFZf2yNiSFe8hkyRyzbo8wPeq8Xy7nre3O9xMYfigArDuhhsY8gg5yBn6alDLdjGtsE8GlqwnZAi7jQfrzKwxNbvxL0IqbRbJhjbIQO6rQgy9yespqhe');
--let AUDIT_OPTIONS_ID = audit_log-20990101T000000-18446744073709551615
--source ../inc/keyring_file_set_audit_options_id.inc

SELECT KEY_ID FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%' ORDER BY KEY_ID;
SELECT audit_log_encryption_password_get() = audit_log_encryption_password_get('audit_log-20990101T000001-1') AS new_password_active,
       REGEXP_LIKE(JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')), '^[0-9A-Za-z]{126}$', 'c') AS generated_password_format;

--echo # The new password is not replaced again
--source include/keyring_tests/helper/start_server_with_manifest.inc

SELECT KEY_ID FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%' ORDER BY KEY_ID;
SELECT audit_log_encryption_password_get() = audit_log_encryption_password_get('audit_log-20990101T000001-1') AS new_password_active;

--echo #
--echo # A password generated by an earlier version is kept when its options
--echo # are not valid
SELECT audit_log_encryption_password_set('TletisG7O1XFZf2yNiSFe8hkyRyzbo8wPeq8Xy7nre3O9xMYfigArDuhhsY8gg5yBn6alDLdjGtsE8GlqwnZAi7jQfrzKwxNbvxL0IqbRbJhjbIQO6rQgy9yespqhe');
--let AUDIT_OPTIONS_DAMAGE = iterations
--source ../inc/keyring_file_damage_audit_options.inc

SELECT KEY_ID FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%' ORDER BY KEY_ID;
--error ER_UDF_ERROR
SELECT audit_log_encryption_password_get();

--echo #
--echo # The component starts when the active password cannot be read from the
--echo # keyring
--let AUDIT_OPTIONS_DAMAGE = salt
--source ../inc/keyring_file_damage_audit_options.inc

SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
--error ER_UDF_ERROR
SELECT audit_log_encryption_password_get();

--let AUDIT_OPTIONS_DAMAGE = json
--source ../inc/keyring_file_damage_audit_options.inc

SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
--error ER_UDF_ERROR
SELECT audit_log_encryption_password_get();

--echo # A new password can be set
SELECT audit_log_encryption_password_set('pwd2');
SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) AS password;

--echo #
--echo # Cleanup
DROP TABLE t1;
--source ../inc/audit_comp_uninstall.inc
--source ../inc/audit_tables_cleanup.inc
--source suite/component_keyring_file/inc/teardown_component.inc
