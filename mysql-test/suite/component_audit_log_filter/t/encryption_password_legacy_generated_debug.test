#
# Replacement of a log encryption password generated by an earlier server
# version, the cases that need debug keywords:
#  - the new password cannot be stored in the keyring
#  - the local time is behind the ID of the replaced password
#  - the local time is equal to the timestamp of the latest ID
#
# See encryption_password_legacy_generated for the other cases.
#
--source include/have_debug.inc
--source include/have_component_audit_log.inc
--source include/have_component_keyring_file.inc
--source suite/component_keyring_file/inc/setup_component.inc
--source ../inc/audit_tables_init.inc
--source ../inc/audit_comp_install.inc

call mtr.add_suppression("generated by an earlier server version");
call mtr.add_suppression("Failed to store keyring data");

--let $audit_filter_log_path = `SELECT @@global.datadir`

CREATE TABLE t1 (step VARCHAR(16) PRIMARY KEY,
                 key_id VARCHAR(64),
                 password VARCHAR(255),
                 recorded TIMESTAMP(6));

SELECT audit_log_encryption_password_set('TletisG7O1XFZf2yNiSFe8hkyRyzbo8wPeq8Xy7nre3O9xMYfigArDuhhsY8gg5yBn6alDLdjGtsE8GlqwnZAi7jQfrzKwxNbvxL0IqbRbJhjbIQO6rQgy9yespqhe');
INSERT INTO t1
SELECT 'legacy', MAX(KEY_ID),
       JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')),
       NOW(6)
FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';

--echo #
--echo # The password is kept when the new one cannot be stored in the keyring
--echo # Re-starting mysql server with a failing keyring
--let $restart_parameters = restart: $PLUGIN_DIR_OPT --debug=+d,audit_log_filter_fail_keyring_store
--source include/restart_mysqld_no_echo.inc

SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) = password AS password_kept
FROM t1 WHERE step = 'legacy';
SELECT e.PRIO, COUNT(*) AS messages
FROM performance_schema.error_log e, t1 l
WHERE l.step = 'legacy' AND e.LOGGED > l.recorded
  AND e.DATA LIKE CONCAT('%Failed to replace log encryption password with ID \'', l.key_id,
                         '\' generated by an earlier server version%')
GROUP BY e.PRIO;
--echo # The log is still encrypted with the kept password
--let $legacy_key_timestamp = `SELECT SUBSTRING(key_id, 11) FROM t1 WHERE step = 'legacy'`
--file_exists $audit_filter_log_path/audit_filter.log.$legacy_key_timestamp.enc

--echo #
--echo # The ID of the new password follows the ID of the replaced one when the
--echo # local time is behind it
--echo # Re-starting mysql server with the time set back
--let $restart_parameters = restart: $PLUGIN_DIR_OPT --debug=+d,audit_log_filter_debug_timestamp
--source include/restart_mysqld_no_echo.inc

INSERT INTO t1
SELECT 'replaced', MAX(KEY_ID),
       JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')),
       NOW(6)
FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';

SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
SELECT r.password <> l.password AS new_password,
       SUBSTRING_INDEX(r.key_id, '-', 2) = SUBSTRING_INDEX(l.key_id, '-', 2) AS same_timestamp,
       SUBSTRING_INDEX(r.key_id, '-', -1) - SUBSTRING_INDEX(l.key_id, '-', -1) AS sequence_number_step
FROM t1 r, t1 l WHERE r.step = 'replaced' AND l.step = 'legacy';

--echo # The new password stays active after the next restarts
--echo # Re-starting mysql server with the time set back
--source include/restart_mysqld_no_echo.inc
--echo # Re-starting mysql server with the time set back
--source include/restart_mysqld_no_echo.inc

SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) = password AS password_kept
FROM t1 WHERE step = 'replaced';

--echo #
--echo # A password set while the local time is behind the IDs in the keyring
--echo # stays active after a restart
SELECT audit_log_encryption_password_set('pwd1');
SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
SELECT SUBSTRING_INDEX(MAX(k.KEY_ID), '-', 2) = SUBSTRING_INDEX(r.key_id, '-', 2) AS same_timestamp,
       SUBSTRING_INDEX(MAX(k.KEY_ID), '-', -1) - SUBSTRING_INDEX(r.key_id, '-', -1) AS sequence_number_step
FROM performance_schema.keyring_keys k, t1 r
WHERE k.KEY_ID LIKE 'audit_log-%' AND r.step = 'replaced'
GROUP BY r.key_id;

--echo # Re-starting mysql server with the time set back
--source include/restart_mysqld_no_echo.inc

SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) AS password;

--echo #
--echo # Passwords with IDs ahead of the local time are not taken for outdated
--echo # ones. Without the rotated logs none of the passwords is in use except
--echo # the active one.
--remove_files_wildcard $audit_filter_log_path audit_filter.????????T??????.log*
SET GLOBAL audit_log_filter.password_history_keep_days = 3;
SELECT COUNT(*) AS passwords FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%';
SET GLOBAL audit_log_filter.password_history_keep_days = DEFAULT;

--echo #
--echo # A password set at the local time of the latest ID stays active after
--echo # a restart: its ID takes the next sequence number, also when the smaller
--echo # ones are free. The debug time starts at 20220809T100000 and moves by
--echo # a day when it is read.
--let AUDIT_OPTIONS_ID = audit_log-20220810T100000-4294967296
--source ../inc/keyring_file_set_audit_options_id.inc

SET SESSION debug = '+d,audit_log_filter_debug_timestamp';
SELECT audit_log_encryption_password_set('pwd2');
SET SESSION debug = '-d,audit_log_filter_debug_timestamp';
SELECT KEY_ID FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%' ORDER BY KEY_ID;

--echo # Re-starting mysql server
--source include/restart_mysqld_no_echo.inc

SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) AS password;

--echo #
--echo # Cleanup
DROP TABLE t1;
--source ../inc/audit_comp_uninstall.inc
--source ../inc/audit_tables_cleanup.inc
--source suite/component_keyring_file/inc/teardown_component.inc
