#
# The log encryption options with the latest ID are the active ones when the
# component starts. An ID holds the local time it was made at and a sequence
# number, the IDs are ordered by the time as it is written in them:
#  - IDs made in the hour that is repeated when the daylight saving time
#    ends, 2098-10-26 02:00:00 - 02:59:59 in Europe/Warsaw
#  - an ID that is later than the one of the active options after the
#    keyring was reloaded
#
--source include/have_component_audit_log.inc
--source include/have_component_keyring_file.inc
--source suite/component_keyring_file/inc/setup_component.inc
--source ../inc/audit_tables_init.inc
--source ../inc/audit_comp_install.inc

--echo #
--echo # Two IDs with the same time in the repeated hour are ordered by their
--echo # sequence numbers, whatever the other IDs are
--source include/shutdown_mysqld.inc
--let AUDIT_OPTIONS_IDS = audit_log-20981026T021500-1 audit_log-20980101T010000-1 audit_log-20981026T021500-2 audit_log-20980801T010000-1
--source ../inc/keyring_file_add_audit_options.inc
--echo # Re-starting mysql server with the options added to the keyring file
--let $restart_parameters = restart: $PLUGIN_DIR_OPT
--source include/start_mysqld_no_echo.inc

SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) AS password;

--echo # A new password follows them
SELECT audit_log_encryption_password_set('pwd1');
SELECT KEY_ID FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-2098%' ORDER BY KEY_ID;
--source include/keyring_tests/helper/start_server_with_manifest.inc

SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) AS password;

--echo #
--echo # A password set after the keyring was reloaded with later options
--echo # follows them and is the active one after a restart
--let AUDIT_OPTIONS_IDS = audit_log-20990601T000000-1
--source ../inc/keyring_file_add_audit_options.inc
ALTER INSTANCE RELOAD KEYRING;
SELECT audit_log_encryption_password_set('pwd2');
SELECT KEY_ID FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-2099%' ORDER BY KEY_ID;
--source include/keyring_tests/helper/start_server_with_manifest.inc

SELECT JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')) AS password;

--echo #
--echo # Cleanup
--source ../inc/audit_comp_uninstall.inc
--source ../inc/audit_tables_cleanup.inc
--source suite/component_keyring_file/inc/teardown_component.inc
