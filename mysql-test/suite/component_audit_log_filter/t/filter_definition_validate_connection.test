        "name": [ "connect", "change_user", "disconnect" ],
        "log": {
          "and": [
            { "field": { "name": "status", "value": 0 } },
            { "field": { "name": "general_command.str", "value": "Query" } }
          ]
        }
      }
  }
] } }');

