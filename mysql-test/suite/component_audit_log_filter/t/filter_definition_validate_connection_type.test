] } }');

--echo #
--echo # Valid: connection_type "::ssl" (alias for 4)
SELECT audit_log_filter_set_filter('filter_con_connType_ssl', '{"filter": { "class": [
  { "name": "connection",
      "event": {
        "name": [ "connect", "change_user", "disconnect" ],
