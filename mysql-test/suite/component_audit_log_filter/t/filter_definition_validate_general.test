        "log": {
          "and": [
            { "field": { "name": "general_error_code", "value": 0 } },
            { "field": { "name": "general_thread_id", "value": "xyz" } }
          ]
        }
      }
  }
] } }');

--echo #
--echo # Cleanup
--source ../inc/audit_comp_uninstall.inc
--source ../inc/audit_tables_cleanup.inc
