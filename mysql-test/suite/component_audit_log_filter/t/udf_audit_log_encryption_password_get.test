--source include/have_component_audit_log.inc
--source ../inc/audit_tables_init.inc
--source ../inc/audit_comp_install.inc
--source include/have_component_keyring_file.inc

--echo #
--echo # Keyring component not initialized
--error 1123
SELECT audit_log_encryption_password_get();

--source suite/component_keyring_file/inc/setup_component.inc

--echo #
--echo # Check wrong argument number
--error 1123
SELECT audit_log_encryption_password_get('arg1', 'arg2');

--echo #
--echo # Check wrong argument type
--error 1123
SELECT audit_log_encryption_password_get(1);
--error 1123
SELECT audit_log_encryption_password_get(0.1);

--echo #
--echo # Check empty argument
--error 1123
SELECT audit_log_encryption_password_get('');

--echo #
--echo # Check too long argument
--let $too_long_keyring_id = `SELECT REPEAT('a', 767)`
--error 1123
--eval SELECT audit_log_encryption_password_get('$too_long_keyring_id')

--echo #
--echo # Get current password
--replace_regex /"password":"\w*"/"password":"pwd"/ /"iterations":\d*/"iterations":1000/ /"salt":"\w*"/"salt":"ffffffffffffffff"/
SELECT audit_log_encryption_password_get();

--echo #
--echo # The generated password has 126 characters from [0-9A-Za-z]
SELECT REGEXP_LIKE(JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(), '$.password')), '^[0-9A-Za-z]{126}$', 'c') AS generated_password_format;

--echo #
--echo # The options are returned for every row of a result
SELECT audit_log_encryption_password_set('pwd1');
SELECT audit_log_encryption_password_set('pwd2');
CREATE TABLE t1 (id INT PRIMARY KEY AUTO_INCREMENT, key_id VARCHAR(64));
INSERT INTO t1 (key_id)
SELECT KEY_ID FROM performance_schema.keyring_keys WHERE KEY_ID LIKE 'audit_log-%' ORDER BY KEY_ID;
INSERT INTO t1 (key_id) SELECT key_id FROM t1 ORDER BY id;
SELECT id, JSON_UNQUOTE(JSON_EXTRACT(audit_log_encryption_password_get(key_id), '$.password')) IN ('pwd1', 'pwd2') AS password_set
FROM t1 ORDER BY id;
SELECT COUNT(*) AS rows_read, COUNT(DISTINCT audit_log_encryption_password_get(key_id)) AS options_read FROM t1;
DROP TABLE t1;

--source suite/component_keyring_file/inc/teardown_component.inc
--source ../inc/audit_comp_uninstall.inc
--source ../inc/audit_tables_cleanup.inc
