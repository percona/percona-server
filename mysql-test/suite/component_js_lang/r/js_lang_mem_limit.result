# Global prepare of playground.
INSTALL COMPONENT 'file://component_js_lang';
GRANT CREATE_JS_ROUTINE ON *.* TO root@localhost;
# Check the default per connection/user memory limit in our
# component. At the moment it is 8M if it is changed, the
# parameters of calls below need to be ajusted.
SELECT @@js_lang.max_mem_size;
@@js_lang.max_mem_size
8388608
#
# 1) Create routine which will hog prescribed amount of memory on the
#    V8 heap in the process of its execution.
#
# JSON.parse(JSON.stringify()) trick is necessary to suppress V8 string
# optimizations which will cause much smaller memory usage if applied.
#
# Note that since we can only do "best effort" memory limit detection
# with V8, spike allocation of memory still might cause V8/process
# aborts, or go unnoticed if memory is quickly released.
#
# So the below tests might have to be adjusted to slow down memory
# allocation (to let detection kick in) or disabled if it starts to
# misbehave on some machine.
CREATE PROCEDURE p_heap_hog(size INT) LANGUAGE JS AS
$$ let s = JSON.parse(JSON.stringify(("A").repeat(size/2 /* Two copies of string! */))) $$;
#
# Check that we detect exceeding the limit and report it.
CALL p_heap_hog(10*1000*1000);
ERROR HY000: Memory limit exceeded.
#
# Hogging amounts of memory below the limit should be fine.
#
# The below also shows that we can run JS code in the
# connection after hitting memory limit earlier.
CALL p_heap_hog(5*1000*1000);
CALL p_heap_hog(5*1000*1000);
CALL p_heap_hog(5*1000*1000);
DROP PROCEDURE p_heap_hog;
#
# 2) Now create routine which will hog prescribed amount of memory on
#    ArrayBuffer allocator.
CREATE PROCEDURE p_array_buff_hog(size INT) LANGUAGE JS AS $$
let a = new ArrayBuffer(size);
$$|
#
# Check that we detect exceeding the limit and report it.
CALL p_array_buff_hog(10*1000*1000);
ERROR HY000: Memory limit exceeded.
#
# Again staying below the limit should be fine.
#
# Unlike in heap case calling this routine with parameter below the
# limit several times in a row still might fail. The exact behavior
# depends on whether GC manages to free previously allocated 
# ArrayBuffer objects in time. Unlike in heap case where limit can be
# temporarily exceeded until GC, ArrayBuffer allocator treats it as a
# hard one.
CALL p_array_buff_hog(5*1000*1000);
DROP PROCEDURE p_array_buff_hog;
#
# 3) Then create routine which will hog prescribed amount of memory using
#    mix of allocations from ArrayBuffer allocator and V8 heap.
CREATE PROCEDURE p_mixed_hog(size INT) LANGUAGE JS AS $$
let arr = [];
for (let i = 0; i < 20; i++) {
arr[i] = new ArrayBuffer(size/40);
arr[20 + i] = JSON.parse(JSON.stringify(("A").repeat(size/40)));
}
$$|
CALL p_mixed_hog(10*1000*1000);
ERROR HY000: Memory limit exceeded.
DROP PROCEDURE p_mixed_hog;
#
# 4) Let us also test situation when we exceed the memory limit by
#    passing too long argument to routine.
#
CREATE FUNCTION f_longtext_hog(s LONGTEXT) RETURNS VARCHAR(100) LANGUAGE JS AS $$ return s.length $$;
CREATE FUNCTION f_longtext_cs_hog(s LONGTEXT CHARACTER SET cp1251) RETURNS VARCHAR(100) LANGUAGE JS AS $$ return s.length $$;
CREATE FUNCTION f_longblob_hog(b LONGBLOB) RETURNS VARCHAR(100) LANGUAGE JS AS $$ return b.byteLength $$;
CREATE FUNCTION f_json_hog(s JSON) RETURNS VARCHAR(100) LANGUAGE JS AS $$ return s.length $$;
SELECT f_longtext_hog(REPEAT('A', 10*1000*1000)) AS hog;
ERROR HY000: Memory limit exceeded.
# Check that hogging memory below the limit is OK and also that
# we can run JS in the connection after hitting the limit.
SELECT f_longtext_hog(REPEAT('A', 5*1000*1000)) AS hog;
hog
5000000
SELECT f_longtext_cs_hog(REPEAT(X'fa', 10*1000*1000)) AS hog;
ERROR HY000: Memory limit exceeded.
# OK if we stay below the limit.
SELECT f_longtext_cs_hog(REPEAT(X'fa', 5*1000*1000)) AS hog;
hog
5000000
SELECT f_longblob_hog(REPEAT(X'ff', 10*1000*1000)) AS hog;
ERROR HY000: Memory limit exceeded.
# OK if we stay below the limit.
SELECT f_longblob_hog(REPEAT(X'ff', 5*1000*1000)) AS hog;
hog
5000000
SELECT f_json_hog(JSON_ARRAY(REPEAT('a', 10*1000*1000)));
ERROR HY000: Memory limit exceeded.
# OK if we stay below the limit.
SELECT f_json_hog(JSON_ARRAY(REPEAT('a', 5*1000*1000)));
f_json_hog(JSON_ARRAY(REPEAT('a', 5*1000*1000)))
1
DROP FUNCTION f_longtext_hog;
DROP FUNCTION f_longtext_cs_hog;
DROP FUNCTION f_longblob_hog;
DROP FUNCTION f_json_hog;
#
# 5) Let us also test status variables which expose information
#    about memory usage by JS component.
#
# Values of most of these status variables are non-deterministic
# due to garbage collection.
SHOW STATUS LIKE 'js_lang%';
Variable_name	Value
Js_lang_contexts	#
Js_lang_external_memory_size	#
Js_lang_total_heap_size	#
Js_lang_used_heap_size	#
# But at least number of contexts is stable.
SHOW STATUS LIKE 'js_lang_contexts';
Variable_name	Value
Js_lang_contexts	1
# Global clean-up.
REVOKE CREATE_JS_ROUTINE ON *.* FROM root@localhost;
# Disconnect of default connection to free the only remaining
# connection context and isolate, so we can uninstall component.
disconnect default;
connect default,localhost,root;
UNINSTALL COMPONENT 'file://component_js_lang';
# Restart server to let subsequent tests to do INSTALL COMPONENT freely.
# restart
