#
# Test coverage for memory limits handling in JS routines.
#
--source include/have_js_lang_component.inc

--echo # Global prepare of playground.
--enable_connect_log

INSTALL COMPONENT 'file://component_js_lang';

GRANT CREATE_JS_ROUTINE ON *.* TO root@localhost;

--echo # Check the default per connection/user memory limit in our
--echo # component. At the moment it is 8M if it is changed, the
--echo # parameters of calls below need to be ajusted.
SELECT @@js_lang.max_mem_size;

--echo #
--echo # 1) Create routine which will hog prescribed amount of memory on the
--echo #    V8 heap in the process of its execution.
--echo #
--echo # JSON.parse(JSON.stringify()) trick is necessary to suppress V8 string
--echo # optimizations which will cause much smaller memory usage if applied.
--echo #
--echo # Note that since we can only do "best effort" memory limit detection
--echo # with V8, spike allocation of memory still might cause V8/process
--echo # aborts, or go unnoticed if memory is quickly released.
--echo #
--echo # So the below tests might have to be adjusted to slow down memory
--echo # allocation (to let detection kick in) or disabled if it starts to
--echo # misbehave on some machine.
CREATE PROCEDURE p_heap_hog(size INT) LANGUAGE JS AS
    $$ let s = JSON.parse(JSON.stringify(("A").repeat(size/2 /* Two copies of string! */))) $$;

--echo #
--echo # Check that we detect exceeding the limit and report it.
--error ER_LANGUAGE_COMPONENT
CALL p_heap_hog(10*1000*1000);

--echo #
--echo # Hogging amounts of memory below the limit should be fine.
--echo #
--echo # The below also shows that we can run JS code in the
--echo # connection after hitting memory limit earlier.
CALL p_heap_hog(5*1000*1000);
CALL p_heap_hog(5*1000*1000);
CALL p_heap_hog(5*1000*1000);

DROP PROCEDURE p_heap_hog;

--echo #
--echo # 2) Now create routine which will hog prescribed amount of memory on
--echo #    ArrayBuffer allocator.
DELIMITER |;
CREATE PROCEDURE p_array_buff_hog(size INT) LANGUAGE JS AS $$
  let a = new ArrayBuffer(size);
$$|
DELIMITER ;|

--echo #
--echo # Check that we detect exceeding the limit and report it.
--error ER_LANGUAGE_COMPONENT
CALL p_array_buff_hog(10*1000*1000);

--echo #
--echo # Again staying below the limit should be fine.
--echo #
--echo # Unlike in heap case calling this routine with parameter below the
--echo # limit several times in a row still might fail. The exact behavior
--echo # depends on whether GC manages to free previously allocated 
--echo # ArrayBuffer objects in time. Unlike in heap case where limit can be
--echo # temporarily exceeded until GC, ArrayBuffer allocator treats it as a
--echo # hard one.
CALL p_array_buff_hog(5*1000*1000);

DROP PROCEDURE p_array_buff_hog;

--echo #
--echo # 3) Then create routine which will hog prescribed amount of memory using
--echo #    mix of allocations from ArrayBuffer allocator and V8 heap.
DELIMITER |;
CREATE PROCEDURE p_mixed_hog(size INT) LANGUAGE JS AS $$
  let arr = [];
  for (let i = 0; i < 20; i++) {
    arr[i] = new ArrayBuffer(size/40);
    arr[20 + i] = JSON.parse(JSON.stringify(("A").repeat(size/40)));
  }
$$|
DELIMITER ;|

--error ER_LANGUAGE_COMPONENT
CALL p_mixed_hog(10*1000*1000);

DROP PROCEDURE p_mixed_hog;

--echo #
--echo # 4) Let us also test situation when we exceed the memory limit by
--echo #    passing too long argument to routine.
--echo #
CREATE FUNCTION f_longtext_hog(s LONGTEXT) RETURNS VARCHAR(100) LANGUAGE JS AS $$ return s.length $$;
CREATE FUNCTION f_longtext_cs_hog(s LONGTEXT CHARACTER SET cp1251) RETURNS VARCHAR(100) LANGUAGE JS AS $$ return s.length $$;
CREATE FUNCTION f_longblob_hog(b LONGBLOB) RETURNS VARCHAR(100) LANGUAGE JS AS $$ return b.byteLength $$;
CREATE FUNCTION f_json_hog(s JSON) RETURNS VARCHAR(100) LANGUAGE JS AS $$ return s.length $$;

--error ER_LANGUAGE_COMPONENT
SELECT f_longtext_hog(REPEAT('A', 10*1000*1000)) AS hog;
--echo # Check that hogging memory below the limit is OK and also that
--echo # we can run JS in the connection after hitting the limit.
SELECT f_longtext_hog(REPEAT('A', 5*1000*1000)) AS hog;

--error ER_LANGUAGE_COMPONENT
SELECT f_longtext_cs_hog(REPEAT(X'fa', 10*1000*1000)) AS hog;
--echo # OK if we stay below the limit.
SELECT f_longtext_cs_hog(REPEAT(X'fa', 5*1000*1000)) AS hog;

--error ER_LANGUAGE_COMPONENT
SELECT f_longblob_hog(REPEAT(X'ff', 10*1000*1000)) AS hog;
--echo # OK if we stay below the limit.
SELECT f_longblob_hog(REPEAT(X'ff', 5*1000*1000)) AS hog;

--error ER_LANGUAGE_COMPONENT
SELECT f_json_hog(JSON_ARRAY(REPEAT('a', 10*1000*1000)));
--echo # OK if we stay below the limit.
SELECT f_json_hog(JSON_ARRAY(REPEAT('a', 5*1000*1000)));

DROP FUNCTION f_longtext_hog;
DROP FUNCTION f_longtext_cs_hog;
DROP FUNCTION f_longblob_hog;
DROP FUNCTION f_json_hog;

--echo #
--echo # 5) Let us also test status variables which expose information
--echo #    about memory usage by JS component.
--echo #
--echo # Values of most of these status variables are non-deterministic
--echo # due to garbage collection.
--replace_column 2 #
SHOW STATUS LIKE 'js_lang%';
--echo # But at least number of contexts is stable.
SHOW STATUS LIKE 'js_lang_contexts';

--echo # Global clean-up.
REVOKE CREATE_JS_ROUTINE ON *.* FROM root@localhost;

--echo # Disconnect of default connection to free the only remaining
--echo # connection context and isolate, so we can uninstall component.
--disconnect default
--source include/wait_until_disconnected.inc
--connect(default,localhost,root)

UNINSTALL COMPONENT 'file://component_js_lang';

--echo # Restart server to let subsequent tests to do INSTALL COMPONENT freely.
--source include/restart_mysqld.inc

--disable_connect_log
