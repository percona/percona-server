--source include/have_component_keyring_kmip.inc
# Keyring UDF tests with component_keyring_kmip
#
--let $skip_secret_tests = 1

--source ../inc/setup_component.inc
--disable_query_log
CALL mtr.add_suppression("std exception in function .size.: Message too long. Length: [0-9]+: I/O Failure");
# The text after "bits" names kmipclient's error code, which differs between
# kmipclient versions, so it is left out.
CALL mtr.add_suppression("std exception in function .store.: Invalid AES key length: 512 bits. Should be 128, 192 or 256 bits");
CALL mtr.add_suppression("std exception in function .store.: Invalid AES key length: 320 bits. Should be 128, 192 or 256 bits");
CALL mtr.add_suppression("std exception in function .store.: Invalid AES key length: 232 bits. Should be 128, 192 or 256 bits");
--enable_query_log
--source ../inc/keyring_udf_test_kmip.inc
--source ../inc/teardown_component.inc
