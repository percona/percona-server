# ----------------------------------------------------------------------
# Setup
# Creating global configuration file for keyring component: component_keyring_kms
# Creating local configuration file for keyring component: component_keyring_kms
# Creating manifest file for current MySQL server instance
# Re-starting mysql server with manifest file
# ----------------------------------------------------------------------
CALL mtr.add_suppression("component_keyring_kms reported: .Configuration error: ");
CALL mtr.add_suppression("The component is not initialized properly. Error: Failed to initialize or reinitialize keyring");
CALL mtr.add_suppression("component_keyring_kms reported: .'endpoint' value .* uses plain HTTP");
#
# Without the new options there is no Endpoint status row
# Creating local configuration file for keyring component: component_keyring_kms
ALTER INSTANCE RELOAD KEYRING;
SELECT STATUS_KEY, STATUS_VALUE FROM performance_schema.keyring_component_status
WHERE STATUS_KEY IN ('Component_status', 'Endpoint');
STATUS_KEY	STATUS_VALUE
Component_status	Active
#
# An empty endpoint means the default AWS endpoint
# Creating local configuration file for keyring component: component_keyring_kms
