# ----------------------------------------------------------------------
# Setup
# Creating local configuration file for keyring component: component_keyring_vault
# Creating manifest file for current MySQL server instance
# Re-starting mysql server with manifest file
# ----------------------------------------------------------------------
CALL mtr.add_suppression("The component is not initialized properly. Error: Failed to initialize or reinitialize keyring");
# Status reports the configured namespace
include/assert.inc [vault_namespace status value matches the configuration]
# Keys can be generated and stored in the namespace
CREATE TABLE t1 (a INT PRIMARY KEY) ENCRYPTION = 'Y';
INSERT INTO t1 VALUES (1), (2);
SELECT * FROM t1;
a
1
2
# Leading and trailing whitespace is trimmed from vault_namespace
# Creating local configuration file for keyring component: component_keyring_vault
ALTER INSTANCE RELOAD KEYRING;
ALTER INSTANCE ROTATE INNODB MASTER KEY;
SELECT * FROM t1;
a
1
2
include/assert.inc [vault_namespace status value is trimmed]
# Non-string vault_namespace is rejected and the keyring is preserved
# Creating local configuration file for keyring component: component_keyring_vault
ALTER INSTANCE RELOAD KEYRING;
ERROR HY000: Keyring reload failed. Please check error log for more details.
SELECT STATUS_KEY, STATUS_VALUE FROM performance_schema.keyring_component_status
WHERE STATUS_KEY = 'Component_status';
STATUS_KEY	STATUS_VALUE
Component_status	Active
include/assert.inc [vault_namespace status value is unchanged after failed reload]
ALTER INSTANCE ROTATE INNODB MASTER KEY;
SELECT * FROM t1;
a
1
2
DROP TABLE t1;
# ----------------------------------------------------------------------
# Teardown
# Removing manifest file for current MySQL server instance
# Removing local configuration file for keyring component: component_keyring_vault
# Restarting server without the manifest file
# ----------------------------------------------------------------------
