[connection server1]

############################################################
# 2. Read the status variables on both members.
[connection server1]
SHOW GLOBAL STATUS LIKE 'group_replication_flow_control%';
Variable_name	Value
group_replication_flow_control_active	DISABLED
group_replication_flow_control_threshold_nodes	(0/2)
group_replication_flow_control_throttle_quota	0
SHOW SESSION STATUS LIKE 'group_replication_flow_control%';
Variable_name	Value
group_replication_flow_control_active	DISABLED
group_replication_flow_control_threshold_nodes	(0/2)
group_replication_flow_control_throttle_quota	0
SELECT VARIABLE_NAME, VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME LIKE 'group_replication_flow_control%' ORDER BY VARIABLE_NAME;
VARIABLE_NAME	VARIABLE_VALUE
group_replication_flow_control_active	DISABLED
group_replication_flow_control_threshold_nodes	(0/2)
group_replication_flow_control_throttle_quota	0
[connection server2]
SHOW GLOBAL STATUS LIKE 'group_replication_flow_control%';
Variable_name	Value
group_replication_flow_control_active	DISABLED
group_replication_flow_control_threshold_nodes	(0/2)
