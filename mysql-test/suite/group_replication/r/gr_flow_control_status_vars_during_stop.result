include/group_replication.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection server1]

############################################################
# 1. Bootstrap a group on server1 and wait until the flow
#    control stats are known.
[connection server1]
include/start_and_bootstrap_group_replication.inc
SHOW GLOBAL STATUS LIKE 'group_replication_flow_control%';
Variable_name	Value
group_replication_flow_control_active	DISABLED
group_replication_flow_control_threshold_nodes	(0/1)
group_replication_flow_control_throttle_quota	0

############################################################
# 2. Asynchronously execute STOP GROUP_REPLICATION and hold it
#    after it acquired the plugin_running_lock.
SET @@GLOBAL.DEBUG='+d,gr_plugin_gr_stop_after_holding_plugin_running_lock';
[connection server_1]
STOP GROUP_REPLICATION;
[connection server1]
SET DEBUG_SYNC= "now WAIT_FOR signal.reached_plugin_gr_stop_after_holding_plugin_running_lock";
SET @@GLOBAL.DEBUG='-d,gr_plugin_gr_stop_after_holding_plugin_running_lock';

############################################################
# 3. Read the status variables while STOP GROUP_REPLICATION is
#    ongoing. They must return immediately with empty values.
SHOW GLOBAL STATUS LIKE 'group_replication_flow_control%';
Variable_name	Value
group_replication_flow_control_active	
group_replication_flow_control_threshold_nodes	
group_replication_flow_control_throttle_quota	0
SHOW SESSION STATUS LIKE 'group_replication_flow_control%';
Variable_name	Value
group_replication_flow_control_active	
group_replication_flow_control_threshold_nodes	
group_replication_flow_control_throttle_quota	0
SELECT VARIABLE_NAME, VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME LIKE 'group_replication_flow_control%' ORDER BY VARIABLE_NAME;
VARIABLE_NAME	VARIABLE_VALUE
group_replication_flow_control_active	
group_replication_flow_control_threshold_nodes	
group_replication_flow_control_throttle_quota	0

############################################################
# 4. Resume STOP GROUP_REPLICATION.
SET DEBUG_SYNC= "now SIGNAL signal.resume_plugin_gr_stop_after_holding_plugin_running_lock";
[connection server_1]
[connection server1]
include/gr_wait_for_member_state.inc
SHOW GLOBAL STATUS LIKE 'group_replication_flow_control%';
Variable_name	Value
group_replication_flow_control_active	
group_replication_flow_control_threshold_nodes	
group_replication_flow_control_throttle_quota	0

############################################################
# 5. Clean up.
SET DEBUG_SYNC= 'RESET';
SET @@GLOBAL.read_only= 0;
include/group_replication_end.inc
