################################################################################
# Verify the group_replication_flow_control_% status variables while Group
# Replication is running.
#
# The string variables (active, threshold_nodes) were exposed as SHOW_CHAR_PTR
# pointing to a std::string. Depending on the std::string implementation that
# made SHOW STATUS read the internal buffer of std::string as a pointer, an
# invalid memory access (seen with libc++ once 'active' was set to 'DISABLED').
#
# 1. Start a group with two members.
# 2. Wait until the flow control stats of both members are known and read the
#    status variables on both members with SHOW STATUS and from
#    performance_schema.global_status.
# 3. Clean up.
################################################################################
--source include/have_group_replication_plugin.inc
--source include/group_replication.inc

--echo
--echo ############################################################
--echo # 2. Read the status variables on both members.
--let $member= 1
while ($member <= 2)
{
  --let $rpl_connection_name= server$member
  --source include/connection.inc

  --let $wait_condition= SELECT VARIABLE_VALUE = '(0/2)' FROM performance_schema.global_status WHERE VARIABLE_NAME = 'group_replication_flow_control_threshold_nodes'
  --source include/wait_condition.inc

  SHOW GLOBAL STATUS LIKE 'group_replication_flow_control%';
  SHOW SESSION STATUS LIKE 'group_replication_flow_control%';
  SELECT VARIABLE_NAME, VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME LIKE 'group_replication_flow_control%' ORDER BY VARIABLE_NAME;

  --inc $member
}

--echo
--echo ############################################################
--echo # 3. Clean up.
--source include/group_replication_end.inc
