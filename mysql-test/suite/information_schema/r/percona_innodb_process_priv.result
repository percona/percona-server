CREATE DATABASE isp_db;
USE isp_db;
CREATE TABLE parent_t (id INT PRIMARY KEY, payload VARCHAR(32)) ENGINE=InnoDB;
CREATE TABLE child_t (
id INT PRIMARY KEY,
parent_id INT,
KEY ix_child_parent (parent_id),
CONSTRAINT fk_child_parent FOREIGN KEY (parent_id) REFERENCES parent_t (id)
) ENGINE=InnoDB;
CREATE TABLE virt_t (
id INT PRIMARY KEY,
a INT,
b INT,
s INT AS (a + b) VIRTUAL,
KEY ix_s (s)
) ENGINE=InnoDB;
CREATE TABLE gated_tables (id INT PRIMARY KEY, name VARCHAR(64));
INSERT INTO gated_tables VALUES
(1, 'INNODB_TABLES'),
(2, 'INNODB_TABLESTATS'),
(3, 'INNODB_INDEXES'),
(4, 'INNODB_COLUMNS'),
(5, 'INNODB_VIRTUAL'),
(6, 'INNODB_FIELDS'),
(7, 'INNODB_FOREIGN'),
(8, 'INNODB_FOREIGN_COLS'),
(9, 'INNODB_TABLESPACES'),
(10, 'INNODB_DATAFILES'),
(11, 'INNODB_TABLESPACES_BRIEF'),
(12, 'FILES');
CREATE USER 'isp_user'@'localhost';
GRANT SELECT ON isp_db.* TO 'isp_user'@'localhost';
