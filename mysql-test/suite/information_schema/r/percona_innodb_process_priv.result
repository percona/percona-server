# Join of InnoDB tables.
SELECT COUNT(*) > 0 AS has_rows FROM INFORMATION_SCHEMA.INNODB_FIELDS f JOIN INFORMATION_SCHEMA.INNODB_INDEXES i ON i.INDEX_ID = f.INDEX_ID JOIN INFORMATION_SCHEMA.INNODB_TABLES t ON t.TABLE_ID = i.TABLE_ID WHERE t.NAME LIKE 'isp_db/%';
ERROR 42000: Access denied; you need (at least one of) the PROCESS privilege(s) for this operation
# Join of a server table with an InnoDB table.
SELECT COUNT(*) > 0 AS has_rows FROM INFORMATION_SCHEMA.TABLES s JOIN INFORMATION_SCHEMA.INNODB_TABLES t ON t.NAME = CONCAT(s.TABLE_SCHEMA, '/', s.TABLE_NAME) WHERE s.TABLE_SCHEMA = 'isp_db';
ERROR 42000: Access denied; you need (at least one of) the PROCESS privilege(s) for this operation
