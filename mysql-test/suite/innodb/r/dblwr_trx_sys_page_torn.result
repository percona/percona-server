#
# The TRX_SYS page (page 5 of the system tablespace) is read at startup
# to find the legacy doublewrite area, before crash recovery restores
# torn pages from the doublewrite files.  A torn TRX_SYS page must be
# restored from its doublewrite copy like any other page, not abort the
# startup.
#
CREATE TABLE t1 (f1 INT PRIMARY KEY, f2 BLOB) ENGINE=InnoDB
STATS_PERSISTENT=0;
INSERT INTO t1 VALUES (1, repeat('#', 12)), (2, repeat('+', 12)),
(3, repeat('/', 12)), (4, repeat('-', 12));
# Make the page cleaner write every dirty page, including the TRX_SYS
# page, through the doublewrite buffer; then forbid it to write
# anything else, so that no later batch reuses the doublewrite slots,
# and kill the server.
SET GLOBAL innodb_adaptive_flushing = OFF;
SET GLOBAL innodb_idle_flush_pct = 0;
SET GLOBAL innodb_max_dirty_pages_pct_lwm = 0;
SET GLOBAL innodb_max_dirty_pages_pct = 0;
SET GLOBAL innodb_max_dirty_pages_pct = 99;
# Kill the server
# Tear the TRX_SYS page: its second half is garbage.  The doublewrite
# buffer must hold the version of the page that was on disk; a batch
# written after the one that carried the page may have reused its
# slot, in which case that version is put back into a slot here.
# restart
Pattern "Recovered page \[page id: space=0, page number=5\] from the doublewrite buffer" found
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
SELECT f1, f2 FROM t1;
f1	f2
1	############
2	++++++++++++
3	////////////
4	------------
DROP TABLE t1;
