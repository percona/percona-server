#
# Bug#38169053 MySQL 8.0.39/40 crashed due to Assertion failure error
#              when running TRUNCATE
# (public bug report: Bug#120156 TRUNCATE TABLE crashes when the
#  database directory is a symlink)
#
# A schema directory replaced with a symlink to a directory outside of
# the datadir must still be treated as the default location of its
# file-per-table tablespaces. The data dictionary must keep the
# implicit path and TRUNCATE TABLE must succeed.
#
CREATE DATABASE bug120156db;
CREATE TABLE bug120156db.t1 (id INT PRIMARY KEY, val VARCHAR(100)) ENGINE=InnoDB;
INSERT INTO bug120156db.t1 VALUES (1,'hello'),(2,'world');
# restart
# The tablespace must still be registered at its default location
# and the table must not be marked as having a DATA DIRECTORY.
SELECT PATH FROM INFORMATION_SCHEMA.INNODB_DATAFILES WHERE PATH LIKE '%bug120156db%';
PATH
./bug120156db/t1.ibd
SELECT NAME, FLAG & 64 AS data_dir_flag FROM INFORMATION_SCHEMA.INNODB_TABLES WHERE NAME LIKE 'bug120156db/%';
NAME	data_dir_flag
bug120156db/t1	0
SHOW CREATE TABLE bug120156db.t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `val` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# TRUNCATE must succeed.
TRUNCATE TABLE bug120156db.t1;
INSERT INTO bug120156db.t1 VALUES (1,'after'),(2,'truncate');
SELECT * FROM bug120156db.t1 ORDER BY id;
id	val
1	after
2	truncate
SELECT PATH FROM INFORMATION_SCHEMA.INNODB_DATAFILES WHERE PATH LIKE '%bug120156db%';
PATH
./bug120156db/t1.ibd
SELECT NAME, FLAG & 64 AS data_dir_flag FROM INFORMATION_SCHEMA.INNODB_TABLES WHERE NAME LIKE 'bug120156db/%';
NAME	data_dir_flag
bug120156db/t1	0
# The table must be usable after another restart.
# restart
SELECT PATH FROM INFORMATION_SCHEMA.INNODB_DATAFILES WHERE PATH LIKE '%bug120156db%';
PATH
./bug120156db/t1.ibd
SELECT NAME, FLAG & 64 AS data_dir_flag FROM INFORMATION_SCHEMA.INNODB_TABLES WHERE NAME LIKE 'bug120156db/%';
NAME	data_dir_flag
bug120156db/t1	0
TRUNCATE TABLE bug120156db.t1;
INSERT INTO bug120156db.t1 VALUES (3,'after restart');
SELECT * FROM bug120156db.t1 ORDER BY id;
id	val
3	after restart
DROP DATABASE bug120156db;
