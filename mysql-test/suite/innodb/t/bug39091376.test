# Bug#39091376 Failed DDL may not cleanup all builders
#
# During a table rebuild (e.g. moving to a new tablespace), the
# clustered index is rebuilt directly via Btree_load (Builder::m_id==0,
# is_skip_file_sort() true: the scan is already in PK order, so rows are
# inserted straight into the new B-tree; the leaf page being filled, and
# any parent page created for it, stay buffer-fixed while Btree_load is
# alive -- see Btree_load::insert()/prepare_space()). A non-spatial
# secondary index builder instead buffers rows into a sort key-buffer,
# spilling to a temporary file once that buffer overflows. A spatial
# index builder caches rows in add_row() and flushes them from
# batch_inserter at end-of-page.
#
# Non-spatial builders are driven from the per-row loop in
# Parallel_cursor::scan()'s bulk_inserter (ddl/ddl0par-scan.cc);
# spatial builders also use that loop only to cache, then
# batch_inserter to insert. If a LATER builder fails (add_row() or
# batch_insert()) while the EARLIER clustered builder's Btree_load is
# still live (i.e. the whole PK scan has not reached EOF yet), the loop
# must unwind that clustered builder too, or its Btree_load -- and the
# buffer-fixed pages under it -- leak: Builder::~Builder() only does a
# bare "delete m_btr_load" with no Btree_load::finish() call, so the
# Page_load objects (and the pages they hold buffer-fixed) are never
# released.
#
# Case 1 forces the secondary index's temp file creation to fail
# (via the existing ddl_tmpfile_fail debug sync point, already used by
# Loader::scan_and_build_indexes()). Case 2 uses a spatial index:
# ddl_batch_inserter_fail arms ddl_ins_spatial_fail from insert_direct()
# after Btree_load::release(). In both cases the error is injected
# partway through a table rebuild, once the (small, low
# innodb_sort_buffer_size) buffer has overflowed at least once --
# guaranteed here by using enough rows that the buffer overflows
# repeatedly long before the scan reaches its last row, so the
# clustered builder's Btree_load is certain to still be alive when the
# later builder fails.
#
# No SQL-visible counter (e.g. INFORMATION_SCHEMA.INNODB_BUFFER_PAGE.
# FIX_COUNT) reliably reflects this leak: Page_load buffer-fixes pages
# outside the normal mtr memo (see Page_load::m_n_blocks_buf_fixed), so
# FIX_COUNT reads back as 0 even while the page is genuinely still held.
# The leak is only ever caught later, when something walks the buffer
# pool expecting every page to be replaceable -- on a debug build, that
# happens at clean shutdown (buf_assert_all_are_replaceable(), called
# from srv_shutdown_log()), which trips ut_ad and aborts the server.
# include/restart_mysqld.inc runs that shutdown inside the test.

--source include/have_debug.inc

CREATE TABLESPACE ts1 ADD DATAFILE 'ts1.ibd' ENGINE=InnoDB;

--echo # Case 1: bulk_inserter, secondary KEY, ddl_tmpfile_fail.
CREATE TABLE t1 (
  pk INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  c1 VARCHAR(200) NOT NULL,
  KEY idx_c1 (c1)
) ENGINE=InnoDB;

--echo # Insert enough rows that idx_c1's sort buffer (see
--echo # bug39091376-master.opt) overflows -- and so spills to a
--echo # temporary file -- many times over, long before the scan
--echo # reaches EOF, while the clustered index's Btree_load is alive.
--disable_query_log
INSERT INTO t1 (c1) VALUES (REPEAT('a', 200));
let $i = 14;
while ($i)
{
  INSERT INTO t1 (c1) SELECT c1 FROM t1;
  dec $i;
}
--enable_query_log

SELECT COUNT(*) FROM t1;

--echo # Rebuild the table into the new tablespace. The clustered
--echo # builder (processed first, per row) keeps filling its B-tree
--echo # directly; once idx_c1's sort buffer overflows, force its temp
--echo # file creation to fail. Force a single-threaded scan so the
--echo # injected error fires on the same THD that armed it
--echo # (Sync_point lookups are keyed by current_thd, which a parallel
--echo # reader worker thread does not share with the connection).
SET SESSION innodb_parallel_read_threads = 1;
SET SESSION debug = '+d,ddl_tmpfile_fail';

--error ER_OUT_OF_RESOURCES
ALTER TABLE t1 TABLESPACE ts1;

SET SESSION debug = '-d,ddl_tmpfile_fail';
SET SESSION innodb_parallel_read_threads = DEFAULT;

--echo # The table must remain fully usable after the failed DDL.
CHECK TABLE t1;

DROP TABLE t1;

--echo # Case 2: batch_inserter, SPATIAL INDEX, ddl_ins_spatial_fail
--echo # armed after clustered Btree_load::release().
CREATE TABLE t1 (
  pk INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  c1 VARCHAR(200) NOT NULL,
  g GEOMETRY NOT NULL SRID 0,
  SPATIAL INDEX(g)
) ENGINE=InnoDB;

--echo # Insert enough rows that the clustered sort buffer (see
--echo # bug39091376-master.opt) overflows -- and so
--echo # Btree_load::release() runs -- many times over, long before
--echo # the scan reaches EOF, while the clustered index's Btree_load
--echo # is alive.
--disable_query_log
INSERT INTO t1 (c1, g) VALUES (REPEAT('a', 200), ST_SRID(POINT(1, 1), 0));
let $i = 14;
while ($i)
{
  INSERT INTO t1 (c1, g) SELECT c1, g FROM t1;
  dec $i;
}
--enable_query_log

SELECT COUNT(*) FROM t1;

--echo # Rebuild the table into the new tablespace. After clustered
--echo # Btree_load::release(), arm ddl_ins_spatial_fail so the R-tree
--echo # insert path returns DB_FAIL. Force a single-threaded scan so
--echo # the injected error fires on the same THD that armed it
--echo # (Sync_point lookups are keyed by current_thd, which a parallel
--echo # reader worker thread does not share with the connection).
SET SESSION innodb_parallel_read_threads = 1;
SET SESSION debug = '+d,ddl_batch_inserter_fail';

--error ER_GET_ERRNO
ALTER TABLE t1 TABLESPACE ts1;

SET SESSION debug = '-d,ddl_batch_inserter_fail';
SET SESSION innodb_parallel_read_threads = DEFAULT;

--echo # The table must remain fully usable after the failed DDL.
CHECK TABLE t1;

DROP TABLE t1;
DROP TABLESPACE ts1;

--echo # Restart to verify the failed DDL left no latched or
--echo # buffer-fixed pages. On a debug build, clean shutdown calls
--echo # buf_assert_all_are_replaceable() -- see include/have_debug.inc
--echo # and the comment at the top of this file.
--source include/restart_mysqld.inc
