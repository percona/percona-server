--source include/not_valgrind.inc

--echo #
--echo # When the first page of a tablespace is torn, recovery surveys the first
--echo # 64 pages of the file for every page size from 1K up to decide which
--echo # space id to look up in the doublewrite buffer.  Any 1K-aligned piece of
--echo # the file whose bytes at the FIL_PAGE_TYPE offset read as an encrypted
--echo # page type is accepted without a checksum check, and the space id stored
--echo # in it wins.  Recovery must instead use the space id it already knows
--echo # from the redo log and the directory scan, and restore the page.
--echo #

--disable_query_log
call mtr.add_suppression("Checksum mismatch in datafile");
--enable_query_log

let MYSQLD_DATADIR=`select @@datadir`;

CREATE TABLE t1 (f1 INT PRIMARY KEY, f2 BLOB) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, repeat('#', 12)), (2, repeat('+', 12)),
                      (3, repeat('/', 12)), (4, repeat('-', 12));

--echo # Write all dirty pages of t1 through the doublewrite buffer, then kill
--echo # the server before anything else can reuse the doublewrite slots.  A
--echo # committed change of a data page, which the page cleaner is not
--echo # allowed to write, keeps redo for the tablespace ahead of the
--echo # checkpoint, so that recovery is the one to open the file.
SET GLOBAL innodb_adaptive_flushing = OFF;
SET GLOBAL innodb_idle_flush_pct = 0;
SET GLOBAL innodb_max_dirty_pages_pct_lwm = 0;
SET GLOBAL innodb_max_dirty_pages_pct = 99;
FLUSH TABLES t1 FOR EXPORT;
UNLOCK TABLES;
UPDATE t1 SET f2 = repeat('*', 12) WHERE f1 = 1;

--source include/kill_mysqld.inc

--echo # Tear page 0: overwrite 64 bytes at offset 5K.  Seen as the 1K page
--echo # number 5, the garbage has FIL_PAGE_TYPE = FIL_PAGE_ENCRYPTED and
--echo # FIL_PAGE_SPACE_ID = 65535.
perl;
use IO::Handle;
my $fname = "$ENV{'MYSQLD_DATADIR'}/test/t1.ibd";
open(FILE, "+<", $fname) or die "cannot open $fname: $!";
binmode FILE;
seek(FILE, 5 * 1024, SEEK_SET);
print FILE chr(0xff) x 24;                 # 0..23
print FILE chr(0x00) . chr(0x0f);          # 24..25: FIL_PAGE_ENCRYPTED
print FILE chr(0xff) x 8;                  # 26..33
print FILE chr(0x00) x 2 . chr(0xff) x 2;  # 34..37: space id 65535
print FILE chr(0xff) x 26;                 # 38..63
close FILE;
EOF

--source include/start_mysqld.inc

let SEARCH_FILE= $MYSQLTEST_VARDIR/log/mysqld.1.err;
let SEARCH_PATTERN= Restoring page \\[page id: space=\\d+, page number=0\\] of datafile .*t1.ibd. from the doublewrite buffer;
--source include/search_pattern.inc

CHECK TABLE t1;
SELECT f1, f2 FROM t1;

DROP TABLE t1;
