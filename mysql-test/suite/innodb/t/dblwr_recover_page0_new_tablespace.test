--source include/have_debug.inc
--source include/not_valgrind.inc

if (`SELECT @@global.innodb_doublewrite NOT IN ('ON', 'DETECT_AND_RECOVER')`) {
  --skip Test requires innodb_doublewrite=ON
}

--echo #
--echo # PS-11988: Crash recovery fails on a torn first page of a new
--echo # tablespace even though the page is in the doublewrite buffer
--echo #
--echo # Recovery must restore the first page of a tablespace from the
--echo # doublewrite buffer even if no other page of the tablespace has a
--echo # valid checksum on disk, so the space ID cannot be determined by
--echo # scanning the data file.
--echo #

--disable_query_log
call mtr.add_suppression("Checksum mismatch in datafile");
call mtr.add_suppression("Cannot determine the space ID from the first 64 pages");
call mtr.add_suppression("Database page \\[page id: space=[0-9]+, page number=[0-9]+\\] contained only zeroes");
--enable_query_log

let MYSQLD_DATADIR = `SELECT @@datadir`;
let INNODB_PAGE_SIZE = `SELECT @@innodb_page_size`;

--echo # Keep the checkpoint before the table is created, so that all pages
--echo # of the table can be rebuilt from the redo log.
SET GLOBAL innodb_checkpoint_disabled = 1;

CREATE TABLE t1 (f1 INT PRIMARY KEY, f2 VARCHAR(100)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, REPEAT('a', 50)), (2, REPEAT('b', 50)),
                      (3, REPEAT('c', 50));

SELECT space FROM INFORMATION_SCHEMA.INNODB_TABLESPACES
WHERE name = 'test/t1' INTO @space_id;
let SPACE_ID = `SELECT @space_id`;

--echo # Make the first page of t1 dirty, flush all dirty pages through the
--echo # doublewrite buffer and kill the server.
SET GLOBAL innodb_saved_page_number_debug = 0;
--source include/expect_crash.inc
--error CR_SERVER_LOST
SET GLOBAL innodb_fil_make_page_dirty_debug = @space_id;

--echo # Simulate a torn write of the first page of t1: zero its second half.
--let IBD_FILE = $MYSQLD_DATADIR/test/t1.ibd
--let PAGE_NUM = "0"
--let ALL_ZEROES = 0
--source ../include/corrupt_page.inc

--echo # Simulate that no other page of t1 has been flushed yet: zero all
--echo # pages after the first one.
perl;
use IO::Handle;
my $file      = $ENV{'IBD_FILE'}         or die "IBD_FILE is required";
my $page_size = $ENV{'INNODB_PAGE_SIZE'} or die "INNODB_PAGE_SIZE is required";
my $file_size = -s $file;
open(FILE, "+<", $file) or die "Could not open $file: $!";
FILE->autoflush(1);
binmode FILE;
seek(FILE, $page_size, SEEK_SET);
print FILE chr(0) x ($file_size - $page_size);
close FILE;
EOF

--source include/start_mysqld.inc

--let $assert_file = $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_text = Recovery used the space ID from the redo log for t1.ibd
--let $assert_select = Using space ID $SPACE_ID found in the redo log and in the header of the first page to restore the first page from the doublewrite buffer
--let $assert_count = 1
--source include/assert_grep.inc

--let $assert_text = The first page of t1.ibd was restored from the doublewrite buffer
--let $assert_select = Restoring page \[page id: space=$SPACE_ID, page number=0\] of datafile
--let $assert_count = 1
--source include/assert_grep.inc

CHECK TABLE t1;
SELECT f1, LENGTH(f2), LEFT(f2, 3) FROM t1;

DROP TABLE t1;
