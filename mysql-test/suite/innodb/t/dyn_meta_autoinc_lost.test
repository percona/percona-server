--source include/have_debug.inc
--source include/not_valgrind.inc
--echo #
--echo # A checkpointed AUTO_INCREMENT survives a crash when only a
--echo # corrupted-index redo record follows the checkpoint.
--echo #

--disable_query_log
call mtr.add_suppression("Flagged corruption of.* in table .* in CHECK TABLE");
call mtr.add_suppression("Index .* is marked as corrupted");
--enable_query_log

CREATE TABLE t1 (id INT AUTO_INCREMENT PRIMARY KEY, k INT, KEY kk (k));
INSERT INTO t1 (k) VALUES (1), (2);
--echo # Bumps the table version; the definition stores AUTO_INCREMENT 3.
ALTER TABLE t1 ADD INDEX k2 (k, id);
INSERT INTO t1 (k) VALUES (3), (4), (5), (6);

--echo # The checkpoint writes {autoinc 6} to the buffer row.
SET GLOBAL innodb_log_checkpoint_now = ON;
SET GLOBAL innodb_checkpoint_disabled = ON;

--echo # After it only a corrupted-index record.
SET SESSION debug = "+d,dict_set_index_corrupted";
CHECK TABLE t1;
SET SESSION debug = "-d,dict_set_index_corrupted";

--source include/kill_and_restart_mysqld.inc

--echo # Expected: id 7.
INSERT INTO t1 (k) VALUES (7);
SELECT LAST_INSERT_ID();

DROP TABLE t1;