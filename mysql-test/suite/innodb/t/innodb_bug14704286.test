# Adding big test option for this test.
--source include/big_test.inc

#
# create test-bed to run test
#
use test;
--disable_warnings
drop table if exists t1;
--enable_warnings
create table t1 (id int primary key, value int, value2 int,
value3 int, index(value,value2)) engine=innodb;

insert into t1 values
(10,10,10,10),(11,11,11,11),(12,12,12,12),(13,13,13,13),(14,14,14,14),
(15,15,15,15),(16,16,16,16),(17,17,17,17),(18,18,18,18),(19,19,19,19),
(20,20,20,20);
let $ID= `SELECT @id := CONNECTION_ID()`;

#
# we need multiple connections as we need to keep one connection
# active with trx requesting consistent read.
#
connect (conn1, localhost, root,,);
connect (conn2, localhost, root,,);
connect (conn3, localhost, root,,);

#
# start trx with consistent read
#
connection conn1;
use test;

start transaction with consistent snapshot;

#
# update table such that secondary index is updated.
#
connection conn2;
use test;
delimiter |;
CREATE PROCEDURE update_t1()
BEGIN
	DECLARE i INT DEFAULT 1;
	while (i <= 28000) DO
		update test.t1 set value2=value2+1, value3=value3+1 where id=12;
		SET i = i + 1;
	END WHILE;
END|

delimiter ;|
set autocommit=0;
CALL update_t1();
select * from t1;
set autocommit=1;
select * from t1;

#
# Now try to fire select query from connection-1 enforcing
# use of secondary index.
#
connection conn1;
let $ID= `SELECT @id := CONNECTION_ID()`;
#--error ER_QUERY_INTERRUPTED
--send
select * from t1 force index(value) where value=12;

#
# select is going to take good time so let's kill query.
#
# On a fast machine (e.g. a release build) the select can finish before
# it is seen in the processlist (see also Bug#28464642). Wait until it
# is either executing or finished. Only an executing select can be
# killed, so the result is checked only in that case.
#
connection conn3;
let $select_query= select * from t1 force index(value) where value=12;
let $select_running= 0;
let $select_finished= 0;
let $wait_counter= 300;
--disable_query_log
while ($wait_counter)
{
  let $select_running= `select count(*) from information_schema.processlist where id = $ID and state = 'executing' and info = '$select_query'`;
  let $select_finished= `select count(*) from performance_schema.events_statements_current s join performance_schema.threads t using (thread_id) where t.processlist_id = $ID and s.sql_text = '$select_query' and s.end_event_id is not null`;
  if ($select_running)
  {
    let $wait_counter= 0;
  }
  if ($select_finished)
  {
    let $wait_counter= 0;
  }
  if ($wait_counter)
  {
    sleep 0.1;
    dec $wait_counter;
  }
}
if (!$select_running)
{
  if (!$select_finished)
  {
    query_vertical select * from information_schema.processlist where id = $ID;
    die The select is neither executing nor finished after 30 seconds;
  }
}
--enable_query_log
let $ignore= `SELECT @id := $ID`;
kill query @id;

#
# reap the value of connection-1
#
connection conn1;
--disable_result_log
--error 0,ER_QUERY_INTERRUPTED
reap;
--enable_result_log
if ($select_running)
{
  if ($mysql_errno != 1317)
  {
    die The select was executing, but it was not interrupted by KILL QUERY (error $mysql_errno);
  }
}

#
# clean test-bed.
#
connection default;
disconnect conn1;
disconnect conn2;
disconnect conn3;
drop procedure if exists update_t1;
drop table if exists t1;


