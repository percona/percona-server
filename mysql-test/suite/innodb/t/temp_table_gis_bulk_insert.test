--source include/have_innodb.inc
--source include/have_geometry.inc

--disable_warnings
DROP TEMPORARY TABLE IF EXISTS t1;
--enable_warnings

#
# Create a TEMPORARY table with a SPATIAL index
#
CREATE TEMPORARY TABLE t1 (
  id INT NOT NULL,
  g GEOMETRY NOT NULL,
  SPATIAL INDEX(g)
) ENGINE=InnoDB;

#
# Bulk insert many rows to force:
#  - optimistic descent
#  - fallback to pessimistic descent
#  - MBR enlargement
#
# This used to crash due to wrong mtr->log_mode
#
INSERT INTO t1
SELECT
  seq,
  ST_GeomFromText(
    CONCAT(
      'POLYGON((',
      seq, ' ', seq, ', ',
      seq + 1, ' ', seq, ', ',
      seq + 1, ' ', seq + 1, ', ',
      seq, ' ', seq + 1, ', ',
      seq, ' ', seq,
      '))'
    )
  )
FROM (
  SELECT @rownum := @rownum + 1 AS seq
  FROM
    information_schema.COLUMNS,
    (SELECT @rownum := 0) r
  LIMIT 500
) AS src;

#
# Verify rows were inserted successfully
#
SELECT COUNT(*) FROM t1;

#
# Cleanup
#
DROP TEMPORARY TABLE t1;

