#
# PS-11299: ADD FULLTEXT on a table that already has a vector index.
#
# Both hidden columns then exist, laid out FTS_DOC_ID first and
# percona_vec_aux_id second. The rebuild's column map has to advance its
# slot cursor for the FTS_DOC_ID the new table gains, or it maps
# percona_vec_aux_id onto it and every row's label is written into the
# doc id column instead.
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
body TEXT,
v VECTOR(2) NOT NULL,
KEY vk (v) TYPE hnsw WITH (M = 4));
INSERT INTO t1 VALUES (1, 'alpha beta', STRING_TO_VECTOR('[0,0]')),
(2, 'gamma delta', STRING_TO_VECTOR('[1,0]')),
(3, 'epsilon zeta', STRING_TO_VECTOR('[2,0]'));
# Adding FULLTEXT rebuilds the table, so the column map runs.
ALTER TABLE t1 ADD FULLTEXT KEY ft (body);
Warnings:
Warning	124	InnoDB rebuilding table to add column FTS_DOC_ID
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` bigint unsigned NOT NULL,
  `body` text,
  `v` vector(2) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `vk` (`v`) TYPE `hnsw` WITH (`M`=4),
  FULLTEXT KEY `ft` (`body`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# The vector index must still answer, which it cannot if the labels
# were written into FTS_DOC_ID.
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 3;
id
1
2
3
# And FULLTEXT must work on the same table.
SELECT id FROM t1 WHERE MATCH(body) AGAINST ('gamma' IN NATURAL LANGUAGE MODE);
id
2
# Both survive a reload.
# restart
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[2,0]'), 'EUCLIDEAN') LIMIT 1;
id
3
SELECT id FROM t1 WHERE MATCH(body) AGAINST ('alpha' IN NATURAL LANGUAGE MODE);
id
1
DROP TABLE t1;
