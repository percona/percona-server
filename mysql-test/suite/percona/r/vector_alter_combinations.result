#
# PS-11300: ALTER combinations around ADD VECTOR INDEX.
#
# The build runs inside ddl::Builder now, so a vector index shares the
# scan, the phase driver and the dictionary with whatever else the same
# ALTER is doing. These are the combinations that exercise that sharing.
#
# Reaching the INPLACE path takes care: the FIRST ADD VECTOR INDEX has no
# hidden column yet, so it is refused INPLACE and runs through COPY. Each
# case below therefore adds an index and drops it first, which leaves
# percona_vec_aux_id behind, before the ADD under test.
#
#
# ---- mixed secondary ----
#
# ADD a plain secondary index and a vector index in ONE ALTER.
# Two builders, one scan, different phases each.
CREATE TABLE t_mixed_secondary (id BIGINT UNSIGNED PRIMARY KEY, x INT, v VECTOR(4) NOT NULL);
ALTER TABLE t_mixed_secondary ADD KEY (v) TYPE hnsw WITH (M = 8);
ALTER TABLE t_mixed_secondary DROP KEY v;
INSERT INTO t_mixed_secondary VALUES (1,10,STRING_TO_VECTOR('[1,0,0,0]')),(2,20,STRING_TO_VECTOR('[2,0,0,0]')),
(3,30,STRING_TO_VECTOR('[3,0,0,0]')),(4,40,STRING_TO_VECTOR('[4,0,0,0]'));
ALTER TABLE t_mixed_secondary ADD INDEX x_idx (x), ADD KEY (v) TYPE hnsw WITH (M = 8);
SHOW CREATE TABLE t_mixed_secondary;
Table	Create Table
t_mixed_secondary	CREATE TABLE `t_mixed_secondary` (
  `id` bigint unsigned NOT NULL,
  `x` int DEFAULT NULL,
  `v` vector(4) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `x_idx` (`x`),
  KEY `v` (`v`) TYPE `hnsw` WITH (`M`=8)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT id FROM t_mixed_secondary ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3,0,0,0]'), 'euclidean') LIMIT 1;
id
3
SELECT COUNT(*) FROM t_mixed_secondary WHERE x > 15;
COUNT(*)
3
CHECK TABLE t_mixed_secondary;
Table	Op	Msg_type	Msg_text
test.t_mixed_secondary	check	status	OK
DROP TABLE t_mixed_secondary;
#
# ---- vector first ----
#
# Vector index listed FIRST: m_n_uniq is taken from the first index and
# skipped for a vector index, so this is the ordering that could leave it 0.
CREATE TABLE t_vector_first (id BIGINT UNSIGNED PRIMARY KEY, x INT, v VECTOR(4) NOT NULL);
ALTER TABLE t_vector_first ADD KEY (v) TYPE hnsw WITH (M = 8);
ALTER TABLE t_vector_first DROP KEY v;
INSERT INTO t_vector_first VALUES (1,10,STRING_TO_VECTOR('[1,0,0,0]')),(2,20,STRING_TO_VECTOR('[2,0,0,0]')),
(3,30,STRING_TO_VECTOR('[3,0,0,0]'));
ALTER TABLE t_vector_first ADD KEY (v) TYPE hnsw WITH (M = 8), ADD INDEX x_idx (x);
SELECT id FROM t_vector_first ORDER BY DISTANCE(v, STRING_TO_VECTOR('[2,0,0,0]'), 'euclidean') LIMIT 1;
id
2
CHECK TABLE t_vector_first;
Table	Op	Msg_type	Msg_text
test.t_vector_first	check	status	OK
DROP TABLE t_vector_first;
#
# ---- with fulltext ----
#
# FULLTEXT and vector in one ALTER: two special index kinds, each with
# its own build phase (FTS_SORT_AND_BUILD vs VEC_BUILD).
CREATE TABLE t_with_fulltext (id BIGINT UNSIGNED PRIMARY KEY, txt TEXT, v VECTOR(4) NOT NULL);
ALTER TABLE t_with_fulltext ADD KEY (v) TYPE hnsw WITH (M = 8);
ALTER TABLE t_with_fulltext DROP KEY v;
INSERT INTO t_with_fulltext VALUES (1,'alpha beta',STRING_TO_VECTOR('[1,0,0,0]')),
(2,'gamma delta',STRING_TO_VECTOR('[2,0,0,0]'));
ALTER TABLE t_with_fulltext ADD FULLTEXT ft_idx (txt), ADD KEY (v) TYPE hnsw WITH (M = 8);
Warnings:
Warning	124	InnoDB rebuilding table to add column FTS_DOC_ID
SELECT id FROM t_with_fulltext ORDER BY DISTANCE(v, STRING_TO_VECTOR('[2,0,0,0]'), 'euclidean') LIMIT 1;
id
2
SELECT id FROM t_with_fulltext WHERE MATCH(txt) AGAINST ('alpha');
id
1
CHECK TABLE t_with_fulltext;
Table	Op	Msg_type	Msg_text
test.t_with_fulltext	check	status	OK
DROP TABLE t_with_fulltext;
#
# ---- with spatial ----
#
# SPATIAL forces Parallel_cursor into single-threaded mode for the whole
# scan, so the vector build here loses its parallelism.
CREATE TABLE t_with_spatial (id BIGINT UNSIGNED PRIMARY KEY, g GEOMETRY NOT NULL SRID 0, v VECTOR(4) NOT NULL);
ALTER TABLE t_with_spatial ADD KEY (v) TYPE hnsw WITH (M = 8);
ALTER TABLE t_with_spatial DROP KEY v;
INSERT INTO t_with_spatial VALUES (1,ST_GeomFromText('POINT(1 1)'),STRING_TO_VECTOR('[1,0,0,0]')),
(2,ST_GeomFromText('POINT(2 2)'),STRING_TO_VECTOR('[2,0,0,0]'));
SET SESSION innodb_parallel_read_threads = 8;
ALTER TABLE t_with_spatial ADD SPATIAL INDEX g_idx (g), ADD KEY (v) TYPE hnsw WITH (M = 8);
SET SESSION innodb_parallel_read_threads = DEFAULT;
SELECT id FROM t_with_spatial ORDER BY DISTANCE(v, STRING_TO_VECTOR('[2,0,0,0]'), 'euclidean') LIMIT 1;
id
2
CHECK TABLE t_with_spatial;
Table	Op	Msg_type	Msg_text
test.t_with_spatial	check	status	OK
DROP TABLE t_with_spatial;
#
# ---- empty table ----
#
# Empty table: the graph has no nodes, so the bulk load never starts and
# not even record 0 is written.
CREATE TABLE t_empty_table (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL);
ALTER TABLE t_empty_table ADD KEY (v) TYPE hnsw WITH (M = 8);
ALTER TABLE t_empty_table DROP KEY v;
ALTER TABLE t_empty_table ADD KEY (v) TYPE hnsw WITH (M = 8);
SELECT COUNT(*) FROM t_empty_table;
COUNT(*)
0
# And it must still work once rows arrive.
INSERT INTO t_empty_table VALUES (1,STRING_TO_VECTOR('[1,0,0,0]')),(2,STRING_TO_VECTOR('[2,0,0,0]'));
SELECT id FROM t_empty_table ORDER BY DISTANCE(v, STRING_TO_VECTOR('[2,0,0,0]'), 'euclidean') LIMIT 1;
id
2
CHECK TABLE t_empty_table;
Table	Op	Msg_type	Msg_text
test.t_empty_table	check	status	OK
DROP TABLE t_empty_table;
#
# ---- drop add ----
#
# DROP the vector index and ADD one back in the SAME ALTER: the old aux
# is dropped and a new one built in one statement.
CREATE TABLE t_drop_add (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL);
INSERT INTO t_drop_add VALUES (1,STRING_TO_VECTOR('[1,0,0,0]')),(2,STRING_TO_VECTOR('[2,0,0,0]')),
(3,STRING_TO_VECTOR('[3,0,0,0]'));
ALTER TABLE t_drop_add ADD KEY (v) TYPE hnsw WITH (M = 8);
ALTER TABLE t_drop_add DROP KEY v, ADD KEY v2 (v) TYPE hnsw WITH (M = 16);
SHOW CREATE TABLE t_drop_add;
Table	Create Table
t_drop_add	CREATE TABLE `t_drop_add` (
  `id` bigint unsigned NOT NULL,
  `v` vector(4) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `v2` (`v`) TYPE `hnsw` WITH (`M`=16)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT id FROM t_drop_add ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3,0,0,0]'), 'euclidean') LIMIT 1;
id
3
CHECK TABLE t_drop_add;
Table	Op	Msg_type	Msg_text
test.t_drop_add	check	status	OK
DROP TABLE t_drop_add;
#
# ---- two vector ----
#
# Two vector indexes in one ALTER. PS-11264 caps a table at one, and
# ddl0builder asserts on that cap, so this must be refused cleanly.
CREATE TABLE t_two_vector (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL, w VECTOR(4) NOT NULL);
INSERT INTO t_two_vector VALUES (1,STRING_TO_VECTOR('[1,0,0,0]'),STRING_TO_VECTOR('[9,0,0,0]'));
ALTER TABLE t_two_vector ADD KEY (v) TYPE hnsw WITH (M = 8), ADD KEY (w) TYPE hnsw WITH (M = 8);
Got one of the listed errors
SHOW CREATE TABLE t_two_vector;
Table	Create Table
t_two_vector	CREATE TABLE `t_two_vector` (
  `id` bigint unsigned NOT NULL,
  `v` vector(4) NOT NULL,
  `w` vector(4) NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
CHECK TABLE t_two_vector;
Table	Op	Msg_type	Msg_text
test.t_two_vector	check	status	OK
DROP TABLE t_two_vector;
#
# ---- add column ----
#
# ADD COLUMN together with the vector index: the hidden column's ordinal
# has to survive a user column arriving in the same statement.
CREATE TABLE t_add_column (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL);
ALTER TABLE t_add_column ADD KEY (v) TYPE hnsw WITH (M = 8);
ALTER TABLE t_add_column DROP KEY v;
INSERT INTO t_add_column VALUES (1,STRING_TO_VECTOR('[1,0,0,0]')),(2,STRING_TO_VECTOR('[2,0,0,0]'));
ALTER TABLE t_add_column ADD COLUMN c INT DEFAULT 7, ADD KEY (v) TYPE hnsw WITH (M = 8);
SELECT id, c FROM t_add_column ORDER BY id;
id	c
1	7
2	7
SELECT id FROM t_add_column ORDER BY DISTANCE(v, STRING_TO_VECTOR('[2,0,0,0]'), 'euclidean') LIMIT 1;
id
2
CHECK TABLE t_add_column;
Table	Op	Msg_type	Msg_text
test.t_add_column	check	status	OK
DROP TABLE t_add_column;
#
# ---- rebuild after ----
#
# Build the vector index, then force a rebuild of the table underneath it.
CREATE TABLE t_rebuild_after (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL);
ALTER TABLE t_rebuild_after ADD KEY (v) TYPE hnsw WITH (M = 8);
ALTER TABLE t_rebuild_after DROP KEY v;
INSERT INTO t_rebuild_after VALUES (1,STRING_TO_VECTOR('[1,0,0,0]')),(2,STRING_TO_VECTOR('[2,0,0,0]'));
ALTER TABLE t_rebuild_after ADD KEY (v) TYPE hnsw WITH (M = 8);
# A rebuild with a surviving vector index - refused, or rebuilt correctly.
ALTER TABLE t_rebuild_after FORCE;
SHOW CREATE TABLE t_rebuild_after;
Table	Create Table
t_rebuild_after	CREATE TABLE `t_rebuild_after` (
  `id` bigint unsigned NOT NULL,
  `v` vector(4) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `v` (`v`) TYPE `hnsw` WITH (`M`=8)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT id FROM t_rebuild_after ORDER BY DISTANCE(v, STRING_TO_VECTOR('[2,0,0,0]'), 'euclidean') LIMIT 1;
id
2
CHECK TABLE t_rebuild_after;
Table	Op	Msg_type	Msg_text
test.t_rebuild_after	check	status	OK
DROP TABLE t_rebuild_after;
#
# ---- algorithm lock ----
#
# Explicit ALGORITHM and LOCK on the INPLACE path. LOCK=NONE must be
# refused; SHARED and INPLACE must work.
CREATE TABLE t_algorithm_lock (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL);
ALTER TABLE t_algorithm_lock ADD KEY (v) TYPE hnsw WITH (M = 8);
ALTER TABLE t_algorithm_lock DROP KEY v;
INSERT INTO t_algorithm_lock VALUES (1,STRING_TO_VECTOR('[1,0,0,0]')),(2,STRING_TO_VECTOR('[2,0,0,0]'));
ALTER TABLE t_algorithm_lock ADD KEY (v) TYPE hnsw WITH (M = 8), ALGORITHM=INPLACE, LOCK=NONE;
ERROR 0A000: LOCK=NONE is not supported. Reason: InnoDB does not support building a vector index with LOCK=NONE; rows written while it is built would not reach the graph. Try LOCK=SHARED.
ALTER TABLE t_algorithm_lock ADD KEY (v) TYPE hnsw WITH (M = 8), ALGORITHM=INPLACE, LOCK=SHARED;
SELECT id FROM t_algorithm_lock ORDER BY DISTANCE(v, STRING_TO_VECTOR('[2,0,0,0]'), 'euclidean') LIMIT 1;
id
2
CHECK TABLE t_algorithm_lock;
Table	Op	Msg_type	Msg_text
test.t_algorithm_lock	check	status	OK
DROP TABLE t_algorithm_lock;
