#
# PS-11300: a table with a vector index can be rebuilt in place.
#
# The rebuild recreates every index on the new table, the vector index
# among them, so ddl::Builder rebuilds the graph from the copied rows:
# labels come across untouched in the hidden column, base_pk follows
# whatever the primary key has become, and the label counter is carried
# in the table definition.
#
# Not online, though - the row log cannot maintain a graph while DML
# runs against it, so these are LOCK=SHARED.
#
# Each case: rebuild, insert, search, CHECK TABLE, restart, search.
# Node levels are random, so nothing here asserts a graph shape.
#
#
# ---- FORCE ----
#
ALTER TABLE t1 FORCE, ALGORITHM=INPLACE;
INSERT INTO t1 (id, alt, v) VALUES (9,109,STRING_TO_VECTOR('[9,0,0,0]'));
# The new table copied its labels from the old rows without assigning
# any, so its own counter is zero and the old table holding the real
# one is already freed. A counter that did not come across reissues a
# label the INSERT above still holds.
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output AS verify_after_force;
verify_after_force
nodes=4 distinct_ids=4 distinct_base_pks=4 dup_ids=0 dup_base_pks=0 labels_contiguous_from_1=1
SELECT COUNT(*) AS rows_after FROM t1;
rows_after
4
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[9,0,0,0]'), 'euclidean') LIMIT 1;
id
9
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# restart
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3,0,0,0]'), 'euclidean') LIMIT 1;
id
3
# The rebuild renames the aux after the new table_id - the old one
# must not be left behind.
SELECT COUNT(*) AS aux_tables FROM information_schema.innodb_tables
WHERE name LIKE '%percona_vec_hnsw%';
aux_tables
1
#
# ---- OPTIMIZE ----
#
OPTIMIZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t1	optimize	status	OK
INSERT INTO t1 (id, alt, v) VALUES (9,109,STRING_TO_VECTOR('[9,0,0,0]'));
SELECT COUNT(*) AS rows_after FROM t1;
rows_after
4
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[9,0,0,0]'), 'euclidean') LIMIT 1;
id
9
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# restart
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3,0,0,0]'), 'euclidean') LIMIT 1;
id
3
# The rebuild renames the aux after the new table_id - the old one
# must not be left behind.
SELECT COUNT(*) AS aux_tables FROM information_schema.innodb_tables
WHERE name LIKE '%percona_vec_hnsw%';
aux_tables
1
