#
# PS-11299: DROP TABLE must hold an exclusive MDL on the vector aux
# tables while it drops them.
#
# The aux tables are hidden, so the server took no metadata lock on
# them when it locked the parent. Without an explicit lock, the aux
# table is dropped from under any session still reading it. FTS solves
# this with fts_lock_all_aux_tables; this is the same thing for vector.
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR(2) NOT NULL,
KEY vk (v) TYPE hnsw WITH (M = 4));
INSERT INTO t1 VALUES (1, STRING_TO_VECTOR('[0,0]')),
(2, STRING_TO_VECTOR('[1,1]'));
SET DEBUG_SYNC = 'vec_aux_mdl_acquired SIGNAL aux_locked WAIT_FOR go';
DROP TABLE t1;
SET DEBUG_SYNC = 'now WAIT_FOR aux_locked';
# The aux table is holding an EXCLUSIVE, GRANTED table MDL.
SELECT object_type, lock_type, lock_status
FROM performance_schema.metadata_locks
WHERE object_name LIKE 'percona_vec_hnsw%'
ORDER BY object_name;
object_type	lock_type	lock_status
TABLE	EXCLUSIVE	GRANTED
SET DEBUG_SYNC = 'now SIGNAL go';
SET DEBUG_SYNC = 'RESET';
# And the lock is gone once the drop is done.
SELECT COUNT(*) AS leftover_aux_locks
FROM performance_schema.metadata_locks
WHERE object_name LIKE 'percona_vec_hnsw%';
leftover_aux_locks
0
SET DEBUG_SYNC = 'RESET';
