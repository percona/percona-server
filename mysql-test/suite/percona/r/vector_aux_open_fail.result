#
# An INSERT or UPDATE whose vector index's aux table cannot be opened
# fails the statement; it does not end the server. The failed open used
# to return DB_TABLE_NOT_FOUND, which row_mysql_handle_errors() does not
# list and so reached its ib::fatal() arm (ultracodereview: issue5).
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
VECTOR KEY vk (v) TYPE hnsw (M = 4));
INSERT INTO t1 VALUES (1, STRING_TO_VECTOR('[1,0,0,0]'));
SET DEBUG = '+d,vec_aux_open_fail';
INSERT INTO t1 VALUES (2, STRING_TO_VECTOR('[2,0,0,0]'));
ERROR HY000: Index t1 is corrupted
UPDATE t1 SET v = STRING_TO_VECTOR('[3,0,0,0]') WHERE id = 1;
ERROR HY000: Index t1 is corrupted
SET DEBUG = '-d,vec_aux_open_fail';
# The server is still up, and neither statement changed a row.
SELECT id, VECTOR_TO_STRING(v) FROM t1 ORDER BY id;
id	VECTOR_TO_STRING(v)
1	[1.00000e+00,0.00000e+00,0.00000e+00,0.00000e+00]
DROP TABLE t1;
