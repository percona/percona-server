#
# PS-11299: vector aux tables must NOT be reported as FTS aux tables
# by the InnoDB dict_table_t::is_fts_aux() predicate. They share the
# generic is_aux() bucket but the two flags (DICT_TF2_AUX for FTS,
# DICT_TF2_VEC_AUX for vector) are distinct.
#
# Direct C-level access is not available from SQL; this test confirms
# the indirect behavior:
#   1. a vector aux table is hidden from INFORMATION_SCHEMA.TABLES
#      (relies on is_aux() returning true);
#   2. INFORMATION_SCHEMA.INNODB_TABLES does NOT classify the vec aux
#      with FTS-specific tags;
#   3. the table survives a server restart (DICT_TF2_VEC_AUX must be
#      reconstructed at DD-reload time from the on-disk name pattern).
#
CREATE TABLE tva (
id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR(8) NOT NULL,
KEY (v) TYPE hnsw WITH (M = 6)
);
# The aux .ibd exists on disk.
percona_vec_hnsw_<TID>_<IID>.ibd
# INFORMATION_SCHEMA.TABLES must not surface the percona_vec_*_* aux to users.
# Same hiding rule the FTS aux gets — proves is_aux() covers vec.
SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE 'vec\_%' ESCAPE '\\';
TABLE_NAME
# INFORMATION_SCHEMA.INNODB_TABLES does surface aux tables (this is
# internal/debugging info_schema). Pull the row so we can assert the
# vec aux is present *as a row* and round-trips its identity after
# the restart below.
SELECT NAME FROM INFORMATION_SCHEMA.INNODB_TABLES
WHERE NAME LIKE 'test/percona_vec\_%' ESCAPE '\\';
NAME
test/percona_vec_hnsw_<TID>_<IID>
# Restart server. On reload, dd_open_table_one detects the percona_vec_hnsw_<id>_<id>
# name pattern and re-sets DICT_TF2_VEC_AUX + parent_id. Without that
# reconstruction the aux would lose its "aux" identity entirely.
# restart
# Aux row must still appear in INNODB_TABLES with the same identity.
SELECT NAME FROM INFORMATION_SCHEMA.INNODB_TABLES
WHERE NAME LIKE 'test/percona_vec\_%' ESCAPE '\\';
NAME
test/percona_vec_hnsw_<TID>_<IID>
# And still hidden from the user-facing view.
SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE 'vec\_%' ESCAPE '\\';
TABLE_NAME
DROP TABLE tva;
# All aux .ibd gone.
