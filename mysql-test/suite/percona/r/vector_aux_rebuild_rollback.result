#
# PS-11299: rebuild-rollback path must drop the vector aux table
# that lives on the (about-to-be-thrown-away) ctx->new_table.
# Mirrors innobase_drop_fts_index_table for FTS in the same block
# at handler0alter.cc error_handled.
#
# Triggered by forcing ALTER ADD INDEX to take the REBUILD
# path — the base table has been INSTANT-altered, so adding the
# first vector index forces rebuild via add_vec_aux_col. Then the
# debug knob fails prepare, exercising:
#   error_handling   per-index vec aux drop (added in task #18)
#   error_handled    rebuild block: vec_aux_drop_all_tables on
#                    ctx->new_table (added in this task)
# The second drop is a no-op for indexes the first drop handled.
#
CREATE TABLE tvr (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(8) NOT NULL);
# The FIRST ADD materializes the hidden column by rebuilding the table
# in place, so it is itself a rebuild that the armed knob rolls back:
# no aux left behind, and the table keeps its old shape (N_COLS 5).
SET @@SESSION.debug = '+d,vec_prepare_fail_after_aux_create';
ALTER TABLE tvr ADD VECTOR KEY (v) TYPE hnsw (M = 6);
Got one of the listed errors
SET @@SESSION.debug = '-d,vec_prepare_fail_after_aux_create';
SELECT n_cols FROM information_schema.innodb_tables WHERE name = 'test/tvr';
n_cols
5
ALTER TABLE tvr ADD VECTOR KEY (v) TYPE hnsw (M = 6);
# Drop it. The hidden column is retained, so a later ADD is
# eligible for INPLACE again.
ALTER TABLE tvr DROP KEY v;
# Add a column in the same ALTER so it must take the INPLACE
# *rebuild* path, which is the path whose rollback this covers.
# (INSTANT ADD COLUMN, which this test used to use for the same
# purpose, is refused once the hidden column exists.)
SET @@SESSION.debug = '+d,vec_prepare_fail_after_aux_create';
ALTER TABLE tvr ADD COLUMN c1 INT, ADD VECTOR KEY (v) TYPE hnsw (M = 6),
ALGORITHM=INPLACE;
Got one of the listed errors
SET @@SESSION.debug = '-d,vec_prepare_fail_after_aux_create';
# No vec aux .ibd left behind after rebuild rollback.
# Retry must succeed — both the original-table dict_sys slots
# and any aux name slots are free.
ALTER TABLE tvr ADD COLUMN c1 INT, ADD VECTOR KEY (v) TYPE hnsw (M = 6),
ALGORITHM=INPLACE;
SHOW CREATE TABLE tvr;
Table	Create Table
tvr	CREATE TABLE `tvr` (
  `id` bigint unsigned NOT NULL,
  `v` vector(8) NOT NULL,
  `c1` int DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `v` (`v`) USING `hnsw` (`M`=6)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
percona_vec_hnsw_<TID>_<IID>.ibd
DROP TABLE tvr;
