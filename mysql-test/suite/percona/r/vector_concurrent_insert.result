#
# PS-11300: concurrent INSERTs into one vector index.
#
# These now run concurrently: the HNSW class synchronises itself,
# so vec_t::graph_lock is taken shared and the inserts mutate the
# graph in parallel.
#
# The test asserts the RESULT, not the serialisation, which is why
# it kept its meaning when the latch came out. Every committed row
# must have exactly one node, every node must name a real row, and
# the label counter must have issued each label once.
#
# Twelve rows over four connections is already enough to deadlock:
# every insert rewires the nodes nearest the entry point, so the
# same few aux rows are contended no matter how small the graph is.
# The aborts are therefore tolerated and the surviving rows checked
# against the graph. vector_insert_contention drives the same
# invariant under heavy load.
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR(4) NOT NULL,
KEY (v) TYPE hnsw WITH (M = 4));
INSERT INTO t1 VALUES (1,STRING_TO_VECTOR('[1,0,0,0]')),(5,STRING_TO_VECTOR('[0.9,0.1,0,0]')),(9,STRING_TO_VECTOR('[0.8,0,0.2,0]'));
INSERT INTO t1 VALUES (2,STRING_TO_VECTOR('[0,1,0,0]')),(6,STRING_TO_VECTOR('[0.1,0.9,0,0]')),(10,STRING_TO_VECTOR('[0,0.8,0.2,0]'));
INSERT INTO t1 VALUES (3,STRING_TO_VECTOR('[0,0,1,0]')),(7,STRING_TO_VECTOR('[0,0.1,0.9,0]')),(11,STRING_TO_VECTOR('[0.2,0,0.8,0]'));
INSERT INTO t1 VALUES (4,STRING_TO_VECTOR('[0,0,0,1]')),(8,STRING_TO_VECTOR('[0,0,0.1,0.9]')),(12,STRING_TO_VECTOR('[0,0.2,0,0.8]'));
# Invariants that must hold whatever order the four INSERTs
# interleaved in, and whichever of them aborted: one node per
# committed row, and no two nodes naming the same row.
#
# Neither the row count nor the per-node detail is recorded. How
# many rows survive depends on who aborted, and the id to base_pk
# mapping depends on the interleaving; recording either would make
# the test flake. labels_contiguous_from_1 is left out for the same
# reason — an aborted insert has already consumed its label.
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
# Graph and table agree.
DROP TABLE t1;
