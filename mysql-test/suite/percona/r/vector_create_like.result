#
# PS-11299: CREATE TABLE LIKE on a vec-indexed table.
# The copy must:
#   - preserve the KEY definition including TYPE and WITH
#   - own its own vec aux .ibd (distinct from source's)
#   - be functionally independent of the source
CREATE TABLE src (id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR(8) NOT NULL,
KEY (v) TYPE hnsw WITH (M = 6));
# Source has its vec aux.
percona_vec_hnsw_<SRC>.ibd
CREATE TABLE copy_t LIKE src;
SHOW CREATE TABLE copy_t;
Table	Create Table
copy_t	CREATE TABLE `copy_t` (
  `id` bigint unsigned NOT NULL,
  `v` vector(8) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `v` (`v`) TYPE `hnsw` WITH (`M`=6)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# The copy has its own aux .ibd — distinct (TID/IID) from source's.
percona_vec_hnsw_<TID>_<IID>.ibd
percona_vec_hnsw_<TID>_<IID>.ibd
# Drop the SOURCE first, the COPY must remain functional.
DROP TABLE src;
SHOW CREATE TABLE copy_t;
Table	Create Table
copy_t	CREATE TABLE `copy_t` (
  `id` bigint unsigned NOT NULL,
  `v` vector(8) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `v` (`v`) TYPE `hnsw` WITH (`M`=6)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Only the copy's aux remains.
percona_vec_hnsw_<COPY>.ibd
DROP TABLE copy_t;
