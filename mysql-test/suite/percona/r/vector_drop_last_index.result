# Replacing the vector index while adding a virtual column: no rebuild
# (the column stays), so it is allowed in place, and the labels stay.
CREATE TABLE t5 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
c INT, e INT, VECTOR KEY vk (v) TYPE hnsw (M = 8));
INSERT INTO t5 VALUES (1, STRING_TO_VECTOR('[1,0,0,0]'), 10, 1),
(2, STRING_TO_VECTOR('[2,0,0,0]'), 20, 2),
(3, STRING_TO_VECTOR('[3,0,0,0]'), 30, 3);
DELETE FROM t5 WHERE id = 2;
INSERT INTO t5 VALUES (4, STRING_TO_VECTOR('[4,0,0,0]'), 40, 4);
ALTER TABLE t5 DROP KEY vk, ADD VECTOR KEY vk2 (v) TYPE hnsw (M = 8),
ADD COLUMN g INT GENERATED ALWAYS AS (c + 1) VIRTUAL, ALGORITHM=INPLACE;
affected rows: 0
info: Records: 0  Duplicates: 0  Warnings: 0
# Replacing it while dropping a stored column: a rebuild that keeps
# the column, so the labels are copied, not reassigned.
ALTER TABLE t5 DROP KEY vk2, ADD VECTOR KEY vk3 (v) TYPE hnsw (M = 8),
DROP COLUMN e, ALGORITHM=INPLACE;
# Labels 1, 3 and 4: row 2's label is not reissued.
SET SESSION innodb_interpreter = 'vec_aux_dump test/t5';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=4 max_id=4
id=0 level=# base_pk=# nb=#
id=1 level=# base_pk=1 nb=#
id=3 level=# base_pk=3 nb=#
id=4 level=# base_pk=4 nb=#

SELECT id, g FROM t5 ORDER BY id;
id	g
1	11
3	31
4	41
CHECK TABLE t5;
Table	Op	Msg_type	Msg_text
test.t5	check	status	OK
# Every table reopens with the definition it was left with.
# restart
CHECK TABLE t3, t4, t5, t6;
Table	Op	Msg_type	Msg_text
test.t3	check	status	OK
test.t4	check	status	OK
test.t5	check	status	OK
test.t6	check	status	OK
SELECT id FROM t5
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[4,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id
4
DROP TABLE t3, t4, t5, t6;
#
# The last DROP is a rebuild, so a surviving SPATIAL index refuses
# LOCK=NONE as it does for any online rebuild (ultracodereview: issue3).
#
CREATE TABLE t8 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
g GEOMETRY NOT NULL SRID 0, SPATIAL KEY gk (g),
VECTOR KEY vk (v) TYPE hnsw (M = 8));
INSERT INTO t8 VALUES (1, STRING_TO_VECTOR('[1,0,0,0]'), ST_GeomFromText('POINT(1 1)')),
(2, STRING_TO_VECTOR('[2,0,0,0]'), ST_GeomFromText('POINT(2 2)'));
ALTER TABLE t8 DROP KEY vk, ALGORITHM=INPLACE, LOCK=NONE;
ERROR 0A000: LOCK=NONE is not supported. Reason: Do not support online operation on table with GIS index. Try LOCK=SHARED.
ALTER TABLE t8 DROP KEY vk, ALGORITHM=INPLACE, LOCK=SHARED;
SELECT n_cols FROM information_schema.innodb_tables WHERE name = 'test/t8';
n_cols
6
SELECT id FROM t8 WHERE MBRContains(ST_GeomFromText('POLYGON((0 0,0 3,3 3,3 0,0 0))'), g) ORDER BY id;
id
1
2
CHECK TABLE t8;
Table	Op	Msg_type	Msg_text
test.t8	check	status	OK
DROP TABLE t8;
