#
# PS-11300 S3: SQL kNN — ORDER BY DISTANCE(...) LIMIT k is served by
# the HNSW vector index (JT_VECTOR access, sort elided, rows in
# ascending distance). Everything else stays on the exact path.
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
k INT,
v VECTOR(2) NOT NULL,
KEY vk (v) TYPE hnsw WITH (M = 4));
INSERT INTO t1 VALUES (100, 0, STRING_TO_VECTOR('[0,0]')),
(101, 1, STRING_TO_VECTOR('[1,0]')),
(102, 0, STRING_TO_VECTOR('[0,2]')),
(103, 1, STRING_TO_VECTOR('[3,0]')),
(104, 0, STRING_TO_VECTOR('[0,4]')),
(105, 1, STRING_TO_VECTOR('[5,0]'));
# The canonical shape uses the index: access type vector_knn, key vk,
# and no filesort in the plan.
EXPLAIN SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 3;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	vector_knn	NULL	vk	1	NULL	#	#	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id` from `test`.`t1` order by distance(`test`.`t1`.`v`,to_vector('[0,0]'),'EUCLIDEAN') limit 3
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 3;
id
100
101
102
