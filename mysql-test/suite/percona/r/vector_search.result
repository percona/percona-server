EXPLAIN SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN_SQUARED') LIMIT 3;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	vector_knn	NULL	vk	1	NULL	#	#	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id` from `test`.`t1` order by distance(`test`.`t1`.`v`,to_vector('[0,0]'),'EUCLIDEAN_SQUARED') limit 3
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN_SQUARED') LIMIT 3;
id
100
101
102
# Constant may be the first argument too.
SELECT id FROM t1 ORDER BY DISTANCE(STRING_TO_VECTOR('[5,0]'), v, 'EUCLIDEAN') LIMIT 2;
id
105
103
# The exact path (IGNORE INDEX: scan + filesort) returns the same
# rows in the same order. An indexed vector column is NOT NULL, so
# there is no NULL-ordering difference between the two paths to
# document — earlier revisions of this test carried one, on a base
# where a nullable vector column could be indexed.
EXPLAIN SELECT id FROM t1 IGNORE INDEX (vk) ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 3;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using filesort
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id` from `test`.`t1` IGNORE INDEX (`vk`) order by distance(`test`.`t1`.`v`,to_vector('[0,0]'),'EUCLIDEAN') limit 3
SELECT id FROM t1 IGNORE INDEX (vk) ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 3;
id
100
101
102
#
# Shapes that must NOT use the index (approximate results are only
# acceptable under the explicit ORDER BY ... LIMIT contract):
#
# No LIMIT.
EXPLAIN SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN');
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using filesort
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id` from `test`.`t1` order by distance(`test`.`t1`.`v`,to_vector('[0,0]'),'EUCLIDEAN')
# DESC (farthest-first is not what the graph returns).
EXPLAIN SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') DESC LIMIT 3;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using filesort
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id` from `test`.`t1` order by distance(`test`.`t1`.`v`,to_vector('[0,0]'),'EUCLIDEAN') desc limit 3
# Metric not servable by the L2 graph.
EXPLAIN SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'MANHATTAN') LIMIT 3;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using filesort
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id` from `test`.`t1` order by distance(`test`.`t1`.`v`,to_vector('[0,0]'),'MANHATTAN') limit 3
# Distance only in WHERE: exact scan, exact results.
EXPLAIN SELECT id FROM t1 WHERE DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') <= 2;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using where
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id` from `test`.`t1` where (distance(`test`.`t1`.`v`,<cache>(to_vector('[0,0]')),'EUCLIDEAN') <= 2)
SELECT id FROM t1 WHERE DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') <= 2 ORDER BY id;
id
100
101
102
# Both arguments non-constant.
EXPLAIN SELECT id FROM t1 ORDER BY DISTANCE(v, v, 'EUCLIDEAN') LIMIT 3;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using filesort
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id` from `test`.`t1` order by distance(`test`.`t1`.`v`,`test`.`t1`.`v`,'EUCLIDEAN') limit 3
#
# WHERE + ORDER BY LIMIT: the filter consumes near candidates and the
# handler's resume loop keeps widening the search — all 3 k=1 rows
# arrive even though they interleave with k=0 rows in distance order.
#
EXPLAIN SELECT id FROM t1 WHERE k = 1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 3;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	vector_knn	NULL	vk	1	NULL	#	#	Using where
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id` from `test`.`t1` where (`test`.`t1`.`k` = 1) order by distance(`test`.`t1`.`v`,to_vector('[0,0]'),'EUCLIDEAN') limit 3
SELECT id FROM t1 WHERE k = 1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 3;
id
101
103
105
# A LIMIT larger than the graph returns every row, once each: the
# resume loop widens until the graph is exhausted, then stops.
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 10;
id
100
101
102
103
104
105
#
# Visibility: an uncommitted point from another transaction is in the
# shared graph but must not surface — its base row is invisible and
# the read path skips it (candidates, not results).
#
BEGIN;
INSERT INTO t1 VALUES (200, 0, STRING_TO_VECTOR('[0.1,0]'));
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 3;
id
100
101
102
COMMIT;
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 3;
id
100
200
101
# DELETE drops the point from results immediately.
DELETE FROM t1 WHERE id = 200;
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 3;
id
100
101
102
# The phase-1 COUNT(*) bug is fixed: the stub vector index is never
# picked for scans.
SELECT COUNT(*) FROM t1;
COUNT(*)
6
# ef_search is a session knob.
SET SESSION innodb_hnsw_ef_search = 200;
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 3;
id
100
101
102
SET SESSION innodb_hnsw_ef_search = default;
# Search works on the reloaded graph after a restart.
# restart
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,4]'), 'EUCLIDEAN') LIMIT 3;
id
104
102
100
DROP TABLE t1;
