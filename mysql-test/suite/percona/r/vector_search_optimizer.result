# Joins
CREATE TABLE t3 (
id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR (3) NOT NULL,
VECTOR KEY (v) USING hnsw
);
INSERT INTO t3 VALUES ( 1, to_vector('[0, 0, 0]') );
INSERT INTO t3 VALUES ( 2, to_vector('[1, 1, 1]') );
INSERT INTO t3 VALUES ( 3, to_vector('[1, 1, 2]') );
INSERT INTO t3 VALUES ( 4, to_vector('[1, 2, 1]') );
INSERT INTO t3 VALUES ( 5, to_vector('[1, 2, 2]') );
INSERT INTO t3 VALUES ( 6, to_vector('[2, 1, 1]') );
INSERT INTO t3 VALUES ( 7, to_vector('[2, 1, 2]') );
INSERT INTO t3 VALUES ( 8, to_vector('[2, 2, 1]') );
INSERT INTO t3 VALUES ( 9, to_vector('[2, 2, 2]') );
EXPLAIN ANALYZE
SELECT id, vector_to_pretty_string(t2.v) v
FROM t2 join t3 using (id)
WHERE distance( t2.v, to_vector('[0, 0, 0]'), 'EUCLIDEAN' ) <= 2.5;
EXPLAIN
-> Nested loop inner join  (cost=4.3 rows=9) (actual time=X..Y rows=5 loops=1)
    -> Filter: (distance(t2.v,<cache>(to_vector('[0, 0, 0]')),'EUCLIDEAN') <= 2.5)  (cost=1.15 rows=9) (actual time=X..Y rows=5 loops=1)
        -> Table scan on t2  (cost=1.15 rows=9) (actual time=X..Y rows=9 loops=1)
    -> Single-row covering index lookup on t3 using PRIMARY (id = t2.id)  (cost=0.261 rows=1) (actual time=X..Y rows=1 loops=5)

SELECT id, vector_to_pretty_string(t2.v) v
FROM t2 join t3 using (id)
WHERE distance( t2.v, to_vector('[0, 0, 0]'), 'EUCLIDEAN' ) <= 2.5;
id	v
1	[0,0,0]
2	[1,1,1]
3	[1,1,2]
4	[1,2,1]
6	[2,1,1]
EXPLAIN ANALYZE
SELECT id, vector_to_pretty_string(t2i.v) v
FROM ( SELECT id, v FROM t2 WHERE id < 3 ) t2i join t3 using (id)
WHERE distance( t2i.v, to_vector('[0, 0, 0]'), 'EUCLIDEAN' ) <= 2.5;
EXPLAIN
-> Nested loop inner join  (cost=1.61 rows=2) (actual time=X..Y rows=2 loops=1)
    -> Filter: ((distance(t2.v,<cache>(to_vector('[0, 0, 0]')),'EUCLIDEAN') <= 2.5) and (t2.id < 3))  (cost=0.91 rows=2) (actual time=X..Y rows=2 loops=1)
        -> Index range scan on t2 using PRIMARY over (id < 3)  (cost=0.91 rows=2) (actual time=X..Y rows=2 loops=1)
    -> Single-row covering index lookup on t3 using PRIMARY (id = t2.id)  (cost=0.3 rows=1) (actual time=X..Y rows=1 loops=2)

SELECT id, vector_to_pretty_string(t2i.v) v
FROM ( SELECT id, v FROM t2 WHERE id < 3 ) t2i join t3 using (id)
WHERE distance( t2i.v, to_vector('[0, 0, 0]'), 'EUCLIDEAN' ) <= 2.5;
id	v
1	[0,0,0]
2	[1,1,1]
EXPLAIN ANALYZE
SELECT id, vector_to_pretty_string(t2i.v) v
FROM ( SELECT id, t2.v FROM t2 WHERE id < 3 ) t2i join t3 using (id)
WHERE 2.5 >= distance( t2i.v, to_vector('[0, 0, 0]'), 'EUCLIDEAN' );
EXPLAIN
-> Nested loop inner join  (cost=1.61 rows=2) (actual time=X..Y rows=2 loops=1)
    -> Filter: ((2.5 >= distance(t2.v,<cache>(to_vector('[0, 0, 0]')),'EUCLIDEAN')) and (t2.id < 3))  (cost=0.91 rows=2) (actual time=X..Y rows=2 loops=1)
        -> Index range scan on t2 using PRIMARY over (id < 3)  (cost=0.91 rows=2) (actual time=X..Y rows=2 loops=1)
    -> Single-row covering index lookup on t3 using PRIMARY (id = t2.id)  (cost=0.3 rows=1) (actual time=X..Y rows=1 loops=2)

SELECT id, vector_to_pretty_string(t2i.v) v
FROM ( SELECT id, v FROM t2 WHERE id < 3 ) t2i join t3 using (id)
WHERE 2.5 >= distance( t2i.v, to_vector('[0, 0, 0]'), 'EUCLIDEAN' );
