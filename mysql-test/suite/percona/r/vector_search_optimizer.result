EXPLAIN FORMAT=TREE
SELECT id, t2.v v
FROM t2 JOIN t3 USING (id)
WHERE distance( t2.v, to_vector('[0, 0, 0]'), 'EUCLIDEAN' ) <= 2.5;
EXPLAIN
-> Nested loop inner join  (cost=X rows=9)
    -> Filter: (distance(t2.v,<cache>(to_vector('[0, 0, 0]')),'EUCLIDEAN') <= 2.5)  (cost=X rows=9)
        -> Table scan on t2  (cost=X rows=9)
    -> Single-row covering index lookup on t3 using PRIMARY (id = t2.id)  (cost=X rows=1)

SELECT id, t2.v v
FROM t2 JOIN t3 USING (id)
WHERE distance( t2.v, to_vector('[0, 0, 0]'), 'EUCLIDEAN' ) <= 2.5;
