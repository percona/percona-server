#
# Determine which optimizer path sets up the vector access for each
# predicate shape. make_join_query_block()'s LOW_LIMIT recheck emits a
# "rechecking_index_usage" trace object with "recheck_reason":
# "low_limit"; test_if_skip_sort_order() emits
# "reconsidering_access_paths_for_index_ordering" instead.
#
CREATE TABLE t1 (
id BIGINT UNSIGNED PRIMARY KEY,
c INT,
v VECTOR(2) NOT NULL,
KEY c_idx (c),
VECTOR KEY (v) USING hnsw
);
INSERT INTO t1 VALUES
(1,  10, TO_VECTOR("[0, 0]")),
(2,  20, TO_VECTOR("[1, 0]")),
(3,  30, TO_VECTOR("[0, 2]")),
(4,  40, TO_VECTOR("[3, 0]")),
(5,  50, TO_VECTOR("[0, 4]")),
(6,  60, TO_VECTOR("[5, 0]")),
(7,  70, TO_VECTOR("[0, 6]")),
(8,  80, TO_VECTOR("[7, 0]")),
(9,  90, TO_VECTOR("[0, 8]")),
(10, 100, TO_VECTOR("[9, 0]"));
ANALYZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
SET SESSION optimizer_trace = "enabled=on";
# Non-selective predicate -> full scan, c_idx stays in const_keys.
EXPLAIN ANALYZE
SELECT id FROM t1 WHERE c > 0 ORDER BY DISTANCE(v, TO_VECTOR("[0, 0]"), "EUCLIDEAN") LIMIT 3;
EXPLAIN
-> Limit: 3 row(s)  (cost=1.25 rows=3) (actual time=X..Y rows=3 loops=1)
    -> Filter: (t1.c > 0)  (cost=1.25 rows=10) (actual time=X..Y rows=3 loops=1)
        -> Vector index search on t1 using v (v = to_vector('[0, 0]'))  (cost=1.25 rows=10) (actual time=X..Y rows=3 loops=1)

EXPLAIN FORMAT=TRADITIONAL
SELECT id FROM t1 WHERE c > 0 ORDER BY DISTANCE(v, TO_VECTOR("[0, 0]"), "EUCLIDEAN") LIMIT 3;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	vector_knn	c_idx,v	v	0	const	10	100.00	Using where
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id` from `test`.`t1` where (`test`.`t1`.`c` > 0) order by distance(`test`.`t1`.`v`,to_vector('[0, 0]'),'EUCLIDEAN') limit 3
SELECT id FROM t1 WHERE c > 0 ORDER BY DISTANCE(v, TO_VECTOR("[0, 0]"), "EUCLIDEAN") LIMIT 3;
id
1
2
3
SELECT JSON_EXTRACT(trace, '$**.rechecking_index_usage') AS low_limit_recheck,
JSON_CONTAINS_PATH(trace, 'one',
'$**.reconsidering_access_paths_for_index_ordering') AS skip_sort_path
FROM information_schema.optimizer_trace;
low_limit_recheck	skip_sort_path
[{"limit": 3, "row_estimate": 10, "recheck_reason": "low_limit"}]	1
# Selective predicate -> range scan chosen on c_idx (QS_RANGE).
EXPLAIN ANALYZE
SELECT id FROM t1 WHERE c >= 30 ORDER BY DISTANCE(v, TO_VECTOR("[0, 0]"), "EUCLIDEAN") LIMIT 2;
EXPLAIN
-> Limit: 2 row(s)  (cost=3.3 rows=2) (actual time=X..Y rows=2 loops=1)
    -> Filter: (t1.c >= 30)  (cost=3.3 rows=8) (actual time=X..Y rows=2 loops=1)
        -> Vector index search on t1 using v (v = to_vector('[0, 0]'))  (cost=3.3 rows=10) (actual time=X..Y rows=4 loops=1)

