#
# Session A runs START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION for
# session B and then session C runs it for session A. C must get the read view
# and the binary log snapshot of B.
#
--source include/have_log_bin.inc
--source include/count_sessions.inc

CREATE TABLE t1 (id INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1);

--connect (con_b,localhost,root,,)
--let $b_id=`SELECT CONNECTION_ID()`
START TRANSACTION WITH CONSISTENT SNAPSHOT;
--let $b_file= query_get_value(SHOW SESSION STATUS LIKE 'Binlog_snapshot_file', Value, 1)
--let $b_pos= query_get_value(SHOW SESSION STATUS LIKE 'Binlog_snapshot_position', Value, 1)

--connection default
# Moves the binary log past the snapshot of B.
INSERT INTO t1 VALUES (2);

--connect (con_a,localhost,root,,)
--let $a_id=`SELECT CONNECTION_ID()`
--replace_regex /FROM SESSION [0-9]+/FROM SESSION B_ID/
--eval START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION $b_id

--connect (con_c,localhost,root,,)
--replace_regex /FROM SESSION [0-9]+/FROM SESSION A_ID/
--eval START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION $a_id
SELECT * FROM t1;
--let $c_file= query_get_value(SHOW SESSION STATUS LIKE 'Binlog_snapshot_file', Value, 1)
--let $c_pos= query_get_value(SHOW SESSION STATUS LIKE 'Binlog_snapshot_position', Value, 1)
--let $assert_text= C has the binary log snapshot of B
--let $assert_cond= "$c_file" = "$b_file" AND $c_pos = $b_pos
--source include/assert.inc
COMMIT;

--connection con_a
COMMIT;
--connection con_b
COMMIT;

--connection default
--disconnect con_a
--disconnect con_b
--disconnect con_c
DROP TABLE t1;
--source include/wait_until_count_sessions.inc
