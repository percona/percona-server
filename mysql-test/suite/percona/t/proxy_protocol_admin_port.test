# The box should support IPv4-mapped addresses
--source include/have_ipv4_mapped.inc
--source include/add_extra_root_users.inc
--source include/count_sessions.inc
--source include/suppress_tls_off.inc

--let $restart_parameters=restart: --skip-name-resolve --admin-address=::ffff:127.0.0.1 --admin_port=$MASTER_ADMINPORT --admin-tls-version= --proxy_protocol_networks=*
--replace_result $MASTER_ADMINPORT ADMIN_PORT
--source include/restart_mysqld.inc

--echo # An unproxied client connection should be accepted when connection to an extra_port if proxying enabled on the server
connect (conn1,"127.0.0.1",root,,,$MASTER_ADMINPORT,);
--connection conn1
SHOW GLOBAL STATUS LIKE 'Threads_connected';

--disconnect conn1
--connection default
--source include/remove_extra_root_users.inc
--source include/wait_until_count_sessions.inc
