CREATE TABLE au
(
    `id`         int NOT NULL AUTO_INCREMENT,
    `name`       varchar(255) DEFAULT NULL,
    `head`       int          DEFAULT NULL,
    `department` int          DEFAULT NULL,
    `comment`    text,
    PRIMARY KEY (`id`),
    KEY          `IX_au_head` (`head`),
    KEY          `IX_au_department` (`department`)
) ENGINE=InnoDB AUTO_INCREMENT=218 DEFAULT CHARSET=utf8mb3;

CREATE TABLE aau
(
    `id_admin` int NOT NULL,
    `id_unit`  int NOT NULL,
    UNIQUE KEY `UK_aau` (`id_admin`,`id_unit`),
    KEY        `IX_aau` (`id_unit`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;

CREATE TABLE a
(
    `id`          int          NOT NULL AUTO_INCREMENT,
    `name`        varchar(255) NOT NULL,
    `login`       varchar(255) NOT NULL,
    `deleted`     int          NOT NULL DEFAULT '0',
    `connect_tel` varchar(20)           DEFAULT NULL,
    `caption`     varchar(20)           DEFAULT NULL,
    PRIMARY KEY (`id`),
    UNIQUE KEY `login` (`login`),
    KEY        `UK_a` (`login`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;

CREATE TABLE aum
(
    `id_unit`    int NOT NULL,
    `id_manager` int NOT NULL,
    PRIMARY KEY (`id_unit`, `id_manager`),
    KEY          `UK_aum` (`id_manager`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;

