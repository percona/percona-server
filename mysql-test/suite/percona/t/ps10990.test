DELIMITER |;
CREATE PROCEDURE fail_test(IN arg_admin int, IN arg_param json)
BEGIN
    DECLARE var_full_access, var_b2b_status, var_is_head, var_deleted tinyint(4) default 0;
    SET var_full_access = COALESCE(JSON_EXTRACT(arg_param, '$.full_access'),0);
    SET var_deleted = COALESCE(JSON_EXTRACT(arg_param, '$.deleted'),1);

    SELECT 1 INTO var_is_head;
    IF var_is_head = 1 AND var_full_access = 0 THEN
      SELECT DISTINCT a.id, a.login, a.name, a.caption, a.connect_tel, a.deleted
      FROM au LEFT JOIN aau ON aau.id_unit = au.id
        LEFT JOIN a ON aau.id_admin = a.id
      WHERE (a.deleted = 0 OR var_deleted = 1)
        AND (au.head = arg_admin OR arg_admin IN
            (SELECT aum.id_manager FROM aum WHERE aum.id_unit = au.id));
    END IF;
END|

DELIMITER ;|

