--echo #
--echo # PS-11299: ALTER TABLE interactions with vector indexes.
--echo # Section A/B: column ops on tables that already have a vector index.
--echo # Section C: non-vector secondary index ADD/DROP alongside vector.
--echo # Section D: ADD INDEX after INSTANT column ADD (forces rebuild).
--echo # Section E: ADD INDEX after INSTANT column DROP (forces rebuild).
--echo # Section F: DROP vector index then INSTANT ADD COLUMN.
--echo #

--let $MYSQLD_DATADIR = `SELECT @@datadir`

--echo #
--echo # === Section A: ADD COLUMN on a table that already has a vector index
--echo #

CREATE TABLE ta1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v VECTOR(8) NOT NULL,
  KEY (v) TYPE hnsw WITH (M = 6)
);

--echo # A.1 ADD COLUMN ... ALGORITHM=INSTANT — blocked on vec-indexed tables
--echo # (parallel to FTS's ER_INNODB_FT_LIMIT). Enabling this needs a fix
--echo # in ha_innobase::build_template to skip HT_HIDDEN_SE cols when
--echo # computing the InnoDB→MySQL column map. Deferred to PS-11300.
--error ER_ALTER_OPERATION_NOT_SUPPORTED,ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE ta1 ADD COLUMN c1 INT, ALGORITHM=INSTANT;
--echo # Fallback: server-picked algorithm succeeds (INPLACE or COPY).
ALTER TABLE ta1 ADD COLUMN c1 INT;
SHOW CREATE TABLE ta1;

--echo # A.2 ADD COLUMN ... ALGORITHM=INPLACE — refused: any rebuild-class
--echo # INPLACE on a vec-indexed table is rejected (mirrors FTS's
--echo # ER_INNODB_FT_LIMIT policy — aux contents can't survive a native
--echo # rebuild). COPY is the supported route.
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE ta1 ADD COLUMN c2 INT, ALGORITHM=INPLACE;
--echo # Fallback: server-picked algorithm (COPY) succeeds.
ALTER TABLE ta1 ADD COLUMN c2 INT;
SHOW CREATE TABLE ta1;

--echo # A.3 ADD COLUMN ... ALGORITHM=COPY (full rebuild — aux .ibd gets a new id)
ALTER TABLE ta1 ADD COLUMN c3 INT, ALGORITHM=COPY;
SHOW CREATE TABLE ta1;
--replace_regex /percona_vec_hnsw_[0-9a-f]+_[0-9a-f]+\.ibd/percona_vec_hnsw_<TID>_<IID>.ibd/
--list_files $MYSQLD_DATADIR/test percona_vec_*.ibd

--echo # A.4 Default ADD COLUMN (server picks algorithm)
ALTER TABLE ta1 ADD COLUMN c4 INT;
SHOW CREATE TABLE ta1;

DROP TABLE ta1;

--echo #
--echo # === Section B: DROP COLUMN on a table with a vector index
--echo #

CREATE TABLE tb1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v VECTOR(8) NOT NULL,
  c1 INT, c2 INT, c3 INT,
  KEY (v) TYPE hnsw WITH (M = 6)
);

--echo # B.1 DROP COLUMN ... ALGORITHM=INSTANT — blocked (see A.1 note)
--error ER_ALTER_OPERATION_NOT_SUPPORTED,ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE tb1 DROP COLUMN c1, ALGORITHM=INSTANT;
--echo # Fallback: server-picked algorithm succeeds.
ALTER TABLE tb1 DROP COLUMN c1;

--echo # B.2 DROP COLUMN ... ALGORITHM=COPY
ALTER TABLE tb1 DROP COLUMN c2, ALGORITHM=COPY;
SHOW CREATE TABLE tb1;

DROP TABLE tb1;

--echo #
--echo # === Section C: ADD/DROP non-vector secondary index alongside vector
--echo #

CREATE TABLE tc1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v VECTOR(8) NOT NULL,
  c INT,
  KEY (v) TYPE hnsw WITH (M = 6)
);

--echo # C.1 ADD a non-vector secondary index
ALTER TABLE tc1 ADD INDEX ix_c (c);
SHOW INDEXES FROM tc1;

--echo # C.2 DROP that secondary index
ALTER TABLE tc1 DROP INDEX ix_c;
SHOW INDEXES FROM tc1;

DROP TABLE tc1;

--echo #
--echo # === Section D: ADD INDEX after INSTANT ADD COLUMN
--echo #
--echo # Until PS-11299's rebuild-forcing fix, this crashed at dict0dd.cc:2682
--echo # because percona_vec_aux_id was missing from the rebuilt dict_table_t while
--echo # the dd::Table carried it. ADD INDEX now forces a rebuild that
--echo # materializes percona_vec_aux_id on a fresh dict_table_t (current_row_version=0),
--echo # mirroring how ADD FULLTEXT forces a rebuild via add_fts_doc_id.

CREATE TABLE td1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v VECTOR(8) NOT NULL
);

--echo # D.1 INSTANT ADD COLUMN bumps current_row_version on the base table.
ALTER TABLE td1 ADD COLUMN c1 INT, ALGORITHM=INSTANT;
ALTER TABLE td1 ADD COLUMN c2 INT, ALGORITHM=INSTANT;

--echo # D.2 Adding the first vector index now succeeds — rebuild forced.
CREATE INDEX vix ON td1 (v) TYPE hnsw WITH (M = 6);
SHOW CREATE TABLE td1;
--replace_regex /percona_vec_hnsw_[0-9a-f]+_[0-9a-f]+\.ibd/percona_vec_hnsw_<TID>_<IID>.ibd/
--list_files $MYSQLD_DATADIR/test percona_vec_*.ibd

DROP TABLE td1;

--echo #
--echo # === Section E: ADD INDEX after INSTANT DROP COLUMN
--echo #

CREATE TABLE te1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v VECTOR(8) NOT NULL,
  c1 INT, c2 INT
);

ALTER TABLE te1 DROP COLUMN c1, ALGORITHM=INSTANT;
CREATE INDEX vix ON te1 (v) TYPE hnsw WITH (M = 6);
SHOW CREATE TABLE te1;
DROP TABLE te1;

--echo #
--echo # === Section F: DROP vector index then INSTANT ADD COLUMN
--echo #
--echo # The hidden percona_vec_aux_id column is retained across DROP of the last
--echo # vector index in the current implementation. Consequently INSTANT
--echo # ADD is still blocked here (the retained hidden col would sit
--echo # between user cols and the INSTANT-added tail column, tripping
--echo # the row0sel.ic:199 mismatch on subsequent SELECT). Once
--echo # PS-11300 either clears percona_vec_aux_id on last-DROP-INDEX or fixes
--echo # the SELECT column mapping, this section can flip to expect
--echo # success.

CREATE TABLE tf1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v VECTOR(8) NOT NULL,
  KEY (v) TYPE hnsw WITH (M = 6)
);
ALTER TABLE tf1 DROP KEY v;
--error ER_ALTER_OPERATION_NOT_SUPPORTED,ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE tf1 ADD COLUMN c1 INT, ALGORITHM=INSTANT;
--echo # Server-picked algorithm succeeds (rebuild).
ALTER TABLE tf1 ADD COLUMN c1 INT;
SHOW CREATE TABLE tf1;
DROP TABLE tf1;

--echo #
--echo # === Section G: native rebuild refused on vec-indexed tables ===
--echo # Mirrors FTS's ER_INNODB_FT_LIMIT policy: a native (INPLACE)
--echo # rebuild re-inserts every row under a new table_id/index_id, so
--echo # the vec aux table would be re-minted empty and the HNSW graph
--echo # lost. ALGORITHM=COPY rebuilds the aux organically via per-row
--echo # INSERT stamping.

CREATE TABLE tg1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v VECTOR(8) NOT NULL,
  KEY (v) TYPE hnsw WITH (M = 6)
);
INSERT INTO tg1 VALUES (1, STRING_TO_VECTOR('[1,1,1,1,1,1,1,1]'));

--echo # G.1 Explicit ALGORITHM=INPLACE rebuild: refused with the vector
--echo # reason (parallel to FTS's refusal on FTS-indexed tables).
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE tg1 FORCE, ALGORITHM=INPLACE;

--echo # G.2 Server-picked algorithm: silently falls back to COPY.
ALTER TABLE tg1 FORCE;

--echo # G.3 OPTIMIZE TABLE: same fallback, data survives, one aux .ibd.
OPTIMIZE TABLE tg1;
SELECT id, VECTOR_TO_STRING(v) FROM tg1 FORCE INDEX (PRIMARY);
--replace_regex /percona_vec_hnsw_[0-9a-f]+_[0-9a-f]+\.ibd/percona_vec_hnsw_<TID>_<IID>.ibd/
--list_files $MYSQLD_DATADIR/test percona_vec_*.ibd

--echo # G.4 First ADD INDEX is refused for INPLACE and falls back to
--echo # COPY: the hidden column must materialize, and the native rebuild
--echo # has no pass that builds the index contents. Every ADD after a
--echo # DROP is eligible for INPLACE, since the column is retained.
CREATE TABLE tg2 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(8) NOT NULL);
INSERT INTO tg2 VALUES (1, STRING_TO_VECTOR('[2,2,2,2,2,2,2,2]'));
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE tg2 ADD KEY vk (v) TYPE hnsw, ALGORITHM=INPLACE;
--echo # Server-picked algorithm succeeds via COPY.
ALTER TABLE tg2 ADD KEY vk (v) TYPE hnsw;
SELECT id, VECTOR_TO_STRING(v) FROM tg2 FORCE INDEX (PRIMARY);
--echo # And now the re-ADD may run INPLACE.
ALTER TABLE tg2 DROP KEY vk;
ALTER TABLE tg2 ADD KEY vk2 (v) TYPE hnsw, ALGORITHM=INPLACE;
SELECT id, VECTOR_TO_STRING(v) FROM tg2 FORCE INDEX (PRIMARY);

DROP TABLE tg1, tg2;

--echo # After all DROP TABLEs, no aux .ibd left over.
--list_files $MYSQLD_DATADIR/test percona_vec_*.ibd
