--source include/have_debug.inc
SET SESSION debug = '+d,skip_dd_table_access_check';

--echo #
--echo # PS-11299: a rebuild must leave the data dictionary and the
--echo # tablespace agreeing about the hidden percona_vec_aux_id column.
--echo #
--echo # The column exists exactly while a vector index does, in the
--echo # dictionary and in every row. If the two disagree - rows written with
--echo # a column the committed dictionary does not describe - the next
--echo # INSERT that splits a page asserts in btr_page_split_and_insert
--echo # (page_validate), and CHECK TABLE reports the B-tree corrupt.
--echo #

CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
                 pad CHAR(200) NOT NULL,
                 v VECTOR(4) NOT NULL,
                 VECTOR KEY vk (v) TYPE hnsw (M = 4));
--echo # Enough rows for several pages, so a later INSERT has to split one.
--disable_query_log
let $i = 1;
while ($i <= 300)
{
  eval INSERT INTO t1 VALUES ($i, REPEAT('x', 200),
                             STRING_TO_VECTOR(CONCAT('[', $i, ',0,0,0]')));
  inc $i;
}
--enable_query_log

--echo # With the index present, the DD carries the hidden column.
SELECT c.name AS dd_hidden_col FROM mysql.columns c
  JOIN mysql.tables t ON c.table_id = t.id
  WHERE t.name = 't1' AND c.name = 'percona_vec_aux_id';

--echo # Dropping the last vector index removes it: that DROP rebuilds the
--echo # table without the column.
ALTER TABLE t1 DROP KEY vk;
SELECT c.name AS dd_hidden_col FROM mysql.columns c
  JOIN mysql.tables t ON c.table_id = t.id
  WHERE t.name = 't1' AND c.name = 'percona_vec_aux_id';

--echo # Now the rebuild. No vector index remains, so the new definition has
--echo # no hidden column - and the dictionary must reach the same conclusion.
ALTER TABLE t1 FORCE, ALGORITHM=INPLACE;
SELECT c.name AS dd_hidden_col FROM mysql.columns c
  JOIN mysql.tables t ON c.table_id = t.id
  WHERE t.name = 't1' AND c.name = 'percona_vec_aux_id';

--echo # DML that splits pages.
INSERT INTO t1 VALUES (1001, REPEAT('y', 200), STRING_TO_VECTOR('[1,0,0,0]'));
UPDATE t1 SET pad = REPEAT('z', 200) WHERE id = 150;
DELETE FROM t1 WHERE id = 151;
SELECT COUNT(*) FROM t1;
CHECK TABLE t1;

--echo # And the same after a reload, which is where the mismatch showed up
--echo # as a corrupt B-tree.
--source include/restart_mysqld.inc
SET SESSION debug = '+d,skip_dd_table_access_check';
SELECT COUNT(*) FROM t1;
SELECT SUM(id) FROM t1;
CHECK TABLE t1;

--echo # OPTIMIZE takes the same path (recreate + analyze).
CREATE TABLE t2 (id BIGINT UNSIGNED PRIMARY KEY,
                 pad CHAR(200) NOT NULL,
                 v VECTOR(4) NOT NULL,
                 VECTOR KEY vk (v) TYPE hnsw (M = 4));
--disable_query_log
let $i = 1;
while ($i <= 300)
{
  eval INSERT INTO t2 VALUES ($i, REPEAT('x', 200),
                             STRING_TO_VECTOR(CONCAT('[', $i, ',0,0,0]')));
  inc $i;
}
--enable_query_log
ALTER TABLE t2 DROP KEY vk;
OPTIMIZE TABLE t2;
INSERT INTO t2 VALUES (1001, REPEAT('y', 200), STRING_TO_VECTOR('[7,7,7,7]'));
CHECK TABLE t2;
--source include/restart_mysqld.inc
CHECK TABLE t2;
SELECT COUNT(*) FROM t2;

--echo # Re-adding a vector index after all of the above adds the column back
--echo # and indexes every row that survived.
ALTER TABLE t2 ADD VECTOR KEY vk2 (v) TYPE hnsw (M = 4);
SET SESSION debug = '+d,skip_dd_table_access_check';
SELECT c.name AS dd_hidden_col FROM mysql.columns c
  JOIN mysql.tables t ON c.table_id = t.id
  WHERE t.name = 't2' AND c.name = 'percona_vec_aux_id';
--echo # A vector no other row carries, so the nearest is unambiguous - the
--echo # rows that survived the rebuild are searchable through the new index.
SELECT id FROM t2 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[7,7,7,7]'), 'EUCLIDEAN') LIMIT 1;
SET SESSION innodb_interpreter = 'vec_aux_verify test/t2';
SELECT @@session.innodb_interpreter_output;

DROP TABLE t1, t2;
