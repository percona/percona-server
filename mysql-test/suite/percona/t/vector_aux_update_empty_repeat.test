--source include/have_debug.inc

--echo #
--echo # PS-11300: repeat-empty update of a vector aux row's neighbors
--echo # field. vec_aux_update_row() (vec0dml.cc) builds the neighbors
--echo # update field via a non-null placeholder when the new neighbor
--echo # list is empty, mirroring vec_aux_set_field's insert-path guard.
--echo # Updating an already-empty neighbors field to empty again keeps
--echo # the on-disk field size unchanged (0 -> 0), so InnoDB takes the
--echo # in-place update path (row_upd_rec_in_place -> rec_set_nth_field
--echo # -> rec_set_nth_field_low); this must succeed cleanly.
--echo #
--echo # (Without the placeholder, that path fed a null data pointer
--echo # into rec_set_nth_field_low's memcpy -- undefined behaviour
--echo # regardless of length -- which a debug assertion in that
--echo # function now turns into an immediate crash if this regresses.)
--echo #

CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
                 v VECTOR(4) NOT NULL,
                 KEY (v) TYPE hnsw WITH (M = 4));

--echo # Insert a graph row with an empty neighbor list.
SET SESSION innodb_interpreter = 'vec_aux_insert_row test/t1 1 0 1.0,0.0,0.0,0.0 -';
SELECT @@session.innodb_interpreter_output;

--echo # Update the same row's neighbors to empty again: old and new
--echo # on-disk length are both 0 -> in-place update path. Must
--echo # succeed, not crash.
SET SESSION innodb_interpreter = 'vec_aux_update_row test/t1 1 -';
SELECT @@session.innodb_interpreter_output;

--echo # Row is unchanged: still present, still an empty neighbor list.
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;

--echo # Repeat once more -- repeated no-op updates must stay stable.
SET SESSION innodb_interpreter = 'vec_aux_update_row test/t1 1 -';
SELECT @@session.innodb_interpreter_output;
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;

DROP TABLE t1;
