--source include/have_debug.inc

--echo #
--echo # PS-11300: the hidden percona_vec_aux_id counter is persisted
--echo # autoinc-style (PM_TABLE_VEC_IDX_ID dynamic metadata, redo-logged at
--echo # assignment), so a label is NEVER reissued — not across restart, not
--echo # across crash.
--echo #
--echo # Tested through the assignment path rather than by reading the aux
--echo # maximum back. That matters: ids can be consumed WITHOUT ever
--echo # reaching the aux table — a rolled-back INSERT burns one — so the aux
--echo # maximum is not the source of truth, and a test that read it would
--echo # pass even with the counter reset on restart.
--echo #

CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
                 v VECTOR(2) NOT NULL,
                 KEY (v) TYPE hnsw WITH (M = 4));

--echo # Three labels. First must be 1: 0 is reserved as the graph's
--echo # empty-slot sentinel, which is what lets aux record 0 hold the
--echo # entry point instead of a node.
SET SESSION innodb_interpreter = 'vec_next_id test/t1';
SELECT @@session.innodb_interpreter_output;
SET SESSION innodb_interpreter = 'vec_next_id test/t1';
SELECT @@session.innodb_interpreter_output;
SET SESSION innodb_interpreter = 'vec_next_id test/t1';
SELECT @@session.innodb_interpreter_output;

--echo # Restart. The counter must resume past 3, not from 0.
--source include/restart_mysqld.inc

SET SESSION innodb_interpreter = 'vec_next_id test/t1';
SELECT @@session.innodb_interpreter_output;

--echo # A second restart with no assignment in between must not lose it.
--source include/restart_mysqld.inc

SET SESSION innodb_interpreter = 'vec_next_id test/t1';
SELECT @@session.innodb_interpreter_output;

--echo # A different table has its own counter, starting at 1 again.
CREATE TABLE t2 (id BIGINT UNSIGNED PRIMARY KEY,
                 v VECTOR(2) NOT NULL,
                 KEY (v) TYPE hnsw WITH (M = 4));
SET SESSION innodb_interpreter = 'vec_next_id test/t2';
SELECT @@session.innodb_interpreter_output;

DROP TABLE t1, t2;
