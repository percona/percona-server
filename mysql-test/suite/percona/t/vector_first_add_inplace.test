--source include/have_debug.inc
--echo #
--echo # The first vector index on a table is added in place.
--echo #
--echo # It needs the hidden label column on every row, which used to mean
--echo # COPY only. It now rebuilds in place: ddl::Builder writes the column
--echo # on each copied row with a fresh label, and the vector index is built
--echo # from the same scan with those labels as node ids.
--echo #

CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL);
--echo # N_COLS counts InnoDB's own columns too: id, v and three system
--echo # columns make 5; the hidden label column makes 6.

--echo # Many leaf pages, so the rebuild copies a real tree.
SET @@global.innodb_limit_optimistic_insert_debug = 2;
--disable_query_log
SET SESSION cte_max_recursion_depth = 5000;
INSERT INTO t1
WITH RECURSIVE seq(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n < 1000)
SELECT n, STRING_TO_VECTOR(CONCAT('[', n, ',0,0,0]')) FROM seq;
--enable_query_log
SET @@global.innodb_limit_optimistic_insert_debug = 0;

SELECT n_cols FROM information_schema.innodb_tables WHERE name = 'test/t1';

--echo # A rebuild that keeps the primary key reads the rows in key order on
--echo # one scan thread, so this labels them 1..1000 in that order.
ALTER TABLE t1 ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ALGORITHM=INPLACE;

SELECT n_cols FROM information_schema.innodb_tables WHERE name = 'test/t1';

--echo # One node per row, each under its own label, labels 1..1000.
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;

--echo # The index answers the same as the exact scan.
SELECT id FROM t1
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[500.2,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
SELECT id FROM t1 IGNORE INDEX (vk)
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[500.2,0,0,0]'), 'EUCLIDEAN') LIMIT 3;

--echo # The counter carries on from the rebuild: new rows get 1001 onwards,
--echo # before and after a restart.
INSERT INTO t1 VALUES (1001, STRING_TO_VECTOR('[1001,0,0,0]'));
--source include/restart_mysqld.inc
INSERT INTO t1 VALUES (1002, STRING_TO_VECTOR('[1002,0,0,0]'));
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;
SELECT id FROM t1
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1002,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
DROP TABLE t1;

--echo # A table with a FULLTEXT index cannot be rebuilt in place, so there the
--echo # first vector index still needs COPY.
CREATE TABLE t2 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
                 d VARCHAR(20), FULLTEXT KEY fd (d));
INSERT INTO t2 VALUES (1, STRING_TO_VECTOR('[1,0,0,0]'), 'a');
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE t2 ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ALGORITHM=INPLACE;
ALTER TABLE t2 ADD VECTOR KEY vk (v) TYPE hnsw (M = 8);
SELECT id FROM t2
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
DROP TABLE t2;

--echo # Dropping and re-adding the vector index in one statement keeps the
--echo # column, so every row keeps its label and the new graph is built under
--echo # those labels. Row 3's vector is updated first, which moves it to label
--echo # 6: a relabelling would give 1..5 again, a reuse keeps 1,2,4,5,6.
CREATE TABLE t3 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
                 VECTOR KEY vk (v) TYPE hnsw (M = 8));
INSERT INTO t3 VALUES (1, STRING_TO_VECTOR('[1,0,0,0]')),
                      (2, STRING_TO_VECTOR('[2,0,0,0]')),
                      (3, STRING_TO_VECTOR('[3,0,0,0]')),
                      (4, STRING_TO_VECTOR('[4,0,0,0]')),
                      (5, STRING_TO_VECTOR('[5,0,0,0]'));
UPDATE t3 SET v = STRING_TO_VECTOR('[30,0,0,0]') WHERE id = 3;

let $dump = SET SESSION innodb_interpreter = 'vec_aux_dump test/t3';
--echo # Without a rebuild.
ALTER TABLE t3 DROP KEY vk, ADD VECTOR KEY vk2 (v) TYPE hnsw (M = 8),
  ALGORITHM=INPLACE;
eval $dump;
--replace_regex /id=0 level=[0-9]+ base_pk=[0-9]+/id=0 level=# base_pk=#/ /level=[0-9]+/level=#/ /nb=[0-9,]*/nb=#/
SELECT @@session.innodb_interpreter_output;

--echo # With a rebuild: the labels are copied, not reassigned, and the
--echo # counter carries on - the new row gets 7.
ALTER TABLE t3 DROP KEY vk2, ADD VECTOR KEY vk3 (v) TYPE hnsw (M = 8),
  ADD COLUMN c INT, ALGORITHM=INPLACE;
INSERT INTO t3 (id, v) VALUES (6, STRING_TO_VECTOR('[6,0,0,0]'));
eval $dump;
--replace_regex /id=0 level=[0-9]+ base_pk=[0-9]+/id=0 level=# base_pk=#/ /level=[0-9]+/level=#/ /nb=[0-9,]*/nb=#/
SELECT @@session.innodb_interpreter_output;
SELECT id FROM t3
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[30,0,0,0]'), 'EUCLIDEAN') LIMIT 1;

--echo # COPY writes every row through write_row, which labels afresh: 1..6.
ALTER TABLE t3 DROP KEY vk3, ADD VECTOR KEY vk4 (v) TYPE hnsw (M = 8),
  ALGORITHM=COPY;
eval $dump;
--replace_regex /id=0 level=[0-9]+ base_pk=[0-9]+/id=0 level=# base_pk=#/ /level=[0-9]+/level=#/ /nb=[0-9,]*/nb=#/
SELECT @@session.innodb_interpreter_output;
DROP TABLE t3;

--echo #
--echo # The first ADD together with other column and index changes. Adding
--echo # an index is never INSTANT, so each is the first ADD's rebuild with
--echo # the other changes applied to the same copy.
--echo #

--echo # A virtual column and an index on it, with the first vector index.
CREATE TABLE t4 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL, c INT);
INSERT INTO t4 VALUES (1, STRING_TO_VECTOR('[1,0,0,0]'), 10),
                      (2, STRING_TO_VECTOR('[2,0,0,0]'), 20),
                      (3, STRING_TO_VECTOR('[3,0,0,0]'), 30);
ALTER TABLE t4 ADD COLUMN g INT GENERATED ALWAYS AS (c + 1) VIRTUAL,
  ADD KEY kg (g), ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ALGORITHM=INPLACE;
SET SESSION innodb_interpreter = 'vec_aux_verify test/t4';
SELECT @@session.innodb_interpreter_output;
SELECT id, g FROM t4 WHERE g > 15 ORDER BY id;
SELECT id FROM t4
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
CHECK TABLE t4;

--echo # Dropping a virtual column and a stored one, with the first vector
--echo # index.
CREATE TABLE t5 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL, c INT,
                 e INT, g INT GENERATED ALWAYS AS (c + 1) VIRTUAL);
INSERT INTO t5 (id, v, c, e) VALUES (1, STRING_TO_VECTOR('[1,0,0,0]'), 10, 1),
                                    (2, STRING_TO_VECTOR('[2,0,0,0]'), 20, 2);
ALTER TABLE t5 DROP COLUMN g, DROP COLUMN e,
  ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ALGORITHM=INPLACE;
SET SESSION innodb_interpreter = 'vec_aux_verify test/t5';
SELECT @@session.innodb_interpreter_output;
SELECT id, c FROM t5 ORDER BY id;
CHECK TABLE t5;

--echo # The vector column itself added in the same statement as its index.
CREATE TABLE t6 (id BIGINT UNSIGNED PRIMARY KEY, c INT);
INSERT INTO t6 VALUES (1, 10), (2, 20);
ALTER TABLE t6 ADD COLUMN v VECTOR(4),
  ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ALGORITHM=INPLACE;
UPDATE t6 SET v = STRING_TO_VECTOR('[1,0,0,0]') WHERE id = 1;
SET SESSION innodb_interpreter = 'vec_aux_verify test/t6';
SELECT @@session.innodb_interpreter_output;
CHECK TABLE t6;

--echo # Every table reopens with the definition it was left with.
--source include/restart_mysqld.inc
CHECK TABLE t4, t5, t6;
SELECT id FROM t4
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
DROP TABLE t4, t5, t6;
