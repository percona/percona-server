--echo #
--echo # PS-11300: a vector-indexed child table may not carry a CASCADE
--echo # referential action.
--echo #
--echo # Cascaded DML runs inside the engine through the row0ins FK cascade
--echo # nodes and never reaches the handler hooks that maintain the vector
--echo # index. ON DELETE CASCADE is in fact harmless here — DELETE writes
--echo # nothing to the aux table by design — but ON UPDATE CASCADE on a
--echo # column that is part of the child PK leaves the aux row pointing at
--echo # the old key, and the row drops out of kNN results. Both are refused
--echo # for now; see the comment in mysql_prepare_create_table.
--echo #

CREATE TABLE parent (id BIGINT UNSIGNED PRIMARY KEY);

--echo # CREATE with ON DELETE CASCADE — refused.
--error ER_NOT_SUPPORTED_YET
CREATE TABLE child (
  id BIGINT UNSIGNED PRIMARY KEY,
  v VECTOR(8) NOT NULL,
  pid BIGINT UNSIGNED,
  KEY (v) TYPE hnsw,
  FOREIGN KEY (pid) REFERENCES parent(id) ON DELETE CASCADE
);

--echo # CREATE with ON UPDATE CASCADE — refused.
--error ER_NOT_SUPPORTED_YET
CREATE TABLE child (
  id BIGINT UNSIGNED PRIMARY KEY,
  v VECTOR(8) NOT NULL,
  pid BIGINT UNSIGNED,
  KEY (v) TYPE hnsw,
  FOREIGN KEY (pid) REFERENCES parent(id) ON UPDATE CASCADE
);

--echo # Adding a CASCADE FK to an existing vector-indexed table — refused.
CREATE TABLE child (
  id BIGINT UNSIGNED PRIMARY KEY,
  v VECTOR(8) NOT NULL,
  pid BIGINT UNSIGNED,
  KEY (v) TYPE hnsw
);
--error ER_NOT_SUPPORTED_YET
ALTER TABLE child ADD FOREIGN KEY (pid) REFERENCES parent(id) ON DELETE CASCADE;
DROP TABLE child;

--echo # Adding a vector index to a table that already has a CASCADE FK —
--echo # refused through the same site, via existing_fks.
CREATE TABLE child (
  id BIGINT UNSIGNED PRIMARY KEY,
  v VECTOR(8) NOT NULL,
  pid BIGINT UNSIGNED,
  FOREIGN KEY (pid) REFERENCES parent(id) ON DELETE CASCADE
);
--error ER_NOT_SUPPORTED_YET
ALTER TABLE child ADD KEY (v) TYPE hnsw;
DROP TABLE child;

--echo # RESTRICT / NO ACTION / SET NULL stay allowed: they either refuse the
--echo # parent DML or null a non-PK column, so no vector maintenance is owed.
CREATE TABLE child (
  id BIGINT UNSIGNED PRIMARY KEY,
  v VECTOR(8) NOT NULL,
  pid BIGINT UNSIGNED,
  KEY (v) TYPE hnsw,
  FOREIGN KEY (pid) REFERENCES parent(id) ON DELETE SET NULL
);
INSERT INTO parent VALUES (1);
INSERT INTO child VALUES (1, STRING_TO_VECTOR('[1,1,1,1,1,1,1,1]'), 1);
DELETE FROM parent WHERE id = 1;
--echo # Child row survives with pid NULL; nothing about the vector changed.
SELECT id, pid, VECTOR_TO_STRING(v) FROM child;
DROP TABLE child;

DROP TABLE parent;
