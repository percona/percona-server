--echo #
--echo # PS-11264: Vector index support in Data Dictionary
--echo # PS-11203: Vector Index Syntax
--echo #

--echo #
--echo # Legacy Syntax: keyword used a identifier
--echo #
CREATE TABLE vector ( a INTEGER );
SHOW CREATE TABLE vector;

CREATE TABLE t1 ( vector VECTOR ( 1 ) );
SHOW CREATE TABLE t1;

CREATE TABLE t2 ( a INTEGER, INDEX vector ( a ) );
SHOW CREATE TABLE t2;

DROP TABLE vector, t1, t2;


--echo #
--echo # New Syntax
--echo #

--error ER_INDEX_MUST_HAVE_COMPATIBLE_COLUMN
CREATE TABLE t1 (
  v1 VECTOR( 1234 ),
  KEY( v1 ) TYPE hnsw WITH ( M = 6 )
);

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t1 (
  v1 VECTOR( 1234 ) NOT NULL,
  KEY( v1 ) TYPE hnsw WITH ( M = 6 )
);

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t1 (
  id BIGINT PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  KEY( v1 ) TYPE hnsw WITH ( M = 6 )
);

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t1 (
  id INT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  KEY( v1 ) TYPE hnsw WITH ( M = 6 )
);

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t1 (
  id1 BIGINT UNSIGNED,
  id2 BIGINT UNSIGNED,
  v1 VECTOR( 1234 ) NOT NULL,
  PRIMARY KEY (id1, id2),
  KEY( v1 ) TYPE hnsw
);

--error ER_TABLE_CANT_HANDLE_INDEX
CREATE TABLE t1 (
  id INT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  KEY( v1 ) TYPE hnsw WITH ( M = 6 )
) ENGINE = memory;

CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  KEY( v1 ) TYPE hnsw
);
SHOW CREATE TABLE t1;
SHOW INDEXES FROM t1;
SHOW INDEXES FROM t1 WHERE Index_type = 'VECTOR';

CREATE TABLE t2 (
  id BIGINT UNSIGNED UNIQUE NOT NULL,
  v1 VECTOR( 1234 ) NOT NULL,
  KEY( v1 ) TYPE hnsw
);
SHOW CREATE TABLE t2;
SHOW INDEXES FROM t2;
SHOW INDEXES FROM t2 WHERE Index_type = 'VECTOR';

SET sql_mode='ANSI';
SHOW CREATE TABLE t1;
SET sql_mode=default;

--error ER_NOT_SUPPORTED_YET
ALTER TABLE t1 DROP PRIMARY KEY;

--error ER_NOT_SUPPORTED_YET
ALTER TABLE t1 CHANGE id id INT UNSIGNED;

--error ER_NOT_SUPPORTED_YET
ALTER TABLE t1 CHANGE id id BIGINT;

--error ER_TOO_MANY_KEY_PARTS
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  v2 VECTOR( 1234 ) NOT NULL,
  INDEX ( v1, v2 ) TYPE hnsw
);

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  v2 VECTOR( 1234 ) NOT NULL,
  INDEX ( v1 ) TYPE hnsw,
  INDEX ( v2 ) TYPE hnsw
);

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  v2 VECTOR( 1234 ) NOT NULL,
  INDEX ( v1 ) TYPE hnsw,
  INDEX ( v1 ) TYPE hnsw
);

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  INDEX ( v1 ) TYPE hnsw INVISIBLE
);

CREATE TABLE t3 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  INDEX ( v1 ) TYPE hnsw
);

--error ER_NOT_SUPPORTED_YET
ALTER TABLE t3 ALTER INDEX v1 INVISIBLE;

--error ER_WRONG_SUB_KEY
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  INDEX ( v1( 1 ) ) TYPE hnsw
);

CREATE FUNCTION foo( v VECTOR ) RETURNS VECTOR DETERMINISTIC
RETURN to_vector('[1]');

--error ER_FUNCTIONAL_INDEX_FUNCTION_IS_NOT_ALLOWED
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR(1) NOT NULL,
  INDEX (( foo ( v1 ) ))
);

DROP FUNCTION foo;

--error ER_NON_SCALAR_USED_AS_KEY
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR(1) UNIQUE,
  INDEX ( v1 ) TYPE hnsw
);

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR(1) NOT NULL,
  INDEX ( v1 ) TYPE hnsw KEY_BLOCK_SIZE 1
);

--error ER_NON_SCALAR_USED_AS_KEY
ALTER TABLE t1 ADD INDEX v2 (v1);
--error ER_NON_SCALAR_USED_AS_KEY
ALTER TABLE t1 ADD INDEX v2 (v1(1));
--error ER_NON_SCALAR_USED_AS_KEY
ALTER TABLE t1 ADD UNIQUE (v1);
--error ER_NON_SCALAR_USED_AS_KEY
ALTER TABLE t1 ADD UNIQUE (v1(1));
--error ER_NOT_SUPPORTED_YET
ALTER TABLE t1 ADD INDEX v2 (v1) TYPE hnsw;

SHOW CREATE TABLE t1;

ALTER TABLE t1 DROP INDEX v1;
SHOW CREATE TABLE t1;
SHOW INDEXES FROM t1;

DROP TABLE t1, t2, t3;


CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 8 ) NOT NULL
);
SHOW CREATE TABLE t1;
SHOW INDEXES FROM t1;

--error ER_NON_SCALAR_USED_AS_KEY
ALTER TABLE t1 ADD INDEX ix (v1);

SHOW CREATE TABLE t1;
SHOW INDEXES FROM t1;

ALTER TABLE t1 ADD INDEX vx (v1) TYPE hnsw;

SHOW CREATE TABLE t1;
SHOW INDEXES FROM t1;

DROP TABLE t1;

--error ER_PARSE_ERROR
CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  KEY( v1 ) TYPE hnsw COMMENT 'abc' WITH ( M = 6 )
);


CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  KEY( v1 ) TYPE hnsw WITH ( M = 6 ) COMMENT 'abc'
);
SHOW CREATE TABLE t1;
SHOW INDEXES FROM t1;

DROP TABLE t1;


CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL
);
SHOW CREATE TABLE t1;
SHOW INDEXES FROM t1;

--error ER_PARSE_ERROR
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  KEY ( v1 ) TYPE hnsw WITH ()
);

--error ER_PARSE_ERROR
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  KEY ( v1 ) TYPE hnsw WITH ( M = 6.0 )
);

--error ER_PARSE_ERROR
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  KEY ( v1 ) TYPE hnsw WITH ( M = "6" )
);

--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  KEY ( v1 ) TYPE hnsw WITH ( `M = 1` = 1 )
);

--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  KEY ( v1 ) TYPE hnsw WITH ( bogus = 1 )
);

--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER_VALUE
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  KEY ( v1 ) TYPE hnsw WITH ( metric = nosuchmetric )
);

--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER_VALUE
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  KEY ( v1 ) TYPE hnsw WITH ( M = abc )
);

--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER_VALUE
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  KEY ( v1 ) TYPE hnsw WITH ( M = `M = 1`)
);

--error ER_PARSE_ERROR
CREATE INDEX ix ON t1(v1) TYPE Hnsw WITH ();
--error ER_PARSE_ERROR
CREATE INDEX ix ON t1(v1) TYPE Hnsw WITH ( M = 6.0 );
--error ER_PARSE_ERROR
CREATE INDEX ix ON t1(v1) TYPE Hnsw WITH ( M = "6" );

--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER
CREATE INDEX ix ON t1(v1) TYPE Hnsw WITH ( `M = 1` = 1 );
--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER
CREATE INDEX ix ON t1(v1) TYPE Hnsw WITH ( bogus = 1 );

--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER_VALUE
CREATE INDEX ix ON t1(v1) TYPE Hnsw WITH ( metric = nosuchmetric );
--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER_VALUE
CREATE INDEX ix ON t1(v1) TYPE Hnsw WITH ( M = abc );
--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER_VALUE
CREATE INDEX ix ON t1(v1) TYPE Hnsw WITH ( M = `M = 1` );

--error ER_INDEX_TYPE_NOT_SUPPORTED
CREATE INDEX ix ON t1(v1) TYPE no_such_type;
--error ER_NON_SCALAR_USED_AS_KEY
CREATE INDEX ix ON t1(v1);
--error ER_NON_SCALAR_USED_AS_KEY
CREATE INDEX ix ON t1(v1(1));

CREATE INDEX ix ON t1(v1) TYPE Hnsw WITH ( m = 6 );
SHOW INDEXES FROM t1;
SHOW CREATE TABLE t1;

--error ER_NOT_SUPPORTED_YET
ALTER TABLE t1 DROP PRIMARY KEY;

ALTER TABLE t1 DROP INDEX ix;
SHOW CREATE TABLE t1;
SHOW INDEXES FROM t1;

CREATE INDEX ix ON t1(v1) TYPE Hnsw WITH ( m = 6, metric = Euclidean );
SHOW INDEXES FROM t1;
SHOW CREATE TABLE t1;
ALTER TABLE t1 DROP INDEX ix;

CREATE INDEX ix ON t1(v1) TYPE Hnsw WITH ( metric = Euclidean, m = 6 );
SHOW INDEXES FROM t1;
SHOW CREATE TABLE t1;
ALTER TABLE t1 DROP INDEX ix;


ALTER TABLE t1 DROP PRIMARY KEY;
SHOW CREATE TABLE t1;
SHOW INDEXES FROM t1;

DROP TABLE t1;


--error ER_NON_SCALAR_USED_AS_KEY
CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  KEY( v1 )
);

--error ER_NON_SCALAR_USED_AS_KEY
CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  KEY( v1 ) USING btree
);

--error ER_NON_SCALAR_USED_AS_KEY
CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  KEY( v1 ) USING rtree
);

--error ER_NON_SCALAR_USED_AS_KEY
CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  KEY( v1 ) USING hash
);

--error ER_INDEX_MUST_HAVE_COMPATIBLE_COLUMN
CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  c INT,
  KEY (c) TYPE hnsw
);

CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  v2 VECTOR( 1234 )
);

--error ER_TOO_MANY_KEY_PARTS
CREATE INDEX ix ON t1( v1, v2 ) TYPE hnsw;

DROP TABLE t1;


CREATE TABLE t1 (
  id BIGINT UNSIGNED NOT NULL,
  v1 VECTOR(8) NOT NULL,
  UNIQUE KEY u_id (id),
  KEY (v1) TYPE hnsw
);
SHOW CREATE TABLE t1;
SHOW INDEXES FROM t1;

DROP TABLE t1;

CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 8 ) NOT NULL,
  KEY( v1 ) TYPE hnsw WITH ( M = 6, metric = euclidean )
);
SHOW CREATE TABLE t1;
# Unrelated ALTER
ALTER TABLE t1 ADD COLUMN c INT;
SHOW CREATE TABLE t1;


DROP TABLE t1;

--error ER_NOT_SUPPORTED_YET
CREATE TEMPORARY TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  INDEX ( v1 ) TYPE hnsw
);

CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1 ) NOT NULL
) PARTITION BY KEY (id) PARTITIONS 1;

--error ER_NOT_SUPPORTED_YET
ALTER TABLE t1 ADD INDEX v1 ( v1 ) TYPE hnsw;

DROP TABLE t1;

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1 ) NOT NULL,
  INDEX ( v1 ) TYPE hnsw
) PARTITION BY KEY (id) PARTITIONS 1;

--error ER_UNSUPPORTED_ACTION_ON_GENERATED_COLUMN
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1 ) GENERATED ALWAYS AS (to_vector('[1]')) VIRTUAL NOT NULL,
  INDEX ( v1 ) TYPE hnsw
);

CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1 ) GENERATED ALWAYS AS (to_vector('[1]')) STORED NOT NULL,
  INDEX ( v1 ) TYPE hnsw
);

SHOW CREATE TABLE t1;
SHOW KEYS FROM t1;

DROP TABLE t1;

CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  KEY( v1 ) TYPE hnsw WITH ( metric = euclidean )
);
SHOW CREATE TABLE t1;

CREATE TABLE t2 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  KEY( v1 ) TYPE hnsw WITH ( metric = euclidean_squared )
);
SHOW CREATE TABLE t2;

CREATE TABLE t3 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  KEY( v1 ) TYPE hnsw WITH ( metric = cosine )
);
SHOW CREATE TABLE t3;

CREATE TABLE t4 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  KEY( v1 ) TYPE hnsw WITH ( metric = dot )
);
SHOW CREATE TABLE t4;

CREATE TABLE t5 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR( 1234 ) NOT NULL,
  KEY( v1 ) TYPE hnsw WITH ( metric = manhattan )
);
SHOW CREATE TABLE t5;


DROP TABLE t1, t2, t3, t4, t5;
