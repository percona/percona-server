--echo #
--echo # PS-11264: Vector Index support in Data Dictionary
--echo # PS-11203: Vector Index Syntax
--echo #

--echo #
--echo # Legacy Syntax: keyword used a identifier
--echo #
CREATE TABLE vector ( a INTEGER );
SHOW CREATE TABLE vector;
DROP TABLE vector;

CREATE TABLE t1 ( vector INT );
SHOW CREATE TABLE t1;

CREATE TABLE t2 ( a INT, INDEX vector ( a ) );
SHOW CREATE TABLE t2;

CREATE TABLE t3 ( a INT );

CREATE INDEX vector ON t3(a);
SHOW CREATE TABLE t3;

CREATE TABLE t4 ( a INT );
ALTER TABLE t4 ADD vector INT;
SHOW CREATE TABLE t4;

CREATE TABLE t5 ( a INT );
ALTER TABLE t5 ADD COLUMN vector INT;
SHOW CREATE TABLE t5;

CREATE TABLE t6 ( a INT );
ALTER TABLE t6 ADD (vector INT);
SHOW CREATE TABLE t6;

CREATE TABLE t7 ( a INT );
ALTER TABLE t7 ADD INDEX vector (a);
SHOW CREATE TABLE t7;

CREATE TABLE t8 ( a INT, vector INT );
ALTER TABLE t8 CHANGE vector b INT;
SHOW CREATE TABLE t8;
ALTER TABLE t8 CHANGE b vector INT;
SHOW CREATE TABLE t8;
ALTER TABLE t8 CHANGE COLUMN vector b INT;
SHOW CREATE TABLE t8;
ALTER TABLE t8 CHANGE COLUMN b vector INT;
SHOW CREATE TABLE t8;

CREATE TABLE t9 ( a INT, vector INT );
ALTER TABLE t9 MODIFY vector INT FIRST;
ALTER TABLE t9 MODIFY COLUMN vector INT AFTER a;
SHOW CREATE TABLE t9;

CREATE TABLE t10 ( a INT, vector INT );
ALTER TABLE t10 DROP COLUMN vector;
SHOW CREATE TABLE t10;

CREATE TABLE t11 ( a INT, vector INT );
ALTER TABLE t11 DROP vector;
SHOW CREATE TABLE t11;

CREATE TABLE t12 ( vector VECTOR ( 1 ) );
SHOW CREATE TABLE t12;

CREATE TABLE t13 ( a INT );
ALTER TABLE t13 ADD vector VECTOR ( 2 );
SHOW CREATE TABLE t13;

CREATE TABLE t14 ( a INT );
ALTER TABLE t14 ADD COLUMN vector VECTOR ( 3 );
SHOW CREATE TABLE t14;

CREATE TABLE vector (
  id BIGINT UNSIGNED PRIMARY KEY,
  vector VECTOR ( 1234 ) NOT NULL,
  VECTOR KEY vector ( vector ) TYPE hnsw
);

CREATE ROLE vector;

DELIMITER //;
CREATE PROCEDURE p1() BEGIN DECLARE vector INT; SET vector = 1; END//
CREATE PROCEDURE p2() BEGIN vector: LOOP LEAVE vector; END LOOP vector; END//
DELIMITER ;//

SET @vector = 1;

DROP PROCEDURE p1;
DROP PROCEDURE p2;
DROP ROLE vector;
DROP TABLE vector, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11, t12, t13, t14;

--echo #
--echo # New Syntax
--echo #

--error ER_PARSE_ERROR
CREATE TABLE t (
  v1 VECTOR ( 1234 ),
  VECTOR KEY ( v1 ) TYPE hnsw TYPE HNSW
);

--error ER_PARSE_ERROR
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR ( v1 ) TYPE hnsw
);

--error ER_PARSE_ERROR
CREATE VECTOR INDEX ix ON t1(v1) TYPE hnsw TYPE hnsw;

--error ER_PARSE_ERROR
ALTER TABLE t ADD VECTOR INDEX v1 (v1) TYPE hnsw TYPE hnsw;

--error ER_INDEX_MUST_HAVE_COMPATIBLE_COLUMN
CREATE TABLE t1 (
  v1 VECTOR ( 1234 ),
  VECTOR KEY ( v1 ) TYPE hnsw ( M = 6 )
);

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t1 (
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw ( M = 6 )
);

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t1 (
  id BIGINT PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw ( M = 6 )
);

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t1 (
  id INT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw ( M = 6 )
);

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t1 (
  id1 BIGINT UNSIGNED,
  id2 BIGINT UNSIGNED,
  v1 VECTOR ( 1234 ) NOT NULL,
  PRIMARY KEY (id1, id2),
  VECTOR KEY ( v1 ) TYPE hnsw
);

--error ER_TABLE_CANT_HANDLE_INDEX
CREATE TABLE t1 (
  id INT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw ( M = 6 )
) ENGINE = memory;

CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw
);
SHOW CREATE TABLE t1;
SHOW INDEXES FROM t1;
SHOW INDEXES FROM t1 WHERE Index_type = 'VECTOR';

DROP TABLE t1;

CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR KEY ( v1 ) USING hnsw ( M = 6 )
);
SHOW CREATE TABLE t1;
SHOW INDEXES FROM t1;
SHOW INDEXES FROM t1 WHERE Index_type = 'VECTOR';


CREATE TABLE t2 (
  id BIGINT UNSIGNED UNIQUE NOT NULL,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw
);
SHOW CREATE TABLE t2;
SHOW INDEXES FROM t2;
SHOW INDEXES FROM t2 WHERE Index_type = 'VECTOR';

SET sql_mode='ANSI';
SHOW CREATE TABLE t1;
SET sql_mode=default;

--error ER_NOT_SUPPORTED_YET
ALTER TABLE t1 DROP PRIMARY KEY;

--error ER_NOT_SUPPORTED_YET
ALTER TABLE t1 CHANGE id id INT UNSIGNED;

--error ER_NOT_SUPPORTED_YET
ALTER TABLE t1 CHANGE id id BIGINT;

--error ER_TOO_MANY_KEY_PARTS
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  v2 VECTOR ( 1234 ) NOT NULL,
  VECTOR INDEX ( v1, v2 ) TYPE hnsw
);

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  v2 VECTOR ( 1234 ) NOT NULL,
  VECTOR INDEX ( v1 ) TYPE hnsw,
  VECTOR INDEX ( v2 ) TYPE hnsw
);

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  v2 VECTOR ( 1234 ) NOT NULL,
  VECTOR INDEX ( v1 ) TYPE hnsw,
  VECTOR INDEX ( v1 ) TYPE hnsw
);

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR INDEX ( v1 ) TYPE hnsw INVISIBLE
);

CREATE TABLE t3 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR INDEX ( v1 ) TYPE hnsw
);

--error ER_NOT_SUPPORTED_YET
ALTER TABLE t3 ALTER INDEX v1 INVISIBLE;

--error ER_WRONG_SUB_KEY
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR INDEX ( v1( 1 ) ) TYPE hnsw
);

CREATE FUNCTION foo( v VECTOR ) RETURNS VECTOR DETERMINISTIC
RETURN to_VECTOR ('[1]');

--error ER_FUNCTIONAL_INDEX_FUNCTION_IS_NOT_ALLOWED
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR (1) NOT NULL,
  INDEX (( foo ( v1 ) ))
);

DROP FUNCTION foo;

--error ER_NON_SCALAR_USED_AS_KEY
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR (1) UNIQUE,
  VECTOR INDEX ( v1 ) TYPE hnsw
);

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR (1) NOT NULL,
  VECTOR INDEX ( v1 ) TYPE hnsw KEY_BLOCK_SIZE 1
);

CREATE TABLE t4 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL
);

--error ER_PARSE_ERROR
ALTER TABLE t4 ADD VECTOR INDEX v1 (v1);
--error ER_NON_SCALAR_USED_AS_KEY
ALTER TABLE t4 ADD UNIQUE (v1);
--error ER_PARSE_ERROR
ALTER TABLE t4 ADD UNIQUE (v1(1)) TYPE hnsw;
ALTER TABLE t4 ADD VECTOR INDEX v1 (v1) TYPE hnsw;

SHOW CREATE TABLE t4;

ALTER TABLE t4 DROP INDEX v1;
SHOW CREATE TABLE t4;
SHOW INDEXES FROM t4;

DROP TABLE t1, t2, t3, t4;


CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 8 ) NOT NULL
);
SHOW CREATE TABLE t1;
SHOW INDEXES FROM t1;

--error ER_PARSE_ERROR
ALTER TABLE t1 ADD VECTOR INDEX ix (v1);

SHOW CREATE TABLE t1;
SHOW INDEXES FROM t1;

ALTER TABLE t1 ADD VECTOR INDEX vx (v1) TYPE hnsw;

SHOW CREATE TABLE t1;
SHOW INDEXES FROM t1;

DROP TABLE t1;

--error ER_PARSE_ERROR
CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw COMMENT 'abc' WITH ( M = 6 )
);


CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw ( M = 6 ) COMMENT 'abc'
);
SHOW CREATE TABLE t1;
SHOW INDEXES FROM t1;

DROP TABLE t1;


CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL
);
SHOW CREATE TABLE t1;
SHOW INDEXES FROM t1;

--error ER_PARSE_ERROR
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw ()
);

--error ER_PARSE_ERROR
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw ( M = 6.0 )
);

--error ER_PARSE_ERROR
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw ( M = "6" )
);

--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw ( `M = 1` = 1 )
);

--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw ( bogus = 1 )
);

--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER_VALUE
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw ( metric = nosuchmetric )
);

--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER_VALUE
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw ( M = abc )
);

--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER_VALUE
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw ( M = `M = 1`)
);

# M must be within [2, 200]: below 2, a graph with fewer connections per
# node isn't a meaningful HNSW parameter and the runtime relies on M >= 2
# downstream (e.g. 1 / log(M)); above 200, per-node neighbor buffers
# (sized off M) would balloon to gigabytes for a single row.
--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER_VALUE
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  KEY ( v1 ) TYPE hnsw WITH ( M = 0 )
);

--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER_VALUE
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  KEY ( v1 ) TYPE hnsw WITH ( M = 1 )
);

CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  KEY ( v1 ) TYPE hnsw WITH ( M = 2 )
);
DROP TABLE t;

CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  KEY ( v1 ) TYPE hnsw WITH ( M = 200 )
);
DROP TABLE t;

--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER_VALUE
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  KEY ( v1 ) TYPE hnsw WITH ( M = 201 )
);

--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER_VALUE
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  KEY ( v1 ) TYPE hnsw WITH ( M = 2147483647 )
);

--error ER_PARSE_ERROR
CREATE VECTOR INDEX ix ON t1(v1) TYPE hnsw ();
--error ER_PARSE_ERROR
CREATE VECTOR INDEX ix ON t1(v1) TYPE hnsw ( M = 6.0 );
--error ER_PARSE_ERROR
CREATE VECTOR INDEX ix ON t1(v1) TYPE hnsw ( M = "6" );

--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER
CREATE VECTOR INDEX ix ON t1(v1) TYPE hnsw ( `M = 1` = 1 );
--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER
CREATE VECTOR INDEX ix ON t1(v1) TYPE hnsw ( bogus = 1 );

--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER_VALUE
CREATE VECTOR INDEX ix ON t1(v1) TYPE hnsw ( metric = nosuchmetric );
--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER_VALUE
CREATE VECTOR INDEX ix ON t1(v1) TYPE hnsw ( M = abc );
--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER_VALUE
CREATE VECTOR INDEX ix ON t1(v1) TYPE hnsw ( M = `M = 1` );

--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER_VALUE
CREATE INDEX ix ON t1(v1) TYPE Hnsw WITH ( M = 0 );
--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER_VALUE
CREATE INDEX ix ON t1(v1) TYPE Hnsw WITH ( M = 1 );

CREATE INDEX ix ON t1(v1) TYPE Hnsw WITH ( M = 2 );
SHOW INDEXES FROM t1;
ALTER TABLE t1 DROP INDEX ix;

CREATE INDEX ix ON t1(v1) TYPE Hnsw WITH ( M = 200 );
SHOW INDEXES FROM t1;
ALTER TABLE t1 DROP INDEX ix;

--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER_VALUE
CREATE INDEX ix ON t1(v1) TYPE Hnsw WITH ( M = 201 );
--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER_VALUE
CREATE INDEX ix ON t1(v1) TYPE Hnsw WITH ( M = 2147483647 );

--error ER_INDEX_TYPE_NOT_SUPPORTED
CREATE VECTOR INDEX ix ON t1(v1) TYPE no_such_type;
--error ER_PARSE_ERROR
CREATE VECTOR INDEX ix ON t1(v1);
--error ER_PARSE_ERROR
CREATE VECTOR INDEX ix ON t1(v1(1));

CREATE VECTOR INDEX ix ON t1(v1) TYPE hnsw ( m = 6 );
SHOW INDEXES FROM t1;
SHOW CREATE TABLE t1;

--error ER_NOT_SUPPORTED_YET
ALTER TABLE t1 DROP PRIMARY KEY;

ALTER TABLE t1 DROP INDEX ix;
SHOW CREATE TABLE t1;
SHOW INDEXES FROM t1;

CREATE VECTOR INDEX ix ON t1(v1) TYPE hnsw ( m = 6, metric = Euclidean );
SHOW INDEXES FROM t1;
SHOW CREATE TABLE t1;
ALTER TABLE t1 DROP INDEX ix;

CREATE VECTOR INDEX ix ON t1(v1) TYPE hnsw ( metric = Euclidean, m = 6 );
SHOW INDEXES FROM t1;
SHOW CREATE TABLE t1;
ALTER TABLE t1 DROP INDEX ix;


ALTER TABLE t1 DROP PRIMARY KEY;
SHOW CREATE TABLE t1;
SHOW INDEXES FROM t1;

DROP TABLE t1;


--error ER_PARSE_ERROR
CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR KEY ( v1 )
);

--error ER_PARSE_ERROR
CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR KEY ( v1 ) USING btree
);

--error ER_PARSE_ERROR
CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR KEY ( v1 ) USING rtree
);

--error ER_PARSE_ERROR
CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR KEY ( v1 ) USING hash
);

--error ER_INDEX_MUST_HAVE_COMPATIBLE_COLUMN
CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  c INT,
  VECTOR KEY (c) TYPE hnsw
);

CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  v2 VECTOR ( 1234 )
);

--error ER_TOO_MANY_KEY_PARTS
CREATE VECTOR INDEX ix ON t1( v1, v2 ) TYPE hnsw;

DROP TABLE t1;


CREATE TABLE t1 (
  id BIGINT UNSIGNED NOT NULL,
  v1 VECTOR (8) NOT NULL,
  UNIQUE KEY u_id (id),
  VECTOR KEY (v1) TYPE hnsw
);
SHOW CREATE TABLE t1;
SHOW INDEXES FROM t1;

DROP TABLE t1;

CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 8 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw ( M = 6, metric = euclidean )
);
SHOW CREATE TABLE t1;
# Unrelated ALTER
ALTER TABLE t1 ADD COLUMN c INT;
SHOW CREATE TABLE t1;


DROP TABLE t1;

--error ER_NOT_SUPPORTED_YET
CREATE TEMPORARY TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR INDEX ( v1 ) TYPE hnsw
);

CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL
) PARTITION BY KEY (id) PARTITIONS 1;

--error ER_NOT_SUPPORTED_YET
ALTER TABLE t1 ADD VECTOR INDEX v1 ( v1 ) TYPE hnsw;

DROP TABLE t1;

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) NOT NULL,
  VECTOR INDEX ( v1 ) TYPE hnsw
) PARTITION BY KEY (id) PARTITIONS 1;

--error ER_UNSUPPORTED_ACTION_ON_GENERATED_COLUMN
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) GENERATED ALWAYS AS (to_VECTOR ('[1]')) VIRTUAL NOT NULL,
  VECTOR INDEX ( v1 ) TYPE hnsw
);

CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1 ) GENERATED ALWAYS AS (to_VECTOR ('[1]')) STORED NOT NULL,
  VECTOR INDEX ( v1 ) TYPE hnsw
);

SHOW CREATE TABLE t1;
SHOW KEYS FROM t1;

DROP TABLE t1;

CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw ( metric = euclidean )
);

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw ( metric = euclidean_squared )
);

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw ( metric = cosine )
);

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw ( metric = dot )
);

--error ER_NOT_SUPPORTED_YET
CREATE TABLE t (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  VECTOR KEY ( v1 ) TYPE hnsw ( metric = manhattan )
);


DROP TABLE t1;
