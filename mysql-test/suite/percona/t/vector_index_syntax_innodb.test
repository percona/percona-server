CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR ( 1234 ) NOT NULL,
  KEY( v1 ) TYPE hnsw
);
SHOW CREATE TABLE t1;
SHOW INDEXES FROM t1;

--replace_column 1 # 3 # 4 # 7 # 8 #
SELECT * FROM information_schema.innodb_indexes WHERE name = 'v1';

SELECT * FROM information_schema.statistics WHERE table_name = 't1' AND index_name = 'v1';

DROP TABLE t1;

