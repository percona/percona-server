--source include/have_debug.inc

--echo #
--echo # PS-11578: a vector with fewer dimensions than its column must be
--echo # refused by the vector index as what it is, naming the row.
--echo #
--echo # VECTOR(n) stores a value with fewer than n dimensions (only a longer
--echo # one is refused), and that stays so here. The vector index cannot hold
--echo # such a value, and used to refuse it as DB_CORRUPTION: the client got
--echo # "Incorrect key file for table", an ALTER also logged "We detected
--echo # index corruption", and nothing said which row was the problem. The
--echo # table was never damaged. Every path that puts a row into the index
--echo # now fails with ER_VECTOR_INDEX_WRONG_DIMENSIONS and the row's key.
--echo #

CREATE TABLE t (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
                VECTOR KEY vk (v) TYPE hnsw (M = 8));
INSERT INTO t VALUES (1, STRING_TO_VECTOR('[1,0,0,0]'));

--echo # INSERT into an indexed table.
--error ER_VECTOR_INDEX_WRONG_DIMENSIONS
INSERT INTO t VALUES (2, STRING_TO_VECTOR('[1,2,3]'));
--echo # A multi-row INSERT fails as a whole.
--error ER_VECTOR_INDEX_WRONG_DIMENSIONS
INSERT INTO t VALUES (3, STRING_TO_VECTOR('[3,0,0,0]')),
                     (4, STRING_TO_VECTOR('[4,0]'));
SELECT id, LENGTH(v) FROM t ORDER BY id;
--echo # The index still answers.
SELECT id FROM t
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;

--echo # Without the index the short value is stored, as VECTOR(4) allows.
--echo # DROP KEY keeps the hidden label column, so the next ADD can be INPLACE.
ALTER TABLE t DROP KEY vk;
INSERT INTO t VALUES (2, STRING_TO_VECTOR('[1,2,3]'));
SELECT id, LENGTH(v) FROM t ORDER BY id;

--echo # Building the index finds it, on either algorithm.
--error ER_VECTOR_INDEX_WRONG_DIMENSIONS
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ALGORITHM=INPLACE;
--error ER_VECTOR_INDEX_WRONG_DIMENSIONS
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ALGORITHM=COPY;

--echo # Fixing the row is enough.
UPDATE t SET v = STRING_TO_VECTOR('[1,2,3,0]') WHERE id = 2;
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ALGORITHM=INPLACE;
SELECT id FROM t
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,2,3,0]'), 'EUCLIDEAN') LIMIT 1;
DROP TABLE t;

--echo # A table that never had a vector index: the first ADD is COPY only.
CREATE TABLE t (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL);
INSERT INTO t VALUES (1, STRING_TO_VECTOR('[1,0,0,0]')),
                     (7, STRING_TO_VECTOR('[1,0]'));
--error ER_VECTOR_INDEX_WRONG_DIMENSIONS
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8);
DROP TABLE t;

--echo # A build on many scan threads reports the row too. The scan thread
--echo # that finds it has no session; the ALTER's own thread reports it.
CREATE TABLE t (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL);
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8);
ALTER TABLE t DROP KEY vk;
SET @@global.innodb_limit_optimistic_insert_debug = 2;
--disable_query_log
SET SESSION cte_max_recursion_depth = 5000;
INSERT INTO t
WITH RECURSIVE seq(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n < 1000)
SELECT n, STRING_TO_VECTOR(IF(n = 777, '[1,2]', CONCAT('[', n, ',0,0,0]')))
  FROM seq;
--enable_query_log
SET @@global.innodb_limit_optimistic_insert_debug = 0;
SET SESSION innodb_parallel_read_threads = 8;
--error ER_VECTOR_INDEX_WRONG_DIMENSIONS
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ALGORITHM=INPLACE;
SET SESSION innodb_parallel_read_threads = DEFAULT;
DROP TABLE t;

--echo # None of it was reported as corruption.
--let $assert_file = $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_only_after = CURRENT_TEST: percona.vector_index_wrong_dimensions
--let $assert_select = index corruption
--let $assert_count = 0
--let $assert_text = no row with the wrong dimensions was logged as corruption
--source include/assert_grep.inc
