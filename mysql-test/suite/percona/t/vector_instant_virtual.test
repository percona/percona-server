--echo #
--echo # PS-11299: INSTANT_VIRTUAL_ONLY ALTER on a vec-indexed table
--echo # must preserve the hidden percona_vec_aux_id column in dd::Table.
--echo #
--echo # Trigger: ALTER ADD COLUMN ... AS (expr) VIRTUAL on a table
--echo # that has a vector index. This goes through
--echo # Instant_ddl_impl::commit_instant_ddl's INSTANT_VIRTUAL_ONLY
--echo # branch, which rebuilds the new dd::Table from altered_table->s
--echo # (which has no SE-hidden cols) and so loses percona_vec_aux_id unless
--echo # we explicitly re-add it.
--echo #
--echo # Without the dict0inst.cc fix, the next reload (server restart
--echo # or any path that goes through dd_open_table_one) hits the
--echo # `vec_add_idx_id_column` invariant or the n_fields check —
--echo # debug crash, release misbehavior.
--echo #

CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v VECTOR(8) NOT NULL,
  c1 INT,
  KEY (v) TYPE hnsw WITH (M = 6)
);

--echo # Add a virtual column — should take INSTANT_VIRTUAL_ONLY path.
ALTER TABLE t1 ADD COLUMN c1_plus_one INT AS (c1 + 1) VIRTUAL;
SHOW CREATE TABLE t1;

--echo # Restart server. dd_open_table_one rebuilds dict_table_t from
--echo # the dd::Table. percona_vec_aux_id must still be there.
--source include/restart_mysqld.inc

SHOW CREATE TABLE t1;

--echo # ALTER ADD another virtual column post-restart — percona_vec_aux_id
--echo # must still be there.
ALTER TABLE t1 ADD COLUMN c1_plus_two INT AS (c1 + 2) VIRTUAL;
SHOW CREATE TABLE t1;

DROP TABLE t1;
