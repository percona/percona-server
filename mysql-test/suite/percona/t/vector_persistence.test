--echo #
--echo # PS-11299: Vector index persistence — phase 1.
--echo # CREATE TABLE creates one aux .ibd per vector index and auto-adds the
--echo # hidden percona_vec_aux_id column. SHOW CREATE must not expose percona_vec_aux_id.
--echo #

CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR(8) NOT NULL,
  KEY (v1) TYPE hnsw
);

--echo # SHOW CREATE TABLE must NOT mention percona_vec_aux_id (HT_HIDDEN_SE).
SHOW CREATE TABLE t1;

--echo # Aux tables are HT_HIDDEN_SE — invisible to user-facing catalog
--echo # views (SHOW TABLES, I_S.TABLES) but registered in DD and so
--echo # visible to InnoDB's internal I_S.INNODB_TABLES. Same as FTS aux.
SHOW TABLES;
SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES
  WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME LIKE 'vec_%';
--replace_regex /percona_vec_hnsw_[0-9a-f]+_[0-9a-f]+/percona_vec_hnsw_<TID>_<IID>/
SELECT NAME FROM INFORMATION_SCHEMA.INNODB_TABLES
  WHERE NAME LIKE 'test/percona_vec_%';

--echo # Exactly one aux .ibd per vector index must exist on disk.
--echo # Names are vec_<hex_table_id>_<hex_index_id>.ibd — mask the ids so the
--echo # result file is stable across runs.
--let $MYSQLD_DATADIR = `SELECT @@datadir`
--replace_regex /percona_vec_hnsw_[0-9a-f]+_[0-9a-f]+\.ibd/percona_vec_hnsw_<TID>_<IID>.ibd/
--list_files $MYSQLD_DATADIR/test percona_vec_*.ibd

--echo # User cannot declare a column named percona_vec_aux_id when the table has a
--echo # vector index — the name is reserved.
--error ER_WRONG_COLUMN_NAME
CREATE TABLE t2 (
  id BIGINT UNSIGNED PRIMARY KEY,
  percona_vec_aux_id BIGINT UNSIGNED,
  v1 VECTOR(8) NOT NULL,
  KEY (v1) TYPE hnsw
);

--echo # ... and it is rejected on a table with no vector index too - the
--echo # name is reserved unconditionally, so a table cannot be set up now
--echo # in a way that would break ALTER ... ADD KEY ... TYPE hnsw later.
--error ER_WRONG_COLUMN_NAME
CREATE TABLE t3 (
  id BIGINT UNSIGNED PRIMARY KEY,
  percona_vec_aux_id BIGINT UNSIGNED
);

--echo #
--echo # RENAME TABLE — aux name is "<db>/vec_<table_id>_<index_id>" so a
--echo # same-schema rename is a no-op on disk. Cross-schema rename
--echo # moves each aux .ibd to the new schema directory and reparents
--echo # its dd::Table — full FTS parity via dd_rename_fts_table.
--echo #

--echo #
--echo # TRUNCATE TABLE — InnoDB implements truncate as drop+create, so the
--echo # aux table gets removed and recreated. New table_id/index_id means
--echo # the aux .ibd name changes, but the count stays at one per vector
--echo # index.
--echo #

--echo # Capture the aux name before truncate.
--replace_regex /percona_vec_hnsw_[0-9a-f]+_[0-9a-f]+\.ibd/vec_<BEFORE>.ibd/
--list_files $MYSQLD_DATADIR/test percona_vec_*.ibd

TRUNCATE TABLE t1;

--echo # Still exactly one aux .ibd in test/ (likely with a different id).
--replace_regex /percona_vec_hnsw_[0-9a-f]+_[0-9a-f]+\.ibd/vec_<AFTER>.ibd/
--list_files $MYSQLD_DATADIR/test percona_vec_*.ibd

--echo #
--echo # OPTIMIZE TABLE — for InnoDB this maps to ALTER TABLE FORCE
--echo # (full rebuild). Aux table should be re-minted with the new
--echo # parent table_id; count stays at one per vector index. Same
--echo # shape as TRUNCATE.
--echo #
OPTIMIZE TABLE t1;
--echo # Still exactly one aux .ibd in test/ post-OPTIMIZE.
--replace_regex /percona_vec_hnsw_[0-9a-f]+_[0-9a-f]+\.ibd/vec_<POST_OPTIMIZE>.ibd/
--list_files $MYSQLD_DATADIR/test percona_vec_*.ibd

--echo # Same-schema rename: aux file unchanged.
RENAME TABLE t1 TO t1_renamed;
--replace_regex /percona_vec_hnsw_[0-9a-f]+_[0-9a-f]+\.ibd/percona_vec_hnsw_<TID>_<IID>.ibd/
--list_files $MYSQLD_DATADIR/test percona_vec_*.ibd

--echo # Cross-schema rename: aux follows the parent to the new schema dir.
CREATE DATABASE vec_other;
RENAME TABLE t1_renamed TO vec_other.t1;
--echo # No more percona_vec_*.ibd in test/.
--list_files $MYSQLD_DATADIR/test percona_vec_*.ibd
--echo # ... they now live under vec_other/.
--replace_regex /percona_vec_hnsw_[0-9a-f]+_[0-9a-f]+\.ibd/percona_vec_hnsw_<TID>_<IID>.ibd/
--list_files $MYSQLD_DATADIR/vec_other percona_vec_*.ibd

DROP TABLE vec_other.t1;
DROP DATABASE vec_other;

--echo #
--echo # ALTER TABLE — ADD INDEX creates a fresh aux .ibd; DROP INDEX
--echo # removes it. Use a base table created WITHOUT a vector index so we
--echo # exercise the ADD path on an existing table.
--echo #

CREATE TABLE t_alter (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR(8) NOT NULL
);
--echo # No percona_vec_*.ibd yet.
--list_files $MYSQLD_DATADIR/test percona_vec_*.ibd

CREATE INDEX v1 ON t_alter (v1) TYPE hnsw;
--echo # Aux .ibd now exists.
--replace_regex /percona_vec_hnsw_[0-9a-f]+_[0-9a-f]+\.ibd/percona_vec_hnsw_<TID>_<IID>.ibd/
--list_files $MYSQLD_DATADIR/test percona_vec_*.ibd

ALTER TABLE t_alter DROP INDEX v1;
--echo # Aux .ibd gone after DROP INDEX.
--list_files $MYSQLD_DATADIR/test percona_vec_*.ibd

DROP TABLE t_alter;

--echo #
--echo # ALTER round-trip — drop the only vector index, then add another.
--echo # The hidden percona_vec_aux_id column is carried forward into the new
--echo # dd::Table by dd_commit_inplace_alter_table (mirroring FTS_DOC_ID);
--echo # if the SQL layer subsequently prunes it because no index points at
--echo # it, the next ALTER ADD INDEX recreates it transparently —
--echo # the round-trip succeeds either way.
--echo #

CREATE TABLE t_rt (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR(8) NOT NULL,
  KEY (v1) TYPE hnsw
);

--echo # percona_vec_aux_id reservation while a vector index exists.
--error ER_WRONG_COLUMN_NAME
ALTER TABLE t_rt ADD COLUMN percona_vec_aux_id BIGINT UNSIGNED;

ALTER TABLE t_rt DROP INDEX v1;
--echo # Aux .ibd gone after DROP INDEX.
--list_files $MYSQLD_DATADIR/test percona_vec_*.ibd

--echo # Re-add a vector index. Must succeed with no duplicate-column error,
--echo # aux is recreated, percona_vec_aux_id is re-established by InnoDB.
CREATE INDEX v2 ON t_rt (v1) TYPE hnsw;
--replace_regex /percona_vec_hnsw_[0-9a-f]+_[0-9a-f]+\.ibd/percona_vec_hnsw_<TID>_<IID>.ibd/
--list_files $MYSQLD_DATADIR/test percona_vec_*.ibd

--echo # And percona_vec_aux_id is again reserved (the new vector index is back).
--error ER_WRONG_COLUMN_NAME
ALTER TABLE t_rt ADD COLUMN percona_vec_aux_id BIGINT UNSIGNED;

DROP TABLE t_rt;

--echo #
--echo # DISCARD / IMPORT TABLESPACE on a table with a vector index is
--echo # rejected in phase 1 — per-aux tablespace import is not yet
--echo # designed. The block lives at the very entry of
--echo # ha_innobase::discard_or_import_tablespace.
--echo #

CREATE TABLE t_disc (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR(8) NOT NULL,
  KEY (v1) TYPE hnsw
);
--error ER_NOT_ALLOWED_COMMAND
ALTER TABLE t_disc DISCARD TABLESPACE;
DROP TABLE t_disc;

--echo # After DROP TABLE the aux .ibd files must be gone too — no orphans.
--list_files $MYSQLD_DATADIR/test percona_vec_*.ibd
