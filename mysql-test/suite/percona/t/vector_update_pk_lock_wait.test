--source include/have_debug.inc

--echo #
--echo # PS-11300: a PK-changing UPDATE that has to wait for a lock before it
--echo # can insert the new clustered record.
--echo #
--echo # row_upd_clust_rec_by_insert() is entered twice for such a statement:
--echo # the first pass delete-marks the old record and then gets DB_LOCK_WAIT
--echo # from row_ins_clust_index_entry(); the second pass, after the lock is
--echo # granted, does the insert. Only the second one may build a graph node.
--echo #
--echo # The first pass has already assigned a label by then, and it is not
--echo # reused: row_upd_clust_step() calls row_upd_store_row() again on
--echo # re-entry, which rebuilds the row it was written into. So the label is
--echo # consumed without ever reaching the aux table - the same thing that
--echo # happens to a rolled-back INSERT's label - and the node that is finally
--echo # built carries the second one. The skipped id below is how this test
--echo # knows the retry really happened.
--echo #

CREATE TABLE t (id BIGINT UNSIGNED PRIMARY KEY,
                v VECTOR(2) NOT NULL,
                VECTOR KEY vk (v) TYPE hnsw (M = 4));
INSERT INTO t VALUES (1, STRING_TO_VECTOR('[0,0]'));
INSERT INTO t VALUES (2, STRING_TO_VECTOR('[10,0]'));

--echo # Two nodes, ids 1 and 2. The next label to be handed out is 3.
SET SESSION innodb_interpreter = 'vec_aux_dump test/t';
--replace_regex /id=0 level=[0-9]+ base_pk=[0-9]+/id=0 level=# base_pk=#/ /level=[0-9]+/level=#/ /nb=[0-9,]*/nb=#/
SELECT @@session.innodb_interpreter_output;

--connect(blocker,localhost,root,,test)
--echo # Lock the gap the UPDATE below has to insert into.
BEGIN;
SELECT id FROM t WHERE id BETWEEN 50 AND 200 FOR UPDATE;

--connection default
BEGIN;
--echo # Blocks on the gap lock, inside row_ins_clust_index_entry().
--send UPDATE t SET id = 70 WHERE id = 1

--connection blocker
let $wait_condition =
  SELECT COUNT(*) = 1 FROM performance_schema.data_lock_waits;
--source include/wait_condition.inc
--echo # Release it; the UPDATE retries its insert and succeeds.
ROLLBACK;

--connection default
--reap
COMMIT;

--echo # ONE new node for the two labels the statement consumed: id 3 was
--echo # assigned by the pass that hit the lock wait and never reached the aux,
--echo # id 4 is the node the retry built. The old node 1 stays, naming the
--echo # key the row no longer has.
SET SESSION innodb_interpreter = 'vec_aux_dump test/t';
--replace_regex /id=0 level=[0-9]+ base_pk=[0-9]+/id=0 level=# base_pk=#/ /level=[0-9]+/level=#/ /nb=[0-9,]*/nb=#/
SELECT @@session.innodb_interpreter_output;

--echo # And the row is reachable through the index at its new key.
SELECT id FROM t FORCE INDEX (vk)
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 1;
SELECT id FROM t IGNORE INDEX (vk)
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 1;

CHECK TABLE t;

--echo #
--echo # Same wait, but the statement changes the vector too. The label then
--echo # comes from calc_row_difference and lives in the update vector, so
--echo # row_upd_store_row's rebuild reproduces it rather than losing it -
--echo # this pass must NOT assign a second one. Where the PK-only case above
--echo # skipped an id, this one does not.
--echo #
--connection blocker
BEGIN;
SELECT id FROM t WHERE id BETWEEN 300 AND 400 FOR UPDATE;

--connection default
BEGIN;
--send UPDATE t SET id = 350, v = STRING_TO_VECTOR('[7,7]') WHERE id = 70

--connection blocker
let $wait_condition =
  SELECT COUNT(*) = 1 FROM performance_schema.data_lock_waits;
--source include/wait_condition.inc
ROLLBACK;

--connection default
--reap
COMMIT;

--echo # One new node, id 5 - the next one, no gap.
SET SESSION innodb_interpreter = 'vec_aux_dump test/t';
--replace_regex /id=0 level=[0-9]+ base_pk=[0-9]+/id=0 level=# base_pk=#/ /level=[0-9]+/level=#/ /nb=[0-9,]*/nb=#/
SELECT @@session.innodb_interpreter_output;

SELECT id FROM t FORCE INDEX (vk)
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[7,7]'), 'EUCLIDEAN') LIMIT 1;
SELECT id FROM t IGNORE INDEX (vk)
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[7,7]'), 'EUCLIDEAN') LIMIT 1;

CHECK TABLE t;

--disconnect blocker
DROP TABLE t;
