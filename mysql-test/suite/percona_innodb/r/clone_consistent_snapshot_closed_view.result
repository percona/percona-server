CREATE TABLE t1(id INT PRIMARY KEY, c INT, pad VARCHAR(200)) ENGINE=InnoDB;
INSERT INTO t1 VALUES(1, 0, REPEAT('a', 200));
#
# Scenario 1: an autocommit READ COMMITTED donor reopening its view.
#
SET SESSION transaction_isolation='READ-COMMITTED';
SELECT c FROM t1 WHERE id=1;
c
0
SET GLOBAL innodb_purge_run_now=ON;
SET DEBUG_SYNC='mvcc_view_open_after_untag_before_reopen SIGNAL donor_before_reopen WAIT_FOR continue_donor TIMEOUT 120';
SELECT c FROM t1 WHERE id=1;
SET SESSION transaction_isolation='REPEATABLE-READ';
SET DEBUG_SYNC='now WAIT_FOR donor_before_reopen TIMEOUT 120';
START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION $donor_id;
Warnings:
Warning	138	InnoDB: WITH CONSISTENT SNAPSHOT FROM SESSION was ignored because the target transaction has not been assigned a read view.
SELECT c FROM t1 WHERE id=1;
c
200
SET DEBUG_SYNC='now SIGNAL continue_donor';
c
200
COMMIT;
#
# Scenario 2: an explicit transaction donor whose read view was closed
# by the commit of its previous read-only transaction.
#
SET SESSION transaction_isolation='REPEATABLE-READ';
START TRANSACTION;
SELECT c FROM t1 WHERE id=1;
c
200
COMMIT;
START TRANSACTION;
SELECT c FROM t1 WHERE id=1 FOR UPDATE;
c
200
START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION $donor_id;
Warnings:
Warning	138	InnoDB: WITH CONSISTENT SNAPSHOT FROM SESSION was ignored because the target transaction has not been assigned a read view.
SELECT c FROM t1 WHERE id=1;
c
200
COMMIT;
#
# Scenario 3: the same donor opening a read view for its next consistent
# read, stopped after trx->read_view has been untagged.
#
SET DEBUG_SYNC='mvcc_view_open_after_untag_before_reopen SIGNAL donor_before_reopen WAIT_FOR continue_donor TIMEOUT 120';
SELECT c FROM t1 WHERE id=1;
SET DEBUG_SYNC='now WAIT_FOR donor_before_reopen TIMEOUT 120';
START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION $donor_id;
Warnings:
Warning	138	InnoDB: WITH CONSISTENT SNAPSHOT FROM SESSION was ignored because the target transaction has not been assigned a read view.
SELECT c FROM t1 WHERE id=1;
c
200
COMMIT;
SET DEBUG_SYNC='now SIGNAL continue_donor';
c
200
COMMIT;
SET DEBUG_SYNC='RESET';
SET SESSION transaction_isolation=DEFAULT;
DROP TABLE t1;
