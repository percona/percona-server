CREATE TABLE t1 (id INT PRIMARY KEY, c INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 0);
CREATE TEMPORARY TABLE tmp1 (id INT PRIMARY KEY) ENGINE=InnoDB;
# Read-only donor commit
START TRANSACTION WITH CONSISTENT SNAPSHOT;
START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION $donor_id;
COMMIT;
COMMIT;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
Read view has no active transaction ids
COMMIT;
# Read-only donor rollback
START TRANSACTION WITH CONSISTENT SNAPSHOT;
START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION $donor_id;
ROLLBACK;
ROLLBACK;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
Read view has no active transaction ids
COMMIT;
# Temporary-table write and commit
START TRANSACTION WITH CONSISTENT SNAPSHOT, READ ONLY;
START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION $donor_id;
COMMIT;
INSERT INTO tmp1 VALUES (1);
COMMIT;
SELECT * FROM tmp1;
id
1
START TRANSACTION WITH CONSISTENT SNAPSHOT;
Read view has no active transaction ids
COMMIT;
# Temporary-table write and rollback
START TRANSACTION WITH CONSISTENT SNAPSHOT, READ ONLY;
START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION $donor_id;
COMMIT;
INSERT INTO tmp1 VALUES (2);
ROLLBACK;
SELECT * FROM tmp1;
id
1
START TRANSACTION WITH CONSISTENT SNAPSHOT;
Read view has no active transaction ids
COMMIT;
# Disconnect with an unused reservation
START TRANSACTION WITH CONSISTENT SNAPSHOT;
START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION $donor_id;
COMMIT;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
Read view has no active transaction ids
COMMIT;
DROP TABLE t1;
