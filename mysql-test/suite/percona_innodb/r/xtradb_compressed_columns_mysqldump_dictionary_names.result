# Dictionary data read by a mysql client in sjis and gbk
CREATE COMPRESSION_DICTIONARY mb1 ('あ''あ\\');
SET @data = X'835C27835C5C';
CREATE COMPRESSION_DICTIONARY mb2 (@data);
CREATE TABLE t2 (
a BLOB COLUMN_FORMAT COMPRESSED WITH COMPRESSION_DICTIONARY mb1,
b BLOB COLUMN_FORMAT COMPRESSED WITH COMPRESSION_DICTIONARY mb2);
SELECT DICT_NAME, HEX(DICT_DATA) FROM INFORMATION_SCHEMA.COMPRESSION_DICTIONARY WHERE DICT_NAME IN ('mb1', 'mb2') ORDER BY DICT_NAME;
DICT_NAME	HEX(DICT_DATA)
mb1	E3818227E381825C
mb2	835C27835C5C
# Dump and restore with --default-character-set=sjis
DROP TABLE t2;
DROP COMPRESSION_DICTIONARY mb1;
DROP COMPRESSION_DICTIONARY mb2;
SELECT DICT_NAME, HEX(DICT_DATA) FROM INFORMATION_SCHEMA.COMPRESSION_DICTIONARY WHERE DICT_NAME IN ('mb1', 'mb2') ORDER BY DICT_NAME;
DICT_NAME	HEX(DICT_DATA)
mb1	E3818227E381825C
mb2	835C27835C5C
