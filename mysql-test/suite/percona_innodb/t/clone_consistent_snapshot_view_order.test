#
# START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION must keep the MVCC
# view list ordered by low limit number. A clone has the low limit number of
# its donor, which can be older than that of other open views. Purge takes the
# oldest open view from the tail of the list, so a clone put at the head could
# lose the undo history it needs once its donor closes its view.
#

--source include/count_sessions.inc

CREATE TABLE t1 (id INT PRIMARY KEY, c INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 0);

--connect (donor,localhost,root,,)
--connect (newer,localhost,root,,)
--connect (receiver,localhost,root,,)

--connection donor
--let $donor_id=`SELECT CONNECTION_ID()`
START TRANSACTION WITH CONSISTENT SNAPSHOT;

--connection default
UPDATE t1 SET c = 1 WHERE id = 1;

# This view is newer than the donor's one.
--connection newer
START TRANSACTION WITH CONSISTENT SNAPSHOT;

--connection receiver
--disable_query_log
--echo START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION \$donor_id;
--eval START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION $donor_id
--enable_query_log
SELECT c FROM t1 WHERE id = 1;

# The clone is now the oldest open view, and must keep purge from removing
# the old version of the row.
--connection donor
COMMIT;

--connection default
SET GLOBAL innodb_purge_run_now=ON;
--source include/wait_innodb_all_purged.inc

--connection receiver
SELECT c FROM t1 WHERE id = 1;
COMMIT;

--connection newer
SELECT c FROM t1 WHERE id = 1;
COMMIT;

--connection default
--disconnect donor
--disconnect newer
--disconnect receiver

DROP TABLE t1;

--source include/wait_until_count_sessions.inc
