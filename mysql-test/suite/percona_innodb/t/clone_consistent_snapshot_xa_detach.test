#
# XA PREPARE detaches a read-only XA transaction from its session and frees it
# while START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION of another
# session already took it as the donor transaction. The clone must not use the
# freed transaction object, which can already belong to another session, even
# to the receiver itself.
#
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/count_sessions.inc

CREATE TABLE t1 (id INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1);

--connect (donor,localhost,root,,)
--let $donor_id=`SELECT CONNECTION_ID()`
XA START 'x';
SELECT * FROM t1;
XA END 'x';
SET DEBUG_SYNC='before_execute_sql_command SIGNAL donor_started WAIT_FOR donor_go';
--send XA PREPARE 'x'

--connection default
SET DEBUG_SYNC='now WAIT_FOR donor_started';

--connect (receiver,localhost,root,,)
SET DEBUG_SYNC='innobase_clone_read_view_after_donor_trx SIGNAL receiver_has_donor WAIT_FOR receiver_go';
--replace_regex /FROM SESSION [0-9]+/FROM SESSION DONOR_ID/
--send_eval START TRANSACTION WITH CONSISTENT SNAPSHOT FROM SESSION $donor_id

--connection default
SET DEBUG_SYNC='now WAIT_FOR receiver_has_donor';
SET DEBUG_SYNC='now SIGNAL donor_go';

--connection donor
--reap

--connection default
SET DEBUG_SYNC='now SIGNAL receiver_go';

--connection receiver
--reap
SELECT * FROM t1;
COMMIT;

--connection donor
XA COMMIT 'x';

--connection default
--disconnect donor
--disconnect receiver
SET DEBUG_SYNC='RESET';
DROP TABLE t1;
--source include/wait_until_count_sessions.inc
