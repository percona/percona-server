#
# PS-11615: an ANN search while an in-place ALTER replaces the vector
# index. The ALTER's new index is in the table's index list, not yet
# committed, until the ALTER commits. Readers keep using the old index.
#
CREATE TABLE t_replace (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
VECTOR KEY vk (v) TYPE hnsw (M = 8));
SET SESSION cte_max_recursion_depth = 1000;
INSERT INTO t_replace
WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 200)
SELECT n, STRING_TO_VECTOR(CONCAT('[', n, ',0,0,0]')) FROM s;
UPDATE t_replace SET v = STRING_TO_VECTOR('[1000,0,0,0]') WHERE id = 3;
ANALYZE TABLE t_replace;
Table	Op	Msg_type	Msg_text
test.t_replace	analyze	status	OK
SET DEBUG_SYNC = 'alter_table_inplace_after_lock_downgrade SIGNAL replacing WAIT_FOR go';
ALTER TABLE t_replace DROP KEY vk, ADD VECTOR KEY vk2 (v) TYPE hnsw (M = 16), ALGORITHM=INPLACE, LOCK=SHARED;
SET DEBUG_SYNC = 'now WAIT_FOR replacing';
# During the ALTER: the search uses the old index and finds row 3.
EXPLAIN SELECT id FROM t_replace ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1000,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t_replace	NULL	vector_ann	vk	vk	0	const	#	#	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t_replace`.`id` AS `id` from `test`.`t_replace` order by distance(`test`.`t_replace`.`v`,to_vector('[1000,0,0,0]'),'EUCLIDEAN') limit 1
SELECT id FROM t_replace ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1000,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id
3
# A session that opens the table now does the same.
SELECT id FROM t_replace ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1000,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id
3
SET DEBUG_SYNC = 'now SIGNAL go';
# After the ALTER: the new index answers.
EXPLAIN SELECT id FROM t_replace ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1000,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t_replace	NULL	vector_ann	vk2	vk2	0	const	#	#	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t_replace`.`id` AS `id` from `test`.`t_replace` order by distance(`test`.`t_replace`.`v`,to_vector('[1000,0,0,0]'),'EUCLIDEAN') limit 1
SELECT id FROM t_replace ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1000,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id
3
DROP TABLE t_replace;
SET DEBUG_SYNC = 'RESET';
