#
# vec_aux_read_node must refuse an aux row whose level field has an
# unexpected length, not silently treat it as level 0. The other
# fixed-width column read the same way (base_pk) already does this;
# level did not. A malformed aux row is this index's corruption, and it
# does not heal: the index is refused until it is rebuilt.
#
# The corruption is injected on the entry-point node's own row, not
# the index's metadata row (aux id 0), so this also covers
# HNSW::init_from_entry_point() surfacing a load_node_cb failure as
# an error return instead of aborting a debug server.
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR(2) NOT NULL,
VECTOR KEY vk (v) TYPE hnsw (M = 4));
INSERT INTO t1 VALUES (1, STRING_TO_VECTOR('[0,0]')),
(2, STRING_TO_VECTOR('[10,0]')),
(3, STRING_TO_VECTOR('[20,0]'));
# Drop the in-memory graph so the next access rebuilds it from the
# aux table, through vec_aux_read_node, rather than reusing nodes
# already resident from the inserts above.
# restart
SET SESSION debug = '+d,vec_aux_corrupt_level_len';
# The entry-point node (base_pk 1, the first row inserted) is read
# here via init_from_entry_point(); with the hook active its level
# field reads back as length 0 instead of 1. The hook skips aux row
# id 0, which is the index's own metadata row, not a graph node.
SELECT id FROM t1
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 1;
ERROR HY000: Index t1 is corrupted
SET SESSION debug = '-d,vec_aux_corrupt_level_len';
# The index stays refused - the aux that failed to load is the same
# aux - while the base table is untouched.
SELECT id FROM t1
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 1;
ERROR HY000: Index vk is corrupted
SELECT id FROM t1 IGNORE INDEX (vk)
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 1;
id
1
# Rebuilding the index is the remedy. Under a new name: the same name
# and definition in one statement is no change at all to the server.
ALTER TABLE t1 DROP KEY vk, ADD VECTOR KEY vk2 (v) TYPE hnsw (M = 4);
SELECT id FROM t1
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 1;
id
1
DROP TABLE t1;
