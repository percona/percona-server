SELECT COUNT(*) FROM t1;
COUNT(*)
400
CALL ann_all();
ann_rows
400
# restart
# After the restart the index takes rows and finds every row.
CALL add_rows(3000, 20);
SELECT COUNT(*) FROM t1;
COUNT(*)
420
CALL ann_all();
ann_rows
420
INSERT INTO t1 VALUES (10000, STRING_TO_VECTOR('[9,9,9,9,9,9,9,9]'));
SELECT id FROM t1 FORCE INDEX (vk)
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[9,9,9,9,9,9,9,8]'), 'euclidean')
LIMIT 1;
id
10000
CHECK TABLE t1;
