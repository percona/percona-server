#
# PS-11617: DROP + ADD of a vector index under the same name, with new
# parameters, rebuilds the index.
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(2) NOT NULL,
VECTOR KEY vk (v) TYPE hnsw (M = 8));
INSERT INTO t1 VALUES (1, STRING_TO_VECTOR('[0,0]')),
(2, STRING_TO_VECTOR('[1,0]'));
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` bigint unsigned NOT NULL,
  `v` vector(2) NOT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vk` (`v`) USING `hnsw` (`M`=8, `ef_construction`=200, `metric`=`euclidean`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# New parameters rebuild the index, which is then used.
ALTER TABLE t1 DROP KEY vk,
ADD VECTOR KEY vk (v) TYPE hnsw (M = 12, ef_construction = 64);
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` bigint unsigned NOT NULL,
  `v` vector(2) NOT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vk` (`v`) USING `hnsw` (`M`=12, `ef_construction`=64, `metric`=`euclidean`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
include/assert.inc [The index was rebuilt]
EXPLAIN SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0]'), 'EUCLIDEAN') LIMIT 1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	vector_ann	vk	vk	0	const	#	#	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id` from `test`.`t1` order by distance(`test`.`t1`.`v`,to_vector('[1,0]'),'EUCLIDEAN') limit 1
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0]'), 'EUCLIDEAN') LIMIT 1;
id
2
# The same parameters, written differently, keep it.
ALTER TABLE t1 DROP KEY vk,
ADD VECTOR KEY vk (v) TYPE HNSW
(EF_CONSTRUCTION = 064, Metric = Euclidean, m = 012);
include/assert.inc [The index was kept]
# A new metric rebuilds it too. The euclidean index serves only
# EUCLIDEAN queries.
EXPLAIN SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0]'), 'EUCLIDEAN') LIMIT 1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	vector_ann	vk	vk	0	const	#	#	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id` from `test`.`t1` order by distance(`test`.`t1`.`v`,to_vector('[1,0]'),'EUCLIDEAN') limit 1
EXPLAIN SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0]'), 'COSINE') LIMIT 1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using filesort
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id` from `test`.`t1` order by distance(`test`.`t1`.`v`,to_vector('[1,0]'),'COSINE') limit 1
# Under cosine, the zero vector is refused.
ALTER TABLE t1 DROP KEY vk,
ADD VECTOR KEY vk (v) TYPE hnsw (M = 12, metric = cosine);
ERROR HY000: Column 'v' has a vector value its vector index cannot use.
DELETE FROM t1 WHERE id = 1;
ALTER TABLE t1 DROP KEY vk,
ADD VECTOR KEY vk (v) TYPE hnsw (M = 12, metric = cosine);
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` bigint unsigned NOT NULL,
  `v` vector(2) NOT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vk` (`v`) USING `hnsw` (`M`=12, `ef_construction`=200, `metric`=`cosine`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
INSERT INTO t1 VALUES (1, STRING_TO_VECTOR('[0,0]'));
ERROR HY000: Column 'v' has a vector value its vector index cannot use.
# The cosine index serves only COSINE queries.
EXPLAIN SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0]'), 'EUCLIDEAN') LIMIT 1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using filesort
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id` from `test`.`t1` order by distance(`test`.`t1`.`v`,to_vector('[1,0]'),'EUCLIDEAN') limit 1
EXPLAIN SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0]'), 'COSINE') LIMIT 1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	vector_ann	vk	vk	0	const	#	#	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id` from `test`.`t1` order by distance(`test`.`t1`.`v`,to_vector('[1,0]'),'COSINE') limit 1
DROP TABLE t1;
