SELECT id, g, s FROM t1 WHERE g > 66 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
id	g	s
34	68	102
35	70	105
36	72	108
SELECT id, g, s FROM t1 IGNORE INDEX (vk) WHERE g > 66 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
id	g	s
34	68	102
35	70	105
36	72	108
SELECT id, g, s FROM t1 WHERE g % 4 = 0 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
id	g	s
34	68	102
32	64	96
36	72	108
SELECT id, g, s FROM t1 IGNORE INDEX (vk) WHERE g % 4 = 0 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
id	g	s
34	68	102
32	64	96
36	72	108
DROP TABLE t1;
#
# Virtual column which is also indexed by a secondary index, read
# through the vector index, including locking reads. The row comes
# from the clustered index, so the secondary index does not provide
# the value: it must be computed for every row.
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
a INT NOT NULL DEFAULT 0,
g INT GENERATED ALWAYS AS (id * 2 + a) VIRTUAL,
KEY kg (g),
VECTOR KEY vk (v) TYPE hnsw (M = 8));
INSERT INTO t1 (id, v)
WITH RECURSIVE ids (id) AS (
SELECT 1
UNION ALL
SELECT id + 1
FROM ids
WHERE id < 50
)
SELECT
id,
STRING_TO_VECTOR(CONCAT('[', id, ',0,0,0]'))
FROM ids;
UPDATE t1 SET a = 100 WHERE id IN (32, 35);
EXPLAIN SELECT id, g FROM t1 WHERE g > 66 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	vector_ann	vk,kg	vk	0	const	#	#	Using where
Warnings:
