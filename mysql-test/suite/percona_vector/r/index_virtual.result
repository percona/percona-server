id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	vector_ann	vk	vk	0	const	#	#	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id`,`test`.`t1`.`g` AS `g` from `test`.`t1` order by distance(`test`.`t1`.`v`,to_vector('[33.4,0,0,0]'),'EUCLIDEAN') limit 3
BEGIN;
SELECT id, g FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3 FOR UPDATE;
