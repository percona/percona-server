#
# Error in a virtual column expression for a row returned by the
# vector index scan is reported as it is for any other access path.
# The column is added after the rows, so the bad row could be stored.
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
j VARCHAR(20), VECTOR KEY vk (v) TYPE hnsw (M = 8));
INSERT INTO t1 (id, v, j) VALUES
(1, STRING_TO_VECTOR('[1,0,0,0]'), '{"a": 1}'),
(2, STRING_TO_VECTOR('[2,0,0,0]'), '{"a": 2}'),
(3, STRING_TO_VECTOR('[3,0,0,0]'), 'not json');
ALTER TABLE t1 ADD COLUMN g INT GENERATED ALWAYS AS (JSON_EXTRACT(j, '$.a')) VIRTUAL, ALGORITHM=INPLACE;
# Rows 1 and 2 are nearest and fine.
SELECT id, g FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 2;
id	g
1	1
2	2
SELECT id, g FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
ERROR 22032: Invalid JSON text in argument 1 to function json_extract: "Invalid value." at position 1.
SHOW WARNINGS;
Level	Code	Message
Error	3141	Invalid JSON text in argument 1 to function json_extract: "Invalid value." at position 1.
Error	1030	Got error 1 - 'Operation not permitted' from storage engine
SELECT id, g FROM t1 IGNORE INDEX (vk) ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
ERROR 22032: Invalid JSON text in argument 1 to function json_extract: "Invalid value." at position 1.
SHOW WARNINGS;
Level	Code	Message
Error	3141	Invalid JSON text in argument 1 to function json_extract: "Invalid value." at position 1.
Error	1030	Got error 1 - 'Operation not permitted' from storage engine
DROP TABLE t1;
