#
# PS-11578, PS-11583: a vector with fewer dimensions than its column
# must be refused by the vector index as what it is.
#
# VECTOR(n) stores a value with fewer than n dimensions (only a longer
# one is refused), and that stays so here. The vector index cannot hold
# such a value, and used to refuse it as DB_CORRUPTION: the client got
# "Incorrect key file for table", an ALTER also logged "We detected
# index corruption", though the table was never damaged. Every path
# that puts a row into the index now fails with
# ER_VECTOR_INDEX_WRONG_DIMENSIONS, naming the column and the
# dimensions its index needs.
#
CREATE TABLE t (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
VECTOR KEY vk (v) TYPE hnsw (M = 8));
INSERT INTO t VALUES (1, STRING_TO_VECTOR('[1,0,0,0]'));
# INSERT into an indexed table.
INSERT INTO t VALUES (2, STRING_TO_VECTOR('[1,2,3]'));
ERROR HY000: Column 'v' has a vector without the 4 dimensions its vector index needs.
# That is the only condition: no generic engine error under it.
SHOW WARNINGS;
Level	Code	Message
Error	7040	Column 'v' has a vector without the 4 dimensions its vector index needs.
# IGNORE does not skip the row. The refusal is not an ignorable
# error, because ALTER's copy treats every ignorable error as a
# duplicate key.
INSERT IGNORE INTO t VALUES (2, STRING_TO_VECTOR('[1,2,3]'));
ERROR HY000: Column 'v' has a vector without the 4 dimensions its vector index needs.
# Under IGNORE a duplicate key is still skipped, but a row the vector
# index refuses fails the whole statement: nothing below is inserted,
# not even the good row.
INSERT IGNORE INTO t VALUES (1, STRING_TO_VECTOR('[9,0,0,0]')),
(20, STRING_TO_VECTOR('[2,0,0,0]')),
(21, STRING_TO_VECTOR('[1,2]'));
ERROR HY000: Column 'v' has a vector without the 4 dimensions its vector index needs.
SELECT id, VECTOR_TO_STRING(v) FROM t ORDER BY id;
id	VECTOR_TO_STRING(v)
1	[1.00000e+00,0.00000e+00,0.00000e+00,0.00000e+00]
# Without the short row, IGNORE behaves as usual.
INSERT IGNORE INTO t VALUES (1, STRING_TO_VECTOR('[9,0,0,0]')),
(20, STRING_TO_VECTOR('[2,0,0,0]'));
Warnings:
Warning	1062	Duplicate entry '1' for key 't.PRIMARY'
SELECT id FROM t ORDER BY id;
id
1
20
DELETE FROM t WHERE id = 20;
# A multi-row INSERT fails as a whole.
INSERT INTO t VALUES (3, STRING_TO_VECTOR('[3,0,0,0]')),
(4, STRING_TO_VECTOR('[4,0]'));
ERROR HY000: Column 'v' has a vector without the 4 dimensions its vector index needs.
SELECT id, LENGTH(v) FROM t ORDER BY id;
id	LENGTH(v)
1	16
# The index still answers.
SELECT id FROM t
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id
1
# PS-11583: UPDATE, and INSERT ... ON DUPLICATE KEY UPDATE, which is an
# UPDATE of the existing row. The statement is rolled back, so the row
# keeps its old value.
UPDATE t SET v = STRING_TO_VECTOR('[1,2]') WHERE id = 1;
ERROR HY000: Column 'v' has a vector without the 4 dimensions its vector index needs.
SHOW WARNINGS;
Level	Code	Message
Error	7040	Column 'v' has a vector without the 4 dimensions its vector index needs.
INSERT INTO t (id, v) VALUES (1, STRING_TO_VECTOR('[1,2]'))
ON DUPLICATE KEY UPDATE v = VALUES(v);
ERROR HY000: Column 'v' has a vector without the 4 dimensions its vector index needs.
# REPLACE on a primary-key conflict is an update of the row; its
# delete-and-insert path is at the end.
REPLACE INTO t VALUES (1, STRING_TO_VECTOR('[1,2]'));
ERROR HY000: Column 'v' has a vector without the 4 dimensions its vector index needs.
SELECT id, VECTOR_TO_STRING(v) FROM t ORDER BY id;
id	VECTOR_TO_STRING(v)
1	[1.00000e+00,0.00000e+00,0.00000e+00,0.00000e+00]
SELECT id FROM t
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id
1
# An empty value has no dimensions at all. Non-strict mode and IGNORE
# turn a missing, NULL or too-long value into one, and it used to be
# stored with no graph node - or, on UPDATE, to abort a debug server.
SET sql_mode = '';
INSERT INTO t VALUES (6, STRING_TO_VECTOR('[1,0,0,0,0]'));
ERROR HY000: Column 'v' has a vector without the 4 dimensions its vector index needs.
INSERT INTO t (id) VALUES (7);
ERROR HY000: Column 'v' has a vector without the 4 dimensions its vector index needs.
UPDATE t SET v = NULL WHERE id = 1;
ERROR HY000: Column 'v' has a vector without the 4 dimensions its vector index needs.
SET sql_mode = DEFAULT;
INSERT IGNORE INTO t VALUES (8, NULL);
ERROR HY000: Column 'v' has a vector without the 4 dimensions its vector index needs.
UPDATE IGNORE t SET v = NULL WHERE id = 1;
ERROR HY000: Column 'v' has a vector without the 4 dimensions its vector index needs.
SELECT id, LENGTH(v) FROM t ORDER BY id;
id	LENGTH(v)
1	16
SELECT COUNT(*) FROM
(SELECT id FROM t
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0,0,0]'), 'EUCLIDEAN') LIMIT 10) d;
COUNT(*)
1
DROP TABLE t;
#
# REPLACE on a conflict with another unique key deletes the conflicting
# row and inserts the new one. The index must follow that, and a short
# vector is refused there too, leaving the old row in place.
#
CREATE TABLE t_rep (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
u INT, UNIQUE KEY ku (u),
VECTOR KEY vk (v) TYPE hnsw (M = 8));
INSERT INTO t_rep VALUES (1, STRING_TO_VECTOR('[1,0,0,0]'), 10),
(2, STRING_TO_VECTOR('[2,0,0,0]'), 20);
# Primary-key conflict: an update of row 1.
REPLACE INTO t_rep VALUES (1, STRING_TO_VECTOR('[5,0,0,0]'), 10);
# Unique-key conflict: row 2 is deleted, row 3 inserted.
REPLACE INTO t_rep VALUES (3, STRING_TO_VECTOR('[7,0,0,0]'), 20);
SELECT id, u FROM t_rep ORDER BY id;
id	u
1	10
3	20
SELECT id FROM t_rep
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[7,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
id
3
1
SELECT id FROM t_rep IGNORE INDEX (vk)
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[7,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
id
3
1
SELECT id FROM t_rep
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[2,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id
1
REPLACE INTO t_rep VALUES (4, STRING_TO_VECTOR('[9,9]'), 20);
ERROR HY000: Column 'v' has a vector without the 4 dimensions its vector index needs.
SELECT id, u FROM t_rep ORDER BY id;
id	u
1	10
3	20
DROP TABLE t_rep;
