#
# PS-11299: INSTANT_VIRTUAL_ONLY ALTER on a vec-indexed table
# must preserve the hidden percona_vec_aux_id column in dd::Table.
#
# Trigger: ALTER ADD COLUMN ... AS (expr) VIRTUAL on a table that
# has a vector index. The new dd::Table is rebuilt from
# altered_table->s, which carries no SE-hidden columns, so
# percona_vec_aux_id must be re-added explicitly. A reload that
# does not find it (server restart, or any dd_open_table_one path)
# hits the vec_add_aux_id_column invariant.
#
# Phase 1 refuses ALGORITHM=INSTANT on a vector-indexed table, so
# this ALTER takes the INPLACE path. The INSTANT_VIRTUAL_ONLY branch
# in Instant_ddl_impl::commit_instant_ddl re-adds the column for the
# day that refusal is lifted; it is not what this test exercises.
#
CREATE TABLE t1 (
id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR(8) NOT NULL,
c1 INT,
VECTOR KEY (v) TYPE hnsw (M = 6)
);
# Add a virtual column — should take INSTANT_VIRTUAL_ONLY path.
ALTER TABLE t1 ADD COLUMN c1_plus_one INT AS (c1 + 1) VIRTUAL;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` bigint unsigned NOT NULL,
  `v` vector(8) NOT NULL,
  `c1` int DEFAULT NULL,
  `c1_plus_one` int GENERATED ALWAYS AS ((`c1` + 1)) VIRTUAL,
  PRIMARY KEY (`id`),
  VECTOR KEY `v` (`v`) USING `hnsw` (`M`=6)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Restart server. dd_open_table_one rebuilds dict_table_t from
# the dd::Table. percona_vec_aux_id must still be there.
# restart
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` bigint unsigned NOT NULL,
  `v` vector(8) NOT NULL,
  `c1` int DEFAULT NULL,
  `c1_plus_one` int GENERATED ALWAYS AS ((`c1` + 1)) VIRTUAL,
  PRIMARY KEY (`id`),
  VECTOR KEY `v` (`v`) USING `hnsw` (`M`=6)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# ALTER ADD another virtual column post-restart — percona_vec_aux_id
# must still be there.
ALTER TABLE t1 ADD COLUMN c1_plus_two INT AS (c1 + 2) VIRTUAL;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` bigint unsigned NOT NULL,
  `v` vector(8) NOT NULL,
  `c1` int DEFAULT NULL,
  `c1_plus_one` int GENERATED ALWAYS AS ((`c1` + 1)) VIRTUAL,
  `c1_plus_two` int GENERATED ALWAYS AS ((`c1` + 2)) VIRTUAL,
  PRIMARY KEY (`id`),
  VECTOR KEY `v` (`v`) USING `hnsw` (`M`=6)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t1;
