#
# innodb_hnsw_max_memory reached during a parallel INPLACE build must be
# reported as the ceiling, as on every other path.
#
# The build inserts into the graph on the scan threads, which have no
# session. The ceiling was reported from there through current_thd, so
# on a scan thread nothing was reported and the ALTER failed with the
# generic out-of-memory text instead - "check ulimit, add swap" - for a
# limit the user set. The scan thread now returns an error of its own
# for the ceiling, and the ALTER reports it like any other.
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL);
ALTER TABLE t1 ADD VECTOR KEY vk (v) TYPE hnsw (M = 8);
ALTER TABLE t1 DROP KEY vk;
# Enough leaf pages for the scan to be split across threads.
SET @@global.innodb_limit_optimistic_insert_debug = 2;
SET @@global.innodb_limit_optimistic_insert_debug = 0;
# A ceiling the pre-flight check passes and the first nodes cross.
SET @old_max = @@global.innodb_hnsw_max_memory;
SET GLOBAL innodb_hnsw_max_memory = 1;
SET SESSION innodb_parallel_read_threads = 8;
ALTER TABLE t1 ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ALGORITHM=INPLACE;
ERROR HY000: Memory capacity of 1 bytes for 'innodb_hnsw_max_memory' exceeded. The vector index graph was left unchanged. Raise innodb_hnsw_max_memory and retry.
SHOW WARNINGS;
Level	Code	Message
Error	3170	Memory capacity of 1 bytes for 'innodb_hnsw_max_memory' exceeded. The vector index graph was left unchanged. Raise innodb_hnsw_max_memory and retry.
SET SESSION innodb_parallel_read_threads = DEFAULT;
SET GLOBAL innodb_hnsw_max_memory = @old_max;
# Nothing was left behind, and with room the build succeeds.
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` bigint unsigned NOT NULL,
  `v` vector(4) NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
ALTER TABLE t1 ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ALGORITHM=INPLACE;
SELECT id FROM t1
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[500,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id
500
DROP TABLE t1;
