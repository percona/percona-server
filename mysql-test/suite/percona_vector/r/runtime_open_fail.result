#
# A vector index whose runtime could not be opened must not be
# silently skipped by DML.
#
# ha_innobase::open() does not fail the table open when
# vec_runtime_open() cannot build a runtime - the table has to stay
# readable and droppable, which is how it gets repaired. But the
# runtime lives on dict_index_t, so the index then has none for
# every session until the table is reopened, and an INSERT that
# skips it writes a row with a hidden label that no node is ever
# created under. The index answers without that row for good, and
# nothing reconciles the two afterwards.
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
k INT,
v VECTOR(4) NOT NULL,
VECTOR KEY vk (v) TYPE hnsw (M = 4));
INSERT INTO t1 VALUES (1, 0, STRING_TO_VECTOR('[1,0,0,0]')),
(2, 0, STRING_TO_VECTOR('[0,1,0,0]'));
# One node per row, and the index answers.
SELECT id FROM t1
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'euclidean') LIMIT 1;
id
1
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
nodes=2 distinct_ids=2 distinct_base_pks=2 dup_ids=0 dup_base_pks=0 labels_contiguous_from_1=1
# Drop the runtime, then refuse to build it again. The next
# statement is the one that opens the table.
# restart
SET DEBUG = '+d,vec_runtime_open_fail';
#
# INSERT fails rather than writing a row the index will never have.
#
INSERT INTO t1 VALUES (3, 0, STRING_TO_VECTOR('[0,0,1,0]'));
ERROR HY000: Out of memory; check if mysqld or some other process uses all available memory; if not, you may have to use 'ulimit' to allow mysqld to use more memory or you can add more swap space
#
# UPDATE of the vector column, the same: calc_row_difference has
# already given the row a fresh label, so skipping the graph would
# strand the row exactly as an INSERT would.
#
UPDATE t1 SET v = STRING_TO_VECTOR('[0,0,0,1]') WHERE id = 2;
ERROR HY000: Out of memory; check if mysqld or some other process uses all available memory; if not, you may have to use 'ulimit' to allow mysqld to use more memory or you can add more swap space
#
# Changing the primary key is graph work too - the node carries the
# base row's key, which is what a search returns - so it is refused
# for the same reason.
#
UPDATE t1 SET id = 20 WHERE id = 2;
ERROR HY000: Out of memory; check if mysqld or some other process uses all available memory; if not, you may have to use 'ulimit' to allow mysqld to use more memory or you can add more swap space
#
# An UPDATE that touches neither the vector nor the key has nothing
# to maintain, and goes through.
#
UPDATE t1 SET k = 5 WHERE id = 2;
SELECT id, k FROM t1 FORCE INDEX (PRIMARY) ORDER BY id;
id	k
1	0
2	5
#
# And the read path says so too, rather than reporting a table with
# nothing near the query vector.
#
# The LIMIT has to stay under the table's two rows. One that reaches
# the whole table leaves the optimizer free to answer from a scan,
# which never opens the runtime and so never reaches the failure
# this checks - the statement would just succeed.
#
SELECT id FROM t1
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'euclidean') LIMIT 1;
ERROR HY000: Out of memory; check if mysqld or some other process uses all available memory; if not, you may have to use 'ulimit' to allow mysqld to use more memory or you can add more swap space
SET DEBUG = '-d,vec_runtime_open_fail';
#
# Nothing was lost. The reason recorded was an allocation failure,
# which a later open can get past, and once it does the statements
# that were refused go through and the index has every row.
#
# restart
INSERT INTO t1 VALUES (3, 0, STRING_TO_VECTOR('[0,0,1,0]'));
UPDATE t1 SET v = STRING_TO_VECTOR('[0,0,0,1]') WHERE id = 2;
SELECT id FROM t1
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0,1,0]'), 'euclidean') LIMIT 1;
id
3
SELECT id FROM t1
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0,0,1]'), 'euclidean') LIMIT 1;
id
2
# Four nodes for three rows: the UPDATE above gave row 2 a fresh
# label, and the node under its old label stays. That orphan is what
# the design accepts for an UPDATE, so dup_base_pks=1 here is the
# expected shape, not a defect.
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
nodes=4 distinct_ids=4 distinct_base_pks=3 dup_ids=0 dup_base_pks=1 labels_contiguous_from_1=0
DROP TABLE t1;
