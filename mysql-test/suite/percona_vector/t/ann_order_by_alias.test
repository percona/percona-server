--echo #
--echo # ORDER BY the alias of a select-list DISTANCE() uses the index the same
--echo # as ORDER BY the call itself.
--echo #
--echo # Whether the optimizer even looked at the ORDER BY depended on a list
--echo # of DISTANCE() calls that the select list does not add to, so the
--echo # alias form used the index only when some other DISTANCE() happened
--echo # to appear in WHERE.
--echo #

CREATE TABLE t (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
                VECTOR KEY vk (v) TYPE hnsw (M = 8));
INSERT INTO t VALUES (1, STRING_TO_VECTOR('[1,0,0,0]')),
                     (2, STRING_TO_VECTOR('[2,0,0,0]')),
                     (3, STRING_TO_VECTOR('[3,0,0,0]'));

--replace_column 10 # 11 #
EXPLAIN SELECT id, DISTANCE(v, STRING_TO_VECTOR('[0,0,0,0]'), 'EUCLIDEAN') AS d
  FROM t ORDER BY d LIMIT 2;
SELECT id, DISTANCE(v, STRING_TO_VECTOR('[0,0,0,0]'), 'EUCLIDEAN') AS d
  FROM t ORDER BY d LIMIT 2;

--echo # The same with an unrelated DISTANCE() in WHERE, which already did.
--replace_column 10 # 11 #
EXPLAIN SELECT id, DISTANCE(v, STRING_TO_VECTOR('[0,0,0,0]'), 'EUCLIDEAN') AS d
  FROM t WHERE DISTANCE(v, STRING_TO_VECTOR('[9,0,0,0]'), 'EUCLIDEAN') > 0
  ORDER BY d LIMIT 2;

--echo # And by position.
--replace_column 10 # 11 #
EXPLAIN SELECT id, DISTANCE(v, STRING_TO_VECTOR('[0,0,0,0]'), 'EUCLIDEAN') AS d
  FROM t ORDER BY 2 LIMIT 2;

--echo # Through a view: the ORDER BY names the view's DISTANCE() column, and
--echo # the plan's own check must look through the view reference too.
CREATE VIEW vw AS
  SELECT id, DISTANCE(v, STRING_TO_VECTOR('[0,0,0,0]'), 'EUCLIDEAN') AS d
  FROM t;
--replace_column 10 # 11 #
EXPLAIN SELECT id FROM vw ORDER BY d LIMIT 2;
SELECT id FROM vw ORDER BY d LIMIT 2;
SELECT id FROM t IGNORE INDEX (vk)
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0,0,0]'), 'EUCLIDEAN') LIMIT 2;
DROP VIEW vw;

--echo # A query with no DISTANCE() at all is untouched.
--replace_column 10 # 11 #
EXPLAIN SELECT id FROM t ORDER BY id LIMIT 2;

DROP TABLE t;
