--source include/have_debug.inc

--echo #
--echo # PS-11907: A failed INSERT can leave the saved HNSW graph naming a
--echo #           node that has no row; after a restart the index is declared
--echo #           corrupt.
--echo #
--echo # An INSERT whose aux write fails must leave no trace in the saved graph.
--echo #
--echo # The failed node is already linked into its neighbours' in-memory
--echo # lists when its own row fails to be written. Later inserts save those
--echo # lists, so the saved graph must not name the failed node: after a
--echo # restart, a walk that reaches it would find no row and declare the
--echo # index corrupt.
--echo #

--disable_query_log
call mtr.add_suppression("The table 't1' is full");
--enable_query_log

CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY AUTO_INCREMENT,
                 v VECTOR(8) NOT NULL,
                 VECTOR KEY vk (v) TYPE hnsw (M = 8));

--echo # n rows from a fixed sequence, one statement each.
DELIMITER |;
CREATE PROCEDURE add_rows(seq INT, n INT)
BEGIN
  DECLARE i INT DEFAULT seq;
  WHILE i < seq + n DO
    INSERT INTO t1 (v) VALUES (STRING_TO_VECTOR(CONCAT('[',
      SIN(i * 1.1), ',', COS(i * 1.7), ',', SIN(i * 2.3), ',',
      COS(i * 2.9), ',', SIN(i * 3.7), ',', COS(i * 4.3), ',',
      SIN(i * 5.1), ',', COS(i * 5.9), ']')));
    SET i = i + 1;
  END WHILE;
END|
DELIMITER ;|

--echo # Every row, as the index returns them.
DELIMITER |;
CREATE PROCEDURE ann_all()
BEGIN
  SELECT COUNT(*) AS ann_rows FROM (
    SELECT id FROM t1 FORCE INDEX (vk)
     ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0,0,0,0,0,0,0]'), 'euclidean')
     LIMIT 100000) AS x;
END|
DELIMITER ;|

CALL add_rows(1, 300);

--echo # 20 times: one INSERT fails on its aux write, then 5 succeed.
--disable_query_log
--let $i = 0
while ($i < 20)
{
  SET DEBUG = '+d,vec_aux_insert_transient_fail';
  --error ER_RECORD_FILE_FULL
  eval CALL add_rows(1000 + $i, 1);
  SET DEBUG = '-d,vec_aux_insert_transient_fail';
  eval CALL add_rows(2000 + $i * 5, 5);
  --inc $i
}
--enable_query_log

SELECT COUNT(*) FROM t1;
CALL ann_all();

--source include/restart_mysqld.inc

--echo # After the restart the index takes rows and finds every row.
CALL add_rows(3000, 20);
SELECT COUNT(*) FROM t1;
CALL ann_all();
INSERT INTO t1 VALUES (10000, STRING_TO_VECTOR('[9,9,9,9,9,9,9,9]'));
SELECT id FROM t1 FORCE INDEX (vk)
 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[9,9,9,9,9,9,9,8]'), 'euclidean')
 LIMIT 1;
CHECK TABLE t1;

DROP PROCEDURE add_rows;
DROP PROCEDURE ann_all;
DROP TABLE t1;
