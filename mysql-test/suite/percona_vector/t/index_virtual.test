--echo #
--echo # PS-11751: VIRTUAL generated column returns a stale, identical value for
--echo #           every row when read through an HNSW vector index (ANN query).
--echo #
--echo #
--echo # Virtual generated columns must be computed for rows returned by
--echo # the vector index scan. The scan read rows without computing them, so
--echo # a VIRTUAL column kept whatever value was left in the record buffer:
--echo # the select list showed a stale, repeating value and a WHERE filter on
--echo # it rejected or accepted the wrong rows. STORED columns were fine.
--echo #

CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
  g INT GENERATED ALWAYS AS (id * 2) VIRTUAL,
  s INT GENERATED ALWAYS AS (id * 3) STORED,
  VECTOR KEY vk (v) TYPE hnsw (M = 8));

# insert ids 1..50 with v = [id,0,0,0]
INSERT INTO t1 (id, v)
WITH RECURSIVE ids (id) AS (
    SELECT 1
    UNION ALL
    SELECT id + 1
    FROM ids
    WHERE id < 50
)
SELECT
    id,
    STRING_TO_VECTOR(CONCAT('[', id, ',0,0,0]'))
FROM ids;

# The query vector [33.4,0,0,0] is off the grid, so no two rows are at the
# same distance from it and the order of the result is deterministic:
# 33 (0.4), 34 (0.6), 32 (1.4), 35 (1.6), 31 (2.4), 36 (2.6), ...

--echo # Virtual column in the select list must be computed for each row
--echo # returned by the vector index scan.
--replace_column 10 # 11 #
EXPLAIN SELECT id, g, s FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
SELECT id, g, s FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
SELECT id, g, s FROM t1 IGNORE INDEX (vk) ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3;

--echo # Virtual column used in a WHERE filter on top of the vector index scan.
--replace_column 10 # 11 #
EXPLAIN SELECT id, g, s FROM t1 WHERE g > 66 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
SELECT id, g, s FROM t1 WHERE g > 66 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
SELECT id, g, s FROM t1 IGNORE INDEX (vk) WHERE g > 66 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3;

SELECT id, g, s FROM t1 WHERE g % 4 = 0 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
SELECT id, g, s FROM t1 IGNORE INDEX (vk) WHERE g % 4 = 0 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3;

DROP TABLE t1;

--echo #
--echo # Virtual column which is also indexed by a secondary index, read
--echo # through the vector index, including locking reads. The row comes
--echo # from the clustered index, so the secondary index does not provide
--echo # the value: it must be computed for every row.
--echo #
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
  a INT NOT NULL DEFAULT 0,
  g INT GENERATED ALWAYS AS (id * 2 + a) VIRTUAL,
  KEY kg (g),
  VECTOR KEY vk (v) TYPE hnsw (M = 8));

INSERT INTO t1 (id, v)
WITH RECURSIVE ids (id) AS (
    SELECT 1
    UNION ALL
    SELECT id + 1
    FROM ids
    WHERE id < 50
)
SELECT
    id,
    STRING_TO_VECTOR(CONCAT('[', id, ',0,0,0]'))
FROM ids;
UPDATE t1 SET a = 100 WHERE id IN (32, 35);

--replace_column 10 # 11 #
EXPLAIN SELECT id, g FROM t1 WHERE g > 66 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
SELECT id, g FROM t1 WHERE g > 66 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
SELECT id, g FROM t1 IGNORE INDEX (vk) WHERE g > 66 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3;

--replace_column 10 # 11 #
EXPLAIN SELECT id, g FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3 FOR UPDATE;
BEGIN;
SELECT id, g FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3 FOR UPDATE;
ROLLBACK;
BEGIN;
SELECT id, g FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3 FOR SHARE;
ROLLBACK;
SELECT id, g FROM t1 IGNORE INDEX (vk) ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3;

DROP TABLE t1;

--echo #
--echo # Multi-table UPDATE/DELETE. ORDER BY ... LIMIT is not allowed there, so
--echo # the vector index is used in a derived table or subquery, which reads
--echo # virtual columns through it; the updated table itself is read by
--echo # PRIMARY KEY. t1/t2 run each statement through the vector index,
--echo # u1/u2 run the same statement with IGNORE INDEX (vk).
--echo #
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
  a INT NOT NULL DEFAULT 0,
  g INT GENERATED ALWAYS AS (id * 2 + a) VIRTUAL,
  KEY kg (g),
  VECTOR KEY vk (v) TYPE hnsw (M = 8));
INSERT INTO t1 (id, v)
WITH RECURSIVE ids (id) AS (
    SELECT 1
    UNION ALL
    SELECT id + 1
    FROM ids
    WHERE id < 50
)
SELECT
    id,
    STRING_TO_VECTOR(CONCAT('[', id, ',0,0,0]'))
FROM ids;
CREATE TABLE t2 (id BIGINT UNSIGNED PRIMARY KEY, b INT NOT NULL);
INSERT INTO t2 SELECT id, 0 FROM t1;
CREATE TABLE u1 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
  a INT NOT NULL DEFAULT 0,
  g INT GENERATED ALWAYS AS (id * 2 + a) VIRTUAL,
  KEY kg (g),
  VECTOR KEY vk (v) TYPE hnsw (M = 8));
INSERT INTO u1 (id, v)
WITH RECURSIVE ids (id) AS (
    SELECT 1
    UNION ALL
    SELECT id + 1
    FROM ids
    WHERE id < 50
)
SELECT
    id,
    STRING_TO_VECTOR(CONCAT('[', id, ',0,0,0]'))
FROM ids;
CREATE TABLE u2 (id BIGINT UNSIGNED PRIMARY KEY, b INT NOT NULL);
INSERT INTO u2 SELECT id, 0 FROM u1;

--replace_column 10 # 11 #
EXPLAIN UPDATE t2 JOIN (SELECT id, g FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3) d USING (id) SET t2.b = d.g;
UPDATE t2 JOIN (SELECT id, g FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3) d USING (id) SET t2.b = d.g;
--disable_query_log
UPDATE u2 JOIN (SELECT id, g FROM u1 IGNORE INDEX (vk) ORDER BY DISTANCE(v, STRING_TO_VECTOR('[33.4,0,0,0]'), 'EUCLIDEAN') LIMIT 3) d USING (id) SET u2.b = d.g;
--enable_query_log

--replace_column 10 # 11 #
EXPLAIN UPDATE t1 JOIN (SELECT id FROM t1 WHERE g > 0 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[20.4,0,0,0]'), 'EUCLIDEAN') LIMIT 2) d USING (id) SET t1.a = t1.a + 100;
UPDATE t1 JOIN (SELECT id FROM t1 WHERE g > 0 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[20.4,0,0,0]'), 'EUCLIDEAN') LIMIT 2) d USING (id) SET t1.a = t1.a + 100;
--disable_query_log
UPDATE u1 JOIN (SELECT id FROM u1 IGNORE INDEX (vk) WHERE g > 0 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[20.4,0,0,0]'), 'EUCLIDEAN') LIMIT 2) d USING (id) SET u1.a = u1.a + 100;
--enable_query_log

--replace_column 10 # 11 #
EXPLAIN UPDATE /*+ JOIN_ORDER(t2, t1) */ t1, t2 SET t1.a = t1.a + 7, t2.b = t1.g WHERE t1.id = t2.id AND t1.id IN (SELECT id FROM (SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[5.4,0,0,0]'), 'EUCLIDEAN') LIMIT 2) x);
UPDATE /*+ JOIN_ORDER(t2, t1) */ t1, t2 SET t1.a = t1.a + 7, t2.b = t1.g WHERE t1.id = t2.id AND t1.id IN (SELECT id FROM (SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[5.4,0,0,0]'), 'EUCLIDEAN') LIMIT 2) x);
--disable_query_log
UPDATE u1, u2 SET u1.a = u1.a + 7, u2.b = u1.g WHERE u1.id = u2.id AND u1.id IN (SELECT id FROM (SELECT id FROM u1 IGNORE INDEX (vk) ORDER BY DISTANCE(v, STRING_TO_VECTOR('[5.4,0,0,0]'), 'EUCLIDEAN') LIMIT 2) x);
--enable_query_log

--replace_column 10 # 11 #
EXPLAIN UPDATE t2 SET b = (SELECT g FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[25.4,0,0,0]'), 'EUCLIDEAN') LIMIT 1) WHERE id = 1;
UPDATE t2 SET b = (SELECT g FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[25.4,0,0,0]'), 'EUCLIDEAN') LIMIT 1) WHERE id = 1;
--disable_query_log
UPDATE u2 SET b = (SELECT g FROM u1 IGNORE INDEX (vk) ORDER BY DISTANCE(v, STRING_TO_VECTOR('[25.4,0,0,0]'), 'EUCLIDEAN') LIMIT 1) WHERE id = 1;
--enable_query_log

--replace_column 10 # 11 #
EXPLAIN DELETE t1 FROM t1 JOIN (SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[40.4,0,0,0]'), 'EUCLIDEAN') LIMIT 2) d USING (id);
DELETE t1 FROM t1 JOIN (SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[40.4,0,0,0]'), 'EUCLIDEAN') LIMIT 2) d USING (id);
--disable_query_log
DELETE u1 FROM u1 JOIN (SELECT id FROM u1 IGNORE INDEX (vk) ORDER BY DISTANCE(v, STRING_TO_VECTOR('[40.4,0,0,0]'), 'EUCLIDEAN') LIMIT 2) d USING (id);
--enable_query_log

--replace_column 10 # 11 #
EXPLAIN DELETE t2 FROM t2 JOIN (SELECT id, g FROM t1 WHERE g > 90 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[45.4,0,0,0]'), 'EUCLIDEAN') LIMIT 2) d USING (id);
DELETE t2 FROM t2 JOIN (SELECT id, g FROM t1 WHERE g > 90 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[45.4,0,0,0]'), 'EUCLIDEAN') LIMIT 2) d USING (id);
--disable_query_log
DELETE u2 FROM u2 JOIN (SELECT id, g FROM u1 IGNORE INDEX (vk) WHERE g > 90 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[45.4,0,0,0]'), 'EUCLIDEAN') LIMIT 2) d USING (id);
--enable_query_log

SELECT id, a, g FROM t1 WHERE a > 0 ORDER BY id;
SELECT id, b FROM t2 WHERE b <> 0 ORDER BY id;
SELECT COUNT(*) FROM t1;
SELECT COUNT(*) FROM t2;
--echo # Same result with and without the vector index (both must be 0).
SELECT COUNT(*) FROM ((SELECT id, a, g FROM t1 EXCEPT SELECT id, a, g FROM u1)
  UNION ALL (SELECT id, a, g FROM u1 EXCEPT SELECT id, a, g FROM t1)) d;
SELECT COUNT(*) FROM ((SELECT id, b FROM t2 EXCEPT SELECT id, b FROM u2)
  UNION ALL (SELECT id, b FROM u2 EXCEPT SELECT id, b FROM t2)) d;
CHECK TABLE t1;

DROP TABLE t1, t2, u1, u2;

--echo #
--echo # Error in a virtual column expression for a row returned by the
--echo # vector index scan is reported as it is for any other access path.
--echo # The column is added after the rows, so the bad row could be stored.
--echo #
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
  j VARCHAR(20), VECTOR KEY vk (v) TYPE hnsw (M = 8));
INSERT INTO t1 (id, v, j) VALUES
  (1, STRING_TO_VECTOR('[1,0,0,0]'), '{"a": 1}'),
  (2, STRING_TO_VECTOR('[2,0,0,0]'), '{"a": 2}'),
  (3, STRING_TO_VECTOR('[3,0,0,0]'), 'not json');
ALTER TABLE t1 ADD COLUMN g INT GENERATED ALWAYS AS (JSON_EXTRACT(j, '$.a')) VIRTUAL, ALGORITHM=INPLACE;

--echo # Rows 1 and 2 are nearest and fine.
SELECT id, g FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 2;
--error ER_INVALID_JSON_TEXT_IN_PARAM
SELECT id, g FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
SHOW WARNINGS;
--error ER_INVALID_JSON_TEXT_IN_PARAM
SELECT id, g FROM t1 IGNORE INDEX (vk) ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
SHOW WARNINGS;

DROP TABLE t1;
