--source include/have_debug_sync.inc

--echo #
--echo # PS-11756: a vector scan is ended through the handler API while its
--echo # statement is still running.
--echo #
--echo # VectorSearchIterator used to call handler::vec_init() directly, and
--echo # InnoDB's vec_init() called rnd_init() directly, so handler::inited
--echo # stayed NONE for the whole scan. The executor's ha_index_or_rnd_end()
--echo # (from JOIN::cleanup() and from the iterator's destructor) then did
--echo # nothing, and the open scan, which holds the aux table, was only closed
--echo # at statement cleanup, by ha_reset() -> end_stmt().
--echo #
--echo # The iterator now calls ha_index_init() on the vector key, then
--echo # vec_init(), so ha_index_or_rnd_end() reaches index_end(), which
--echo # closes the scan. The sync point ib_vec_scan_closed fires in
--echo # index_end() only when it closes an open scan. Each case below parks
--echo # the statement there and checks that it is still running. Without
--echo # the fix the sync point is never reached: the wait below times out and
--echo # the statement has already finished.
--echo #

CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
                 v VECTOR(2) NOT NULL,
                 VECTOR KEY vk (v) TYPE hnsw (M = 4));
INSERT INTO t1 VALUES (1, STRING_TO_VECTOR('[0,0]')),
                      (2, STRING_TO_VECTOR('[1,0]')),
                      (3, STRING_TO_VECTOR('[3,0]')),
                      (4, STRING_TO_VECTOR('[6,0]'));

--connect (con1, localhost, root,,)
--let $con1_id = `SELECT CONNECTION_ID()`

--echo # 1. Scan abandoned early: LIMIT is satisfied from the first batch,
--echo #    so vec_read_next is never called again.
--connection con1
--replace_regex /cost=[0-9.e+-]+ /cost=X / /rows=[0-9.e+-]+/rows=X/
EXPLAIN FORMAT=TREE SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 1;
SET DEBUG_SYNC = 'ib_vec_scan_closed SIGNAL scan_closed WAIT_FOR go';
--send SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 1

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR scan_closed TIMEOUT 30';
--echo # The scan is closed and the SELECT is still the running statement.
--replace_result $con1_id CON1_ID
--eval SELECT command, state, info FROM performance_schema.processlist WHERE id = $con1_id
SET DEBUG_SYNC = 'now SIGNAL go';

--connection con1
--reap

--echo # 2. Scan run to exhaustion: the filter rejects every candidate, so
--echo #    the scan reads the whole graph and returns no rows.
--replace_regex /cost=[0-9.e+-]+ /cost=X / /rows=[0-9.e+-]+/rows=X/
EXPLAIN FORMAT=TREE SELECT id FROM t1 WHERE id > 100 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 2;
SET DEBUG_SYNC = 'ib_vec_scan_closed SIGNAL scan_closed WAIT_FOR go';
--send SELECT id FROM t1 WHERE id > 100 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 2

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR scan_closed TIMEOUT 30';
--replace_result $con1_id CON1_ID
--eval SELECT command, state, info FROM performance_schema.processlist WHERE id = $con1_id
SET DEBUG_SYNC = 'now SIGNAL go';

--connection con1
--reap
SET DEBUG_SYNC = 'RESET';
--disconnect con1

--connection default
SET DEBUG_SYNC = 'RESET';
DROP TABLE t1;
