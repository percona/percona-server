#
# 3) Test users with hostname other than 'localhost'.
#
CREATE USER foo@'%' IDENTIFIED BY 'foo' FAILED_LOGIN_ATTEMPTS 2 PASSWORD_LOCK_TIME 2;
CREATE USER foo@'santa.claus.ipv4.example.com' IDENTIFIED BY 'foo' FAILED_LOGIN_ATTEMPTS 2 PASSWORD_LOCK_TIME 4;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user = 'foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	santa.claus.ipv4.example.com	YES	2	4	NO	2	0
foo	%	YES	2	2	NO	2	0

# Try to connect to locally.
ERROR 28000: Access denied for user 'foo'@'localhost' (using password: NO)
connection default;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	santa.claus.ipv4.example.com	YES	2	4	NO	2	0
foo	%	YES	2	2	NO	1	0

# Now simulate external connection.
SET GLOBAL debug= "+d,vio_peer_addr_fake_ipv4,getnameinfo_fake_ipv4,getaddrinfo_fake_good_ipv4";
ERROR 28000: Access denied for user 'foo'@'santa.claus.ipv4.example.com' (using password: NO)
connection default;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	santa.claus.ipv4.example.com	YES	2	4	NO	1	0
foo	%	YES	2	2	NO	1	0

# Yet another failed remote login attempt should lead to account being locked.
ERROR HY000: Access denied for user 'foo'@'santa.claus.ipv4.example.com'. Account is blocked for 4 day(s) (4 day(s) remaining) due to 2 consecutive failed logins.
connection default;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	santa.claus.ipv4.example.com	YES	2	4	YES	0	4
foo	%	YES	2	2	NO	1	0
SET GLOBAL debug= "-d,vio_peer_addr_fake_ipv4,getnameinfo_fake_ipv4,getaddrinfo_fake_good_ipv4";
DROP USER foo@'%';
DROP USER foo@'santa.claus.ipv4.example.com';
#
# 4) Test that performance_schema.account_failed_login_lock_status is not world readable.
#
CREATE USER foo@localhost;
connect con_foo,localhost,foo,,test;

# Check that P_S is accessible in general, e.g. by accessing session_status table.
SELECT * FROM performance_schema.session_status;

# However, performance_schema.account_failed_login_lock_status should not be accessible.
SELECT * FROM performance_schema.account_failed_login_lock_status;
ERROR 42000: SELECT command denied to user 'foo'@'localhost' for table 'account_failed_login_lock_status'
connection default;

# Granting SELECT privilege on the table should help.
GRANT SELECT ON performance_schema.account_failed_login_lock_status TO foo@localhost;
connection con_foo;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	NO	0	0	NULL	NULL	NULL
disconnect con_foo;
connection default;
DROP USER foo@localhost;
#
# 5) Finally, let us check how account_failed_login_status P_S table works
#    in --skip-grant-tables mode.
#
# restart:--skip-grant-tables

# In --skip-grant-tables mode we simply return empty table.
SELECT * FROM performance_schema.account_failed_login_lock_status;
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
# restart:
