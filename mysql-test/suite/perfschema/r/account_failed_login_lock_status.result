#
# Test coverage for PS-8980 / p_s.account_failed_login_lock_status table.
#
# There is additional test coverage in schema, table_schema, index_schema
# and dml/ddl/idx_account_failed_login_lock_status tests in perfschema
# suite.
#
# 1) Check contents of the table in various scenario.
#
#
# 1.1) User with failed login tracking disabled (default case).
#
CREATE USER foo@localhost IDENTIFIED BY 'foo';

# Prior to any logins.
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	NO	0	0	NULL	NULL	NULL

# After successful login.
connect con_ok,localhost,foo,foo,test;
disconnect con_ok;
connection default;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	NO	0	0	NULL	NULL	NULL

# After failed login.
ERROR 28000: Access denied for user 'foo'@'localhost' (using password: NO)
connection default;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	NO	0	0	NULL	NULL	NULL
DROP USER foo@localhost;
#
# 1.2) User with failed login tracking enabled.
#
CREATE USER foo@localhost IDENTIFIED BY 'foo' FAILED_LOGIN_ATTEMPTS 2 PASSWORD_LOCK_TIME 3;

# Prior to any logins.
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	YES	2	3	NO	2	0

# After successful login.
connect con_ok,localhost,foo,foo,test;
disconnect con_ok;
connection default;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	YES	2	3	NO	2	0

# After failed login, not locked yet.
ERROR 28000: Access denied for user 'foo'@'localhost' (using password: NO)
connection default;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	YES	2	3	NO	1	0

# Since it is not locked yet, failure count should be reset by successful connect.
connect con_ok,localhost,foo,foo,test;
disconnect con_ok;
connection default;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	YES	2	3	NO	2	0

# Now let us see what happens when two failed attempts to login lead
# to account locking.
ERROR 28000: Access denied for user 'foo'@'localhost' (using password: NO)
connection default;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	YES	2	3	NO	1	0

# The second attempt fails due to account being locked.
ERROR HY000: Access denied for user 'foo'@'localhost'. Account is blocked for 3 day(s) (3 day(s) remaining) due to 2 consecutive failed logins.
connection default;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	YES	2	3	YES	0	3

# The third attempt fails due to account being locked.
# P_S table contents should stay untouched.
ERROR HY000: Access denied for user 'foo'@'localhost'. Account is blocked for 3 day(s) (3 day(s) remaining) due to 2 consecutive failed logins.
connection default;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	YES	2	3	YES	0	3

# Even providing correct password should not help. P_S table content
# stays the same.
ERROR HY000: Access denied for user 'foo'@'localhost'. Account is blocked for 3 day(s) (3 day(s) remaining) due to 2 consecutive failed logins.
connection default;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	YES	2	3	YES	0	3

# ALTER USER ... ACCOUNT UNLOCK should reset failed login tracking state.
ALTER USER foo@localhost ACCOUNT UNLOCK;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	YES	2	3	NO	2	0

# We should be able to login with correct password after that.
connect con_ok,localhost,foo,foo,test;
disconnect con_ok;
connection default;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	YES	2	3	NO	2	0

# Again, failing to login twice should cause account being locked.
ERROR 28000: Access denied for user 'foo'@'localhost' (using password: NO)
connection default;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	YES	2	3	NO	1	0
ERROR HY000: Access denied for user 'foo'@'localhost'. Account is blocked for 3 day(s) (3 day(s) remaining) due to 2 consecutive failed logins.
connection default;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	YES	2	3	YES	0	3

# Let us test what happens when ten days pass.
# Account should become unlocked.
SET GLOBAL DEBUG = '+d,account_lock_daynr_add_ten';
ERROR 28000: Access denied for user 'foo'@'localhost' (using password: NO)
connection default;
SET GLOBAL DEBUG = '-d,account_lock_daynr_add_ten';
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	YES	2	3	NO	2	0

# We should be able to login with correct password after that.
connect con_ok,localhost,foo,foo,test;
disconnect con_ok;
connection default;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	YES	2	3	NO	2	0
DROP USER foo@localhost;

# Bonus: P_S table should not contain row once account has been deleted.
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
#
# 1.3) User with failed login tracking enabled and unlimited lock time.
#
CREATE USER foo@localhost IDENTIFIED BY 'foo' FAILED_LOGIN_ATTEMPTS 2 PASSWORD_LOCK_TIME UNBOUNDED;

# Prior to any logins.
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	YES	2	-1	NO	2	0

# After successful login.
connect con_ok,localhost,foo,foo,test;
disconnect con_ok;
connection default;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	YES	2	-1	NO	2	0

# After failed login, not locked yet.
ERROR 28000: Access denied for user 'foo'@'localhost' (using password: NO)
connection default;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	YES	2	-1	NO	1	0

# The second attempt fails due to account being locked.
ERROR HY000: Access denied for user 'foo'@'localhost'. Account is blocked for unlimited day(s) (unlimited day(s) remaining) due to 2 consecutive failed logins.
connection default;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	YES	2	-1	YES	0	-1

# Even after ten days pass account stays locked.
SET GLOBAL DEBUG = '+d,account_lock_daynr_add_ten';
ERROR HY000: Access denied for user 'foo'@'localhost'. Account is blocked for unlimited day(s) (unlimited day(s) remaining) due to 2 consecutive failed logins.
connection default;
SET GLOBAL DEBUG = '-d,account_lock_daynr_add_ten';
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	YES	2	-1	YES	0	-1

# Still ALTER USER ... ACCOUNT UNLOCK should reset failed login tracking state.
ALTER USER foo@localhost ACCOUNT UNLOCK;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	YES	2	-1	NO	2	0

# And we should be able to login with correct password after that.
connect con_ok,localhost,foo,foo,test;
disconnect con_ok;
connection default;
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user='foo';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo	localhost	YES	2	-1	NO	2	0
DROP USER foo@localhost;
#
# 2) Test various types of accesses to our P_S table.
#  
# The below statements invoke different methods implemented by
# our descendant of PFS_engine_table class.
#
# 2.1) Simple table scan.
CREATE USER foo1@localhost IDENTIFIED BY 'foo';
CREATE USER foo2@localhost IDENTIFIED BY 'foo';
EXPLAIN SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user LIKE 'foo%';
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	account_failed_login_lock_status	NULL	ALL	ACCOUNT	NULL	NULL	NULL	#	#	Using where
Warnings:
Note	1003	/* select#1 */ select `performance_schema`.`account_failed_login_lock_status`.`USER` AS `USER`,`performance_schema`.`account_failed_login_lock_status`.`HOST` AS `HOST`,`performance_schema`.`account_failed_login_lock_status`.`IS_TRACKING_ACTIVE` AS `IS_TRACKING_ACTIVE`,`performance_schema`.`account_failed_login_lock_status`.`MAX_ATTEMPTS` AS `MAX_ATTEMPTS`,`performance_schema`.`account_failed_login_lock_status`.`PASSWORD_LOCK_DAYS` AS `PASSWORD_LOCK_DAYS`,`performance_schema`.`account_failed_login_lock_status`.`IS_LOCKED` AS `IS_LOCKED`,`performance_schema`.`account_failed_login_lock_status`.`REMAINING_ATTEMPTS` AS `REMAINING_ATTEMPTS`,`performance_schema`.`account_failed_login_lock_status`.`REMAINING_DAYS_LOCKED` AS `REMAINING_DAYS_LOCKED` from `performance_schema`.`account_failed_login_lock_status` where (`performance_schema`.`account_failed_login_lock_status`.`USER` like 'foo%')
SELECT * FROM performance_schema.account_failed_login_lock_status WHERE user LIKE 'foo%';
USER	HOST	IS_TRACKING_ACTIVE	MAX_ATTEMPTS	PASSWORD_LOCK_DAYS	IS_LOCKED	REMAINING_ATTEMPTS	REMAINING_DAYS_LOCKED
foo1	localhost	NO	0	0	NULL	NULL	NULL
foo2	localhost	NO	0	0	NULL	NULL	NULL
