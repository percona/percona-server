# Defaults: collection OFF.
SHOW GLOBAL VARIABLES LIKE 'performance_schema_%latch_source%';
Variable_name	Value
performance_schema_latch_source_summary	OFF
performance_schema_max_latch_source_summaries	4096
UPDATE performance_schema.setup_instruments SET ENABLED = 'YES', TIMED = 'YES'
  WHERE NAME IN ('wait/synch/mutex/sql/MYSQL_BIN_LOG::LOCK_log',
'wait/synch/mutex/sql/DEBUG_SYNC::mutex',
'wait/synch/cond/sql/DEBUG_SYNC::cond');
# OFF: nothing is collected.
TRUNCATE TABLE performance_schema.events_waits_summary_by_source;
SHOW BINARY LOGS;
SELECT COUNT(*) FROM performance_schema.events_waits_summary_by_source;
COUNT(*)
0
# ON: collected.
SET GLOBAL performance_schema_latch_source_summary = SOURCE;
SHOW GLOBAL VARIABLES LIKE 'performance_schema_latch_source_summary';
Variable_name	Value
performance_schema_latch_source_summary	SOURCE
# con1 holds LOCK_log for at least 1.5 seconds, con2 waits for it.
SET DEBUG_SYNC = 'show_binlogs_after_lock_log_before_lock_index SIGNAL parked WAIT_FOR go';
SHOW BINARY LOGS;
SET DEBUG_SYNC = 'now WAIT_FOR parked';
SHOW BINARY LOGS;
SET DEBUG_SYNC = 'now SIGNAL go';
# The SHOW BINARY LOGS acquire site of LOCK_log.
SELECT EVENT_NAME, SOURCE LIKE 'rpl_source.cc:%' AS SOURCE_OK, OPERATION,
COUNT_STAR >= 2 AS COUNT_OK,
MAX_TIMER_WAIT >= 1000000000000 AS WAITED_1S,
COUNT_HOLD >= 2 AS COUNT_HOLD_OK,
MAX_TIMER_HOLD >= 1500000000000 AS HELD_1_5S,
SUM_TIMER_HOLD >= MAX_TIMER_HOLD AS SUM_OK,
MIN_TIMER_HOLD <= AVG_TIMER_HOLD AND AVG_TIMER_HOLD <= MAX_TIMER_HOLD
AS AVG_OK
FROM performance_schema.events_waits_summary_by_source
WHERE EVENT_NAME = 'wait/synch/mutex/sql/MYSQL_BIN_LOG::LOCK_log'
    AND SOURCE LIKE 'rpl_source.cc:%';
EVENT_NAME	SOURCE_OK	OPERATION	COUNT_OK	WAITED_1S	COUNT_HOLD_OK	HELD_1_5S	SUM_OK	AVG_OK
wait/synch/mutex/sql/MYSQL_BIN_LOG::LOCK_log	1	lock	1	1	1	1	1	1
# DEBUG_SYNC::mutex is released while waiting on DEBUG_SYNC::cond, so
# the waits of con1 and default are not counted as hold time.
SELECT COUNT(*) > 0 AS HAS_ROWS,
MAX(MAX_TIMER_HOLD) < 1000000000000 AS NOT_HELD_WHILE_WAITING
FROM performance_schema.events_waits_summary_by_source
WHERE EVENT_NAME = 'wait/synch/mutex/sql/DEBUG_SYNC::mutex';
HAS_ROWS	NOT_HELD_WHILE_WAITING
1	1
# OFF again: counts do not grow, rows stay.
SET GLOBAL performance_schema_latch_source_summary = OFF;
SHOW BINARY LOGS;
UNCHANGED
1
# TRUNCATE removes all rows and resets the counters.
TRUNCATE TABLE performance_schema.events_waits_summary_by_source;
SELECT COUNT(*) FROM performance_schema.events_waits_summary_by_source;
COUNT(*)
0
lost: 0, holds_lost: 0
# Rows are read only.
INSERT INTO performance_schema.events_waits_summary_by_source
SET EVENT_NAME = 'x', SOURCE = 'y', OPERATION = 'lock';
ERROR 42000: INSERT command denied to user 'root'@'localhost' for table 'events_waits_summary_by_source'
DELETE FROM performance_schema.events_waits_summary_by_source;
ERROR 42000: DELETE command denied to user 'root'@'localhost' for table 'events_waits_summary_by_source'
SET DEBUG_SYNC = 'RESET';
UPDATE performance_schema.setup_instruments SET ENABLED = 'YES', TIMED = 'YES'
  WHERE NAME IN ('wait/synch/mutex/sql/MYSQL_BIN_LOG::LOCK_log',
'wait/synch/mutex/sql/DEBUG_SYNC::mutex',
'wait/synch/cond/sql/DEBUG_SYNC::cond');
TRUNCATE TABLE performance_schema.events_waits_summary_by_source;
