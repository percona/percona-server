# Tests for PERFORMANCE_SCHEMA (Percona, PS-11822)

select * from performance_schema.events_waits_summary_by_source
  where event_name like 'XXYYZZ%' limit 1;

select * from performance_schema.events_waits_summary_by_source
  where event_name='XXYYZZ';

--error ER_TABLEACCESS_DENIED_ERROR
insert into performance_schema.events_waits_summary_by_source
  set event_name='XXYYZZ', source='x.cc:1', operation='lock', count_star=1;

--error ER_TABLEACCESS_DENIED_ERROR
update performance_schema.events_waits_summary_by_source
  set count_star=12;

--error ER_TABLEACCESS_DENIED_ERROR
update performance_schema.events_waits_summary_by_source
  set count_star=12 where event_name like "XXYYZZ";

--error ER_TABLEACCESS_DENIED_ERROR
delete from performance_schema.events_waits_summary_by_source
  where count_star=1;

--error ER_TABLEACCESS_DENIED_ERROR
delete from performance_schema.events_waits_summary_by_source;

-- error ER_TABLEACCESS_DENIED_ERROR
LOCK TABLES performance_schema.events_waits_summary_by_source READ;
UNLOCK TABLES;

-- error ER_TABLEACCESS_DENIED_ERROR
LOCK TABLES performance_schema.events_waits_summary_by_source WRITE;
UNLOCK TABLES;
