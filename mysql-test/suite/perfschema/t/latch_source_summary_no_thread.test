#
# PS-11822: with the thread_instrumentation consumer disabled, mutex waits
# are also instrumented in threads that have no performance schema thread,
# e.g. while a thread ends. Collecting them must not allocate memory there;
# the server crashed in my_thread_end() when collection was enabled at startup.
#

SELECT * FROM performance_schema.setup_consumers
  WHERE NAME = 'thread_instrumentation';
SHOW GLOBAL VARIABLES LIKE 'performance_schema_latch_source_summary';

UPDATE performance_schema.setup_instruments SET ENABLED = 'YES', TIMED = 'YES'
  WHERE NAME = 'wait/synch/mutex/sql/LOCK_status';

FLUSH STATUS;
--disable_result_log
SHOW GLOBAL STATUS LIKE 'Threads_connected';
--enable_result_log

SELECT COUNT(*) > 0 AS HAS_ROWS, SUM(COUNT_STAR) > 0 AS COUNTED
  FROM performance_schema.events_waits_summary_by_source
  WHERE EVENT_NAME = 'wait/synch/mutex/sql/LOCK_status';

--echo # Restart: threads that end during startup and shutdown are fine.
--source include/restart_mysqld.inc

SHOW GLOBAL VARIABLES LIKE 'performance_schema_latch_source_summary';
