#
# PS-11822: when TRUNCATE TABLE events_waits_summary_by_source cannot remove
# a row from the hash index (out of memory), the row must stay allocated with
# its key, so the index never points to a row reused for another key.
#

--source include/have_debug.inc

UPDATE performance_schema.setup_instruments SET ENABLED = 'YES', TIMED = 'YES'
  WHERE NAME = 'wait/synch/mutex/sql/LOCK_status';

TRUNCATE TABLE performance_schema.events_waits_summary_by_source;
SET GLOBAL performance_schema_latch_source_summary = SOURCE;
--disable_result_log
SHOW GLOBAL STATUS LIKE 'Threads_connected';
--enable_result_log
SET GLOBAL performance_schema_latch_source_summary = OFF;

let $rows = `SELECT COUNT(*) FROM performance_schema.events_waits_summary_by_source`;
let $count = `SELECT SUM(COUNT_STAR)
  FROM performance_schema.events_waits_summary_by_source
  WHERE EVENT_NAME = 'wait/synch/mutex/sql/LOCK_status'`;
--disable_query_log
eval SELECT $rows > 0 AS HAS_ROWS;
--enable_query_log

--echo # Hash delete fails: rows stay.
SET SESSION debug = '+d,latch_source_hash_delete_oom';
TRUNCATE TABLE performance_schema.events_waits_summary_by_source;
SET SESSION debug = '-d,latch_source_hash_delete_oom';
--disable_query_log
eval SELECT COUNT(*) = $rows AS ROWS_KEPT
  FROM performance_schema.events_waits_summary_by_source;
--enable_query_log

--echo # Collection still works and finds the kept rows.
SET GLOBAL performance_schema_latch_source_summary = SOURCE;
--disable_result_log
SHOW GLOBAL STATUS LIKE 'Threads_connected';
--enable_result_log
SET GLOBAL performance_schema_latch_source_summary = OFF;
--disable_query_log
eval SELECT COUNT(*) = $rows AS ROWS_REUSED
  FROM performance_schema.events_waits_summary_by_source;
eval SELECT SUM(COUNT_STAR) > $count AS COUNTED
  FROM performance_schema.events_waits_summary_by_source
  WHERE EVENT_NAME = 'wait/synch/mutex/sql/LOCK_status';
--enable_query_log

--echo # Normal TRUNCATE removes them.
TRUNCATE TABLE performance_schema.events_waits_summary_by_source;
SELECT COUNT(*) FROM performance_schema.events_waits_summary_by_source;
