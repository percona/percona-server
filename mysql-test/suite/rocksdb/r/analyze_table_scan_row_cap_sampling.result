# Row cap 900: index cardinality never exceeds the row count
SELECT index_name, cardinality <= 1000 AS within_row_count
FROM information_schema.statistics
WHERE table_schema = 'test' AND table_name = 't1'
    ORDER BY index_name, seq_in_index;
INDEX_NAME	within_row_count
khi	1
