CREATE TABLE t1 (pk INT PRIMARY KEY) ENGINE=ROCKSDB;
CREATE TABLE t2 (pk INT PRIMARY KEY) ENGINE=ROCKSDB;
CREATE TABLE t3 (pk INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE t4 (pk INT PRIMARY KEY) ENGINE=InnoDB;
SET rocksdb_bulk_load = 1;
INSERT INTO t1 VALUES (1), (2), (3);
# DDL of the table being loaded is refused
ALTER TABLE t1 ADD COLUMN c INT;
ERROR HY000: Lock acquisition refused by storage engine.
DROP TABLE t1;
ERROR HY000: Lock acquisition refused by storage engine.
# DDL of another MyRocks table succeeds
ALTER TABLE t2 ADD COLUMN c INT;
DROP TABLE t2;
CREATE TABLE t2 (pk INT PRIMARY KEY) ENGINE=ROCKSDB;
# DDL of InnoDB tables succeeds
ALTER TABLE t3 ADD COLUMN c INT;
DROP TABLE t4;
SET rocksdb_bulk_load = 0;
SELECT COUNT(*) FROM t1;
COUNT(*)
3
DROP TABLE t1, t2, t3;
