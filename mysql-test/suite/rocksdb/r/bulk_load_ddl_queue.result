CREATE TABLE t1 (a INT) ENGINE=InnoDB;
SET DEBUG_SYNC='alter_table_before_open_tables SIGNAL parked WAIT_FOR go';
ALTER TABLE t1 ADD COLUMN b INT;
SET DEBUG_SYNC='now WAIT_FOR parked';
# Pending DDL must not reject other DDL before metadata locking
CREATE INDEX ia ON t1(a);
SHOW WARNINGS;
Level	Code	Message
SET DEBUG_SYNC='now SIGNAL go';
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int DEFAULT NULL,
  `b` int DEFAULT NULL,
  KEY `ia` (`a`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t1;
SET DEBUG_SYNC='RESET';
