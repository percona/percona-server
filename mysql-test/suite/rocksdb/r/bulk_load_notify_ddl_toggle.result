#
# Switching rocksdb_skip_bulk_load_notify_ddl while a DDL runs must not
# leave its bulk-load session active, nor end another one.
#
CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=ROCKSDB;
CREATE TABLE t2 (a INT PRIMARY KEY) ENGINE=ROCKSDB;
# ON after PRE: POST still completes the DDL session
SET DEBUG_SYNC = 'alter_table_before_open_tables SIGNAL parked WAIT_FOR go';
ALTER TABLE t1 ADD COLUMN b INT, ALGORITHM=COPY;
SET DEBUG_SYNC = 'now WAIT_FOR parked';
SET GLOBAL rocksdb_skip_bulk_load_notify_ddl = ON;
SET DEBUG_SYNC = 'now SIGNAL go';
SET GLOBAL rocksdb_skip_bulk_load_notify_ddl = OFF;
SELECT TYPE, STATUS, TABLES FROM information_schema.rocksdb_bulk_load_history
WHERE STATUS = 'ACTIVE';
TYPE	STATUS	TABLES
ALTER TABLE t2 ADD COLUMN c INT;
SET rocksdb_bulk_load=1;
INSERT INTO t1 VALUES (1,1),(2,2);
SET rocksdb_bulk_load=0;
SELECT COUNT(*) FROM t1;
COUNT(*)
2
# DDL skipped at PRE must not complete the session's own bulk load
SET rocksdb_bulk_load=1;
INSERT INTO t2 VALUES (1,1),(2,2);
SET GLOBAL rocksdb_skip_bulk_load_notify_ddl = ON;
CREATE TABLE t3 (a INT PRIMARY KEY) ENGINE=ROCKSDB;
DROP TABLE t3;
SET GLOBAL rocksdb_skip_bulk_load_notify_ddl = OFF;
SELECT TYPE, STATUS, TABLES FROM information_schema.rocksdb_bulk_load_history
WHERE STATUS = 'ACTIVE';
TYPE	STATUS	TABLES
SST_FILE_WRITER	ACTIVE	test.t2
SET rocksdb_bulk_load=0;
SELECT COUNT(*) FROM t2;
COUNT(*)
2
SET DEBUG_SYNC = 'RESET';
DROP TABLE t1, t2;
