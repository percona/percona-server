CREATE TABLE gap5 (
pk int primary key,
a int,
b int,
key(a)
) ENGINE=rocksdb;
insert into gap5 values (1,1,1), (2,2,2), (3,3,3), (4,4,4);
create table gap6 like gap5;
insert into gap6 values (1,1,1), (2,2,2), (3,3,3), (4,4,4);
