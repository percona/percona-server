CREATE TABLE t (id INT PRIMARY KEY, b VARCHAR(36), KEY k(b)) ENGINE=RocksDB;
INSERT INTO t VALUES (1,'first-long-value'), (2,'last-long-value');
SET GLOBAL rocksdb_force_flush_memtable_now=1;
ANALYZE TABLE t;
Table	Op	Msg_type	Msg_text
test.t	analyze	status	OK
SET @saved_bounds=@@global.rocksdb_debug_skip_bloom_filter_check_on_iterator_bounds;
SET GLOBAL rocksdb_debug_skip_bloom_filter_check_on_iterator_bounds=ON;
SET optimizer_switch='mrr=off';
SET DEBUG_SYNC='rocksdb.check_flags_nwd SIGNAL first_read WAIT_FOR resume';
SELECT id FROM t FORCE INDEX(k) WHERE b IN ('first-long-value','last-long-value') ORDER BY id;
SET DEBUG_SYNC='now WAIT_FOR first_read';
SET GLOBAL rocksdb_debug_skip_bloom_filter_check_on_iterator_bounds=OFF;
SET DEBUG_SYNC='now SIGNAL resume';
id
1
2
SET GLOBAL rocksdb_debug_skip_bloom_filter_check_on_iterator_bounds=@saved_bounds;
SET DEBUG_SYNC='RESET';
DROP TABLE t;
