#
# The partitions of a partitioned table share the rec_per_key estimates
# of the table. ha_rocksdb::info() set them for every partition a
# statement used, so the estimates of the table were those of the
# partition that was read last, also if it had few rows or none.
# Now the partition with the most rows sets them, and only for a
# statement that uses all partitions.
#
SET SESSION information_schema_stats_expiry = 0;
SET @save_sampling_pct = @@global.rocksdb_table_stats_sampling_pct;
SET @save_cachetime = @@global.rocksdb_force_compute_memtable_stats_cachetime;
SET GLOBAL rocksdb_table_stats_sampling_pct = 100;
SET GLOBAL rocksdb_force_compute_memtable_stats_cachetime = 0;
CREATE TABLE t_driver (x INT PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO t_driver VALUES (1), (2), (3), (4), (5);
#
# 1. The last partition has 2 rows with different values of a, the
#    first one 1000 rows with the same value. Expected: about 1000 rows
#    for each value of a, as with InnoDB, and not 1.
#
CREATE TABLE t1 (pk INT, part_col INT, a INT, v INT,
PRIMARY KEY (pk, part_col), KEY ka (a)) ENGINE=ROCKSDB
PARTITION BY RANGE (part_col) (
PARTITION p0 VALUES LESS THAN (100),
PARTITION p1 VALUES LESS THAN MAXVALUE);
CREATE TABLE t1_innodb (pk INT, part_col INT, a INT, v INT,
PRIMARY KEY (pk, part_col), KEY ka (a)) ENGINE=InnoDB
PARTITION BY RANGE (part_col) (
PARTITION p0 VALUES LESS THAN (100),
PARTITION p1 VALUES LESS THAN MAXVALUE);
INSERT INTO t1 WITH RECURSIVE s (i) AS
(SELECT 1 UNION ALL SELECT i + 1 FROM s WHERE i < 1000)
SELECT i, 10, 1, i FROM s;
INSERT INTO t1 VALUES (1001, 200, 1, 1), (1002, 200, 2, 2);
INSERT INTO t1_innodb WITH RECURSIVE s (i) AS
(SELECT 1 UNION ALL SELECT i + 1 FROM s WHERE i < 1000)
SELECT i, 10, 1, i FROM s;
INSERT INTO t1_innodb VALUES (1001, 200, 1, 1), (1002, 200, 2, 2);
SET GLOBAL rocksdb_force_flush_memtable_now = ON;
ANALYZE TABLE t_driver, t1, t1_innodb;
Table	Op	Msg_type	Msg_text
test.t_driver	analyze	status	OK
test.t1	analyze	status	OK
test.t1_innodb	analyze	status	OK
SELECT TABLE_NAME, INDEX_NAME, CARDINALITY FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('t1', 't1_innodb')
AND INDEX_NAME = 'ka'
  ORDER BY TABLE_NAME;
TABLE_NAME	INDEX_NAME	CARDINALITY
t1	ka	1
t1_innodb	ka	1
# A join on a therefore reads t1 with a scan, not with the index.
EXPLAIN SELECT * FROM t_driver STRAIGHT_JOIN t1 ON t1.a = t_driver.x;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t_driver	NULL	index	PRIMARY	PRIMARY	4	NULL	#	#	Using index
1	SIMPLE	t1	p0,p1	ALL	ka	NULL	NULL	NULL	#	#	Using where; Using join buffer (hash join)
Warnings:
Note	1003	/* select#1 */ select `test`.`t_driver`.`x` AS `x`,`test`.`t1`.`pk` AS `pk`,`test`.`t1`.`part_col` AS `part_col`,`test`.`t1`.`a` AS `a`,`test`.`t1`.`v` AS `v` from `test`.`t_driver` straight_join `test`.`t1` where (`test`.`t1`.`a` = `test`.`t_driver`.`x`)
EXPLAIN SELECT * FROM t_driver STRAIGHT_JOIN t1_innodb ON t1_innodb.a = t_driver.x;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t_driver	NULL	index	PRIMARY	PRIMARY	4	NULL	#	#	Using index
1	SIMPLE	t1_innodb	p0,p1	ALL	ka	NULL	NULL	NULL	#	#	Using where; Using join buffer (hash join)
Warnings:
Note	1003	/* select#1 */ select `test`.`t_driver`.`x` AS `x`,`test`.`t1_innodb`.`pk` AS `pk`,`test`.`t1_innodb`.`part_col` AS `part_col`,`test`.`t1_innodb`.`a` AS `a`,`test`.`t1_innodb`.`v` AS `v` from `test`.`t_driver` straight_join `test`.`t1_innodb` where (`test`.`t1_innodb`.`a` = `test`.`t_driver`.`x`)
# A statement that reads only the small partition does not set the
# estimates of the table either, here for a second reference to the
# table in the same statement: big is still read with a scan.
EXPLAIN SELECT * FROM t_driver
STRAIGHT_JOIN t1 AS big ON big.a = t_driver.x
STRAIGHT_JOIN t1 AS small ON small.part_col = 200 AND small.pk = big.pk;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t_driver	NULL	index	PRIMARY	PRIMARY	4	NULL	#	#	Using index
1	SIMPLE	big	p0,p1	ALL	PRIMARY,ka	NULL	NULL	NULL	#	#	Using where; Using join buffer (hash join)
1	SIMPLE	small	p1	ALL	PRIMARY	NULL	NULL	NULL	#	#	Using where; Using join buffer (hash join)
Warnings:
Note	1003	/* select#1 */ select `test`.`t_driver`.`x` AS `x`,`test`.`big`.`pk` AS `pk`,`test`.`big`.`part_col` AS `part_col`,`test`.`big`.`a` AS `a`,`test`.`big`.`v` AS `v`,`test`.`small`.`pk` AS `pk`,`test`.`small`.`part_col` AS `part_col`,`test`.`small`.`a` AS `a`,`test`.`small`.`v` AS `v` from `test`.`t_driver` straight_join `test`.`t1` `big` straight_join `test`.`t1` `small` where ((`test`.`big`.`a` = `test`.`t_driver`.`x`) and (`test`.`small`.`pk` = `test`.`big`.`pk`) and (`test`.`small`.`part_col` = 200))
EXPLAIN SELECT * FROM t_driver
STRAIGHT_JOIN t1_innodb AS big ON big.a = t_driver.x
STRAIGHT_JOIN t1_innodb AS small ON small.part_col = 200 AND small.pk = big.pk;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t_driver	NULL	index	PRIMARY	PRIMARY	4	NULL	#	#	Using index
1	SIMPLE	big	p0,p1	ALL	PRIMARY,ka	NULL	NULL	NULL	#	#	Using where; Using join buffer (hash join)
1	SIMPLE	small	p1	ALL	PRIMARY	NULL	NULL	NULL	#	#	Using where; Using join buffer (hash join)
Warnings:
Note	1003	/* select#1 */ select `test`.`t_driver`.`x` AS `x`,`test`.`big`.`pk` AS `pk`,`test`.`big`.`part_col` AS `part_col`,`test`.`big`.`a` AS `a`,`test`.`big`.`v` AS `v`,`test`.`small`.`pk` AS `pk`,`test`.`small`.`part_col` AS `part_col`,`test`.`small`.`a` AS `a`,`test`.`small`.`v` AS `v` from `test`.`t_driver` straight_join `test`.`t1_innodb` `big` straight_join `test`.`t1_innodb` `small` where ((`test`.`big`.`a` = `test`.`t_driver`.`x`) and (`test`.`small`.`pk` = `test`.`big`.`pk`) and (`test`.`small`.`part_col` = 200))
# The same without ANALYZE TABLE, in a new table definition.
FLUSH TABLES;
SELECT TABLE_NAME, INDEX_NAME, CARDINALITY FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1' AND INDEX_NAME = 'ka';
TABLE_NAME	INDEX_NAME	CARDINALITY
t1	ka	1
DROP TABLE t1, t1_innodb;
#
# 2. A partition without rows. The first partition has 100 rows with
#    10 values of a. Expected: Cardinality 10 and 100, not NULL.
#
CREATE TABLE t2 (a INT, b INT, PRIMARY KEY (a, b)) ENGINE=ROCKSDB
PARTITION BY RANGE (b) (
PARTITION p0 VALUES LESS THAN (1000),
PARTITION p1 VALUES LESS THAN MAXVALUE);
INSERT INTO t2 WITH RECURSIVE s (i) AS
(SELECT 0 UNION ALL SELECT i + 1 FROM s WHERE i < 99)
SELECT i DIV 10, i FROM s;
SET GLOBAL rocksdb_force_flush_memtable_now = ON;
ANALYZE TABLE t2;
Table	Op	Msg_type	Msg_text
test.t2	analyze	status	OK
SELECT PARTITION_NAME, TABLE_ROWS FROM INFORMATION_SCHEMA.PARTITIONS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't2' ORDER BY PARTITION_NAME;
PARTITION_NAME	TABLE_ROWS
p0	100
p1	0
SELECT INDEX_NAME, SEQ_IN_INDEX, CARDINALITY
FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't2'
  ORDER BY INDEX_NAME, SEQ_IN_INDEX;
INDEX_NAME	SEQ_IN_INDEX	CARDINALITY
PRIMARY	1	10
PRIMARY	2	100
# A statement that reads only the partition without rows leaves the
# estimates as they are: 10 rows for each value of a, and not 1, with
# which the join would look up each value of a in the index.
EXPLAIN SELECT * FROM t_driver STRAIGHT_JOIN t2 ON t2.a = t_driver.x
WHERE t2.b >= 1000;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t_driver	NULL	index	PRIMARY	PRIMARY	4	NULL	5	#	Using index
1	SIMPLE	t2	p1	index	PRIMARY	PRIMARY	8	NULL	1	#	Using where; Using index; Using join buffer (hash join)
Warnings:
Note	1003	/* select#1 */ select `test`.`t_driver`.`x` AS `x`,`test`.`t2`.`a` AS `a`,`test`.`t2`.`b` AS `b` from `test`.`t_driver` straight_join `test`.`t2` where ((`test`.`t2`.`a` = `test`.`t_driver`.`x`) and (`test`.`t2`.`b` >= 1000))
EXPLAIN SELECT * FROM t_driver STRAIGHT_JOIN t2 ON t2.a = t_driver.x;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t_driver	NULL	index	PRIMARY	PRIMARY	4	NULL	5	#	Using index
1	SIMPLE	t2	p0,p1	ref	PRIMARY	PRIMARY	4	test.t_driver.x	10	#	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t_driver`.`x` AS `x`,`test`.`t2`.`a` AS `a`,`test`.`t2`.`b` AS `b` from `test`.`t_driver` straight_join `test`.`t2` where (`test`.`t2`.`a` = `test`.`t_driver`.`x`)
#
# 3. The partition without rows gets one row, which stays in the
#    memtable, so the partition has no index statistics. Expected: the
#    estimates of the first partition stay.
#
INSERT INTO t2 VALUES (100, 2000);
SELECT PARTITION_NAME, TABLE_ROWS > 0 AS has_rows
FROM INFORMATION_SCHEMA.PARTITIONS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't2' ORDER BY PARTITION_NAME;
PARTITION_NAME	has_rows
p0	1
p1	1
SELECT INDEX_NAME, SEQ_IN_INDEX, CARDINALITY BETWEEN 10 AND 20 AS about_10
FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't2' AND SEQ_IN_INDEX = 1;
INDEX_NAME	SEQ_IN_INDEX	about_10
PRIMARY	1	1
EXPLAIN SELECT * FROM t_driver STRAIGHT_JOIN t2 ON t2.a = t_driver.x;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t_driver	NULL	index	PRIMARY	PRIMARY	4	NULL	5	#	Using index
1	SIMPLE	t2	p0,p1	ref	PRIMARY	PRIMARY	4	test.t_driver.x	10	#	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t_driver`.`x` AS `x`,`test`.`t2`.`a` AS `a`,`test`.`t2`.`b` AS `b` from `test`.`t_driver` straight_join `test`.`t2` where (`test`.`t2`.`a` = `test`.`t_driver`.`x`)
DROP TABLE t2;
#
# 4. The estimates follow the index statistics without ANALYZE TABLE
#    and without a new table definition, as they do for a table
#    without partitions: the table is opened without rows, then gets
#    100 rows with 10 values of a, which are flushed.
#
CREATE TABLE t3 (a INT, b INT, PRIMARY KEY (a, b)) ENGINE=ROCKSDB
PARTITION BY RANGE (b) (
PARTITION p0 VALUES LESS THAN (1000),
PARTITION p1 VALUES LESS THAN MAXVALUE);
SELECT COUNT(*) FROM t3;
COUNT(*)
0
INSERT INTO t3 WITH RECURSIVE s (i) AS
(SELECT 0 UNION ALL SELECT i + 1 FROM s WHERE i < 99)
SELECT i DIV 10, i FROM s;
SET GLOBAL rocksdb_force_flush_memtable_now = ON;
SELECT INDEX_NAME, SEQ_IN_INDEX, CARDINALITY
FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't3'
  ORDER BY INDEX_NAME, SEQ_IN_INDEX;
INDEX_NAME	SEQ_IN_INDEX	CARDINALITY
PRIMARY	1	10
PRIMARY	2	100
DROP TABLE t3;
#
# 5. A table with rows but without index statistics (the rows are in
#    the memtable), with rocksdb_debug_optimizer_no_zero_cardinality =
#    OFF. MyRocks then guesses the estimates as the optimizer does for
#    a key without statistics: the first key part matches 1% of the
#    rows. Expected: 1% of the rows of the table, as for the same table
#    without partitions, and not 1% of the rows of a partition (or its
#    lower limit of 10 rows): Cardinality 100.
#
SET @save_no_zero_cardinality = @@global.rocksdb_debug_optimizer_no_zero_cardinality;
SET GLOBAL rocksdb_debug_optimizer_no_zero_cardinality = OFF;
CREATE TABLE t4 (pk INT PRIMARY KEY, k INT, g INT, v INT,
KEY kk (k), KEY kg (g, k)) ENGINE=ROCKSDB;
CREATE TABLE t4p (pk INT PRIMARY KEY, k INT, g INT, v INT,
KEY kk (k), KEY kg (g, k)) ENGINE=ROCKSDB
PARTITION BY HASH (pk) PARTITIONS 16;
SET SESSION cte_max_recursion_depth = 16000;
INSERT INTO t4 WITH RECURSIVE s (i) AS
(SELECT 1 UNION ALL SELECT i + 1 FROM s WHERE i < 16000)
SELECT i, i, i % 100, i FROM s;
INSERT INTO t4p WITH RECURSIVE s (i) AS
(SELECT 1 UNION ALL SELECT i + 1 FROM s WHERE i < 16000)
SELECT i, i, i % 100, i FROM s;
SELECT TABLE_NAME, INDEX_NAME, CARDINALITY FROM INFORMATION_SCHEMA.STATISTICS WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('t4', 't4p') AND INDEX_NAME <> 'PRIMARY' AND SEQ_IN_INDEX = 1 ORDER BY TABLE_NAME, INDEX_NAME;
TABLE_NAME	INDEX_NAME	CARDINALITY
t4	kg	100
t4	kk	100
t4p	kg	100
t4p	kk	100
# The same in a new table definition, which a statement that reads
# half of the partitions opens and no statement that reads all
# partitions has used yet: the estimate for g is 1% of the rows of the
# table. The number of rows in a memtable is itself an estimate, and
# far from exact (a partition with 1000 rows reports 500 to 5000), so
# compare it with the number of rows that the table reports.
FLUSH TABLES;
SET SESSION eq_range_index_dive_limit = 1;
EXPLAIN FORMAT=JSON INTO @plan
SELECT * FROM t4p PARTITION (p0, p1, p2, p3, p4, p5, p6, p7)
FORCE INDEX (kg) WHERE g = 1;
SET SESSION eq_range_index_dive_limit = DEFAULT;
SELECT JSON_EXTRACT(@plan, '$.query_block.table.partitions') AS partitions,
JSON_EXTRACT(@plan, '$.query_block.table.key') AS used_key;
partitions	used_key
["p0", "p1", "p2", "p3", "p4", "p5", "p6", "p7"]	"kg"
SELECT ROUND(100 * JSON_EXTRACT(@plan,
'$.query_block.table.rows_examined_per_scan') /
TABLE_ROWS) AS percent_of_table_rows
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't4p';
percent_of_table_rows
1
SELECT TABLE_NAME, INDEX_NAME, CARDINALITY FROM INFORMATION_SCHEMA.STATISTICS WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('t4', 't4p') AND INDEX_NAME <> 'PRIMARY' AND SEQ_IN_INDEX = 1 ORDER BY TABLE_NAME, INDEX_NAME;
TABLE_NAME	INDEX_NAME	CARDINALITY
t4	kg	100
t4	kk	100
t4p	kg	100
t4p	kk	100
DROP TABLE t4, t4p;
SET SESSION cte_max_recursion_depth = DEFAULT;
SET GLOBAL rocksdb_debug_optimizer_no_zero_cardinality = @save_no_zero_cardinality;
#
# 6. An estimate is limited by the number of rows in the table, not in
#    the partition that sets it. The rows are in the memtable, so
#    there are no index statistics, and the default estimate is made
#    larger than the table with rocksdb_debug_cardinality_multiplier:
#    all rows of the table for each value of k. Expected: Cardinality
#    1, as for the same table without partitions, and not the number
#    of rows in the table divided by those in one partition.
#
SET @save_multiplier = @@global.rocksdb_debug_cardinality_multiplier;
SET GLOBAL rocksdb_debug_cardinality_multiplier = 1000000;
CREATE TABLE t5 (pk INT PRIMARY KEY, k INT, v INT, KEY kk (k)) ENGINE=ROCKSDB;
CREATE TABLE t5p (pk INT PRIMARY KEY, k INT, v INT, KEY kk (k)) ENGINE=ROCKSDB
PARTITION BY HASH (pk) PARTITIONS 16;
INSERT INTO t5 WITH RECURSIVE s (i) AS
(SELECT 1 UNION ALL SELECT i + 1 FROM s WHERE i < 800)
SELECT i, i, i FROM s;
INSERT INTO t5p WITH RECURSIVE s (i) AS
(SELECT 1 UNION ALL SELECT i + 1 FROM s WHERE i < 800)
SELECT i, i, i FROM s;
SELECT TABLE_NAME, INDEX_NAME, CARDINALITY FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME IN ('t5', 't5p')
AND INDEX_NAME = 'kk'
  ORDER BY TABLE_NAME;
TABLE_NAME	INDEX_NAME	CARDINALITY
t5	kk	1
t5p	kk	1
DROP TABLE t5, t5p;
SET GLOBAL rocksdb_debug_cardinality_multiplier = @save_multiplier;
DROP TABLE t_driver;
SET GLOBAL rocksdb_table_stats_sampling_pct = @save_sampling_pct;
SET GLOBAL rocksdb_force_compute_memtable_stats_cachetime = @save_cachetime;
