call mtr.add_suppression("Invalid pattern in rocksdb_read_free_rpl_tables");
SET @saved_tables = @@global.rocksdb_read_free_rpl_tables;
# 90 nested groups are accepted
SET @p = CONCAT(REPEAT('(', 90), 't', REPEAT(')', 90));
SET GLOBAL rocksdb_read_free_rpl_tables = @p;
SELECT LENGTH(@@global.rocksdb_read_free_rpl_tables);
LENGTH(@@global.rocksdb_read_free_rpl_tables)
181
# Deeper nesting is rejected instead of crashing the server
SET @p = CONCAT(REPEAT('(', 10000), 't', REPEAT(')', 10000));
