#
# An empty range stays at the conventional 1 row.
#
explain select * from t1 where a = 9999;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ref	ka	ka	4	const	1	100.00	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`i` AS `i`,`test`.`t1`.`a` AS `a`,`test`.`t1`.`b` AS `b` from `test`.`t1` where (`test`.`t1`.`a` = 9999)
#
# Deterministic single-block scenario: index kc lives in its own
# column family whose whole SST fits in one ~16KB data block, so
# GetApproximateSizes() is guaranteed to return 0 for any range that
# does not extend past the last key: the exact situation from the
# bug report.
#
CREATE TABLE t2 (
i INT PRIMARY KEY AUTO_INCREMENT,
c INT NOT NULL,
KEY kc(c) comment 'cfname=cf_dive'
) ENGINE = rocksdb;
#
# SST path. (Memtable-path coverage for this single-block scenario
# needs a DBUG injection to be deterministic - see
# records_in_range_dive_debug.test.)
#
set global rocksdb_force_flush_memtable_now = true;
analyze table t2;
Table	Op	Msg_type	Msg_text
test.t2	analyze	status	OK
SET SESSION rocksdb_records_in_range_dive_threshold = 10000;
explain select * from t2 where c = 777;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	ref	kc	kc	4	const	3	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`c` AS `c` from `test`.`t2` where (`test`.`t2`.`c` = 777)
explain select * from t2 where c = 50;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	ref	kc	kc	4	const	201	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`c` AS `c` from `test`.`t2` where (`test`.`t2`.`c` = 50)
# Cap semantics, SST path: GetApproximateSizes() returns 0 for the
# whole single-block CF, so the dive always engages here and reads
# at most threshold keys - a range with more keys than the
# threshold estimates as the threshold (a lower bound).
SET SESSION rocksdb_records_in_range_dive_threshold = 50;
explain select * from t2 where c = 50;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	ref	kc	kc	4	const	50	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`c` AS `c` from `test`.`t2` where (`test`.`t2`.`c` = 50)
SET SESSION rocksdb_records_in_range_dive_threshold = DEFAULT;
explain select * from t2 where c = 50;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	ref	kc	kc	4	const	100	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`c` AS `c` from `test`.`t2` where (`test`.`t2`.`c` = 50)
# 0 disables the dive, SST path: this is the PS-10110 bug in both
# directions at once - the wide group (201 keys) floors to the
# conventional 1 row (severe underestimate), while the narrow
# group (3 keys) balloons to the block's full row count (severe
# overestimate). The legacy estimate is not just "too low"; it is
# an unreliable block-granularity guess either way.
SET SESSION rocksdb_records_in_range_dive_threshold = 0;
explain select * from t2 where c = 50;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	ref	kc	kc	4	const	1	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`c` AS `c` from `test`.`t2` where (`test`.`t2`.`c` = 50)
explain select * from t2 where c = 777;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	ref	kc	kc	4	const	299	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`c` AS `c` from `test`.`t2` where (`test`.`t2`.`c` = 777)
#
# rocksdb_skip_fill_cache is honored by the dive's own iterator, not
# just by the handler's normal read path. This needs its own,
# previously-untouched table/CF: t2's single block is already fully
# cached by the explains above, so re-reading it here could never
# show a fresh cache fill either way.
#
CREATE TABLE t6 (
i INT PRIMARY KEY AUTO_INCREMENT,
c INT NOT NULL,
KEY kc(c) comment 'cfname=cf_dive_cache'
) ENGINE = rocksdb;
set global rocksdb_force_flush_memtable_now = true;
analyze table t6;
Table	Op	Msg_type	Msg_text
test.t6	analyze	status	OK
SET SESSION rocksdb_records_in_range_dive_threshold = 10000;
SET SESSION rocksdb_skip_fill_cache = 1;
explain select * from t6 where c = 25;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t6	NULL	ref	kc	kc	4	const	1	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t6`.`i` AS `i`,`test`.`t6`.`c` AS `c` from `test`.`t6` where (`test`.`t6`.`c` = 25)
# Same block, re-read with the default (fill_cache enabled): the
# previous read left it uncached, so this one is a genuine fill.
SET SESSION rocksdb_skip_fill_cache = DEFAULT;
explain select * from t6 where c = 25;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t6	NULL	ref	kc	kc	4	const	1	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t6`.`i` AS `i`,`test`.`t6`.`c` AS `c` from `test`.`t6` where (`test`.`t6`.`c` = 25)
SET SESSION rocksdb_records_in_range_dive_threshold = @save_dive;
DROP TABLE t1;
DROP TABLE t2;
DROP TABLE t6;
