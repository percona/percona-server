# Dive-failure fallback: myrocks_records_in_range_dive_fail forces
# rdb_index_dive_in_range() to fail; caller must fall back to the
# pre-dive estimate (floored to 1), not trust a partial scan.
SET SESSION debug = '+d,myrocks_zero_records_in_range_estimate,myrocks_records_in_range_dive_fail';
explain select * from t2 where c = 50;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	ref	kc	kc	4	const	1	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`c` AS `c` from `test`.`t2` where (`test`.`t2`.`c` = 50)
SET SESSION debug = '-d,myrocks_zero_records_in_range_estimate,myrocks_records_in_range_dive_fail';
SET SESSION rocksdb_records_in_range_dive_threshold = @save_dive;
DROP TABLE t2;
#
# TTL indexes bypass the dive (kd.has_ttl()): a raw iterator would
# count not-yet-compacted expired rows as live. Floor of 1 stays
# even at a generous threshold.
#
CREATE TABLE t4 (
i INT PRIMARY KEY AUTO_INCREMENT,
c INT NOT NULL,
ts BIGINT UNSIGNED NOT NULL,
KEY kc(c) comment 'cfname=cf_dive_ttl'
) ENGINE = rocksdb COMMENT = 'ttl_duration=100000;ttl_col=ts';
SET SESSION debug = '+d,myrocks_zero_records_in_range_estimate';
SET SESSION rocksdb_records_in_range_dive_threshold = 10000;
explain select * from t4 where c = 50;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t4	NULL	ref	kc	kc	4	const	1	100.00	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t4`.`i` AS `i`,`test`.`t4`.`c` AS `c`,`test`.`t4`.`ts` AS `ts` from `test`.`t4` where (`test`.`t4`.`c` = 50)
SET SESSION debug = '-d,myrocks_zero_records_in_range_estimate';
SET SESSION rocksdb_records_in_range_dive_threshold = @save_dive;
DROP TABLE t4;
#
# Partial indexes bypass the dive too (kd.is_partial_index()). FORCE
# INDEX materializes ik1's group first (lazy, read-triggered; a plain
# SELECT would use PRIMARY instead and leave it unmaterialized), so
# a removed guard would be caught: the dive would find real entries,
# not an empty group.
#
CREATE TABLE t5 (
i INT NOT NULL,
j INT NOT NULL,
PRIMARY KEY (i, j),
KEY ik1 (i, j) comment 'cfname=cf_dive_partial;partial_group_keyparts=1;partial_group_threshold=10'
) ENGINE = rocksdb;
SET SESSION debug = '+d,myrocks_zero_records_in_range_estimate';
SET SESSION rocksdb_records_in_range_dive_threshold = 10000;
explain select * from t5 where i = 42;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t5	NULL	ref	PRIMARY,ik1	ik1	4	const	1	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t5`.`i` AS `i`,`test`.`t5`.`j` AS `j` from `test`.`t5` where (`test`.`t5`.`i` = 42)
SET SESSION debug = '-d,myrocks_zero_records_in_range_estimate';
SET SESSION rocksdb_records_in_range_dive_threshold = @save_dive;
DROP TABLE t5;
