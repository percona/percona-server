#
# Deterministic single-block CF (kc): GetApproximateSizes() is
# guaranteed 0 here - the exact bug-report scenario.
#
CREATE TABLE t2 (
i INT PRIMARY KEY AUTO_INCREMENT,
c INT NOT NULL,
KEY kc(c) comment 'cfname=cf_dive'
) ENGINE = rocksdb;
#
# SST path.
#
set global rocksdb_force_flush_memtable_now = true;
analyze table t2;
Table	Op	Msg_type	Msg_text
test.t2	analyze	status	OK
SET SESSION rocksdb_records_in_range_dive_threshold = 10000;
explain select * from t2 where c = 777;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	ref	kc	kc	4	const	3	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`c` AS `c` from `test`.`t2` where (`test`.`t2`.`c` = 777)
explain select * from t2 where c = 50;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	ref	kc	kc	4	const	201	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`c` AS `c` from `test`.`t2` where (`test`.`t2`.`c` = 50)
# Cap semantics, SST path: dive reads at most threshold keys, so a
# larger range estimates as the threshold (a lower bound).
SET SESSION rocksdb_records_in_range_dive_threshold = 50;
explain select * from t2 where c = 50;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	ref	kc	kc	4	const	50	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`c` AS `c` from `test`.`t2` where (`test`.`t2`.`c` = 50)
SET SESSION rocksdb_records_in_range_dive_threshold = DEFAULT;
explain select * from t2 where c = 50;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	ref	kc	kc	4	const	100	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`c` AS `c` from `test`.`t2` where (`test`.`t2`.`c` = 50)
# 0 disables the dive, SST path: the PS-10110 bug both ways - wide
# group (201) floors to 1, narrow group (3) balloons to the block's
# full count.
SET SESSION rocksdb_records_in_range_dive_threshold = 0;
explain select * from t2 where c = 50;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	ref	kc	kc	4	const	1	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`c` AS `c` from `test`.`t2` where (`test`.`t2`.`c` = 50)
explain select * from t2 where c = 777;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	ref	kc	kc	4	const	299	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`c` AS `c` from `test`.`t2` where (`test`.`t2`.`c` = 777)
#
# rocksdb_skip_fill_cache is honored by the dive's own iterator too.
# Needs a fresh table/CF: t2 is already cached by now.
#
CREATE TABLE t6 (
i INT PRIMARY KEY AUTO_INCREMENT,
c INT NOT NULL,
KEY kc(c) comment 'cfname=cf_dive_cache'
) ENGINE = rocksdb;
set global rocksdb_force_flush_memtable_now = true;
analyze table t6;
Table	Op	Msg_type	Msg_text
test.t6	analyze	status	OK
SET SESSION rocksdb_records_in_range_dive_threshold = 10000;
SET GLOBAL rocksdb_pause_background_work = 1;
SET SESSION rocksdb_skip_fill_cache = 1;
explain select * from t6 where c = 25;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t6	NULL	ref	kc	kc	4	const	1	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t6`.`i` AS `i`,`test`.`t6`.`c` AS `c` from `test`.`t6` where (`test`.`t6`.`c` = 25)
# Same block, default fill_cache: previous read left it uncached.
SET SESSION rocksdb_skip_fill_cache = DEFAULT;
explain select * from t6 where c = 25;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t6	NULL	ref	kc	kc	4	const	1	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t6`.`i` AS `i`,`test`.`t6`.`c` AS `c` from `test`.`t6` where (`test`.`t6`.`c` = 25)
SET GLOBAL rocksdb_pause_background_work = DEFAULT;
SET SESSION rocksdb_records_in_range_dive_threshold = @save_dive;
DROP TABLE t1;
DROP TABLE t2;
DROP TABLE t6;
#
# Same scenario, memtable path (pre-flush, pre-dive estimate pinned).
#
CREATE TABLE t2 (
i INT PRIMARY KEY AUTO_INCREMENT,
c INT NOT NULL,
KEY kc(c) comment 'cfname=cf_dive'
) ENGINE = rocksdb;
SET SESSION debug = '+d,myrocks_zero_records_in_range_estimate';
SET SESSION rocksdb_records_in_range_dive_threshold = 10000;
explain select * from t2 where c = 777;
