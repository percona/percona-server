CREATE TABLE t2 (
i INT PRIMARY KEY AUTO_INCREMENT,
c INT NOT NULL,
KEY kc(c) comment 'cfname=cf_dive'
) ENGINE = rocksdb;
SET @save_dive = @@session.rocksdb_records_in_range_dive_threshold;
SET SESSION debug = '+d,myrocks_zero_records_in_range_estimate';
SET SESSION rocksdb_records_in_range_dive_threshold = 10000;
explain select * from t2 where c = 777;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	ref	kc	kc	4	const	3	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`c` AS `c` from `test`.`t2` where (`test`.`t2`.`c` = 777)
explain select * from t2 where c = 50;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	ref	kc	kc	4	const	200	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`c` AS `c` from `test`.`t2` where (`test`.`t2`.`c` = 50)
# Cap semantics, memtable path: same as the SST path (see
# records_in_range_dive.test) - the dive reads at most threshold
# keys, so a range with more keys than the threshold estimates as
# the threshold (a lower bound).
SET SESSION rocksdb_records_in_range_dive_threshold = 50;
explain select * from t2 where c = 50;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	ref	kc	kc	4	const	50	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`c` AS `c` from `test`.`t2` where (`test`.`t2`.`c` = 50)
SET SESSION rocksdb_records_in_range_dive_threshold = DEFAULT;
explain select * from t2 where c = 50;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	ref	kc	kc	4	const	100	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`c` AS `c` from `test`.`t2` where (`test`.`t2`.`c` = 50)
# 0 disables the dive, memtable path: with the raw estimate pinned
# to 0, this reproduces the PS-10110 bug exactly as originally
# reported - the estimate collapses to 1 row regardless of how
# many keys are actually in range.
SET SESSION rocksdb_records_in_range_dive_threshold = 0;
explain select * from t2 where c = 50;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	ref	kc	kc	4	const	1	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`c` AS `c` from `test`.`t2` where (`test`.`t2`.`c` = 50)
explain select * from t2 where c = 777;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	ref	kc	kc	4	const	1	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`c` AS `c` from `test`.`t2` where (`test`.`t2`.`c` = 777)
SET SESSION debug = '-d,myrocks_zero_records_in_range_estimate';
SET SESSION rocksdb_records_in_range_dive_threshold = @save_dive;
DROP TABLE t2;
#
# Dive-failure fallback: myrocks_records_in_range_dive_fail makes
# rdb_index_dive_in_range() report failure unconditionally, the same
# way a kill or a non-ok iterator status (I/O error, corruption,
# Status::Incomplete()) would. Combined with the pre-dive estimate
# pinned to 0, this proves the caller falls back to that pre-dive
# estimate (floored to 1) instead of trusting a partial or
# simulated scan.
#
CREATE TABLE t3 (
i INT PRIMARY KEY AUTO_INCREMENT,
c INT NOT NULL,
KEY kc(c) comment 'cfname=cf_dive_fail'
) ENGINE = rocksdb;
SET SESSION debug = '+d,myrocks_zero_records_in_range_estimate,myrocks_records_in_range_dive_fail';
SET SESSION rocksdb_records_in_range_dive_threshold = 10000;
explain select * from t3 where c = 50;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t3	NULL	ref	kc	kc	4	const	1	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t3`.`i` AS `i`,`test`.`t3`.`c` AS `c` from `test`.`t3` where (`test`.`t3`.`c` = 50)
SET SESSION debug = '-d,myrocks_zero_records_in_range_estimate,myrocks_records_in_range_dive_fail';
SET SESSION rocksdb_records_in_range_dive_threshold = @save_dive;
DROP TABLE t3;
#
# TTL indexes bypass the dive entirely (kd.has_ttl()): a raw iterator
# has no visibility filtering, so it would count not-yet-compacted
# expired records as live. The narrow group below would dive to an
# exact 200 if the dive engaged; instead the legacy 1-row estimate
# is unchanged even at a generous threshold.
#
CREATE TABLE t4 (
i INT PRIMARY KEY AUTO_INCREMENT,
c INT NOT NULL,
ts BIGINT UNSIGNED NOT NULL,
KEY kc(c) comment 'cfname=cf_dive_ttl'
) ENGINE = rocksdb COMMENT = 'ttl_duration=100000;ttl_col=ts';
SET SESSION debug = '+d,myrocks_zero_records_in_range_estimate';
SET SESSION rocksdb_records_in_range_dive_threshold = 10000;
explain select * from t4 where c = 50;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t4	NULL	ref	kc	kc	4	const	1	100.00	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t4`.`i` AS `i`,`test`.`t4`.`c` AS `c`,`test`.`t4`.`ts` AS `ts` from `test`.`t4` where (`test`.`t4`.`c` = 50)
SET SESSION debug = '-d,myrocks_zero_records_in_range_estimate';
SET SESSION rocksdb_records_in_range_dive_threshold = @save_dive;
DROP TABLE t4;
#
# Partial indexes bypass the dive too (kd.is_partial_index()): a raw
# iterator does not see unmaterialized rows and would undercount.
# ik1 only materializes groups of i with more rows than the
# threshold, so its content does not correspond 1:1 with the base
# table; the narrow group below would dive to an exact count if the
# dive engaged, but the legacy 1-row estimate is unchanged instead.
#
CREATE TABLE t5 (
i INT NOT NULL,
j INT NOT NULL,
PRIMARY KEY (i, j),
KEY ik1 (i, j) comment 'cfname=cf_dive_partial;partial_group_keyparts=1;partial_group_threshold=1000'
) ENGINE = rocksdb;
SET SESSION debug = '+d,myrocks_zero_records_in_range_estimate';
SET SESSION rocksdb_records_in_range_dive_threshold = 10000;
explain select * from t5 where i = 42;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t5	NULL	ref	PRIMARY,ik1	ik1	4	const	1	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t5`.`i` AS `i`,`test`.`t5`.`j` AS `j` from `test`.`t5` where (`test`.`t5`.`i` = 42)
SET SESSION debug = '-d,myrocks_zero_records_in_range_estimate';
SET SESSION rocksdb_records_in_range_dive_threshold = @save_dive;
DROP TABLE t5;
