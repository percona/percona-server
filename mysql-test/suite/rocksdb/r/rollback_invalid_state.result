#
# A Rollback() failure that is not an I/O error, as after a failed
# prepare write, must be logged without aborting the server.
#
call mtr.add_suppression("Failed to roll back transaction");
CREATE TABLE t1 (id INT PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1);
SET @old_debug = @@session.debug;
SET SESSION debug = '+d,rocksdb_rollback_invalid_state';
BEGIN;
INSERT INTO t1 VALUES (2);
ROLLBACK;
SET SESSION debug = @old_debug;
SELECT * FROM t1;
id
1
INSERT INTO t1 VALUES (3);
SELECT * FROM t1;
id
1
3
include/assert_grep.inc [The rollback failure was logged]
DROP TABLE t1;
