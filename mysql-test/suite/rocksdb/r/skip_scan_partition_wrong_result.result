#
# PS-11793: a skip scan on a partitioned MyRocks table returned only the
# rows of the first key prefix group. The range read in that group left
# its end range in the handler of the partition, and it limited the read
# of the first row of the next group.
# Expected: the same rows with and without skip scan.
#
# One partition, primary key
CREATE TABLE t (ip_col INT, ipkey INT, PRIMARY KEY (ipkey, ip_col))
ENGINE=ROCKSDB
PARTITION BY RANGE (ip_col) (PARTITION p1 VALUES LESS THAN (1000));
INSERT INTO t VALUES (150,1),(160,2),(170,3),(150,4),(160,5),(170,6);
EXPLAIN SELECT /*+ SKIP_SCAN(t PRIMARY) */ * FROM t WHERE ip_col = 160;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t	p1	range	PRIMARY	PRIMARY	8	NULL	#	#	Using where; Using index for skip scan
Warnings:
Note	1003	/* select#1 */ select /*+ SKIP_SCAN(`t`@`select#1` `PRIMARY`) */ `test`.`t`.`ip_col` AS `ip_col`,`test`.`t`.`ipkey` AS `ipkey` from `test`.`t` where (`test`.`t`.`ip_col` = 160)
SELECT /*+ SKIP_SCAN(t PRIMARY) */ * FROM t WHERE ip_col = 150;
ip_col	ipkey
150	1
150	4
SELECT /*+ SKIP_SCAN(t PRIMARY) */ * FROM t WHERE ip_col = 160;
ip_col	ipkey
160	2
160	5
SELECT /*+ SKIP_SCAN(t PRIMARY) */ * FROM t WHERE ip_col > 155;
ip_col	ipkey
160	2
170	3
160	5
170	6
SELECT /*+ NO_SKIP_SCAN(t) */ * FROM t WHERE ip_col > 155;
ip_col	ipkey
160	2
170	3
160	5
170	6
DROP TABLE t;
# Three partitions, primary key and secondary key
CREATE TABLE t (a INT NOT NULL, b INT NOT NULL, c INT NOT NULL, d INT NOT NULL,
PRIMARY KEY (a, b, c), KEY k (b, c, d))
ENGINE=ROCKSDB
PARTITION BY HASH (c) PARTITIONS 3;
INSERT INTO t
WITH RECURSIVE seq (n) AS
(SELECT 0 UNION ALL SELECT n + 1 FROM seq WHERE n < 63)
SELECT n DIV 16, (n DIV 4) % 4, n % 4, n FROM seq;
# Skipped key part: a
EXPLAIN SELECT /*+ SKIP_SCAN(t PRIMARY) */ a, b, c FROM t WHERE b > 2;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t	p0,p1,p2	range	PRIMARY,k	PRIMARY	8	NULL	#	#	Using where; Using index for skip scan
