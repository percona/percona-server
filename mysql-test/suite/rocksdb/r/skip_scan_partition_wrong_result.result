#
# A loose index scan reads the maximum of a group after a range read of
# the group prefixes. With the end range of that read left in the
# partition, a debug server aborted with "Assertion
# `lower_bound_slice->compare(*upper_bound_slice) <= 0' failed" in
# ha_rocksdb::setup_iterator_bounds().
# Expected: the same rows as without the loose index scan.
#
# Flush the rows and count all keys, so that the plan does not depend
# on the approximate number of rows in the memtable or on sampling.
SET @save_sampling_pct = @@global.rocksdb_table_stats_sampling_pct;
SET GLOBAL rocksdb_table_stats_sampling_pct = 100;
SET GLOBAL rocksdb_force_flush_memtable_now = ON;
SET GLOBAL rocksdb_table_stats_sampling_pct = @save_sampling_pct;
ANALYZE TABLE t;
Table	Op	Msg_type	Msg_text
test.t	analyze	status	OK
EXPLAIN SELECT a, MAX(b) FROM t FORCE INDEX (PRIMARY)
WHERE a < 3 AND b < 3 GROUP BY a;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t	p0,p1,p2	range	PRIMARY	PRIMARY	8	NULL	#	#	Using where; Using index for group-by
Warnings:
Note	1003	/* select#1 */ select `test`.`t`.`a` AS `a`,max(`test`.`t`.`b`) AS `MAX(b)` from `test`.`t` FORCE INDEX (PRIMARY) where ((`test`.`t`.`a` < 3) and (`test`.`t`.`b` < 3)) group by `test`.`t`.`a`
SELECT a, MAX(b) FROM t FORCE INDEX (PRIMARY) WHERE a < 3 AND b < 3 GROUP BY a;
a	MAX(b)
0	2
1	2
2	2
SELECT a, MAX(b) FROM t IGNORE INDEX (PRIMARY, k) WHERE a < 3 AND b < 3
GROUP BY a ORDER BY a;
a	MAX(b)
0	2
1	2
2	2
SELECT a, MIN(b), MAX(b) FROM t FORCE INDEX (PRIMARY)
WHERE a > 0 AND b BETWEEN 1 AND 2 GROUP BY a;
a	MIN(b)	MAX(b)
1	1	2
2	1	2
3	1	2
SELECT a, MIN(b), MAX(b) FROM t IGNORE INDEX (PRIMARY, k)
WHERE a > 0 AND b BETWEEN 1 AND 2 GROUP BY a ORDER BY a;
a	MIN(b)	MAX(b)
1	1	2
2	1	2
3	1	2
DROP TABLE t;
