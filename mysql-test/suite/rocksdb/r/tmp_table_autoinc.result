CREATE TEMPORARY TABLE t (id BIGINT AUTO_INCREMENT PRIMARY KEY, v INT) ENGINE=ROCKSDB;
INSERT INTO t(v) VALUES (10),(20);
INSERT INTO t VALUES (100,30);
INSERT INTO t(v) VALUES (40);
SELECT * FROM t ORDER BY id;
id	v
1	10
2	20
100	30
101	40
BEGIN;
INSERT INTO t(v) VALUES (50);
COMMIT;
SELECT * FROM t ORDER BY id;
id	v
1	10
2	20
100	30
101	40
102	50
DROP TEMPORARY TABLE t;
CREATE TEMPORARY TABLE t (id INT AUTO_INCREMENT PRIMARY KEY, v INT) ENGINE=ROCKSDB;
INSERT INTO t(v) VALUES (60);
SELECT * FROM t;
id	v
1	60
DROP TEMPORARY TABLE t;
# restart
CREATE TEMPORARY TABLE t (id INT AUTO_INCREMENT PRIMARY KEY, v INT) ENGINE=ROCKSDB;
INSERT INTO t(v) VALUES (70);
SELECT * FROM t;
id	v
1	70
DROP TEMPORARY TABLE t;
