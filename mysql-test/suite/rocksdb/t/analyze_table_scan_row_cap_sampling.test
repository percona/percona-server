#
# PS-11694: ANALYZE TABLE with rocksdb_table_stats_use_table_scan=ON and
# rocksdb_table_stats_max_num_rows_scanned > 0, with the default key
# sampling (rocksdb_table_stats_sampling_pct = 10), scales the distinct-key
# estimates up twice and never caps them at the row count. A debug server
# asserts in adjust_cardinality() (ha_rocksdb.cc); a release server stores a
# cardinality larger than the table.
#
# Expected: ANALYZE never fails and no index cardinality exceeds the number
# of rows in the table.
#
--source include/have_rocksdb.inc

CREATE TABLE t1 (pk INT PRIMARY KEY, hi INT, lo INT, KEY khi (hi), KEY klo (lo))
  ENGINE=ROCKSDB;
INSERT INTO t1
  WITH RECURSIVE s(n) AS (SELECT 0 UNION ALL SELECT n + 1 FROM s WHERE n < 999)
  SELECT n, n, n % 10 FROM s;
SET GLOBAL rocksdb_force_flush_memtable_now = 1;

SET @save_use_scan = @@global.rocksdb_table_stats_use_table_scan;
SET @save_max_rows = @@global.rocksdb_table_stats_max_num_rows_scanned;
SET GLOBAL rocksdb_table_stats_use_table_scan = ON;

--let $cap = 100
while ($cap <= 900)
{
  --eval SET GLOBAL rocksdb_table_stats_max_num_rows_scanned = $cap
  --let $i = 0
  while ($i < 10)
  {
    --disable_result_log
    ANALYZE TABLE t1;
    --enable_result_log
    --inc $i
  }
  --echo # Row cap $cap: index cardinality never exceeds the row count
  SELECT index_name, cardinality <= 1000 AS within_row_count
    FROM information_schema.statistics
    WHERE table_schema = 'test' AND table_name = 't1'
    ORDER BY index_name, seq_in_index;
  --let $cap = `SELECT $cap + 400`
}

SET GLOBAL rocksdb_table_stats_use_table_scan = @save_use_scan;
SET GLOBAL rocksdb_table_stats_max_num_rows_scanned = @save_max_rows;
DROP TABLE t1;
