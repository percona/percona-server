source include/have_debug_sync.inc;

disable_query_log;
disable_warnings;
DROP TABLE IF EXISTS t1;
enable_warnings;
enable_query_log;

# allow one completed record
set global rocksdb_bulk_load_history_size=1;

CREATE TABLE t1(c1 INT primary key, c2 int, index k2(c2)) ENGINE=ROCKSDB;

INSERT INTO t1 VALUES(1, 1), (2, 2);

echo;
echo sst commit failure should fail the alter copy;
echo;
SET DEBUG='+d,myrocks_end_alter_copy_failure';
SET rocksdb_bulk_load_allow_sk=1;
SET rocksdb_bulk_load=1;
error ER_GET_ERRNO;
ALTER TABLE t1 ADD column c3 int default 42 after c1;
# should have a bulk load completed
select TYPE, STATUS, RETURN_CODE, SST_FILES from information_schema.rocksdb_bulk_load_history  where TABLES like '%test.t1';
select * from t1;
SET rocksdb_bulk_load=0;

select * from t1;

echo;
echo alter copy should commit sst file on statement complete;
echo;
SET DEBUG='-d,myrocks_end_alter_copy_failure';
SET rocksdb_bulk_load=1;
ALTER TABLE t1 ADD column c3 int default 42 after c1;
select TYPE, STATUS, RETURN_CODE, SST_FILES from information_schema.rocksdb_bulk_load_history  where TABLES like '%test.t1';
select * from t1;
SET rocksdb_bulk_load=0;

select * from t1;

echo;
echo a duplicate in a new unique key fails the alter copy;
echo;
CREATE TABLE t2 (a INT PRIMARY KEY, b INT) ENGINE=ROCKSDB;
INSERT INTO t2 VALUES (1, 1), (2, 1);
SET rocksdb_bulk_load_allow_sk=1;
SET rocksdb_bulk_load_enable_unique_key_check=1;
SET rocksdb_bulk_load=1;
# The key starts with the index id
--replace_regex /key:[0-9A-F]+/key:KEY/
error ER_DUP_ENTRY;
ALTER TABLE t2 ADD UNIQUE KEY ub(b), ALGORITHM=COPY;
SET rocksdb_bulk_load=0;
SET rocksdb_bulk_load_enable_unique_key_check=0;
SET rocksdb_bulk_load=1;
error ER_DUP_ENTRY;
ALTER TABLE t2 ADD UNIQUE KEY ub(b), ALGORITHM=COPY;
SET rocksdb_bulk_load=0;
SHOW CREATE TABLE t2;
SELECT * FROM t2;
CHECK TABLE t2;
DROP TABLE t2;
SET rocksdb_bulk_load_allow_sk=default;

set global rocksdb_bulk_load_history_size=default;
DROP TABLE t1;
