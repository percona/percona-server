--source include/have_rocksdb.inc
--source include/have_debug.inc

--disable_query_log
CALL mtr.add_suppression('Checksum mismatch in key of key-value pair for index');
CALL mtr.add_suppression('Checksum mismatch in value of key-value pair for index');
CALL mtr.add_suppression('Got error 505 when reading table');
CALL mtr.add_suppression('Data with incorrect checksum');
--enable_query_log

# All columns are stored in the primary key, leaving no value fields to decode.
SET SESSION rocksdb_store_row_debug_checksums=ON;
SET SESSION rocksdb_checksums_pct=100;
CREATE TABLE t1 (id INT PRIMARY KEY) ENGINE=RocksDB;
INSERT INTO t1 VALUES (1), (2);
SET SESSION rocksdb_verify_row_debug_checksums=ON;
SELECT * FROM t1;

SET SESSION debug='+d,myrocks_simulate_bad_pk_checksum1';
--error ER_INTERNAL_ERROR
SELECT * FROM t1 WHERE id=1;
--error ER_INTERNAL_ERROR
SELECT * FROM t1;
SET SESSION debug='-d,myrocks_simulate_bad_pk_checksum1';

SET SESSION debug='+d,myrocks_simulate_bad_pk_checksum2';
--error ER_INTERNAL_ERROR
SELECT * FROM t1 WHERE id=1;
--error ER_INTERNAL_ERROR
SELECT * FROM t1;
SET SESSION rocksdb_verify_row_debug_checksums=OFF;
SELECT * FROM t1;
SET SESSION debug='-d,myrocks_simulate_bad_pk_checksum2';

SET SESSION rocksdb_verify_row_debug_checksums=ON;
SELECT * FROM t1;
DROP TABLE t1;
SET SESSION rocksdb_store_row_debug_checksums=DEFAULT;
SET SESSION rocksdb_checksums_pct=DEFAULT;
SET SESSION rocksdb_verify_row_debug_checksums=DEFAULT;
