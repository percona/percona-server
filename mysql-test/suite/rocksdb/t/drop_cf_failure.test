--source include/have_debug.inc
--source include/have_rocksdb.inc

--echo #
--echo # The temporary-table column families cannot be dropped: they are in use
--echo # while the server runs.
--echo #
--error ER_CANT_DROP_CF
SET GLOBAL rocksdb_delete_cf = '__tmp_system__';
--error ER_CANT_DROP_CF
SET GLOBAL rocksdb_delete_cf = '__tmp__';
CREATE TEMPORARY TABLE tt (id INT AUTO_INCREMENT PRIMARY KEY, v INT)
  ENGINE=ROCKSDB;
INSERT INTO tt (v) VALUES (1), (2);
SELECT * FROM tt;
DROP TEMPORARY TABLE tt;

--echo #
--echo # A background column family drop that fails only when persisting the
--echo # OPTIONS file has dropped the column family: forget it.
--echo #
--disable_query_log
CALL mtr.add_suppression("Error persisting a dropped column family");
--enable_query_log
CREATE TABLE t1 (a INT, PRIMARY KEY (a) COMMENT 'cfname=cf_drop_failure')
  ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1);
DROP TABLE t1;
SET GLOBAL rocksdb_signal_drop_index_thread = 1;
--let $wait_timeout = 60
--let $wait_condition = SELECT COUNT(*) = 0 FROM information_schema.rocksdb_global_info WHERE type = 'DDL_DROP_INDEX_ONGOING'
--source include/wait_condition.inc

SET @old_debug = @@global.debug;
SET GLOBAL debug = '+d,rocksdb_remove_dropped_cf_options_failure';
SET GLOBAL rocksdb_delete_cf = 'cf_drop_failure';
--let $wait_condition = SELECT COUNT(*) = 0 FROM information_schema.rocksdb_cfstats WHERE cf_name = 'cf_drop_failure'
--source include/wait_condition.inc
SET GLOBAL debug = @old_debug;
SELECT COUNT(*) AS dropped_marks FROM information_schema.rocksdb_global_info
  WHERE type = 'DROPPED_CF';

--echo # The name can be used again, also after a restart
CREATE TABLE t2 (a INT, PRIMARY KEY (a) COMMENT 'cfname=cf_drop_failure')
  ENGINE=ROCKSDB;
INSERT INTO t2 VALUES (1), (2);
--source include/restart_mysqld.inc
SELECT * FROM t2;
DROP TABLE t2;
