--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/have_rocksdb.inc

--echo #
--echo # Dropping a column family releases its SST files without a restart.
--echo #

CREATE TABLE t (id INT, v VARCHAR(100), PRIMARY KEY(id) COMMENT 'cfname=cf_dropped_sst') ENGINE=ROCKSDB;
INSERT INTO t VALUES (1,'retained');
SET GLOBAL rocksdb_force_flush_memtable_now=ON;
--let $sst_dir=`SELECT CONCAT(@@datadir, @@rocksdb_datadir)`
--let $sst_file=`SELECT SST_NAME FROM information_schema.rocksdb_index_file_map JOIN information_schema.rocksdb_ddl USING(COLUMN_FAMILY,INDEX_NUMBER) WHERE TABLE_NAME='t' LIMIT 1`
--file_exists $sst_dir/$sst_file

SET GLOBAL debug='+d,rocksdb_after_delete_table,rocksdb_drop_cf';
--connect (dropper,localhost,root,,test)
--send DROP TABLE t
--connection default
SET DEBUG_SYNC='now WAIT_FOR ready_to_mark_cf_dropped_after_delete_table';
SET GLOBAL rocksdb_delete_cf='cf_dropped_sst';
SET DEBUG_SYNC='now SIGNAL ready_to_drop_cf';
SET DEBUG_SYNC='now WAIT_FOR drop_cf_done';
SELECT COUNT(*) FROM information_schema.rocksdb_cfstats WHERE CF_NAME='cf_dropped_sst';
SET DEBUG_SYNC='now SIGNAL mark_cf_dropped_done_after_delete_table';
--connection dropper
--reap
--disconnect dropper
--connection default
SET GLOBAL debug='';
# The drop index thread may wait once more before it sees the cleared debug
SET DEBUG_SYNC='now SIGNAL ready_to_drop_cf';

--echo # The dropped column family's SST file is removed
--let SST_PATH=$sst_dir/$sst_file
perl;
  my $f = $ENV{SST_PATH};
  for (my $i = 0; $i < 300 && -e $f; $i++) { select(undef, undef, undef, 0.1); }
  print((-e $f) ? "SST file still exists\n" : "SST file removed\n");
EOF
