--source include/have_rocksdb.inc

# CREATE TABLE ... SELECT used in gap_lock_error_all.inc is not
# compatible with GTID mode for RocksDB.
--source include/rpl/set_gtid_mode_off.inc

let $engine=rocksdb;
let $expect_gap_lock_errors=1;
--source include/gap_lock_error_all.inc

# Restore the default for gtid_mode which is ON
--source include/rpl/set_gtid_mode_on.inc
