--source include/have_rocksdb.inc
--source include/have_debug.inc

CREATE TABLE t (id INT PRIMARY KEY, v INT, KEY v_idx(v)) ENGINE=ROCKSDB;
INSERT INTO t VALUES (1,10),(2,20),(3,30);
SET @saved_debug = @@session.debug;
SET @saved_io_action = @@global.rocksdb_io_error_action;

--echo # Seek failures must not look like an empty forward or backward range
SET SESSION debug = '+d,rocksdb_iterator_seek_error';
--error ER_GET_ERRMSG
SELECT * FROM t FORCE INDEX(PRIMARY) WHERE id >= 1 ORDER BY id;
--error ER_GET_ERRMSG
SELECT * FROM t FORCE INDEX(PRIMARY) WHERE id < 4 ORDER BY id DESC;
SET SESSION debug = @saved_debug;

--echo # Next/Prev failures must not turn a partial scan into successful DML
SET SESSION debug = '+d,rocksdb_iterator_next_error';
--error ER_GET_ERRMSG
SELECT * FROM t FORCE INDEX(PRIMARY) ORDER BY id;
--error ER_GET_ERRMSG
SELECT * FROM t FORCE INDEX(PRIMARY) ORDER BY id DESC;
--error ER_GET_ERRMSG
UPDATE t FORCE INDEX(PRIMARY) SET v=v+1 WHERE id >= 1;
SET SESSION debug = @saved_debug;
SELECT * FROM t ORDER BY id;

--echo # IGNORE_ERROR keeps the server alive but the SQL operation must fail
--disable_query_log
CALL mtr.add_suppression("Ignoring I/O errors.*injected iterator error");
--enable_query_log
SET GLOBAL rocksdb_io_error_action = 'IGNORE_ERROR';
SET SESSION debug = '+d,rocksdb_iterator_seek_error,rocksdb_iterator_io_error';
--error ER_GET_ERRMSG
SELECT v FROM t FORCE INDEX(v_idx) WHERE v >= 10 ORDER BY v;
SET SESSION debug = '+d,rocksdb_iterator_next_error,rocksdb_iterator_io_error';
--error ER_GET_ERRMSG
SELECT v FROM t FORCE INDEX(v_idx) ORDER BY v DESC;
SET SESSION debug = @saved_debug;

--echo # IGNORE_ERROR still marks an iterator corruption for the next restart
--disable_query_log
CALL mtr.add_suppression("Ignoring I/O errors.*Corruption");
--enable_query_log
SET SESSION debug = '+d,rocksdb_return_status_corrupted';
--error ER_GET_ERRMSG
SELECT * FROM t FORCE INDEX(PRIMARY) ORDER BY id;
SET SESSION debug = @saved_debug;
--let $corruption_marker = $MYSQLTEST_VARDIR/mysqld.1/data/.rocksdb/ROCKSDB_CORRUPTED
--file_exists $corruption_marker
--remove_file $corruption_marker

SET GLOBAL rocksdb_io_error_action = @saved_io_action;
SELECT * FROM t ORDER BY id;
DROP TABLE t;

--echo # Partial-index materialization must propagate seek and advancement errors
CREATE TABLE partial_t (id1 INT, id2 INT, v INT, PRIMARY KEY(id1,id2),
  KEY k(id1,v) COMMENT 'partial_group_keyparts=1;partial_group_threshold=100')
  ENGINE=ROCKSDB;
INSERT INTO partial_t VALUES (1,1,1),(1,2,2),(1,3,3);
SET SESSION debug='+d,rocksdb_iterator_seek_error';
--error ER_GET_ERRMSG
SELECT * FROM partial_t FORCE INDEX(k) WHERE id1=1;
SET SESSION debug = @saved_debug;
SET SESSION debug='+d,rocksdb_iterator_next_error';
--error ER_GET_ERRMSG
SELECT * FROM partial_t FORCE INDEX(k) WHERE id1=1;
SET SESSION debug = @saved_debug;
SELECT * FROM partial_t FORCE INDEX(k) WHERE id1=1 ORDER BY id2;
DROP TABLE partial_t;
