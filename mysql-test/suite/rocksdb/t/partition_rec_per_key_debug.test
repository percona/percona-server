--source include/have_rocksdb.inc
--source include/have_debug.inc
--source include/have_debug_sync.inc

--echo #
--echo # PS-12040: the partitions of a partitioned table share the rec_per_key
--echo # estimates of the table, and only the partition that
--echo # Partition_base::info() asks for it sets them, from the statistics of
--echo # all partitions. These are the cases of rocksdb.partition_rec_per_key
--echo # that need a debug server.
--echo #

SET @save_sampling_pct = @@global.rocksdb_table_stats_sampling_pct;
# Count all keys.
SET GLOBAL rocksdb_table_stats_sampling_pct = 100;

CREATE TABLE t_driver (x INT PRIMARY KEY) ENGINE=ROCKSDB;
INSERT INTO t_driver VALUES (1), (2), (3), (4), (5);

--echo #
--echo # 1. A session opens the table once more while another one optimizes a
--echo #    query on it. ha_rocksdb::open() of each partition set the
--echo #    estimates of the table to those of the partition, until
--echo #    Partition_base::open() had them set again when all partitions
--echo #    were open. The last partition has 2 rows with different values of
--echo #    a, the first one 1000 rows with the same value. Expected: the
--echo #    other session reads t1 with a scan, as it does when no session
--echo #    opens the table, and not with an index lookup of 1 row.
--echo #
CREATE TABLE t1 (pk INT, part_col INT, a INT, v INT,
                 PRIMARY KEY (pk, part_col), KEY ka (a)) ENGINE=ROCKSDB
  PARTITION BY RANGE (part_col) (
    PARTITION p0 VALUES LESS THAN (100),
    PARTITION p1 VALUES LESS THAN MAXVALUE);
INSERT INTO t1 WITH RECURSIVE s (i) AS
  (SELECT 1 UNION ALL SELECT i + 1 FROM s WHERE i < 1000)
  SELECT i, 10, 1, i FROM s;
INSERT INTO t1 VALUES (1001, 200, 1, 1), (1002, 200, 2, 2);
SET GLOBAL rocksdb_force_flush_memtable_now = ON;
ANALYZE TABLE t_driver, t1;
--echo # The statement reads one partition, so it does not set the estimates
--echo # itself.
--let $explain_join = EXPLAIN SELECT * FROM t_driver STRAIGHT_JOIN t1 ON t1.a = t_driver.x WHERE t1.part_col < 100
--replace_column 10 # 11 #
--eval $explain_join
--echo # This connection keeps the table in use, so that the other one opens
--echo # it again, and stops when it has opened the partitions.
LOCK TABLES t_driver READ, t1 READ;
--connect (con_open,localhost,root,,)
SET DEBUG_SYNC = 'partition_open_before_info SIGNAL partitions_open WAIT_FOR continue_open';
--send SELECT COUNT(*) FROM t1
--connection default
SET DEBUG_SYNC = 'now WAIT_FOR partitions_open';
--replace_column 10 # 11 #
--eval $explain_join
SET DEBUG_SYNC = 'now SIGNAL continue_open';
--connection con_open
--reap
--connection default
--disconnect con_open
UNLOCK TABLES;
SET DEBUG_SYNC = 'RESET';
DROP TABLE t1;

--echo #
--echo # 2. update_stats() fails for one partition. Then the number of rows in
--echo #    the table is not known, and the estimates stay as they are, also
--echo #    if Partition_base::info() picks a partition for which it worked.
--echo #    The first partition has 1000 rows in the memtable, so it has no
--echo #    index statistics and the estimate is the default of 4 rows for the
--echo #    first of the 3 key parts (with the primary key) of ka. The last
--echo #    partition has 20 rows with different values of a and index
--echo #    statistics. When update_stats() fails for the first partition, it
--echo #    reports no rows, and the last one is the one with the most rows.
--echo #    Expected: 4 rows for each value of a, and not the 1 row of the
--echo #    last partition.
--echo #
CREATE TABLE t2 (pk INT, part_col INT, a INT, v INT,
                 PRIMARY KEY (pk, part_col), KEY ka (a)) ENGINE=ROCKSDB
  PARTITION BY RANGE (part_col) (
    PARTITION p0 VALUES LESS THAN (100),
    PARTITION p1 VALUES LESS THAN MAXVALUE);
INSERT INTO t2 WITH RECURSIVE s (i) AS
  (SELECT 1 UNION ALL SELECT i + 1 FROM s WHERE i < 20)
  SELECT 2000 + i, 200, i, i FROM s;
SET GLOBAL rocksdb_force_flush_memtable_now = ON;
INSERT INTO t2 WITH RECURSIVE s (i) AS
  (SELECT 1 UNION ALL SELECT i + 1 FROM s WHERE i < 1000)
  SELECT i, 10, 1, i FROM s;
--echo # Take the estimate from the index statistics, not from an index dive.
SET SESSION eq_range_index_dive_limit = 1;
--let $explain_update = EXPLAIN UPDATE t2 FORCE INDEX (ka) SET v = 0 WHERE a = 1
--replace_column 11 #
--eval $explain_update
SET SESSION debug = "+d,myrocks_simulate_stats_recalc_failure_p0";
--replace_column 11 #
--eval $explain_update
SET SESSION debug = "-d,myrocks_simulate_stats_recalc_failure_p0";
--replace_column 11 #
--eval $explain_update
SET SESSION eq_range_index_dive_limit = DEFAULT;
DROP TABLE t2;

DROP TABLE t_driver;
SET GLOBAL rocksdb_table_stats_sampling_pct = @save_sampling_pct;
