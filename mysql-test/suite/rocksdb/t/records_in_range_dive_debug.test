--source include/have_rocksdb.inc
--source include/have_debug.inc

# PS-10110: the memtable-path counterpart of records_in_range_dive.test's
# deterministic single-block scenario.
#
# GetApproximateMemTableStats() samples the memtable's skip list, whose
# level structure is randomized per server instance, so its raw estimate
# is not reproducible run to run; the SST-side GetApproximateSizes()-based
# estimate can also shift between calls for the same query. Pin the
# combined pre-dive estimate to 0 via the
# myrocks_zero_records_in_range_estimate debug point so the dive always
# engages here deterministically, exactly as it does for the SST path
# (where GetApproximateSizes() is reliably 0 for a single-block CF). The
# dive itself still scans the real, committed memtable data, so the
# counts below are genuine, not simulated - only the decision to take
# the dive is pinned.
#
# The DBUG point above only pins records_in_range_internal()'s own
# pre-dive estimate. ha_rocksdb::records_in_range()'s caller separately
# clamps the final result to stats.records * 0.99 when the dive's exact
# count would exceed it, and stats.records itself comes from the same
# randomized GetApproximateMemTableStats() sampling (via info()), so a
# too-small background group here can make that outer clamp truncate the
# c = 50 dive's exact 201 down to whatever stats.records sampled that
# run - a real flaky failure this test hit during development. Keep the
# background group large enough (2000 rows here vs. 201) that
# stats.records safely exceeds every dive result below regardless of
# sampling noise.

CREATE TABLE t2 (
       i INT PRIMARY KEY AUTO_INCREMENT,
       c INT NOT NULL,
       KEY kc(c) comment 'cfname=cf_dive'
) ENGINE = rocksdb;
# Background values start at 10000 so the range (10000..11999) cannot
# collide with the c = 50 / c = 777 markers below.
--disable_query_log
let $i = 1;
while ($i <= 2000) {
  eval INSERT INTO t2(c) VALUES (10000 + $i);
  inc $i;
}
let $i = 1;
while ($i <= 200) {
  INSERT INTO t2(c) VALUES (50);
  inc $i;
}
# A second, much narrower group (3 keys) in the same single-block CF:
# contrasts with c = 50 (201 keys) below to show the dive is accurate
# for both a small and a large true count.
let $i = 1;
while ($i <= 3) {
  INSERT INTO t2(c) VALUES (777);
  inc $i;
}
--enable_query_log

SET @save_dive = @@session.rocksdb_records_in_range_dive_threshold;
SET SESSION debug = '+d,myrocks_zero_records_in_range_estimate';

SET SESSION rocksdb_records_in_range_dive_threshold = 10000;
explain select * from t2 where c = 777;
explain select * from t2 where c = 50;

--echo # Cap semantics, memtable path: same as the SST path (see
--echo # records_in_range_dive.test) - the dive reads at most threshold
--echo # keys, so a range with more keys than the threshold estimates as
--echo # the threshold (a lower bound).
SET SESSION rocksdb_records_in_range_dive_threshold = 50;
explain select * from t2 where c = 50;
SET SESSION rocksdb_records_in_range_dive_threshold = DEFAULT;
explain select * from t2 where c = 50;

--echo # 0 disables the dive, memtable path: with the raw estimate pinned
--echo # to 0, this reproduces the PS-10110 bug exactly as originally
--echo # reported - the estimate collapses to 1 row regardless of how
--echo # many keys are actually in range.
SET SESSION rocksdb_records_in_range_dive_threshold = 0;
explain select * from t2 where c = 50;
explain select * from t2 where c = 777;

SET SESSION debug = '-d,myrocks_zero_records_in_range_estimate';
SET SESSION rocksdb_records_in_range_dive_threshold = @save_dive;
DROP TABLE t2;

--echo #
--echo # Dive-failure fallback: myrocks_records_in_range_dive_fail makes
--echo # rdb_index_dive_in_range() report failure unconditionally, the same
--echo # way a kill or a non-ok iterator status (I/O error, corruption,
--echo # Status::Incomplete()) would. Combined with the pre-dive estimate
--echo # pinned to 0, this proves the caller falls back to that pre-dive
--echo # estimate (floored to 1) instead of trusting a partial or
--echo # simulated scan.
--echo #
CREATE TABLE t3 (
       i INT PRIMARY KEY AUTO_INCREMENT,
       c INT NOT NULL,
       KEY kc(c) comment 'cfname=cf_dive_fail'
) ENGINE = rocksdb;
# Background values start at 10000 so the range cannot collide with the
# c = 50 marker below.
--disable_query_log
let $i = 1;
while ($i <= 2000) {
  eval INSERT INTO t3(c) VALUES (10000 + $i);
  inc $i;
}
let $i = 1;
while ($i <= 200) {
  INSERT INTO t3(c) VALUES (50);
  inc $i;
}
--enable_query_log
SET SESSION debug = '+d,myrocks_zero_records_in_range_estimate,myrocks_records_in_range_dive_fail';
SET SESSION rocksdb_records_in_range_dive_threshold = 10000;
explain select * from t3 where c = 50;
SET SESSION debug = '-d,myrocks_zero_records_in_range_estimate,myrocks_records_in_range_dive_fail';
SET SESSION rocksdb_records_in_range_dive_threshold = @save_dive;
DROP TABLE t3;

--echo #
--echo # TTL indexes bypass the dive entirely (kd.has_ttl()): a raw iterator
--echo # has no visibility filtering, so it would count not-yet-compacted
--echo # expired records as live. The narrow group below would dive to an
--echo # exact 200 if the dive engaged; instead the legacy 1-row estimate
--echo # is unchanged even at a generous threshold.
--echo #
CREATE TABLE t4 (
       i INT PRIMARY KEY AUTO_INCREMENT,
       c INT NOT NULL,
       ts BIGINT UNSIGNED NOT NULL,
       KEY kc(c) comment 'cfname=cf_dive_ttl'
) ENGINE = rocksdb COMMENT = 'ttl_duration=100000;ttl_col=ts';
# Background values start at 10000 so the range cannot collide with the
# c = 50 marker below.
--disable_query_log
let $i = 1;
while ($i <= 2000) {
  eval INSERT INTO t4(c, ts) VALUES (10000 + $i, UNIX_TIMESTAMP());
  inc $i;
}
let $i = 1;
while ($i <= 200) {
  INSERT INTO t4(c, ts) VALUES (50, UNIX_TIMESTAMP());
  inc $i;
}
--enable_query_log
SET SESSION debug = '+d,myrocks_zero_records_in_range_estimate';
SET SESSION rocksdb_records_in_range_dive_threshold = 10000;
explain select * from t4 where c = 50;
SET SESSION debug = '-d,myrocks_zero_records_in_range_estimate';
SET SESSION rocksdb_records_in_range_dive_threshold = @save_dive;
DROP TABLE t4;

--echo #
--echo # Partial indexes bypass the dive too (kd.is_partial_index()): a raw
--echo # iterator does not see unmaterialized rows and would undercount.
--echo # ik1 only materializes groups of i with more rows than the
--echo # threshold, so its content does not correspond 1:1 with the base
--echo # table; the narrow group below would dive to an exact count if the
--echo # dive engaged, but the legacy 1-row estimate is unchanged instead.
--echo #
CREATE TABLE t5 (
       i INT NOT NULL,
       j INT NOT NULL,
       PRIMARY KEY (i, j),
       KEY ik1 (i, j) comment 'cfname=cf_dive_partial;partial_group_keyparts=1;partial_group_threshold=1000'
) ENGINE = rocksdb;
--disable_query_log
let $i = 1;
while ($i <= 50) {
  eval INSERT INTO t5(i, j) VALUES (42, $i);
  inc $i;
}
--enable_query_log
SET SESSION debug = '+d,myrocks_zero_records_in_range_estimate';
SET SESSION rocksdb_records_in_range_dive_threshold = 10000;
explain select * from t5 where i = 42;
SET SESSION debug = '-d,myrocks_zero_records_in_range_estimate';
SET SESSION rocksdb_records_in_range_dive_threshold = @save_dive;
DROP TABLE t5;
