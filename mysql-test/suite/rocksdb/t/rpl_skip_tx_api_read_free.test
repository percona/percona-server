--source include/have_rocksdb.inc
--source include/have_binlog_format_row.inc

--echo #
--echo # Read-free replication with rocksdb_rpl_skip_tx_api applies updates and
--echo # deletes without a snapshot.
--echo #

--source include/rpl/init_source_replica.inc

--source include/rpl/connection_source.inc
CREATE TABLE t1 (id INT PRIMARY KEY, a INT, KEY ka(a)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1, 10), (2, 20), (3, 30);
UPDATE t1 SET a = a + 1 WHERE id = 2;
DELETE FROM t1 WHERE id = 1;
--source include/rpl/sync_to_replica.inc

SELECT @@global.rocksdb_rpl_skip_tx_api, @@global.rocksdb_read_free_rpl;
SELECT * FROM t1 ORDER BY id;
SELECT * FROM t1 FORCE INDEX(ka) ORDER BY a;

--source include/rpl/connection_source.inc
DROP TABLE t1;
--source include/rpl/deinit.inc
