--source include/have_rocksdb.inc
--source include/have_debug.inc

#
# A later snapshot of a transaction can be older than its earliest snapshot
# when the wall clock goes back. MyRocks must accept that.
#

CREATE TABLE t1 (id INT PRIMARY KEY, a INT) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1, 1), (2, 2);

SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
BEGIN;
SELECT * FROM t1 WHERE id = 1;
SET SESSION debug = '+d,myrocks_snapshot_clock_back';
UPDATE t1 SET a = a + 1 WHERE id = 1;
DELETE FROM t1 WHERE id = 2;
SELECT * FROM t1;
connect (con1,localhost,root,,);
--disable_result_log
SHOW ENGINE ROCKSDB TRANSACTION STATUS;
SELECT * FROM information_schema.rocksdb_trx;
--enable_result_log
disconnect con1;
connection default;
COMMIT;
SET SESSION debug = '-d,myrocks_snapshot_clock_back';
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
SELECT * FROM t1;
DROP TABLE t1;
