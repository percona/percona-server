--source include/have_rocksdb.inc
--source include/have_debug_sync.inc

#
# XA PREPARE names the RocksDB transaction while INFORMATION_SCHEMA.ROCKSDB_TRX
# may read the name from another thread. The two must be serialized: the reader
# waits for the name to be set.
#

--source include/count_sessions.inc
CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=ROCKSDB;

XA START 'race';
INSERT INTO t1 VALUES (1);
XA END 'race';
SET DEBUG_SYNC = 'rocksdb_set_name_locked SIGNAL named WAIT_FOR go';
--send XA PREPARE 'race'

--connect (con1,localhost,root,,)
SET DEBUG_SYNC = 'now WAIT_FOR named';
SET DEBUG_SYNC = 'myrocks_in_rocksdb_trx_before_trx SIGNAL reading';
--send SELECT LENGTH(NAME) > 0 AS named FROM information_schema.rocksdb_trx WHERE QUERY = "XA PREPARE 'race'"

--connect (con2,localhost,root,,)
SET DEBUG_SYNC = 'now WAIT_FOR reading';
# Let the reader reach the transaction mutex held by XA PREPARE
--sleep 0.5
SET DEBUG_SYNC = 'now SIGNAL go';
--disconnect con2

--connection con1
--reap
--disconnect con1

--connection default
--reap
XA COMMIT 'race';
SET DEBUG_SYNC = 'RESET';
SELECT * FROM t1;
DROP TABLE t1;
--source include/wait_until_count_sessions.inc
