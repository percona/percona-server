include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
CREATE TABLE t1 (a INT PRIMARY KEY, b INT, c INT, KEY sk(b, c)) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1, 1, 1), (2, 2, 2), (3, 3, 3), (4, 4, 4);
include/rpl/sync_to_replica.inc
SELECT * FROM t1 FORCE INDEX(PRIMARY);
a	b	c
1	1	1
2	2	2
3	3	3
4	4	4
SELECT * FROM t1 FORCE INDEX(sk);
a	b	c
1	1	1
2	2	2
3	3	3
4	4	4
# Make the replica diverge from the source
SET sql_log_bin = 0;
CALL mtr.add_suppression("Could not execute Update_rows event on table test.t1; Can't find record in 't1'");
UPDATE t1 SET a = 10 WHERE a = 1;
UPDATE t1 SET b = 20, c = 20 WHERE a = 2;
SET sql_log_bin = 1;
SELECT variable_value INTO @get_for_update FROM performance_schema.global_status
WHERE variable_name = 'rocksdb_num_get_for_update_calls';
UPDATE t1 SET a = 100 WHERE a = 1;
UPDATE t1 SET b = 200, c = 200 WHERE a = 2;
include/rpl/sync_to_replica.inc
# Idempotent mode looked the rows up, so both indexes agree
SELECT * FROM t1 FORCE INDEX(PRIMARY);
a	b	c
2	200	200
3	3	3
4	4	4
10	1	1
SELECT * FROM t1 FORCE INDEX(sk);
a	b	c
10	1	1
3	3	3
4	4	4
2	200	200
SELECT variable_value - @get_for_update > 0 AS rows_looked_up
FROM performance_schema.global_status
WHERE variable_name = 'rocksdb_num_get_for_update_calls';
rows_looked_up
1
# Strict mode still uses read-free replication
include/rpl/stop_replica.inc
SET @saved_replica_exec_mode = @@global.replica_exec_mode;
SET GLOBAL replica_exec_mode = STRICT;
include/rpl/start_replica.inc
SELECT variable_value INTO @get_for_update FROM performance_schema.global_status
WHERE variable_name = 'rocksdb_num_get_for_update_calls';
UPDATE t1 SET b = 30, c = 30 WHERE a = 3;
include/rpl/sync_to_replica.inc
SELECT * FROM t1 FORCE INDEX(sk);
a	b	c
10	1	1
4	4	4
3	30	30
2	200	200
SELECT variable_value - @get_for_update > 0 AS rows_looked_up
FROM performance_schema.global_status
WHERE variable_name = 'rocksdb_num_get_for_update_calls';
rows_looked_up
0
include/rpl/stop_replica.inc
SET GLOBAL replica_exec_mode = @saved_replica_exec_mode;
include/rpl/start_replica.inc
DROP TABLE t1;
include/rpl/sync_to_replica.inc
include/rpl/deinit.inc
