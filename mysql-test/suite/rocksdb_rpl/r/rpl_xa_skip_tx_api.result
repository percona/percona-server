include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
[connection slave]
SET @saved_skip_tx_api = @@GLOBAL.rocksdb_rpl_skip_tx_api;
SET @saved_super_read_only = @@GLOBAL.super_read_only;
SET @saved_read_only = @@GLOBAL.read_only;
include/rpl/stop_replica.inc
SET GLOBAL rocksdb_rpl_skip_tx_api = ON;
SET GLOBAL super_read_only = ON;
include/rpl/start_replica.inc
[connection master]
CREATE TABLE t1 (a INT PRIMARY KEY, b INT) ENGINE=ROCKSDB;
INSERT INTO t1 VALUES (1, 1);
# Prepared, then committed.
XA START 'r1';
INSERT INTO t1 VALUES (2, 2);
UPDATE t1 SET b = 10 WHERE a = 1;
XA END 'r1';
XA PREPARE 'r1';
include/rpl/sync_to_replica.inc
XA RECOVER;
formatID	gtrid_length	bqual_length	data
1	2	0	r1
[connection master]
XA COMMIT 'r1';
# Prepared, then rolled back.
XA START 'r2';
INSERT INTO t1 VALUES (3, 3);
XA END 'r2';
XA PREPARE 'r2';
XA ROLLBACK 'r2';
# One phase commit.
XA START 'r3';
INSERT INTO t1 VALUES (4, 4);
XA END 'r3';
XA COMMIT 'r3' ONE PHASE;
# A regular transaction after the XA transactions.
INSERT INTO t1 VALUES (5, 5);
include/rpl/sync_to_replica.inc
XA RECOVER;
formatID	gtrid_length	bqual_length	data
SELECT * FROM t1 ORDER BY a;
a	b
1	10
2	2
4	4
5	5
include/diff_tables.inc [master:t1, slave:t1]
[connection master]
DROP TABLE t1;
include/rpl/sync_to_replica.inc
include/rpl/stop_replica.inc
SET GLOBAL rocksdb_rpl_skip_tx_api = @saved_skip_tx_api;
SET GLOBAL super_read_only = @saved_super_read_only;
SET GLOBAL read_only = @saved_read_only;
include/rpl/start_replica.inc
include/rpl/deinit.inc
