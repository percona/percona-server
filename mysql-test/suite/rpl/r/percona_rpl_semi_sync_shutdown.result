#
# PS-9916 : If a source waiting for ACKs is stopped, it should log an ERROR message
#
include/rpl_init.inc [topology=1->2,1->3]
include/install_semisync.inc
SET GLOBAL rpl_semi_sync_source_timeout=1000000000;
CALL mtr.add_suppression("Semi-sync source failed on net_flush.*");
CALL mtr.add_suppression("\\[ERROR\\] \\[MY-011145\\] \\[Repl\\] SEMISYNC: Forced shutdown. Some updates might not be replicated.");
create table t1(a INT);
STOP REPLICA IO_THREAD;
STOP REPLICA IO_THREAD;
connection to server after slaves stopped
insert into t1 values(1);
connection3 to server after slaves stopped
insert into t1 values(2);
shutdown master
grep for the ERROR message
Pattern "\[ERROR\] \[MY-011145\] \[Repl\] SEMISYNC: Forced shutdown. Some updates might not be replicated" found
start the master server
START REPLICA IO_THREAD;
START REPLICA IO_THREAD;
DROP TABLE t1;
