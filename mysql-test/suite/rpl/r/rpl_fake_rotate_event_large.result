include/master-slave.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
[connection slave]
CALL mtr.add_suppression("Relay log write failure: could not queue event from source");
CALL mtr.add_suppression("Received oversized rotate event");
SET GLOBAL binlog_checksum= CRC32;
RESET REPLICA ALL;
include/rpl_change_topology.inc [new topology=1->2]
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
# Adding debug point 'binlog_sender_large_rotate_event' to @@GLOBAL.debug

# Case 1: source NONE, replica CRC32. Add checksum into rot_buf.

SET GLOBAL binlog_checksum= NONE;
[connection slave]
START REPLICA IO_THREAD;
include/wait_for_slave_io_error.inc [errno=13122]
Last_IO_Error = 'Relay log write failure: could not queue event from source'
include/assert_grep.inc [Replica error log contains oversized rotate event]
[connection master]
SET GLOBAL binlog_checksum= CRC32;

# Case 2: source CRC32, replica NONE. Strip checksum into rot_buf.

[connection slave]
SET GLOBAL binlog_checksum= NONE;
RESET REPLICA ALL;
include/rpl_change_topology.inc [new topology=1->2]
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
START REPLICA IO_THREAD;
include/wait_for_slave_io_error.inc [errno=13122]
Last_IO_Error = 'Relay log write failure: could not queue event from source'
include/assert_grep.inc [Replica error log contains oversized rotate event after RESET REPLICA ALL]
RESET REPLICA ALL;
SET GLOBAL binlog_checksum= CRC32;
[connection master]
# Removing debug point 'binlog_sender_large_rotate_event' from @@GLOBAL.debug
include/rpl_end.inc
