--source include/have_binlog_format_row.inc 
--source include/rpl/init_source_replica.inc

connection master;
CREATE TABLE t1(id INT AUTO_INCREMENT PRIMARY KEY, payload MEDIUMBLOB NOT NULL);

--let $rpl_server_number= 1
--source include/rpl/restart_server.inc
--source include/rpl/sync_to_replica.inc
# Sometimes it might happen that replica's IO thread might have not managed to
# reconnect to source server after its restart yet. Ignore CR_CONN_HOST_ERROR
# to avoid failure in such a case.
--let $slave_io_errno= 2003
--source include/rpl/stop_replica.inc
--source include/rpl/start_replica.inc
--connection master

INSERT INTO t1(payload) VALUES(REPEAT('a',1468872));
sync_slave_with_master;

connection master;
DROP TABLE t1;

--source include/rpl/deinit.inc
