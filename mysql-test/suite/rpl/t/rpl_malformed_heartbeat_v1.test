# ==== Purpose ====
#
# Bug#39377010 - Validate legacy heartbeat events before exposing parser state
#
# A v1 heartbeat event must carry the current binlog filename after the
# standard event header. The binlog_sender_header_only_heartbeat_v1 debug
# point makes the source dump thread emit a header-only v1 heartbeat with
# no filename payload. Without the fix, the legacy parser could accept that
# event and the replica would not report a heartbeat validation failure.
#
# ==== Requirements ====
#
# R1. A header-only v1 heartbeat must be rejected on the replica receiver
#     path with a heartbeat validation error.
#
# R2. After removing the malformed-heartbeat debug point, v1 heartbeats with
#     a normal payload must still be accepted and replication must continue.
#
# ==== Implementation ====
#
# 1. Force the source dump thread to send legacy v1 heartbeats.
# 2. Enable binlog_sender_header_only_heartbeat_v1 on the source.
# 3. Start replication with a short SOURCE_HEARTBEAT_PERIOD.
# 4. Wait for the replica I/O thread to stop with a queueing error and verify
#    the heartbeat validation message in the error log.
# 5. Remove the malformed-heartbeat debug point, restart replication, and
#    verify that heartbeats and normal DML still work.
#
# ==== References ====
#
# Bug#39377010 mysql/mysql-server@f2682635b5f

--source include/not_group_replication_plugin.inc
--source include/have_debug.inc
--source include/have_binlog_format_row.inc

--echo #
--echo # Bug#39377010 - reject header-only legacy heartbeat events
--echo #

--let $rpl_skip_start_slave= 1
--source include/master-slave.inc

--source include/rpl_connection_master.inc
--let $debug_point= use_old_heartbeat_version
--source include/add_debug_point.inc
--let $debug_point= binlog_sender_header_only_heartbeat_v1
--source include/add_debug_point.inc

--connection slave
call mtr.add_suppression("Unexpected source's heartbeat data");
call mtr.add_suppression("Relay log write failure: could not queue event from source");

--source include/stop_slave.inc
CHANGE REPLICATION SOURCE TO SOURCE_HEARTBEAT_PERIOD=0.1;
--source include/start_slave_io.inc

--echo # R1: header-only v1 heartbeat must fail on the receiver path.
--let $slave_io_errno= 13122
--let $show_slave_io_error= 1
--source include/wait_for_slave_io_error.inc

--let $assert_text= Found heartbeat validation failure in the replica error log
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_select= inconsistent heartbeat event content
--let $assert_count= 1
--source include/assert_grep.inc

--echo # R2: normal v1 heartbeats must work after removing the malformed hook.
--source include/rpl_connection_master.inc
--let $debug_point= binlog_sender_header_only_heartbeat_v1
--source include/remove_debug_point.inc

CREATE TABLE t1 (a INT);

--connection slave
--source include/stop_slave.inc
--source include/start_slave.inc

--let $status_col= count_received_heartbeats
--let $table= replication_connection_status
--let $status_col_value= query_get_value(select count_received_heartbeats from performance_schema.replication_connection_status, count_received_heartbeats, 1)
--let $status_col_comparsion= >
--source include/wait_for_rpl_pfs_status.inc

--source include/rpl_connection_master.inc
INSERT INTO t1 VALUES (1);
--source include/sync_slave_sql_with_master.inc

--let $diff_tables= master:t1, slave:t1
--source include/diff_tables.inc

--echo # Clean up
--source include/rpl_connection_master.inc
--let $debug_point= use_old_heartbeat_version
--source include/remove_debug_point.inc
DROP TABLE t1;
--source include/sync_slave_sql_with_master.inc
--source include/rpl_end.inc
