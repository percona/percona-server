# innodb_hnsw_max_memory: global, dynamic, bytes; 0 means no limit.

SET @start_global_value = @@global.innodb_hnsw_max_memory;

--echo # Default: 1 GiB.
SELECT @@global.innodb_hnsw_max_memory;
SHOW GLOBAL VARIABLES LIKE 'innodb_hnsw_max_memory';
SELECT * FROM performance_schema.global_variables
  WHERE variable_name = 'innodb_hnsw_max_memory';

--echo # Global only.
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT @@session.innodb_hnsw_max_memory;
--error ER_GLOBAL_VARIABLE
SET SESSION innodb_hnsw_max_memory = 1024;
SELECT * FROM performance_schema.session_variables
  WHERE variable_name = 'innodb_hnsw_max_memory';

--echo # Writable: no limit, a small bound, the maximum.
SET GLOBAL innodb_hnsw_max_memory = 0;
SELECT @@global.innodb_hnsw_max_memory;
SET GLOBAL innodb_hnsw_max_memory = 1024;
SELECT @@global.innodb_hnsw_max_memory;
SET GLOBAL innodb_hnsw_max_memory = 18446744073709551615;
SELECT @@global.innodb_hnsw_max_memory;

--echo # Below the minimum is clamped to 0.
SET GLOBAL innodb_hnsw_max_memory = -1;
SELECT @@global.innodb_hnsw_max_memory;

--echo # Wrong types.
--error ER_WRONG_TYPE_FOR_VAR
SET GLOBAL innodb_hnsw_max_memory = 1.1;
--error ER_WRONG_TYPE_FOR_VAR
SET GLOBAL innodb_hnsw_max_memory = 1e1;
--error ER_WRONG_TYPE_FOR_VAR
SET GLOBAL innodb_hnsw_max_memory = 'AUTO';

SET GLOBAL innodb_hnsw_max_memory = @start_global_value;
SELECT @@global.innodb_hnsw_max_memory;
