SET @start_global_value = @@global.innodb_lru_make_young_drain_threshold;
SELECT @start_global_value;

#
# exists as global only
#
--echo Valid value 0 or more
select @@global.innodb_lru_make_young_drain_threshold >= 0;
select @@global.innodb_lru_make_young_drain_threshold;
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
select @@session.innodb_lru_make_young_drain_threshold;
show global variables like 'innodb_lru_make_young_drain_threshold';
show session variables like 'innodb_lru_make_young_drain_threshold';
select * from performance_schema.global_variables where variable_name='innodb_lru_make_young_drain_threshold';
select * from performance_schema.session_variables where variable_name='innodb_lru_make_young_drain_threshold';

#
# show that it's writable
#
set global innodb_lru_make_young_drain_threshold=325;
select @@global.innodb_lru_make_young_drain_threshold;
select * from performance_schema.global_variables where variable_name='innodb_lru_make_young_drain_threshold';
select * from performance_schema.session_variables where variable_name='innodb_lru_make_young_drain_threshold';
--error ER_GLOBAL_VARIABLE
set session innodb_lru_make_young_drain_threshold=444;

#
# incorrect types
#
--error ER_WRONG_TYPE_FOR_VAR
set global innodb_lru_make_young_drain_threshold=1.1;
--error ER_WRONG_TYPE_FOR_VAR
set global innodb_lru_make_young_drain_threshold=1e1;
--error ER_WRONG_TYPE_FOR_VAR
set global innodb_lru_make_young_drain_threshold="foo";

set global innodb_lru_make_young_drain_threshold=7;
select @@global.innodb_lru_make_young_drain_threshold;
select * from performance_schema.global_variables where variable_name='innodb_lru_make_young_drain_threshold';
set global innodb_lru_make_young_drain_threshold=-7;
select @@global.innodb_lru_make_young_drain_threshold;
select * from performance_schema.global_variables where variable_name='innodb_lru_make_young_drain_threshold';

#
# min value
#
set global innodb_lru_make_young_drain_threshold=0;
select @@global.innodb_lru_make_young_drain_threshold;

SET @@global.innodb_lru_make_young_drain_threshold = @start_global_value;
SELECT @@global.innodb_lru_make_young_drain_threshold;
