####### plugin/thread_pool/tests/mtr/t/thread_pool_size_basic.test #####
#                                                                      #
# Variable Name: thread_pool_size                                      #
# Scope:         Global                                                #
# Access Type:   Static                                                #
# Data Type:     Integer                                               #
#                                                                      #
#                                                                      #
# Creation Date: 2010-01-18                                            #
# Author :       Mikael Ronstrom, Matthias Leich                       #
#                                                                      #
# Description:   Test Cases of static System Variable thread_pool_size #
#                that checks the behavior of this variable in the      #
#                following ways                                        #
#                * Value Check                                         #
#                * Scope Check                                         #
#                                                                      #
########################################################################

--source include/have_thread_pool.inc

##################################################################
# Build some prereqisites                                        #
##################################################################
# In compat mode this variable is owned by the server (Percona
# implementation), whose default can differ from the Oracle plugin's own
# (vcpus/2 clamped to 16) default; read the actual value instead of
# assuming a fixed default. The exact default is validated elsewhere, in
# thread_pool_defaults.test.
SET @default_val = @@GLOBAL.thread_pool_size;
let $default_val=`SELECT @default_val`;
CREATE USER low_priv@localhost;
GRANT USAGE ON test.* TO low_priv@localhost;
--connect (low_priv,localhost,low_priv,,test)
let $id_list= `SELECT CONNECTION_ID()`;
--replace_result $default_val <default_val>
eval SET @default_val = $default_val;
--connection default


--echo #---------------------BS_STVARS_051_01----------------------#
####################################################################
# Check the default value                                          #
####################################################################
SELECT @@GLOBAL.thread_pool_size = @default_val AS "Expect 1";

--connection low_priv
SELECT @@GLOBAL.thread_pool_size = @default_val AS "Expect 1";

--connection default
--disconnect low_priv
DROP USER low_priv@localhost;


--echo #---------------------BS_STVARS_051_02----------------------#
####################################################################
# Check if Value can be set                                        #
####################################################################
# In compat mode this variable is owned by the server (Percona
# implementation), which allows GLOBAL writes at runtime (unlike the
# Oracle plugin's own read-only sysvar). As a plain core Sys_var_uint, an
# out-of-range value is clamped to the nearest bound with a truncation
# warning rather than rejected outright. Note that the Oracle thread_pool
# plugin only reads this value once at plugin startup, so changing it here
# has no effect on the running pool's actual thread-group count until the
# server is restarted.
SET @@GLOBAL.thread_pool_size = @default_val;
SELECT @@GLOBAL.thread_pool_size = @default_val AS "Expect 1";

SET @@GLOBAL.thread_pool_size = 0;
SELECT @@GLOBAL.thread_pool_size AS "Expect 1";

# Restore, since later checks in this test still expect @default_val.
SET @@GLOBAL.thread_pool_size = @default_val;


--echo #---------------------BS_STVARS_051_03----------------------#
#########################################################################
# Check if the value in GLOBAL/SESSION Table matches value in variable  #
#########################################################################
--disable_warnings
SELECT @@GLOBAL.thread_pool_size = VARIABLE_VALUE AS "Expect 1"
FROM performance_schema.global_variables
WHERE VARIABLE_NAME = 'thread_pool_size';
SELECT @@GLOBAL.thread_pool_size = VARIABLE_VALUE AS "Expect 1"
FROM performance_schema.session_variables
WHERE VARIABLE_NAME = 'thread_pool_size';
--enable_warnings


--echo #---------------------BS_STVARS_051_04----------------------#
##############################################################################
# Check if accessing variable with and without GLOBAL point to same variable #
##############################################################################
SELECT @@thread_pool_size = @@GLOBAL.thread_pool_size AS "Expect 1";


--echo #---------------------BS_STVARS_051_05----------------------#
##############################################################################
# Check if there exist variables with similar names                          #
##############################################################################
# There is no such session Variable
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT COUNT(@@SESSION.thread_pool_size);

--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT thread_pool_size = @@SESSION.thread_pool_size;


# Cleanup
# The user low_priv was disconnected long time ago. Take care that he
# has really disappeared from the processlist
--source ../inc/wait_until_disappeared.inc
