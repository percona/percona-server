--echo #
--echo # PS-12028: Binlog group commit leaks Global_connection_memory until disconnect
--echo # (upstream Bug #121694)
--echo #

# The binlog group commit leader must not leave connection memory charged to
# the sessions it commits for.

--source include/have_log_bin.inc
--source include/count_sessions.inc

SET @saved_query_alloc_block_size = @@global.query_alloc_block_size;
SET @saved_sync_delay = @@global.binlog_group_commit_sync_delay;
SET @saved_sync_no_delay_count = @@global.binlog_group_commit_sync_no_delay_count;

# Small blocks so that a commit can need a new mem_root block.
SET GLOBAL query_alloc_block_size = 1024;
# Make the four sessions below commit as one group.
SET GLOBAL binlog_group_commit_sync_delay = 1000000;
SET GLOBAL binlog_group_commit_sync_no_delay_count = 4;

CREATE TABLE t1 (id INT PRIMARY KEY, c1 VARCHAR(255), c2 BIGINT, c3 VARCHAR(255),
  c4 BIGINT, c5 VARCHAR(255), c6 MEDIUMTEXT, c7 DATETIME, c8 DATETIME, c9 BIGINT,
  c10 DATETIME, c11 TINYINT, c12 VARCHAR(255), c13 BIGINT, c14 TEXT);

--connect (con1, localhost, root)
--connect (con2, localhost, root)
--connect (con3, localhost, root)
--connect (con4, localhost, root)

--connection default
--let $memory_before = query_get_value(SELECT VARIABLE_VALUE AS v FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Global_connection_memory', v, 1)

--disable_query_log
--let $i = 100
while ($i)
{
  --let $c = 4
  while ($c)
  {
    --connection con$c
    BEGIN;
    --eval INSERT INTO t1 VALUES ($i * 10 + $c, 'ab', 1234567890, 'Lorem', 123456789012, REPEAT('a', 64), 'value', '2024-01-01 00:00:00', '2024-01-01 00:00:00', 9876543210, NULL, 1, 'Lorem ipsum dolor sit amet', NULL, 'lorem') AS new ON DUPLICATE KEY UPDATE c1 = new.c1, c2 = new.c2, c3 = new.c3, c4 = new.c4, c5 = new.c5, c6 = new.c6, c7 = new.c7, c8 = new.c8, c9 = new.c9, c10 = new.c10, c11 = new.c11, c12 = new.c12, c13 = new.c13, c14 = new.c14
    --dec $c
  }
  --let $c = 4
  while ($c)
  {
    --connection con$c
    --send COMMIT
    --dec $c
  }
  --let $c = 4
  while ($c)
  {
    --connection con$c
    --reap
    --dec $c
  }
  --dec $i
}
--enable_query_log

--connection default
--let $memory_after = query_get_value(SELECT VARIABLE_VALUE AS v FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Global_connection_memory', v, 1)
--let $assert_text = Group commit does not leave connection memory charged to its sessions
--let $assert_cond = $memory_after - $memory_before < 65536
--source include/assert.inc

--disconnect con1
--disconnect con2
--disconnect con3
--disconnect con4
--source include/wait_until_count_sessions.inc
DROP TABLE t1;
SET GLOBAL query_alloc_block_size = @saved_query_alloc_block_size;
SET GLOBAL binlog_group_commit_sync_delay = @saved_sync_delay;
SET GLOBAL binlog_group_commit_sync_no_delay_count = @saved_sync_no_delay_count;
