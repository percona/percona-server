# MTR test for PS-11024: Inconsistent results and NULL leakage in
# INDEX-ONLY SCAN on FLOAT ZEROFILL columns
# Created: 2026-04-15
# Reproduces: When using a secondary index on a FLOAT ZEROFILL column,
# index-only scan returns NULL values for WHERE c0 = 0.0 after
# INSERT IGNORE of string-coerced values like "-0x".

--echo # Setup
DROP TABLE IF EXISTS mysql_bug_mre;
CREATE TABLE mysql_bug_mre (
    c0 FLOAT ZEROFILL NULL
) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin;
CREATE INDEX i_c0 ON mysql_bug_mre (c0);

--echo #
--echo # Phase S1: Initial state - insert mix of zeros, string coercions, NULL
--echo #
INSERT IGNORE INTO mysql_bug_mre (c0) VALUES (0.0), ("x"), (NULL);

--echo # S1 query: MAX via index should return 0000000000
SELECT MAX(c0) AS s1_max FROM mysql_bug_mre WHERE c0 = 0.0;

--echo #
--echo # Phase S2: Trigger the bug with more coerced string values
--echo #
INSERT IGNORE INTO mysql_bug_mre (c0) VALUES
(0.0), (0.0), (0.0), (""), ("x"), ("-0x"), (NULL), (NULL);

ANALYZE TABLE mysql_bug_mre;

--echo #
--echo # Bug Evidence 1: MAX() aggregate via index-only scan
--echo # Expected: 0000000000 (not NULL)
--echo #
SELECT MAX(c0) AS result FROM mysql_bug_mre WHERE c0 = 0.0;

--echo #
--echo # Bug Evidence 2: NULL leakage - WHERE c0 = 0.0 must not return NULLs
--echo # All returned rows must show 0000000000, no NULL
--echo #
SELECT c0 FROM mysql_bug_mre WHERE c0 = 0.0;

--echo #
--echo # Bug Evidence 3: FORCE INDEX vs IGNORE INDEX discrepancy
--echo #
SELECT MAX(c0) AS idx_result FROM mysql_bug_mre FORCE INDEX (i_c0) WHERE c0 = 0.0;
SELECT MAX(c0) AS tbl_result FROM mysql_bug_mre IGNORE INDEX (i_c0) WHERE c0 = 0.0;

--echo # Cleanup
DROP TABLE mysql_bug_mre;

--echo # Done
