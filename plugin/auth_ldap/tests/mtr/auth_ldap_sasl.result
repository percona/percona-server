CREATE ROLE 'test_role';
CREATE ROLE 'test_role2';
SELECT PLUGIN_NAME, PLUGIN_STATUS FROM INFORMATION_SCHEMA.PLUGINS WHERE PLUGIN_NAME LIKE 'authentication_ldap_sasl';
PLUGIN_NAME	PLUGIN_STATUS
authentication_ldap_sasl	ACTIVE
SHOW GLOBAL VARIABLES LIKE 'authentication_ldap_sasl';
Variable_name	Value
SET GLOBAL authentication_ldap_sasl_bind_base_dn = 'ou=People,dc=example,dc=com';
SHOW GLOBAL VARIABLES LIKE 'authentication_ldap_sasl';
Variable_name	Value
CREATE USER john3 IDENTIFIED WITH authentication_ldap_sasl BY 'uid=john3,ou=People,dc=example,dc=com';
CREATE USER nonexistent IDENTIFIED WITH authentication_ldap_sasl BY 'uid=nonexistent';
SHOW GRANTS FOR 'john3';
Grants for john3@%
GRANT USAGE ON *.* TO `john3`@`%`
SHOW GLOBAL VARIABLES LIKE 'authentication_ldap_sasl';
Variable_name	Value
ERROR HY000: Unknown MySQL error
#
# The LDAP server ignores the bind DN of a SASL bind and takes the
# identity from the SASL exchange, which is controlled by the client.
# A successful SASL bind as one LDAP user must not authenticate a MySQL
# account mapped to a different LDAP entry.
#
# The DN of the account is resolved by the LDAP server, so letter case
# that the schema ignores does not matter: attribute names, and values
# of caseIgnoreMatch attributes (uid, ou, dc). Neither does whitespace
# around separators.
ALTER USER john3 IDENTIFIED WITH authentication_ldap_sasl BY 'UID=JOHN3, OU=PEOPLE, DC=EXAMPLE, DC=COM';
SELECT CURRENT_USER();
CURRENT_USER()
john3@%
# SASL identity john3 (valid credentials) for an account mapped to
# uid=john4: access denied.
ALTER USER john3 IDENTIFIED WITH authentication_ldap_sasl BY 'uid=john4,ou=People,dc=example,dc=com';
ERROR 28000: Access denied for user 'john3'@'localhost' (using password: YES)
# Same for an account mapped to a DN that does not exist in LDAP.
ALTER USER john3 IDENTIFIED WITH authentication_ldap_sasl BY 'cn=john3,ou=People,dc=example,dc=com';
ERROR 28000: Access denied for user 'john3'@'localhost' (using password: YES)
# Letter case matters for values of caseExactMatch attributes:
# psLoginId=kate and psLoginId=Kate are two different entries.
# SASL identity ce-kate, mapped to its own entry: success.
CREATE USER 'ce-kate' IDENTIFIED WITH authentication_ldap_sasl BY 'psLoginId=kate,ou=People,dc=example,dc=com';
SELECT CURRENT_USER();
CURRENT_USER()
ce-kate@%
# Same credentials for an account mapped to psLoginId=Kate, which exists
# and differs only by letter case: access denied.
ALTER USER 'ce-kate' IDENTIFIED WITH authentication_ldap_sasl BY 'psLoginId=Kate,ou=People,dc=example,dc=com';
ERROR 28000: Access denied for user 'ce-kate'@'localhost' (using password: YES)
DROP USER 'ce-kate';
DROP USER john3;
DROP USER nonexistent;
DROP ROLE test_role;
DROP ROLE test_role2;
SET GLOBAL authentication_ldap_sasl_bind_base_dn = '';
SET GLOBAL authentication_ldap_sasl_log_status = 1;
SET GLOBAL authentication_ldap_sasl_group_role_mapping = '';
