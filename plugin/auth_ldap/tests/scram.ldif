# Test schema: psLoginId has a case-sensitive equality matching rule, so
# psLoginId=kate and psLoginId=Kate (see add3.ldif) are two different entries.
# The OIDs are in the OpenLDAP experimental arc (1.3.6.1.4.1.4203.666).
dn: cn=pstest,cn=schema,cn=config
changetype: add
objectClass: olcSchemaConfig
cn: pstest
olcAttributeTypes: ( 1.3.6.1.4.1.4203.666.255.12030.1 NAME 'psLoginId' EQUALITY caseExactMatch SUBSTR caseExactSubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
olcObjectClasses: ( 1.3.6.1.4.1.4203.666.255.12030.2 NAME 'psLoginAccount' SUP top AUXILIARY MAY psLoginId )

# SASL identity "ce-X" maps to psLoginId=X, any other identity "X" to uid=X.
dn: cn=config
changetype: modify
add: olcAuthzRegexp
olcAuthzRegexp: {0}"uid=ce-([^,]*),cn=scram-sha-1,cn=auth" "psLoginId=$1,ou=People,dc=example,dc=com"
olcAuthzRegexp: {1}"uid=(.*),cn=scram-sha-1,cn=auth" "uid=$1,ou=People,dc=example,dc=com"
