include/group_replication.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the master info repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START SLAVE; see the 'START SLAVE Syntax' in the MySQL Manual for more information.
[connection server1]
[connection server2]
SET SESSION sql_log_bin= 0;
call mtr.add_suppression("Invalid event length while applying data packet on group replication applier pipeline.");
call mtr.add_suppression("Fatal error during execution on the Applier process of Group Replication. The server will now leave the group.");
call mtr.add_suppression("Error at event handling! Got error: 1");
call mtr.add_suppression("The server was automatically set into read only mode after an error was detected.");
call mtr.add_suppression("Skipping leave operation: concurrent attempt to leave the group is on-going.");
call mtr.add_suppression("The applier thread execution was aborted. Unable to process more transactions, this member will now leave the group.");
call mtr.add_suppression("The slave coordinator and worker threads are stopped");
call mtr.add_suppression("The member is leaving a group without being on one");
call mtr.add_suppression("The member is already leaving or joining a group.");
call mtr.add_suppression("Error leaving the group");
call mtr.add_suppression("Unable to convert a packet into an event on the applier! Error: invalid event length.");
call mtr.add_suppression("Failed to fetch Transaction_context_log_event containing required transaction info for certification");
SET SESSION sql_log_bin= 1;

############################################################
# 1. Add a debug point on M2 to force an invalid event length on the
#    applier data packet.
#
[connection server2]
SET @debug_saved= @@GLOBAL.DEBUG;
SET @@GLOBAL.DEBUG= '+d,group_replication_applier_force_invalid_event_length';

############################################################
# 2. Execute a transaction on M1 so that M2 applier receives a data packet.
#    Due to debug point it will have invalid event length.
#
[connection server1]
CREATE TABLE t1 (c1 INT NOT NULL PRIMARY KEY) ENGINE=InnoDB;

############################################################
# 3. Wait until M2 applier errors out and member leaves the group.
#
[connection server2]
include/gr_wait_for_member_state.inc
include/stop_group_replication.inc
include/gr_wait_for_member_state.inc
SET @@GLOBAL.DEBUG= @debug_saved;
include/start_group_replication.inc

############################################################
# 4. Assert that the expected error is logged on M2.
#    Indicating that the bad packet was rejected at the applier pipeline.
#
include/assert_grep.inc [Found the expected invalid event length error on the applier pipeline.]

############################################################
# 5. Assert that the bad packet was rejected at the applier pipeline.
#    avoiding relay log corruption / read error messages.
#
include/assert_grep.inc [No Log_event::read_log_event error was emitted on member 2.]
include/assert_grep.inc [No relay log parse failure was emitted on member 2.]
include/assert_grep.inc [No relay log read failure was emitted on member 2.]
include/assert_grep.inc [No slave SQL thread I/O abort was emitted on member 2.]

############################################################
# 6. Add a debug point on M2 to force an invalid event length inside
#    Pipeline_event::convert_packet_to_log_event().
#
[connection server2]
SET @debug_saved= @@GLOBAL.DEBUG;
SET @@GLOBAL.DEBUG= '+d,group_replication_pipeline_force_invalid_event_length';

############################################################
# 7. Execute a transaction on M1 so that M2's pipeline converts the packet.
#    Due to the debug point it will see an invalid event length.
#
[connection server1]
CREATE TABLE t2 (c1 INT NOT NULL PRIMARY KEY) ENGINE=InnoDB;

############################################################
# 8. Wait until M2 applier errors out and member leaves the group.
#
[connection server2]
include/gr_wait_for_member_state.inc
include/stop_group_replication.inc
include/gr_wait_for_member_state.inc
SET @@GLOBAL.DEBUG= @debug_saved;
include/start_group_replication.inc

############################################################
# 9. Assert that the pipeline-specific error is logged on M2,
#    confirming the early-return packet-free path executed.
#
include/assert_grep.inc [Found the expected invalid event length error on the pipeline conversion path.]

############################################################
# 10. Assert that old errors are not logged.
#
include/assert_grep.inc [Pre-patch deep-failure marker (Error: Sanity check failed) is absent on member 2.]

############################################################
# 11. Clean up.
#
[connection server1]
DROP TABLE t1;
DROP TABLE t2;
include/group_replication_end.inc
