include/group_replication.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the master info repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START SLAVE; see the 'START SLAVE Syntax' in the MySQL Manual for more information.
[connection server1]

############################################################
# 1. Add the error suppressions on both members.
#
[connection server1]
SET SESSION sql_log_bin= 0;
call mtr.add_suppression("Malformed recovery message payload received from the group. The member will now exit the group.");
call mtr.add_suppression("The server was automatically set into read only mode after an error was detected.");
call mtr.add_suppression("Skipping leave operation: concurrent attempt to leave the group is on-going.");
call mtr.add_suppression("The member is leaving a group without being on one.");
call mtr.add_suppression("Error stopping all replication channels while server was leaving the group.*");
SET SESSION sql_log_bin= 1;
[connection server2]
SET SESSION sql_log_bin= 0;
call mtr.add_suppression("Malformed recovery message payload received from the group. The member will now exit the group.");
call mtr.add_suppression("The server was automatically set into read only mode after an error was detected.");
call mtr.add_suppression("Skipping leave operation: concurrent attempt to leave the group is on-going.");
call mtr.add_suppression("The member is leaving a group without being on one.");
call mtr.add_suppression("Error stopping all replication channels while server was leaving the group.*");
SET SESSION sql_log_bin= 1;

############################################################
# 2. Bootstrap the group on M1.
#
[connection server1]
include/start_and_bootstrap_group_replication.inc

############################################################
# 3. Add a debug point on M2 to relabel the member uuid payload item of
#    the recovery end message.
#
[connection server2]
# Adding debug point 'group_replication_malformed_recovery_message_payload_type' to @@GLOBAL.debug

############################################################
# 4. Start GR on M2. Recovery completes, the malformed recovery end
#    message is broadcast to the group, and M2, the sender, rejects its
#    own copy of it and goes into ERROR instead of ONLINE.
#
include/start_group_replication.inc

############################################################
# 5. Wait until M1, the receiver, rejects the message and goes into
#    ERROR.
#
[connection server1]
include/gr_wait_for_member_state.inc

############################################################
# 6. Assert that both members logged the rejection, that both were put
#    into read only mode, and that M2 was never declared online.
#
include/assert_grep.inc [Member 1 rejected the relabelled recovery message payload item.]
include/assert_grep.inc [Member 2 rejected the relabelled recovery message payload item.]
include/assert_grep.inc [Member 2 was never declared online, the malformed message was not acted upon.]
include/assert.inc [Member 1 was put into super read only mode.]
[connection server2]
include/assert.inc [Member 2 was put into super read only mode.]

############################################################
# 7. Restore the group and clean up.
#
[connection server2]
# Removing debug point 'group_replication_malformed_recovery_message_payload_type' from @@GLOBAL.debug
include/stop_group_replication.inc
[connection server1]
include/stop_group_replication.inc
include/start_and_bootstrap_group_replication.inc
[connection server2]
include/start_group_replication.inc
[connection server1]
include/group_replication_end.inc
