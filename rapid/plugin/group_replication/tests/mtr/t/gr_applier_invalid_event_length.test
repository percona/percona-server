################################################################################
# BUG#38712932: MySQL Group Replication applier pipeline validations
#
# Validate that the Group Replication applier pipeline rejects data packets
# that declare an event length bigger than the packet size, instead of
# reading past the end of the packet buffer.
#
# Test:
# 0. The test requires two servers: M1 and M2.
# 1. Add a debug point on M2 to force an invalid event length on the
#    applier data packet.
# 2. Execute a transaction on M1 so that M2 applier receives a data packet.
#    Due to debug point it will have invalid event length.
# 3. Wait until M2 applier errors out and member leaves the group.
# 4. Assert that the expected error is logged on M2.
#    Indicating that the bad packet was rejected at the applier pipeline.
# 5. Assert that the bad packet was rejected at the applier pipeline.
#    avoiding relay log corruption / read error messages.
# 6. Add a debug point on M2 to force an invalid event length inside
#    Pipeline_event::convert_packet_to_log_event().
# 7. Execute a transaction on M1 so that M2's pipeline converts the packet.
#    Due to the debug point it will see an invalid event length.
# 8. Wait until M2 applier errors out and member leaves the group.
# 9. Assert that the pipeline-specific error is logged on M2,
#    confirming the early-return packet-free path executed.
# 10. Assert that old errors are not logged.
# 11. Clean up.
################################################################################
--source include/have_debug.inc
--source ../inc/have_group_replication_plugin.inc
--source ../inc/group_replication.inc

--let $rpl_connection_name= server2
--source include/rpl_connection.inc

SET SESSION sql_log_bin= 0;
call mtr.add_suppression("Invalid event length while applying data packet on group replication applier pipeline.");
call mtr.add_suppression("Fatal error during execution on the Applier process of Group Replication. The server will now leave the group.");
call mtr.add_suppression("Error at event handling! Got error: 1");
call mtr.add_suppression("The server was automatically set into read only mode after an error was detected.");
call mtr.add_suppression("Skipping leave operation: concurrent attempt to leave the group is on-going.");
call mtr.add_suppression("The applier thread execution was aborted. Unable to process more transactions, this member will now leave the group.");
call mtr.add_suppression("The slave coordinator and worker threads are stopped");
call mtr.add_suppression("The member is leaving a group without being on one");
call mtr.add_suppression("The member is already leaving or joining a group.");
call mtr.add_suppression("Error leaving the group");
call mtr.add_suppression("Unable to convert a packet into an event on the applier! Error: invalid event length.");
call mtr.add_suppression("Failed to fetch Transaction_context_log_event containing required transaction info for certification");
SET SESSION sql_log_bin= 1;

--echo
--echo ############################################################
--echo # 1. Add a debug point on M2 to force an invalid event length on the
--echo #    applier data packet.
--echo #

--let $rpl_connection_name= server2
--source include/rpl_connection.inc
SET @debug_saved= @@GLOBAL.DEBUG;
SET @@GLOBAL.DEBUG= '+d,group_replication_applier_force_invalid_event_length';

--echo
--echo ############################################################
--echo # 2. Execute a transaction on M1 so that M2 applier receives a data packet.
--echo #    Due to debug point it will have invalid event length.
--echo #

--let $rpl_connection_name= server1
--source include/rpl_connection.inc
CREATE TABLE t1 (c1 INT NOT NULL PRIMARY KEY) ENGINE=InnoDB;

--echo
--echo ############################################################
--echo # 3. Wait until M2 applier errors out and member leaves the group.
--echo #

--let $rpl_connection_name= server2
--source include/rpl_connection.inc

--let $group_replication_member_state= ERROR
--source ../inc/gr_wait_for_member_state.inc

--source include/stop_group_replication.inc
--let $group_replication_member_state= OFFLINE
--source ../inc/gr_wait_for_member_state.inc

SET @@GLOBAL.DEBUG= @debug_saved;
--source include/start_group_replication.inc

--echo
--echo ############################################################
--echo # 4. Assert that the expected error is logged on M2.
--echo #    Indicating that the bad packet was rejected at the applier pipeline.
--echo #

--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_only_after = CURRENT_TEST: group_replication.gr_applier_invalid_event_length
--let $assert_count = 1
--let $assert_select = Invalid event length while applying data packet on group replication applier pipeline.
--let $assert_text = Found the expected invalid event length error on the applier pipeline.
--source include/assert_grep.inc

--echo
--echo ############################################################
--echo # 5. Assert that the bad packet was rejected at the applier pipeline.
--echo #    avoiding relay log corruption / read error messages.
--echo #

--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_only_after = CURRENT_TEST: group_replication.gr_applier_invalid_event_length
--let $assert_count = 0
--let $assert_select = Error in Log_event::read_log_event
--let $assert_text = No Log_event::read_log_event error was emitted on member 2.
--source include/assert_grep.inc

--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_only_after = CURRENT_TEST: group_replication.gr_applier_invalid_event_length
--let $assert_count = 0
--let $assert_select = Could not parse relay log event entry. The possible reasons are: the master's binary log is corrupted
--let $assert_text = No relay log parse failure was emitted on member 2.
--source include/assert_grep.inc

--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_only_after = CURRENT_TEST: group_replication.gr_applier_invalid_event_length
--let $assert_count = 0
--let $assert_select = Relay log read failure: Could not parse relay log event entry.
--let $assert_text = No relay log read failure was emitted on member 2.
--source include/assert_grep.inc

--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_only_after = CURRENT_TEST: group_replication.gr_applier_invalid_event_length
--let $assert_count = 0
--let $assert_select = slave SQL thread aborted because of I/O error
--let $assert_text = No slave SQL thread I/O abort was emitted on member 2.
--source include/assert_grep.inc

--echo
--echo ############################################################
--echo # 6. Add a debug point on M2 to force an invalid event length inside
--echo #    Pipeline_event::convert_packet_to_log_event().
--echo #

--let $rpl_connection_name= server2
--source include/rpl_connection.inc

SET @debug_saved= @@GLOBAL.DEBUG;
SET @@GLOBAL.DEBUG= '+d,group_replication_pipeline_force_invalid_event_length';

--echo
--echo ############################################################
--echo # 7. Execute a transaction on M1 so that M2's pipeline converts the packet.
--echo #    Due to the debug point it will see an invalid event length.
--echo #

--let $rpl_connection_name= server1
--source include/rpl_connection.inc
CREATE TABLE t2 (c1 INT NOT NULL PRIMARY KEY) ENGINE=InnoDB;

--echo
--echo ############################################################
--echo # 8. Wait until M2 applier errors out and member leaves the group.
--echo #

--let $rpl_connection_name= server2
--source include/rpl_connection.inc

--let $group_replication_member_state= ERROR
--source ../inc/gr_wait_for_member_state.inc

--source include/stop_group_replication.inc
--let $group_replication_member_state= OFFLINE
--source ../inc/gr_wait_for_member_state.inc

SET @@GLOBAL.DEBUG= @debug_saved;
--source include/start_group_replication.inc

--echo
--echo ############################################################
--echo # 9. Assert that the pipeline-specific error is logged on M2,
--echo #    confirming the early-return packet-free path executed.
--echo #

--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_only_after = CURRENT_TEST: group_replication.gr_applier_invalid_event_length
--let $assert_count = 1
--let $assert_select = Unable to convert a packet into an event on the applier! Error: invalid event length.
--let $assert_text = Found the expected invalid event length error on the pipeline conversion path.
--source include/assert_grep.inc

--echo
--echo ############################################################
--echo # 10. Assert that old errors are not logged.
--echo #

--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_only_after = CURRENT_TEST: group_replication.gr_applier_invalid_event_length
--let $assert_count = 0
--let $assert_select = Unable to convert a packet into an event on the applier! Error: Sanity check failed
--let $assert_text = Pre-patch deep-failure marker (Error: Sanity check failed) is absent on member 2.
--source include/assert_grep.inc

--echo
--echo ############################################################
--echo # 11. Clean up.
--echo #

--let $rpl_connection_name= server1
--source include/rpl_connection.inc
DROP TABLE t1;
DROP TABLE t2;

--source ../inc/group_replication_end.inc
