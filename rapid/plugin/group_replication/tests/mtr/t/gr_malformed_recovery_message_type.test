###############################################################################
# Group Replication malformed payload decode validation - payload item types
#
# Companion to gr_malformed_recovery_message, which covers a payload item whose
# declared length does not fit the message. This one covers the other half of a
# payload item: its type.
#
# Validating only lengths leaves a peer free to relabel the items of an
# otherwise well formed payload, and have each value decoded into whichever
# field the receiver expects at that position - a member uuid assigned from the
# message type item, for instance. Nothing about such a payload is out of
# bounds, so no bounds check can reject it; decode_payload() has to compare the
# type of every item against the item that position is defined to carry.
#
# The debug point group_replication_malformed_recovery_message_payload_type
# relabels the member uuid item of the recovery end message as the recovery
# message type item, leaving every length on the wire correct. Every joining
# member broadcasts that message when its recovery completes, so the malformed
# message reaches both members, the sender included, and both must reject it:
# report it, mark themselves in error and leave the group.
#
# Test:
# 0. The test requires two servers: M1 and M2, and a debug build.
#    The group is not started by the setup, so that M2's only join attempt is
#    the one carrying the malformed message.
# 1. Add the error suppressions on both members.
# 2. Bootstrap the group on M1.
# 3. Add a debug point on M2 to relabel the member uuid payload item of the
#    recovery end message.
# 4. Start GR on M2. Recovery completes, the malformed recovery end message is
#    broadcast to the group, and M2, the sender, rejects its own copy of it and
#    goes into ERROR instead of ONLINE.
# 5. Wait until M1, the receiver, rejects the message and goes into ERROR.
# 6. Assert that both members logged the rejection, that both were put into
#    read only mode, and that M2 was never declared online.
# 7. Restore the group and clean up.
###############################################################################
--source include/have_debug.inc
--source ../inc/have_group_replication_plugin.inc
--let $rpl_skip_group_replication_start= 1
--source ../inc/group_replication.inc

--echo
--echo ############################################################
--echo # 1. Add the error suppressions on both members.
--echo #

--let $rpl_connection_name= server1
--source include/rpl_connection.inc

SET SESSION sql_log_bin= 0;
call mtr.add_suppression("Malformed recovery message payload received from the group. The member will now exit the group.");
call mtr.add_suppression("The server was automatically set into read only mode after an error was detected.");
call mtr.add_suppression("Skipping leave operation: concurrent attempt to leave the group is on-going.");
call mtr.add_suppression("The member is leaving a group without being on one.");
call mtr.add_suppression("Error stopping all replication channels while server was leaving the group.*");
SET SESSION sql_log_bin= 1;

--let $rpl_connection_name= server2
--source include/rpl_connection.inc

SET SESSION sql_log_bin= 0;
call mtr.add_suppression("Malformed recovery message payload received from the group. The member will now exit the group.");
call mtr.add_suppression("The server was automatically set into read only mode after an error was detected.");
call mtr.add_suppression("Skipping leave operation: concurrent attempt to leave the group is on-going.");
call mtr.add_suppression("The member is leaving a group without being on one.");
call mtr.add_suppression("Error stopping all replication channels while server was leaving the group.*");
SET SESSION sql_log_bin= 1;

--echo
--echo ############################################################
--echo # 2. Bootstrap the group on M1.
--echo #

--let $rpl_connection_name= server1
--source include/rpl_connection.inc
--source ../inc/start_and_bootstrap_group_replication.inc

--echo
--echo ############################################################
--echo # 3. Add a debug point on M2 to relabel the member uuid payload item of
--echo #    the recovery end message.
--echo #

--let $rpl_connection_name= server2
--source include/rpl_connection.inc

--let $debug_point= group_replication_malformed_recovery_message_payload_type
--source include/add_debug_point.inc

--echo
--echo ############################################################
--echo # 4. Start GR on M2. Recovery completes, the malformed recovery end
--echo #    message is broadcast to the group, and M2, the sender, rejects its
--echo #    own copy of it and goes into ERROR instead of ONLINE.
--echo #

--let $group_replication_start_member_state= ERROR
--source include/start_group_replication.inc

--echo
--echo ############################################################
--echo # 5. Wait until M1, the receiver, rejects the message and goes into
--echo #    ERROR.
--echo #

--let $rpl_connection_name= server1
--source include/rpl_connection.inc

--let $group_replication_member_state= ERROR
--source ../inc/gr_wait_for_member_state.inc

--echo
--echo ############################################################
--echo # 6. Assert that both members logged the rejection, that both were put
--echo #    into read only mode, and that M2 was never declared online.
--echo #

--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_only_after= CURRENT_TEST: group_replication.gr_malformed_recovery_message_type
--let $assert_count= 1
--let $assert_select= Malformed recovery message payload received from the group. The member will now exit the group.
--let $assert_text= Member 1 rejected the relabelled recovery message payload item.
--source include/assert_grep.inc

--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_only_after= CURRENT_TEST: group_replication.gr_malformed_recovery_message_type
--let $assert_count= 1
--let $assert_select= Malformed recovery message payload received from the group. The member will now exit the group.
--let $assert_text= Member 2 rejected the relabelled recovery message payload item.
--source include/assert_grep.inc

--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_only_after= CURRENT_TEST: group_replication.gr_malformed_recovery_message_type
--let $assert_count= 0
--let $assert_select= This server was declared online within the replication group
--let $assert_text= Member 2 was never declared online, the malformed message was not acted upon.
--source include/assert_grep.inc

--let $assert_text= Member 1 was put into super read only mode.
--let $assert_cond= [SELECT @@GLOBAL.super_read_only] = 1
--source include/assert.inc

--let $rpl_connection_name= server2
--source include/rpl_connection.inc

--let $assert_text= Member 2 was put into super read only mode.
--let $assert_cond= [SELECT @@GLOBAL.super_read_only] = 1
--source include/assert.inc

--echo
--echo ############################################################
--echo # 7. Restore the group and clean up.
--echo #

--let $rpl_connection_name= server2
--source include/rpl_connection.inc

--let $debug_point= group_replication_malformed_recovery_message_payload_type
--source include/remove_debug_point.inc

--let $skip_assert_read_only= 1
--source include/stop_group_replication.inc

--let $rpl_connection_name= server1
--source include/rpl_connection.inc

--let $skip_assert_read_only= 1
--source include/stop_group_replication.inc

--source ../inc/start_and_bootstrap_group_replication.inc

--let $rpl_connection_name= server2
--source include/rpl_connection.inc
--source include/start_group_replication.inc

--let $rpl_connection_name= server1
--source include/rpl_connection.inc

--source ../inc/group_replication_end.inc
