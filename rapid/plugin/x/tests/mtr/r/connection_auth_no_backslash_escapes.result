install plugin mysqlx soname "mysqlx.so";
call mtr.add_suppression("Plugin mysqlx reported: .Failed at SSL configuration: .SSL context is not usable without certificate and private key..");
call mtr.add_suppression("Plugin mysqlx reported: .SSL_CTX_load_verify_locations failed.");
CREATE USER 'quote''user'@'localhost'
  IDENTIFIED WITH 'mysql_native_password' BY 'auth_string';
GRANT ALL ON *.* TO 'quote''user'@'localhost';
SET @old_global_sql_mode = @@GLOBAL.sql_mode;
SET @@GLOBAL.sql_mode = 'NO_BACKSLASH_ESCAPES';
Warnings:
Warning	3090	Changing sql mode 'NO_AUTO_CREATE_USER' is deprecated. It will be removed in a future release.
Connection with quoted user name under NO_BACKSLASH_ESCAPES
RUN SELECT CURRENT_USER() AS account

account
quote'user@localhost
0 rows affected
Mysqlx.Ok {
  msg: "bye!"
}
ok
SET @@GLOBAL.sql_mode = @old_global_sql_mode;
DROP USER 'quote''user'@'localhost';
UNINSTALL PLUGIN mysqlx;
