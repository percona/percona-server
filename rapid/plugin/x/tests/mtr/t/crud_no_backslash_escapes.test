## BUG#39268863 / PS-11437
## X Plugin generates SQL text for CRUD statements by escaping string
## literals with backslash-based quoting. Under session
## sql_mode=NO_BACKSLASH_ESCAPES the server parser does not treat backslash
## as an escape character, so a backslash-escaped literal built by X Plugin
## can be mis-parsed and break out of its intended string, letting
## attacker-controlled string content reach the surrounding SQL. Verify a
## CRUD string argument crafted to attempt exactly that predicate-injection
## no longer escapes its quoting under NO_BACKSLASH_ESCAPES.

--source ../include/xplugin_preamble.inc

## Test data
DROP SCHEMA IF EXISTS xtest;
CREATE SCHEMA xtest;
CREATE TABLE xtest.xtable (name VARCHAR(64), touched INT DEFAULT 0);
INSERT INTO xtest.xtable VALUES ('innocent', 0), ('target', 0);

SET @old_global_sql_mode = @@GLOBAL.sql_mode;
SET @@GLOBAL.sql_mode = 'NO_BACKSLASH_ESCAPES';

## Test starts here
--write_file $MYSQL_TMP_DIR/crud_no_backslash_escapes.tmp

-->echo Attempted predicate injection through CRUD string argument
-->quiet
Mysqlx.Crud.Update {
  collection { name: "xtable" schema: "xtest" }
  data_model: TABLE
  operation {
    source { name: "touched" }
    operation: SET
    value {
      type: LITERAL
      literal { type: V_SINT v_signed_int: 1 }
    }
  }
  criteria {
    type: OPERATOR
    operator {
      name: "||"
      param {
        type: OPERATOR
        operator {
          name: "=="
          param { type: IDENT identifier { name: "name" } }
          param { type: PLACEHOLDER position: 0 }
        }
      }
      param {
        type: OPERATOR
        operator {
          name: "=="
          param { type: IDENT identifier { name: "name" } }
          param { type: PLACEHOLDER position: 1 }
        }
      }
    }
  }
  args {
    type: V_STRING
    v_string { value: "missing')) OR TRUE -- " }
  }
  args {
    type: V_STRING
    v_string { value: "target" }
  }
}
-->noquiet
-->recvresult
EOF

--exec $MYSQLXTEST -uroot --password='' --file=$MYSQL_TMP_DIR/crud_no_backslash_escapes.tmp 2>&1
--remove_file $MYSQL_TMP_DIR/crud_no_backslash_escapes.tmp

--let $assert_text= CRUD update must touch exactly one row
--let $assert_cond= (SELECT COUNT(*) FROM xtest.xtable WHERE touched = 1) = 1
--source include/assert.inc

--let $assert_text= CRUD update must touch target row
--let $assert_cond= (SELECT COUNT(*) FROM xtest.xtable WHERE touched = 1 AND name = 0x746172676574) = 1
--source include/assert.inc

SET @@GLOBAL.sql_mode = @old_global_sql_mode;

## Postamble
DROP SCHEMA IF EXISTS xtest;
UNINSTALL PLUGIN mysqlx;
