/** @file include/sync0arr.ic
 The wait array for synchronization primitives

 Inline code

 Created 9/5/1995 Heikki Tuuri
 *******************************************************/

extern ulint sync_array_size;
extern sync_array_t **sync_wait_array;

template <typename Indexer>
static inline sync_array_t *sync_array_get_and_reserve_cell(
    void *object, ulint type, ut::Location location, sync_cell_t **cell) {
  sync_array_t *sync_arr = nullptr;

  *cell = nullptr;
  /* Skip the timer and modulo for the default single-array configuration. */
  size_t index =
      sync_array_size > 1 ? Indexer::get_rnd_index() % sync_array_size : 0;
  /* Walk each instance at most once from the random start (Bug#119585). */
  for (size_t i = 0; i < sync_array_size; ++i) {
    sync_arr = sync_wait_array[index];
    *cell = sync_array_reserve_cell(sync_arr, object, type, location);
    if (*cell != nullptr) {
      return sync_arr;
    }
    if (++index == sync_array_size) {
      index = 0;
    }
  }

  /* Every instance was tried without finding a free cell. */
  ut_a(*cell != nullptr);

  return (sync_arr);
}
